# name: test/sql/attach/remote_pushdown_parameters.test
# description: Prepared statements with parameters against an attached remote catalog are bound locally
# group: [attach]

require quack

require httpfs

statement ok
CREATE TABLE events(id INT, t VARCHAR);

statement ok
CALL quack_serve('quack:127.0.0.1:9541', token = 'test_token');

statement ok
ATTACH 'quack:127.0.0.1:9541' AS r (TOKEN 'test_token');

statement ok
INSERT INTO r.events VALUES (1, 'literal');

statement ok
PREPARE ins AS INSERT INTO r.events VALUES ($1, $2);

statement ok
EXECUTE ins(2, 'parameter');

statement ok
PREPARE sel AS SELECT count(*) FROM r.events WHERE id = $1;

query I
EXECUTE sel(2);
----
1

query I
EXECUTE sel(3);
----
0

query II
SELECT id, t FROM r.events ORDER BY id;
----
1	literal
2	parameter

statement ok
PREPARE sel_positional AS SELECT t FROM r.events WHERE id = ? OR t = ? ORDER BY t;

query I
EXECUTE sel_positional(1, 'parameter');
----
literal
parameter

statement ok
PREPARE sel_named AS SELECT id FROM r.events WHERE t = $t ORDER BY id LIMIT $n;

query I
EXECUTE sel_named(t := 'literal', n := 1);
----
1
