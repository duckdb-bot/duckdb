# name: test/optimizer/deliminator_repeated_delim_column.test
# description: A join that compares one column of the duplicate eliminated scan twice is kept
# group: [optimizer]

statement ok
CREATE TABLE t(a INTEGER, b INTEGER);

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30);

statement ok
CREATE TABLE secrets(id INTEGER);

statement ok
INSERT INTO secrets VALUES (1), (2);

statement ok
CREATE TABLE allowed(id INTEGER);

statement ok
INSERT INTO allowed VALUES (0), (2);

foreach cte_mode true false

statement ok
SET delim_join_as_cte={cte_mode};

# a volatile subquery, its scan has an index column next to the correlated column
query IT
SELECT a, EXISTS (SELECT random() FROM secrets sec JOIN allowed al ON (sec.id = al.id) WHERE sec.id = t.a) AS e
FROM t
ORDER BY a;
----
1	false
2	true
3	false

query I
SELECT a
FROM t
WHERE EXISTS (SELECT random() FROM secrets sec JOIN allowed al ON (sec.id = al.id) WHERE sec.id = t.a)
ORDER BY a;
----
2

# a second outer column
query II
SELECT a, (SELECT max(t.b + sec.id) FROM secrets sec JOIN allowed al ON (sec.id = al.id) WHERE sec.id = t.a) AS m
FROM t
ORDER BY a;
----
1	NULL
2	22
3	NULL

# the second outer column is used in another branch of the subquery
query II
SELECT a, (SELECT count(*) FROM (
	SELECT sec.id FROM secrets sec JOIN allowed al ON (sec.id = al.id) WHERE sec.id = t.a
	UNION ALL
	SELECT x FROM (VALUES (10)) v(x) WHERE x = t.b) u) AS c
FROM t
ORDER BY a;
----
1	1
2	1
3	0

# lateral joins
query II
SELECT a, x
FROM t, LATERAL (SELECT random() * 0 + sec.id AS x FROM secrets sec JOIN allowed al ON (sec.id = al.id) WHERE sec.id = t.a)
ORDER BY a;
----
2	2.0

query II
SELECT a, x
FROM t, LATERAL (SELECT t.b + sec.id AS x FROM secrets sec JOIN allowed al ON (sec.id = al.id) WHERE sec.id = t.a)
ORDER BY a;
----
2	22

endloop
