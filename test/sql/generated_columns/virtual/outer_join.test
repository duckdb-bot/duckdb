# name: test/sql/generated_columns/virtual/outer_join.test
# description: A generated column is NULL in the rows that an outer join NULL-extends
# group: [virtual]

statement ok
CREATE TABLE t1 (c1 INTEGER, c2 INTEGER AS (1), c3 BOOLEAN AS (c1 IS NULL), c4 INTEGER AS (coalesce(c1, 0) + 5), c5 INTEGER AS (c2 * 2), c6 INTEGER AS (c1 + 1));

statement ok
INSERT INTO t1 VALUES (10), (NULL);

statement ok
CREATE TABLE p (k INTEGER);

statement ok
INSERT INTO p VALUES (1), (10);

query IIIIII
SELECT t1.c1, t1.c2, t1.c3, t1.c4, t1.c5, t1.c6 FROM (VALUES (1)) v(x) LEFT JOIN t1 ON FALSE
----
NULL	NULL	NULL	NULL	NULL	NULL

query I
SELECT k FROM p LEFT JOIN t1 ON p.k = t1.c1 WHERE t1.c2 IS NULL ORDER BY k
----
1

query II
SELECT count(t1.c1), count(t1.c2) FROM p LEFT JOIN t1 ON p.k = t1.c1
----
1	1

query IIIIIII
SELECT k, c1, c2, c3, c4, c5, c6 FROM t1 RIGHT JOIN p ON p.k = t1.c1 ORDER BY k
----
1	NULL	NULL	NULL	NULL	NULL	NULL
10	10	1	false	15	2	11

# a row of the table with a NULL column is not NULL-extended
query IIIIIII
SELECT k, c1, c2, c3, c4, c5, c6 FROM p FULL JOIN t1 ON p.k = t1.c1 ORDER BY k NULLS LAST, c1 NULLS LAST
----
1	NULL	NULL	NULL	NULL	NULL	NULL
10	10	1	false	15	2	11
NULL	NULL	1	true	5	2	NULL

query IIIIIII
SELECT * FROM p LEFT JOIN t1 ON p.k = t1.c1 ORDER BY k
----
1	NULL	NULL	NULL	NULL	NULL	NULL
10	10	1	false	15	2	11

query II
SELECT k, c2 FROM p LEFT JOIN t1 ON p.k = t1.c1 AND t1.c2 = 1 ORDER BY k
----
1	NULL
10	1

query II
SELECT p.k, t1.c2 FROM p LEFT JOIN (t1 JOIN p p2 ON t1.c1 = p2.k) ON p.k = t1.c1 ORDER BY 1
----
1	NULL
10	1

query II
SELECT k, c2 FROM (VALUES (1), (2), (10)) q(k) POSITIONAL JOIN t1
----
1	1
2	1
10	NULL

statement ok
CREATE TABLE ts (t INTEGER, g INTEGER AS (coalesce(t, 0) + 1));

statement ok
INSERT INTO ts VALUES (5);

query II
SELECT k, g FROM p ASOF LEFT JOIN ts ON p.k >= ts.t ORDER BY k
----
1	NULL
10	6

# an expression that is already NULL for a NULL row can still be grouped by its columns
query II
SELECT t1.c6, count(*) FROM p LEFT JOIN t1 ON p.k = t1.c1 GROUP BY t1.c1 ORDER BY 1
----
11	1
NULL	1

statement ok
CREATE TABLE gr (a INTEGER, n INTEGER AS (NULL), m INTEGER AS (a + coalesce(a, 0)), c INTEGER AS (coalesce(a, 0) + 5));

statement ok
INSERT INTO gr VALUES (10);

query III
SELECT gr.n, gr.m, count(*) FROM p LEFT JOIN gr ON p.k = gr.a GROUP BY gr.a ORDER BY ALL
----
NULL	20	1
NULL	NULL	1

# an expression that is not NULL for a NULL row depends on the row id, which is not grouped
statement error
SELECT gr.c FROM p LEFT JOIN gr ON p.k = gr.a GROUP BY gr.a
----
must appear in the GROUP BY clause

# a regular column named rowid hides the row id, so a matched row keeps its value
statement ok
CREATE TABLE s (rowid INTEGER, g INTEGER AS (42));

statement ok
INSERT INTO s VALUES (NULL);

query I
SELECT s.g FROM (VALUES (1)) v(x) LEFT JOIN s ON TRUE
----
42

# tables of the same name in nested schemas
statement ok
CREATE SCHEMA n1;

statement ok
CREATE SCHEMA n1.s;

statement ok
CREATE SCHEMA n2;

statement ok
CREATE SCHEMA n2.s;

statement ok
CREATE TABLE n1.s.t (a INTEGER, g INTEGER AS (a + 1), k INTEGER AS (42));

statement ok
CREATE TABLE n2.s.t (a INTEGER, g INTEGER AS (a + 1), k INTEGER AS (42));

statement ok
INSERT INTO n1.s.t VALUES (1);

statement ok
INSERT INTO n2.s.t VALUES (2);

query IIII
SELECT n1.s.t.g, n1.s.t.k, n2.s.t.g, n2.s.t.k FROM n1.s.t LEFT JOIN n2.s.t ON n1.s.t.a = n2.s.t.a
----
2	42	NULL	NULL

# the expression is checked with the functions that the view sees
statement ok
CREATE SCHEMA sp;

statement ok
CREATE MACRO f(x) AS x + 1;

statement ok
SET schema = 'sp';

statement ok
CREATE MACRO f(x) AS coalesce(x, 42);

statement ok
CREATE TABLE tf (a INTEGER, g INTEGER AS (f(a)));

statement ok
CREATE VIEW vf AS SELECT tf.g FROM (VALUES (1)) p(x) LEFT JOIN tf ON FALSE;

statement ok
SET schema = 'main';

query I
SELECT * FROM sp.vf
----
NULL
