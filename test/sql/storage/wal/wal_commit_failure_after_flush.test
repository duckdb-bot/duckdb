# name: test/sql/storage/wal/wal_commit_failure_after_flush.test
# description: A commit that fails after its WAL flush is fatal and replayed on restart, not reported as failed
# group: [wal]

require skip_reload

load {TEST_DIR}/wal_commit_failure_after_flush.db

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET wal_autocheckpoint='1TB';

statement ok
CREATE TABLE t (id INTEGER);

statement ok
SET debug_checkpoint_abort='after_wal_flush';

# a bulk insert writes its row groups optimistically, and the commit fails after the WAL flush
statement error
INSERT INTO t SELECT * FROM range(130000);
----
Commit could not be completed after it was written to the WAL

# the database does not go on without the commit it wrote
statement error
SELECT count(*) FROM t;
----
has been invalidated

restart

statement ok
SET debug_checkpoint_abort='none';

# the restart replays the commit
query I
SELECT count(*) FROM t;
----
130000

# the same for a commit without optimistically written row groups
statement ok
SET debug_checkpoint_abort='after_wal_flush';

statement error
INSERT INTO t VALUES (130000);
----
Commit could not be completed after it was written to the WAL

statement error
SELECT count(*) FROM t;
----
has been invalidated

restart

statement ok
SET debug_checkpoint_abort='none';

query II
SELECT count(*), max(id) FROM t;
----
130001	130000

statement ok
INSERT INTO t VALUES (130001);

query I
SELECT count(*) FROM t;
----
130002
