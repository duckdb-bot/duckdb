# name: test/sql/merge/merge_into_try_subquery.test
# description: TRY over a scalar subquery in MERGE INTO action conditions and error messages
# group: [merge]

statement ok
CREATE TABLE t(k INTEGER, v INTEGER, txt VARCHAR);

statement ok
INSERT INTO t VALUES (1, 10, 'bad');

# the subquery raises an error that TRY masks, so the condition holds in a plain query
query I
SELECT TRY(1 + (SELECT txt::INTEGER FROM t)) IS NULL;
----
true

# the same condition on a WHEN MATCHED action
statement ok
MERGE INTO t USING (VALUES (1)) src(k) ON t.k = src.k
  WHEN MATCHED AND TRY(1 + (SELECT txt::INTEGER FROM t)) IS NULL THEN UPDATE SET v = 0;

query III
SELECT * FROM t;
----
1	0	bad

# a DELETE action
statement ok
MERGE INTO t USING (VALUES (1)) src(k) ON t.k = src.k
  WHEN MATCHED AND TRY(1 + (SELECT txt::INTEGER FROM t)) IS NULL THEN DELETE;

query I
SELECT count(*) FROM t;
----
0

# WHEN NOT MATCHED
statement ok
MERGE INTO t USING (VALUES (1)) src(k) ON t.k = src.k
  WHEN NOT MATCHED AND TRY(1 + (SELECT 'bad'::INTEGER)) IS NULL THEN INSERT VALUES (src.k, 10, 'bad');

query III
SELECT * FROM t;
----
1	10	bad

# WHEN NOT MATCHED BY SOURCE
statement ok
MERGE INTO t USING (VALUES (2)) src(k) ON t.k = src.k
  WHEN NOT MATCHED BY SOURCE AND TRY(1 + (SELECT txt::INTEGER FROM t)) IS NULL THEN UPDATE SET v = 1;

query III
SELECT * FROM t;
----
1	1	bad

# HAS_ERROR as the condition
statement ok
MERGE INTO t USING (VALUES (1)) src(k) ON t.k = src.k
  WHEN MATCHED AND HAS_ERROR(1 + (SELECT txt::INTEGER FROM t)) THEN UPDATE SET v = 2;

query III
SELECT * FROM t;
----
1	2	bad

# a correlated subquery, and source and target columns next to the subquery
statement ok
MERGE INTO t USING (VALUES (1)) src(k) ON t.k = src.k
  WHEN MATCHED AND TRY(src.k + t.v + (SELECT s.txt::INTEGER FROM t s WHERE s.k = t.k)) IS NULL THEN UPDATE SET v = 3;

query III
SELECT * FROM t;
----
1	3	bad

# TRY in an ERROR message, which the error reports with the masked value gone
statement error
MERGE INTO t USING (VALUES (1)) src(k) ON t.k = src.k
  WHEN MATCHED THEN ERROR concat('masked ', TRY(1 + (SELECT txt::INTEGER FROM t))::VARCHAR, 'end');
----
Merge error condition WHEN MATCHED: masked end

# a subquery that raises no error contributes its value
statement ok
UPDATE t SET txt = '5';

statement ok
MERGE INTO t USING (VALUES (1)) src(k) ON t.k = src.k
  WHEN MATCHED AND TRY(1 + (SELECT txt::INTEGER FROM t)) = 6 THEN UPDATE SET v = 4;

query III
SELECT * FROM t;
----
1	4	5

# TRY directly over the subquery
statement ok
MERGE INTO t USING (VALUES (1)) src(k) ON t.k = src.k
  WHEN MATCHED AND TRY((SELECT txt::INTEGER FROM t)) = 5 THEN UPDATE SET v = 5;

query III
SELECT * FROM t;
----
1	5	5

# TRY directly over a subquery that correlates on the target and on the source
statement ok
MERGE INTO t USING (VALUES (1)) src(k) ON t.k = src.k
  WHEN MATCHED AND TRY((SELECT t.k)) = 1 AND TRY((SELECT src.k + 1)) = 2 THEN UPDATE SET v = 6;

query III
SELECT * FROM t;
----
1	6	5

statement error
MERGE INTO t USING (VALUES (1)) src(k) ON t.k = src.k
  WHEN MATCHED THEN ERROR concat('key ', TRY((SELECT t.k))::VARCHAR);
----
key 1

# the subquery value must not be read as a row id
statement ok
CREATE TABLE u(k INTEGER, v INTEGER);

statement ok
INSERT INTO u VALUES (1, 10), (2, 20), (3, 30);

statement ok
MERGE INTO u USING (VALUES (3)) src(k) ON u.k = src.k
  WHEN MATCHED AND TRY((SELECT 1::BIGINT)) = 1 THEN DELETE;

query II
SELECT * FROM u ORDER BY k;
----
1	10
2	20

statement ok
MERGE INTO u USING (VALUES (2)) src(k) ON u.k = src.k
  WHEN MATCHED AND TRY((SELECT 0::BIGINT)) = 0 THEN UPDATE SET v = 0;

query II
SELECT * FROM u ORDER BY k;
----
1	10
2	0

statement ok
MERGE INTO u USING (VALUES (1)) src(k) ON u.k = src.k
  WHEN MATCHED AND TRY((SELECT 1)) = 1 THEN DELETE;

query II
SELECT * FROM u ORDER BY k;
----
2	0

statement ok
INSERT INTO u VALUES (1, 10), (3, 30);

statement ok
MERGE INTO u USING (VALUES (3)) src(k) ON u.k = src.k
  WHEN MATCHED AND TRY((SELECT 1::BIGINT)) = 1 THEN UPDATE SET v = 33;

query II
SELECT * FROM u ORDER BY k;
----
1	10
2	0
3	33

# a subquery that a macro expands to
statement ok
CREATE MACRO m() AS (SELECT 'bad'::INTEGER);

statement ok
MERGE INTO u USING (VALUES (3)) src(k) ON u.k = src.k
  WHEN MATCHED AND TRY(1 + m()) IS NULL THEN UPDATE SET v = 3;

query II
SELECT * FROM u ORDER BY k;
----
1	10
2	0
3	3

# TRY without a subquery
statement ok
MERGE INTO u USING (VALUES (3)) src(k) ON u.k = src.k
  WHEN MATCHED AND TRY(('x' || v)::INTEGER) IS NULL THEN UPDATE SET v = 4;

query II
SELECT * FROM u ORDER BY k;
----
1	10
2	0
3	4

# subqueries in lambdas keep moving out of the lambda on their own
statement ok
MERGE INTO u USING (VALUES (3)) src(k) ON u.k = src.k
  WHEN MATCHED AND list_transform([1, 2], lambda x: TRY(x + (SELECT 1))) = [2, 3] THEN UPDATE SET v = 5;

statement ok
MERGE INTO u USING (VALUES (3)) src(k) ON u.k = src.k
  WHEN MATCHED AND TRY(list_transform([1, 2], lambda x: x + (SELECT 1))) = [2, 3] THEN UPDATE SET v = v + 1;

query II
SELECT * FROM u ORDER BY k;
----
1	10
2	0
3	6

# macros that expand to a lambda around a subquery
statement ok
CREATE MACRO lt(y) AS list_transform([1, 2], lambda x: x + y);

statement ok
CREATE MACRO one() AS (SELECT 1);

statement ok
MERGE INTO u USING (VALUES (3)) src(k) ON u.k = src.k
  WHEN MATCHED AND TRY(lt(one())) = [2, 3] THEN UPDATE SET v = v + 1;

statement ok
MERGE INTO u USING (VALUES (3)) src(k) ON u.k = src.k
  WHEN MATCHED AND TRY(lt((SELECT 1))) = [2, 3] THEN UPDATE SET v = v + 1;

query II
SELECT * FROM u ORDER BY k;
----
1	10
2	0
3	8

# the condition keeps the semantics of SELECT, where an error in the subquery turns the whole TRY into NULL, also
# when the expression around the subquery tolerates NULL, and HAS_ERROR sees the error
statement ok
CREATE TABLE w(k INTEGER, v INTEGER, txt VARCHAR);

statement ok
INSERT INTO w VALUES (1, 10, 'bad');

query IIII
SELECT TRY((SELECT txt::INTEGER FROM w) IS NULL), TRY(coalesce((SELECT txt::INTEGER FROM w), 5)),
       HAS_ERROR(1 + (SELECT txt::INTEGER FROM w)), HAS_ERROR(TRY((SELECT txt::INTEGER FROM w))) FROM w;
----
NULL	NULL	true	false

# NULL is not true, so these actions do not run
statement ok
MERGE INTO w USING (VALUES (1)) src(k) ON w.k = src.k
  WHEN MATCHED AND TRY((SELECT txt::INTEGER FROM w) IS NULL) THEN UPDATE SET v = 0;

statement ok
MERGE INTO w USING (VALUES (1)) src(k) ON w.k = src.k
  WHEN MATCHED AND TRY(coalesce((SELECT txt::INTEGER FROM w), 5)) = 5 THEN UPDATE SET v = 0;

query III
SELECT * FROM w;
----
1	10	bad

statement ok
MERGE INTO w USING (VALUES (1)) src(k) ON w.k = src.k
  WHEN MATCHED AND TRY(coalesce((SELECT txt::INTEGER FROM w), 5)) IS NULL THEN UPDATE SET v = 1;

# TRY directly over the subquery masks the error before HAS_ERROR sees it
statement ok
MERGE INTO w USING (VALUES (1)) src(k) ON w.k = src.k
  WHEN MATCHED AND NOT HAS_ERROR(TRY((SELECT txt::INTEGER FROM w))) THEN UPDATE SET v = v + 1;

query III
SELECT * FROM w;
----
1	2	bad

# HAS_ERROR in an error message
statement error
MERGE INTO w USING (VALUES (1)) src(k) ON w.k = src.k
  WHEN MATCHED THEN ERROR concat('has error ', HAS_ERROR(1 + (SELECT txt::INTEGER FROM w))::VARCHAR);
----
has error true

# an erroring subquery in a lambda body is masked by the TRY in the body, or by the TRY around the lambda
statement ok
MERGE INTO w USING (VALUES (1)) src(k) ON w.k = src.k
  WHEN MATCHED AND list_transform([1, 2], lambda x: TRY(x + (SELECT txt::INTEGER FROM w))) = [NULL, NULL] THEN UPDATE SET v = 3;

statement ok
MERGE INTO w USING (VALUES (1)) src(k) ON w.k = src.k
  WHEN MATCHED AND TRY(list_transform([1, 2], lambda x: x + (SELECT txt::INTEGER FROM w))) IS NULL THEN UPDATE SET v = v + 1;

query III
SELECT * FROM w;
----
1	4	bad

# target rows whose correlated lookup errors, succeeds, is NULL or has no row, with earlier actions taking some rows,
# so every row sees its own error flag
statement ok
CREATE TABLE lookup(k INTEGER, txt VARCHAR);

statement ok
INSERT INTO lookup VALUES (1, 'bad'), (2, '5'), (3, NULL), (5, '7');

statement ok
CREATE TABLE tgt(k INTEGER, v INTEGER);

statement ok
INSERT INTO tgt VALUES (1, 10), (2, 20), (3, 30), (4, 40), (5, 50);

query III
SELECT k, TRY(coalesce((SELECT l.txt::INTEGER FROM lookup l WHERE l.k = tgt.k), 5)),
       HAS_ERROR(1 + (SELECT l.txt::INTEGER FROM lookup l WHERE l.k = tgt.k)) FROM tgt ORDER BY k;
----
1	NULL	true
2	5	false
3	5	false
4	5	false
5	7	false

statement ok
MERGE INTO tgt USING (VALUES (1), (2), (3), (4), (5)) src(k) ON tgt.k = src.k
  WHEN MATCHED AND TRY((SELECT l.txt::INTEGER FROM lookup l WHERE l.k = tgt.k)) = 5 THEN UPDATE SET v = 1
  WHEN MATCHED AND HAS_ERROR(1 + (SELECT l.txt::INTEGER FROM lookup l WHERE l.k = tgt.k)) THEN UPDATE SET v = -1
  WHEN MATCHED AND TRY(coalesce((SELECT l.txt::INTEGER FROM lookup l WHERE l.k = tgt.k), 5)) = 5 THEN UPDATE SET v = 0;

query II
SELECT * FROM tgt ORDER BY k;
----
1	-1
2	1
3	0
4	0
5	50

# the same rows through lambdas
statement ok
MERGE INTO tgt USING (VALUES (1), (2), (3), (4), (5)) src(k) ON tgt.k = src.k
  WHEN MATCHED AND list_transform([1], lambda x: TRY(x + (SELECT l.txt::INTEGER FROM lookup l WHERE l.k = tgt.k))) = [6] THEN UPDATE SET v = v + 100
  WHEN MATCHED AND TRY(list_transform([1], lambda x: x + (SELECT l.txt::INTEGER FROM lookup l WHERE l.k = tgt.k))) IS NULL THEN UPDATE SET v = v - 100;

query II
SELECT * FROM tgt ORDER BY k;
----
1	-101
2	101
3	0
4	0
5	50

# the database stays usable
query I
SELECT 42;
----
42
