# name: test/sql/window/test_leadlag_orderby_ignore_nulls.test
# description: LEAD and LAG with an argument ORDER BY and IGNORE NULLS skip the NULL rows before the own row
# group: [window]

query III
SELECT k,
	LEAD(v ORDER BY k IGNORE NULLS) OVER w,
	LAG(v ORDER BY k IGNORE NULLS) OVER w
FROM (VALUES (1, NULL), (2, 20), (3, 30), (4, 40)) t(k, v)
WINDOW w AS (ORDER BY k DESC ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
ORDER BY k
----
1	20	NULL
2	30	NULL
3	40	20
4	NULL	30

statement ok
CREATE TABLE t AS
SELECT i AS k, CASE WHEN i % 3 = 0 OR i % 7 = 0 THEN NULL ELSE i * 10 END AS v, (i * 37) % 101 AS w
FROM range(1, 101) r(i);

# over the whole partition the argument ordering gives the same results as the window ordering
query I
SELECT count(*) FROM (
	SELECT
		LEAD(v ORDER BY k IGNORE NULLS) OVER wf AS a1, LEAD(v IGNORE NULLS) OVER wk AS b1,
		LEAD(v, 3 ORDER BY k IGNORE NULLS) OVER wf AS a2, LEAD(v, 3 IGNORE NULLS) OVER wk AS b2,
		LAG(v ORDER BY k IGNORE NULLS) OVER wf AS a3, LAG(v IGNORE NULLS) OVER wk AS b3,
		LAG(v, 2, -1 ORDER BY k IGNORE NULLS) OVER wf AS a4, LAG(v, 2, -1 IGNORE NULLS) OVER wk AS b4,
		LEAD(v, -2 ORDER BY k IGNORE NULLS) OVER wf AS a5, LEAD(v, -2 IGNORE NULLS) OVER wk AS b5,
		LEAD(v, 0 ORDER BY k IGNORE NULLS) OVER wf AS a6, LEAD(v, 0 IGNORE NULLS) OVER wk AS b6
	FROM t
	WINDOW
		wf AS (PARTITION BY k % 4 ORDER BY w ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING),
		wk AS (PARTITION BY k % 4 ORDER BY k)
)
WHERE a1 IS DISTINCT FROM b1 OR a2 IS DISTINCT FROM b2 OR a3 IS DISTINCT FROM b3 OR a4 IS DISTINCT FROM b4
	OR a5 IS DISTINCT FROM b5 OR a6 IS DISTINCT FROM b6
----
0

# a frame around the own row, and a frame without it
query I
SELECT count(*) FROM (
	SELECT
		LEAD(v ORDER BY k DESC IGNORE NULLS) OVER (ORDER BY k ROWS BETWEEN 3 PRECEDING AND 2 FOLLOWING) AS a1,
		(SELECT s.v FROM t s WHERE s.k BETWEEN t.k - 3 AND t.k + 2 AND s.k < t.k AND s.v IS NOT NULL
			ORDER BY s.k DESC LIMIT 1) AS b1,
		LAG(v, 2 ORDER BY k DESC IGNORE NULLS) OVER (ORDER BY k ROWS BETWEEN 3 PRECEDING AND 2 FOLLOWING) AS a2,
		(SELECT s.v FROM t s WHERE s.k BETWEEN t.k - 3 AND t.k + 2 AND s.k > t.k AND s.v IS NOT NULL
			ORDER BY s.k LIMIT 1 OFFSET 1) AS b2,
		LAG(v ORDER BY k IGNORE NULLS) OVER (ORDER BY k DESC ROWS BETWEEN 1 FOLLOWING AND 4 FOLLOWING) AS a3,
		(SELECT s.v FROM t s WHERE s.k BETWEEN t.k - 4 AND t.k - 1 AND s.v IS NOT NULL
			ORDER BY s.k DESC LIMIT 1) AS b3,
		LAG(v, 2 ORDER BY k IGNORE NULLS) OVER (ORDER BY k DESC ROWS BETWEEN 1 FOLLOWING AND 4 FOLLOWING) AS a4,
		(SELECT s.v FROM t s WHERE s.k BETWEEN t.k - 4 AND t.k - 1 AND s.v IS NOT NULL
			ORDER BY s.k DESC LIMIT 1 OFFSET 1) AS b4
	FROM t
)
WHERE a1 IS DISTINCT FROM b1 OR a2 IS DISTINCT FROM b2 OR a3 IS DISTINCT FROM b3 OR a4 IS DISTINCT FROM b4
----
0

# frames wider than a few hundred rows count through the value tree
statement ok
CREATE TABLE t2 AS
SELECT i AS k, CASE WHEN i % 3 = 0 OR i % 7 = 0 THEN NULL ELSE i * 10 END AS v, (i * 37) % 2003 AS w
FROM range(1, 2001) r(i);

query I
SELECT count(*) FROM (
	SELECT
		LEAD(v ORDER BY k IGNORE NULLS) OVER wf AS a1, LEAD(v IGNORE NULLS) OVER wk AS b1,
		LAG(v, 2 ORDER BY k IGNORE NULLS) OVER wf AS a2, LAG(v, 2 IGNORE NULLS) OVER wk AS b2,
		LEAD(v, -3 ORDER BY k IGNORE NULLS) OVER wf AS a3, LEAD(v, -3 IGNORE NULLS) OVER wk AS b3
	FROM t2
	WINDOW
		wf AS (PARTITION BY k % 2 ORDER BY w ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING),
		wk AS (PARTITION BY k % 2 ORDER BY k)
)
WHERE a1 IS DISTINCT FROM b1 OR a2 IS DISTINCT FROM b2 OR a3 IS DISTINCT FROM b3
----
0

query I
SELECT count(*) FROM (
	SELECT
		LEAD(v ORDER BY k DESC IGNORE NULLS) OVER (ORDER BY k ROWS BETWEEN 300 PRECEDING AND 300 FOLLOWING) AS a1,
		(SELECT s.v FROM t2 s WHERE s.k BETWEEN t2.k - 300 AND t2.k + 300 AND s.k < t2.k AND s.v IS NOT NULL
			ORDER BY s.k DESC LIMIT 1) AS b1,
		LAG(v, 2 ORDER BY k IGNORE NULLS) OVER (ORDER BY k DESC ROWS BETWEEN 1 FOLLOWING AND 400 FOLLOWING) AS a2,
		(SELECT s.v FROM t2 s WHERE s.k BETWEEN t2.k - 400 AND t2.k - 1 AND s.v IS NOT NULL
			ORDER BY s.k DESC LIMIT 1 OFFSET 1) AS b2
	FROM t2
)
WHERE a1 IS DISTINCT FROM b1 OR a2 IS DISTINCT FROM b2
----
0

# with ties in the argument ordering, LEAD and LAG return each other row once and never the own row
statement ok
CREATE TABLE ties AS
SELECT i, CASE WHEN i % 5 = 0 THEN NULL ELSE i END AS v, i % 7 AS k, hash(i) % 1000 AS w
FROM range(10000) r(i);

query IIIIII
SELECT count(*) FILTER (WHERE nxt = i), count(*) FILTER (WHERE prv = i), count(DISTINCT nxt), count(DISTINCT prv),
	count(*) FILTER (WHERE nxt_v = v OR prv_v = v), count(DISTINCT nxt_v)
FROM (
	SELECT i, v,
		LEAD(i ORDER BY k) OVER w AS nxt, LAG(i ORDER BY k) OVER w AS prv,
		LEAD(v ORDER BY k IGNORE NULLS) OVER w AS nxt_v, LAG(v ORDER BY k IGNORE NULLS) OVER w AS prv_v
	FROM ties
	WINDOW w AS (ORDER BY w, i ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
)
----
0	0	9999	9999	0	8000

# no row with a value
query III
SELECT k,
	LEAD(v ORDER BY k IGNORE NULLS) OVER w,
	LAG(v, 2 ORDER BY k IGNORE NULLS) OVER w
FROM (VALUES (1, NULL::INTEGER), (2, NULL), (3, NULL)) t(k, v)
WINDOW w AS (ORDER BY k DESC ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
ORDER BY k
----
1	NULL	NULL
2	NULL	NULL
3	NULL	NULL

# without IGNORE NULLS the NULL rows count
query III
SELECT k,
	LEAD(v ORDER BY k) OVER w,
	LAG(v ORDER BY k) OVER w
FROM (VALUES (1, NULL), (2, 20), (3, 30), (4, 40)) t(k, v)
WINDOW w AS (ORDER BY k DESC ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
ORDER BY k
----
1	20	NULL
2	30	NULL
3	40	20
4	NULL	30
