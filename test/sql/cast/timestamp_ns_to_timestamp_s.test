# name: test/sql/cast/timestamp_ns_to_timestamp_s.test
# description: TIMESTAMP_NS casts directly to TIMESTAMP_S, rounding away from the epoch like the other precision casts
# group: [cast]

query I
SELECT TIMESTAMP_NS '2020-01-01 10:00:00.5'::TIMESTAMP_S;
----
2020-01-01 10:00:01

query IIIII
SELECT TIMESTAMP_NS '2020-01-01 10:00:00.499999999'::TIMESTAMP_S, TIMESTAMP_NS '2020-01-01 10:00:00.500000001'::TIMESTAMP_S, TIMESTAMP_NS '1969-12-31 23:59:59.5'::TIMESTAMP_S, TIMESTAMP_NS '1969-12-31 23:59:59.499999999'::TIMESTAMP_S, TIMESTAMP_NS '1969-12-31 23:59:59.500000001'::TIMESTAMP_S;
----
2020-01-01 10:00:00	2020-01-01 10:00:01	1969-12-31 23:59:59	1969-12-31 23:59:59	1970-01-01 00:00:00

query III
SELECT TRY_CAST(TIMESTAMP_NS '2020-01-01 10:00:00.5' AS TIMESTAMP_S), NULL::TIMESTAMP_NS::TIMESTAMP_S, typeof(TIMESTAMP_NS '2020-01-01 10:00:00.5'::TIMESTAMP_S);
----
2020-01-01 10:00:01	NULL	TIMESTAMP_S

query II
SELECT 'infinity'::TIMESTAMP_NS::TIMESTAMP_S, '-infinity'::TIMESTAMP_NS::TIMESTAMP_S;
----
infinity	-infinity

# the whole TIMESTAMP_NS range fits
query II
SELECT TIMESTAMP_NS '2262-04-11 23:47:16.854775806'::TIMESTAMP_S, TIMESTAMP_NS '1677-09-21 00:12:43.146'::TIMESTAMP_S;
----
2262-04-11 23:47:17	1677-09-21 00:12:43

# the direct cast agrees with the cast through TIMESTAMP_MS on every value of a table
statement ok
CREATE TABLE ns AS SELECT TIMESTAMP_NS '2000-01-01 00:00:00' + to_microseconds(i * 777777) + to_nanoseconds(i % 1000) AS ts FROM range(5000) t(i);

query I
SELECT count(*) FROM ns WHERE ts::TIMESTAMP_S <> ts::TIMESTAMP_MS::TIMESTAMP_S;
----
0

# CREATE TABLE AS, INSERT and UNION convert too
statement ok
CREATE TABLE s(ts TIMESTAMP_S);

statement ok
INSERT INTO s SELECT ts FROM ns WHERE ts < TIMESTAMP_NS '2000-01-01 00:00:03';

query I
SELECT ts FROM s ORDER BY ts;
----
2000-01-01 00:00:00
2000-01-01 00:00:01
2000-01-01 00:00:02
2000-01-01 00:00:02

statement ok
CREATE TABLE s2 AS SELECT ts::TIMESTAMP_S AS ts FROM ns;

query I
SELECT count(*) FROM s2;
----
5000

query I
SELECT typeof(ts) FROM (SELECT TIMESTAMP_S '2020-01-01 00:00:00' AS ts UNION ALL SELECT TIMESTAMP_NS '2020-01-01 00:00:00.5') LIMIT 1;
----
TIMESTAMP_NS
