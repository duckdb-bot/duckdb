# name: test/sql/copy/parquet/writer/parquet_write_uhugeint.test
# description: Parquet uhugeint round trip
# group: [writer]

require parquet

statement ok
CREATE TABLE hugeints(h UHUGEINT)

statement ok
INSERT INTO hugeints VALUES (0), (1), (NULL), (1180591620717411303424)

statement ok
COPY hugeints TO '{TEST_DIR}/hugeints.parquet' (FORMAT 'parquet');

query I
SELECT * FROM '{TEST_DIR}/hugeints.parquet'
----
0
1
NULL
1180591620717411303424

# a UHUGEINT is written as a 17 byte DECIMAL(39,0), which holds every value of the type
query I
SELECT typeof(h) FROM '{TEST_DIR}/hugeints.parquet' LIMIT 1
----
DECIMAL(39,0)

query IIIII
SELECT type, type_length, converted_type, precision, scale FROM parquet_schema('{TEST_DIR}/hugeints.parquet') WHERE name = 'h'
----
FIXED_LEN_BYTE_ARRAY	17	DECIMAL	39	0

query II
SELECT stats_min_value, stats_max_value FROM parquet_metadata('{TEST_DIR}/hugeints.parquet')
----
0	1180591620717411303424

# the largest values of the type, beyond the range of a HUGEINT
statement ok
CREATE TABLE limits AS SELECT * FROM (VALUES
	(0::UHUGEINT),
	(9007199254740993::UHUGEINT),
	(170141183460469231731687303715884105728::UHUGEINT),
	(340282366920938463463374607431768211455::UHUGEINT)) t(h)

statement ok
COPY limits TO '{TEST_DIR}/uhugeint_limits.parquet' (FORMAT 'parquet');

query I
SELECT h::UHUGEINT FROM '{TEST_DIR}/uhugeint_limits.parquet' ORDER BY h
----
0
9007199254740993
170141183460469231731687303715884105728
340282366920938463463374607431768211455

query I
SELECT count(*) FROM (SELECT h FROM '{TEST_DIR}/uhugeint_limits.parquet' EXCEPT SELECT h FROM limits)
----
0

query II
SELECT stats_min_value, stats_max_value FROM parquet_metadata('{TEST_DIR}/uhugeint_limits.parquet')
----
0	340282366920938463463374607431768211455

# dictionary encoding and a bloom filter, as for every other integer type
statement ok
COPY (SELECT (i % 10)::UHUGEINT * 34028236692093846346337460743176821145::UHUGEINT AS h FROM range(5000) t(i)) TO '{TEST_DIR}/uhugeint_dict.parquet' (FORMAT 'parquet');

query II
SELECT encodings, bloom_filter_length > 0 FROM parquet_metadata('{TEST_DIR}/uhugeint_dict.parquet')
----
PLAIN_DICTIONARY	true

query I
SELECT bloom_filter_excludes FROM parquet_bloom_probe('{TEST_DIR}/uhugeint_dict.parquet', 'h', 34028236692093846346337460743176821146::UHUGEINT)
----
true

query I
SELECT count(*) FROM '{TEST_DIR}/uhugeint_dict.parquet' WHERE h = 34028236692093846346337460743176821145::UHUGEINT
----
500
