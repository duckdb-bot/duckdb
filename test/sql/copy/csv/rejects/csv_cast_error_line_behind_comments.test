# name: test/sql/copy/csv/rejects/csv_cast_error_line_behind_comments.test
# description: A cast error found after parsing reports its own line, whatever comments or skipped empty lines follow
# group: [rejects]

# a comment behind the row that fails to cast
statement ok
COPY (SELECT line FROM (VALUES (0, 'a'), (1, 'bad'), (2, '#cccc')) t(i, line) ORDER BY i) TO '{TEST_DIR}/comment_behind_bad_row.csv' (HEADER false, QUOTE '', DELIMITER '|');

statement error
SELECT * FROM read_csv('{TEST_DIR}/comment_behind_bad_row.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, comment = '#');
----
CSV Error on Line: 2

statement error
SELECT * FROM read_csv('{TEST_DIR}/comment_behind_bad_row.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, comment = '#', parallel = false);
----
CSV Error on Line: 2

statement error
SELECT * FROM read_csv('{TEST_DIR}/comment_behind_bad_row.csv', auto_detect = false, header = true, columns = {'a': 'INTEGER[]'}, comment = '#');
----
CSV Error on Line: 2

# several comments behind it
statement ok
COPY (SELECT line FROM (VALUES (0, 'a'), (1, 'bad'), (2, '#1'), (3, '#2'), (4, '#3')) t(i, line) ORDER BY i) TO '{TEST_DIR}/three_comments_behind_bad_row.csv' (HEADER false, QUOTE '', DELIMITER '|');

statement error
SELECT * FROM read_csv('{TEST_DIR}/three_comments_behind_bad_row.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, comment = '#');
----
CSV Error on Line: 2

# comments in front of the row count, comments behind it do not
statement ok
COPY (SELECT line FROM (VALUES (0, 'a'), (1, '#c'), (2, 'bad'), (3, '#d')) t(i, line) ORDER BY i) TO '{TEST_DIR}/comments_around_bad_row.csv' (HEADER false, QUOTE '', DELIMITER '|');

statement error
SELECT * FROM read_csv('{TEST_DIR}/comments_around_bad_row.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, comment = '#');
----
CSV Error on Line: 3

# with carriage returns
statement ok
COPY (SELECT line FROM (VALUES (0, 'a'), (1, 'bad'), (2, '#cccc')) t(i, line) ORDER BY i) TO '{TEST_DIR}/comment_behind_bad_row_crlf.csv' (HEADER false, QUOTE '', DELIMITER '|', NEW_LINE e'\r\n');

statement error
SELECT * FROM read_csv('{TEST_DIR}/comment_behind_bad_row_crlf.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, comment = '#');
----
CSV Error on Line: 2

# empty lines that a file of two columns skips
statement ok
COPY (SELECT line FROM (VALUES (0, 'a,b'), (1, 'bad,1'), (2, ''), (3, ''), (4, '11111111-2222-3333-4444-555555555555,2')) t(i, line) ORDER BY i) TO '{TEST_DIR}/empty_lines_behind_bad_row.csv' (HEADER false, QUOTE '', DELIMITER '|');

statement error
SELECT * FROM read_csv('{TEST_DIR}/empty_lines_behind_bad_row.csv', auto_detect = false, header = true, columns = {'a': 'UUID', 'b': 'INTEGER'});
----
CSV Error on Line: 2

# the rejects of two rows with comments between and behind them
statement ok
COPY (SELECT line FROM (VALUES (0, 'a'), (1, 'bad'), (2, '#c'), (3, 'worse'), (4, '#d'), (5, '11111111-2222-3333-4444-555555555555')) t(i, line) ORDER BY i) TO '{TEST_DIR}/two_bad_rows.csv' (HEADER false, QUOTE '', DELIMITER '|');

query I
SELECT * FROM read_csv('{TEST_DIR}/two_bad_rows.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, comment = '#', store_rejects = true, rejects_table = 'rejects_two', rejects_scan = 'scan_two');
----
11111111-2222-3333-4444-555555555555

query ITT
SELECT line, error_type, csv_line FROM rejects_two ORDER BY line;
----
2	CAST	bad
4	CAST	worse

query I
SELECT * FROM read_csv('{TEST_DIR}/two_bad_rows.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, comment = '#', store_rejects = true, rejects_table = 'rejects_two_serial', rejects_scan = 'scan_two_serial', parallel = false);
----
11111111-2222-3333-4444-555555555555

query I
SELECT list(line ORDER BY line) FROM rejects_two_serial;
----
[2, 4]

# a block of comments that is longer than a chunk of rows
statement ok
COPY (SELECT line FROM (SELECT -2 AS i, 'a' AS line UNION ALL SELECT -1, 'bad' UNION ALL SELECT i, '#c' FROM range(3000) t(i) UNION ALL SELECT 3000, '11111111-2222-3333-4444-555555555555') ORDER BY i) TO '{TEST_DIR}/comment_block.csv' (HEADER false, QUOTE '', DELIMITER '|');

statement error
SELECT count(a) FROM read_csv('{TEST_DIR}/comment_block.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, comment = '#');
----
CSV Error on Line: 2

# a comment in the chunk of the failing row, behind 2046 good rows
statement ok
COPY (SELECT line FROM (SELECT -2 AS i, 'a' AS line UNION ALL SELECT -1, 'bad' UNION ALL SELECT i, '11111111-2222-3333-4444-555555555555' FROM range(2046) t(i) UNION ALL SELECT 2046, '#c' UNION ALL SELECT 2047, '11111111-2222-3333-4444-555555555555') ORDER BY i) TO '{TEST_DIR}/comment_within_chunk.csv' (HEADER false, QUOTE '', DELIMITER '|');

statement error
SELECT count(a) FROM read_csv('{TEST_DIR}/comment_within_chunk.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, comment = '#');
----
CSV Error on Line: 2

# a failing row in the second chunk, with comments in the first and behind it
statement ok
COPY (SELECT line FROM (SELECT -1 AS i, 'a' AS line UNION ALL SELECT i, CASE WHEN i = 100 THEN '#c' WHEN i = 3000 THEN 'bad' WHEN i = 3001 THEN '#d' ELSE '11111111-2222-3333-4444-555555555555' END FROM range(3100) t(i)) ORDER BY i) TO '{TEST_DIR}/bad_row_in_second_chunk.csv' (HEADER false, QUOTE '', DELIMITER '|');

statement error
SELECT count(a) FROM read_csv('{TEST_DIR}/bad_row_in_second_chunk.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, comment = '#');
----
CSV Error on Line: 3002

# a row that the end of the scan adds counts no line, the rows in front of it keep theirs
statement ok
COPY (SELECT line FROM (VALUES (0, 'x'), (1, '1'), (2, '"abc')) t(i, line) ORDER BY i) TO '{TEST_DIR}/casts_then_unterminated_quote.csv' (HEADER false, QUOTE '', DELIMITER '|');

query I
SELECT * FROM read_csv('{TEST_DIR}/casts_then_unterminated_quote.csv', auto_detect = false, header = false, columns = {'a': 'INTEGER[]'}, strict_mode = true, store_rejects = true, rejects_table = 'rejects_quote', rejects_scan = 'scan_quote');
----

query IT
SELECT line, error_type FROM rejects_quote ORDER BY line;
----
1	CAST
2	CAST
3	UNQUOTED VALUE

# such a row can fail a cast in a column in front of its error, in a chunk of its own
statement ok
COPY (SELECT line FROM (SELECT -1 AS i, 'a,b' AS line UNION ALL SELECT i, '11111111-2222-3333-4444-555555555555,ok' FROM range(2048) t(i) UNION ALL SELECT 2048, 'bad,"abc') ORDER BY i) TO '{TEST_DIR}/bad_row_with_unterminated_quote.csv' (HEADER false, QUOTE '', DELIMITER '|');

foreach parallel false true

query II
SELECT count(a), count(b) FROM read_csv('{TEST_DIR}/bad_row_with_unterminated_quote.csv', auto_detect = false, header = true, columns = {'a': 'UUID', 'b': 'VARCHAR'}, strict_mode = true, parallel = {parallel}, store_rejects = true, rejects_table = 'rejects_end_{parallel}', rejects_scan = 'scan_end_{parallel}');
----
2048	2048

query IT
SELECT line, error_type FROM rejects_end_{parallel} ORDER BY error_type;
----
2050	CAST
2050	UNQUOTED VALUE

endloop

# an empty line that is a row of an empty string, because the column is forced not to be NULL
statement ok
COPY (SELECT line FROM (VALUES (0, 'a'), (1, '11111111-2222-3333-4444-555555555555'), (2, '')) t(i, line) ORDER BY i) TO '{TEST_DIR}/empty_row.csv' (HEADER false, QUOTE '', DELIMITER '|');

statement error
SELECT * FROM read_csv('{TEST_DIR}/empty_row.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, force_not_null = ['a']);
----
CSV Error on Line: 3

query I
SELECT count(a) FROM read_csv('{TEST_DIR}/empty_row.csv', auto_detect = false, header = true, columns = {'a': 'UUID'}, force_not_null = ['a'], store_rejects = true, rejects_table = 'rejects_empty', rejects_scan = 'scan_empty');
----
1

query IT
SELECT line, error_type FROM rejects_empty;
----
3	CAST
