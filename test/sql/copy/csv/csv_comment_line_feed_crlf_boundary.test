mode unskip

# a reject right behind the comment keeps its line and byte positions
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '1,2' || chr(13) || chr(10) || '#comment' || chr(10) || 'nope,400' || chr(13) || chr(10) || '500,600' || chr(13)) TO '{TEST_DIR}/comment_lf_boundary_reject.csv' (HEADER false, QUOTE '', DELIM '|');

loop buffer_size 18 31

query II
SELECT a, b FROM read_csv('{TEST_DIR}/comment_lf_boundary_reject.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = {buffer_size}, store_rejects = true, rejects_table = 'rej_{buffer_size}', rejects_scan = 'scan_{buffer_size}') ORDER BY ALL;
----
1	2
500	600

query IIII
SELECT line, line_byte_position, byte_position, csv_line FROM rej_{buffer_size};
----
4	20	20	nope,400

endloop

# FIXME: with buffers of 11 to 17 bytes the reject behind the comment is lost without a rejects entry, as on main
mode skip

query IIII
SELECT line, line_byte_position, byte_position, csv_line FROM read_csv('{TEST_DIR}/comment_lf_boundary_reject.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = 14, store_rejects = true, rejects_table = 'rej_14', rejects_scan = 'scan_14'), rej_14;
----
4	20	20	nope,400

mode unskip
