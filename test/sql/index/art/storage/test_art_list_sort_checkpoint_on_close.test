# name: test/sql/index/art/storage/test_art_list_sort_checkpoint_on_close.test
# description: The checkpoint on close copies an index whose key uses list_sort, after the connection that bound it is gone
# group: [storage]

load {TEST_DIR}/art_list_sort_checkpoint_on_close.db

statement ok
CREATE TABLE t (id INTEGER, l INTEGER[]);

statement ok
INSERT INTO t VALUES (1, [1, 2]), (2, [5, 4]);

statement ok
CREATE INDEX i ON t ((list_sort(l)[1]));

statement ok
CREATE INDEX j ON t ((list_grade_up(l, 'DESC')[1]));

statement ok
CHECKPOINT;

restart

statement ok
DELETE FROM t WHERE id = 1;

restart

# the close wrote the checkpoint, so the WAL is empty
query I
SELECT wal_size FROM pragma_database_size();
----
0 bytes

query II
SELECT id, l FROM t;
----
2	[5, 4]

query I
SELECT id FROM t WHERE list_sort(l)[1] = 4;
----
2

statement ok
INSERT INTO t VALUES (3, [7, 6]);

restart

query I
SELECT wal_size FROM pragma_database_size();
----
0 bytes

query I
SELECT id FROM t WHERE list_sort(l)[1] = 6;
----
3

# an automatic checkpoint at commit copies the index as well
statement ok
SET checkpoint_threshold = '1B';

statement ok
INSERT INTO t VALUES (4, [11, 10]);

statement ok
DELETE FROM t WHERE id = 2;

query II
SELECT id, list_grade_up(l, 'DESC')[1] FROM t ORDER BY id;
----
3	1
4	1

query I
SELECT id FROM t WHERE list_sort(l)[1] = 10;
----
4
