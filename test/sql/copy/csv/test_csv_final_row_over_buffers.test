# a line feed that is the only byte of the short scan range, behind it the next buffer starts with an empty line
statement ok
COPY (SELECT l || chr(13) FROM (VALUES (0, 'a,b'), (1, '1,2'), (2, ''), (3, '3,4'), (4, ''), (5, ''), (6, '5,6'), (7, 'x,y,z'), (8, '7,8')) t(i, l) ORDER BY i) TO '{TEST_DIR}/crlf_blank_line_buffer_start.csv' (HEADER false, QUOTE '', DELIMITER '|');

