statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

endloop

# more files than twice the threads are read one at a time as well
statement ok
SET threads=1;

statement error
SELECT count(*), sum(a) FROM read_csv(['{TEST_DIR}/terminated_a.csv', '{TEST_DIR}/terminated_b.csv', '{TEST_DIR}/unterminated_quote_eof.csv'], auto_detect=false, header=false, columns={'a': 'INTEGER'}, parallel=true, strict_mode=true);
----
Value with unterminated quote found.

query II
SELECT count(*), sum(a) FROM read_csv(['{TEST_DIR}/terminated_a.csv', '{TEST_DIR}/terminated_b.csv', '{TEST_DIR}/unterminated_quote_eof.csv'], auto_detect=false, header=false, columns={'a': 'INTEGER'}, parallel=true, strict_mode=true, store_rejects=true);
----
6	29

query III
