# name: benchmark/micro/string/substring_grapheme_carriage_return.benchmark
# description: substring_grapheme with a negative offset on long ASCII strings with a CR that no LF follows
# group: [string]

name Substring Grapheme Carriage Return (Long)
group string

load
CREATE TABLE strings AS SELECT repeat('x', 16384) || chr(13) || (i % 10)::VARCHAR AS s FROM range(4096) t(i) UNION ALL SELECT 'é';

run
SELECT min(r), max(r), count(*) FROM (SELECT substring_grapheme(s, -1) AS r FROM strings)

result III
0	é	4097
