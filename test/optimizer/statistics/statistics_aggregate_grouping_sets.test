# name: test/optimizer/statistics/statistics_aggregate_grouping_sets.test
# description: An aggregate with several grouping sets returns its groups once per set, so its statistics bound the rows per set
# group: [statistics]

statement ok
CREATE TABLE t AS SELECT range AS i, range % 2 AS j FROM range(5);

# without the grouping_sets optimizer the aggregate keeps all of its grouping sets
statement ok
SET disabled_optimizers = 'grouping_sets';

# five rows per (i) set and one for the empty set are 11 rows, more than the input has
query I
SELECT count(*) FROM (SELECT i, count(*) FROM t GROUP BY GROUPING SETS ((i), (i), ()));
----
11

# the limit above those rows must stay, as the input's row count does not bound them
query I
SELECT count(*) FROM (SELECT i, count(*) FROM t GROUP BY GROUPING SETS ((i), (i), ()) LIMIT 6);
----
6

query I
SELECT count(*) FROM (SELECT i, count(*) FROM t GROUP BY GROUPING SETS ((i), (i), ()) LIMIT 10);
----
10

query I
SELECT count(*) FROM (SELECT i, j, count(*) FROM t GROUP BY ROLLUP (i, j) LIMIT 7);
----
7

query I
SELECT count(*) FROM (SELECT i, j, count(*) FROM t GROUP BY CUBE (i, j) LIMIT 9);
----
9

# a limit at or above the rows changes nothing
query I
SELECT count(*) FROM (SELECT i, count(*) FROM t GROUP BY GROUPING SETS ((i), (i), ()) LIMIT 11);
----
11

# an ungrouped aggregate returns one row per empty grouping set
query I
SELECT count(*) FROM (SELECT count(*) FROM t GROUP BY GROUPING SETS ((), (), ()));
----
3

query II
SELECT min(i), max(i) FROM t GROUP BY GROUPING SETS ((), ());
----
0	4
0	4

query I
SELECT count(*) FROM (SELECT count(*) FROM t GROUP BY GROUPING SETS ((), (), ()) LIMIT 2);
----
2

# the same over the table function, whose row count the planner knows exactly
query I
SELECT count(*) FROM (SELECT i, count(*) FROM range(5) t(i) GROUP BY GROUPING SETS ((i), (i), ()) LIMIT 6);
----
6

query I
SELECT count(*) FROM (SELECT count(*) FROM range(5) t(i) GROUP BY GROUPING SETS ((), (), ()) LIMIT 2);
----
2

# a single grouping set keeps the input's row count as its bound
query I
SELECT count(*) FROM (SELECT i, count(*) FROM t GROUP BY i LIMIT 6);
----
5

query I
SELECT count(*) FROM (SELECT count(*) FROM t LIMIT 2);
----
1

# the grouping_sets optimizer gives the same results
statement ok
SET disabled_optimizers = '';

query I
SELECT count(*) FROM (SELECT i, count(*) FROM t GROUP BY GROUPING SETS ((i), (i), ()) LIMIT 6);
----
6

query I
SELECT count(*) FROM (SELECT count(*) FROM t GROUP BY GROUPING SETS ((), (), ()) LIMIT 2);
----
2

query I
SELECT count(*) FROM (SELECT count(*) FROM t GROUP BY GROUPING SETS ((), (), ()));
----
3
