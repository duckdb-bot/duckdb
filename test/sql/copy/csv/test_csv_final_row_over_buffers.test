9xxxxxxx	NULL

# a long value in the middle of a file, the rows after it are read
statement ok
COPY (SELECT CASE WHEN i = 5 THEN repeat('x', 100) ELSE i::VARCHAR END AS c FROM range(10) t(i)) TO '{TEST_DIR}/middle_row.csv' (HEADER);

statement error
SELECT count(*) FROM read_csv('{TEST_DIR}/middle_row.csv', header = true, auto_detect = false, columns = {'c': 'VARCHAR'}, buffer_size = 16)
----
Maximum line size of 16 bytes exceeded. Actual Size:100 bytes.

query II
SELECT count(*), sum(c::INTEGER) FROM read_csv('{TEST_DIR}/middle_row.csv', header = true, auto_detect = false, columns = {'c': 'VARCHAR'}, buffer_size = 16, ignore_errors = true)
----
9	40

foreach option buffer_size max_line_size

statement ok
SELECT count(*) FROM read_csv('{TEST_DIR}/middle_row.csv', header = true, auto_detect = false, columns = {'c': 'VARCHAR'}, {option} = 16, store_rejects = true)

query IIII
SELECT line, byte_position, length(csv_line), error_message FROM reject_errors
----
7	13	100	Maximum line size of 16 bytes exceeded. Actual Size:100 bytes.

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

endloop

