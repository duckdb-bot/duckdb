# name: test/sql/index/art/create_index_time_zone_dependent.test
# description: Index keys cannot depend on the TimeZone or Calendar setting, which other sessions bind them again under
# group: [art]

require icu

statement ok
SET TimeZone = 'UTC';

statement ok
CREATE TABLE t (id INTEGER, ts TIMESTAMPTZ, s VARCHAR, naive TIMESTAMP);

statement ok
INSERT INTO t VALUES (1, '2026-01-01 00:00:00+00', '2026-01-01 00:00:00', '2026-01-01 00:00:00');

foreach expression ts::VARCHAR date_part('hour',ts) strftime(ts,'%H') ts::DATE s::TIMESTAMPTZ ts+INTERVAL'1day' timezone('UTC',ts)::VARCHAR [ts]::VARCHAR [ts]::VARCHAR[] [ts]::TIMESTAMPTZ[1]::VARCHAR[1] row(ts)::VARCHAR map([ts],[1])::MAP(VARCHAR,INTEGER) coalesce(ts::VARCHAR,s)

statement error
CREATE INDEX i ON t (({expression}));
----
Index keys cannot depend on session settings such as TimeZone or Calendar

statement error
CREATE UNIQUE INDEX i ON t (({expression}));
----
Index keys cannot depend on session settings such as TimeZone or Calendar

endloop

# a constant argument is not folded into a value that hides the dependency
statement error
CREATE INDEX i ON t ((id + hour(TIMESTAMPTZ '2026-01-01 00:00:00+00')));
----
Index keys cannot depend on session settings such as TimeZone or Calendar

# nor when it is folded away to NULL or evaluated by the bind of switch or date_part
statement error
CREATE INDEX i ON t ((coalesce(id + CASE WHEN hour(TIMESTAMPTZ '2026-01-01 00:00:00+00') = 0 THEN NULL ELSE 1 END, id)));
----
Index keys cannot depend on session settings such as TimeZone or Calendar

statement error
CREATE INDEX i ON t ((switch(id, MAP {1: hour(TIMESTAMPTZ '2026-01-01 00:00:00+00')}, 99)));
----
Index keys cannot depend on session settings such as TimeZone or Calendar

statement error
CREATE INDEX i ON t ((date_part(CASE WHEN hour(TIMESTAMPTZ '2026-01-01 00:00:00+00') = 0 THEN 'day' ELSE 'year' END, naive)));
----
Index keys cannot depend on session settings such as TimeZone or Calendar

# a cast that resolving the argument types adds, which the bind of switch evaluates
statement error
CREATE INDEX i ON t ((switch(ts, MAP {TIMESTAMP '2026-01-01 00:00:00': 1}, 0)));
----
Index keys cannot depend on session settings such as TimeZone or Calendar

# a cast folded into a constant argument
statement error
CREATE INDEX i ON t ((id + epoch_us(TIMESTAMPTZ '2026-01-01 00:00:00')));
----
Index keys cannot depend on session settings such as TimeZone or Calendar

# nor is a lambda body skipped
statement error
CREATE INDEX i ON t ((list_transform([ts], lambda x: hour(x))[1]));
----
Index keys cannot depend on session settings such as TimeZone or Calendar

statement error
CREATE INDEX i ON t ((list_transform([ts], lambda x: x::VARCHAR)[1]));
----
Index keys cannot depend on session settings such as TimeZone or Calendar

# keys that do not depend on the session are still allowed
statement ok
CREATE INDEX i_ts ON t (ts);

statement ok
CREATE INDEX i_epoch ON t ((epoch_us(ts)));

statement ok
CREATE INDEX i_naive ON t ((naive::VARCHAR));

statement ok
CREATE INDEX i_epoch_seconds ON t ((epoch(ts)));

statement ok
CREATE INDEX i_date_part_epoch ON t ((date_part('epoch', ts)));

statement ok
CREATE INDEX i_date_part_struct_epoch ON t ((date_part(['epoch'], ts).epoch));

statement ok
CREATE INDEX i_epoch_ns ON t ((epoch(ts::TIMESTAMPTZ_NS)));

statement error
CREATE INDEX i ON t ((date_part(['epoch', 'hour'], ts).epoch));
----
Index keys cannot depend on session settings such as TimeZone or Calendar

statement ok
SET TimeZone = 'Europe/Amsterdam';

query I
SELECT count(*) FROM t WHERE epoch_us(ts) = epoch_us(TIMESTAMPTZ '2026-01-01 01:00:00+01');
----
1

statement ok
DELETE FROM t WHERE id = 1;

query I
SELECT count(*) FROM t;
----
0
