# name: test/sql/optimizer/test_rowid_vector_pruning.test
# description: Scans with row id filters only read the vectors that hold the row ids (duckdblabs/bot-issue-tracker#549)
# group: [optimizer]

require json

load {TEST_DIR}/rowid_vector_pruning.db

statement ok
SET threads = 1

# 300000 rows in three row groups, row id i holds k = (i * 7919) % 300000 and g = 'geom i'
statement ok
CREATE TABLE r (k BIGINT PRIMARY KEY, g VARCHAR, risk BIGINT, zone VARCHAR, score DOUBLE);

statement ok
INSERT INTO r SELECT (i * 7919) % 300000, 'geom ' || i, i % 7, 'zone ' || (i % 13), i * 0.5 FROM range(300000) t(i);

statement ok
CREATE TABLE plain AS SELECT * FROM r;

statement ok
CHECKPOINT;

statement ok
SET enable_profiling = 'json'

statement ok
SET tracked_metrics = ['query.total_rows_scanned']

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_in.json'

# row ids at the edges of vectors and row groups
query II
SELECT rowid, g FROM r WHERE rowid IN (2047, 2048, 122879, 122880, 299999) ORDER BY rowid
----
2047	geom 2047
2048	geom 2048
122879	geom 122879
122880	geom 122880
299999	geom 299999

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_late.json'

# late materialization finds the three row ids with the index, then scans the vectors that hold them
query IIIII
SELECT k, risk, zone, score, length(g) AS d FROM r WHERE k BETWEEN 4242 AND 4300 ORDER BY d DESC, k LIMIT 3
----
4242	3	zone 11	147159.0	11
4243	2	zone 6	105998.5	11
4244	1	zone 1	64838.0	11

statement ok
PRAGMA disable_profiling

# both scans read a few vectors instead of whole row groups
query I
SELECT query.total_rows_scanned < 122880 FROM '{TEST_DIR}/rowid_vector_pruning_in.json'
----
true

query I
SELECT query.total_rows_scanned < 122880 FROM '{TEST_DIR}/rowid_vector_pruning_late.json'
----
true

query IIII
SELECT risk, zone, score, length(g) AS d FROM r WHERE k = 4242 ORDER BY d LIMIT 1
----
3	zone 11	147159.0	11

# a row id filter that cannot prune keeps every vector
query I
SELECT count(*) FROM r WHERE rowid % 7 = 0
----
42858

# with prefetching, the scan of late materialization reads the blocks of the first vector of a row group, not of the
# whole row group
statement ok
CREATE TABLE p (k BIGINT PRIMARY KEY, o BIGINT, s VARCHAR);

statement ok
INSERT INTO p SELECT i, i % 1000, md5(i::VARCHAR) || md5((i + 1)::VARCHAR) FROM range(245760) t(i);

statement ok
CHECKPOINT;

restart

statement ok
SET threads = 1

statement ok
SET storage_block_prefetch = 'debug_force_always'

statement ok
SET enable_profiling = 'json'

statement ok
SET tracked_metrics = ['io.total_bytes_read']

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_prefetch_late.json'

query I
SELECT s FROM p WHERE k = 122881 ORDER BY o LIMIT 1
----
506995c3dc5272bbfb3321c48ef268ff71452dbcef3372bb549d6385d9566ee5

restart

statement ok
SET threads = 1

statement ok
SET storage_block_prefetch = 'debug_force_always'

statement ok
SET enable_profiling = 'json'

statement ok
SET tracked_metrics = ['io.total_bytes_read']

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_prefetch_group.json'

query I
SELECT count(DISTINCT s) FROM p WHERE rowid >= 122880
----
122880

statement ok
PRAGMA disable_profiling

query I
SELECT late.io.total_bytes_read < row_group.io.total_bytes_read
FROM '{TEST_DIR}/rowid_vector_pruning_prefetch_late.json' late,
     '{TEST_DIR}/rowid_vector_pruning_prefetch_group.json' row_group
----
true

# deleted rows in the vectors that are read and in the vectors that are skipped
statement ok
DELETE FROM r WHERE rowid IN (2048, 122880, 200000)

query II
SELECT rowid, g FROM r WHERE rowid IN (2047, 2048, 122879, 122880, 200000, 299999) ORDER BY rowid
----
2047	geom 2047
122879	geom 122879
299999	geom 299999

# without an index, late materialization scans the table for the row ids first
query IIIII
SELECT * FROM plain WHERE risk = 3 ORDER BY score DESC LIMIT 2
----
260405	geom 299995	3	zone 7	149997.5
204972	geom 299988	3	zone 0	149994.0

# rows the transaction appended, changed or deleted
statement ok
BEGIN

statement ok
INSERT INTO plain VALUES (-1, 'appended', 3, 'zone x', 1000000.0)

statement ok
UPDATE plain SET g = 'changed' WHERE k = 260405

statement ok
DELETE FROM plain WHERE k = 204972

query IIIII
SELECT * FROM plain WHERE risk = 3 ORDER BY score DESC LIMIT 3
----
-1	appended	3	zone x	1000000.0
260405	changed	3	zone 7	149997.5
149539	geom 299981	3	zone 6	149990.5

statement ok
ROLLBACK

query IIIII
SELECT * FROM plain WHERE risk = 3 ORDER BY score DESC LIMIT 2 OFFSET 1
----
204972	geom 299988	3	zone 0	149994.0
149539	geom 299981	3	zone 6	149990.5
