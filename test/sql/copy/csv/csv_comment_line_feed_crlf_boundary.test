# name: test/sql/copy/csv/csv_comment_line_feed_crlf_boundary.test
# description: A comment ending in a line feed in a \r\n file reads the same wherever a buffer ends inside or next to it
# group: [csv]

# a,b\r\n 1,2\r\n #comment\n 3,4\r\n 5,6\r\n, 29 bytes, the comment holds bytes 10 to 18
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '1,2' || chr(13) || chr(10) || '#comment' || chr(10) || '3,4' || chr(13) || chr(10) || '5,6' || chr(13)) TO '{TEST_DIR}/comment_lf_boundary.csv' (HEADER false, QUOTE '', DELIM '|');

query II
SELECT count(*), list(a ORDER BY a) FROM read_csv('{TEST_DIR}/comment_lf_boundary.csv', comment = '#');
----
3	[1, 3, 5]

foreach parallel true false

loop buffer_size 10 30

query II
SELECT count(*), list(a ORDER BY a) FROM read_csv('{TEST_DIR}/comment_lf_boundary.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = {buffer_size}, parallel = {parallel});
----
3	[1, 3, 5]

endloop

endloop

# the row behind the comment has values longer than the validator's margin of two bytes
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '1,2' || chr(13) || chr(10) || '#comment' || chr(10) || '300,400' || chr(13) || chr(10) || '500,600' || chr(13)) TO '{TEST_DIR}/comment_lf_boundary_long.csv' (HEADER false, QUOTE '', DELIM '|');

