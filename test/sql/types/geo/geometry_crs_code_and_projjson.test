# name: test/sql/types/geo/geometry_crs_code_and_projjson.test
# description: An AUTH:CODE CRS equals a PROJJSON or WKT2 CRS whose id is that code
# group: [geo]

load {TEST_DIR}/geometry_crs_code_and_projjson.db

statement ok
SET VARIABLE projjson = '{"type":"GeographicCRS","name":"WGS 84","id":{"authority":"EPSG","code":4326}}';

query II
SELECT l::VARCHAR[], ST_CRS(l[1]) FROM (SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(3 4)'::GEOMETRY, getvariable('projjson'))] AS l);
----
['POINT (1 2)', 'POINT (3 4)']	EPSG:4326

# in both orders, and in a UNION ALL
query I
SELECT len([ST_SetCRS('POINT(3 4)'::GEOMETRY, getvariable('projjson')), ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326')]);
----
2

query I
SELECT ST_AsText(g) FROM (SELECT ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326') AS g UNION ALL SELECT ST_SetCRS('POINT(3 4)'::GEOMETRY, getvariable('projjson'))) ORDER BY 1;
----
POINT (1 2)
POINT (3 4)

# a code that no catalog knows, with a string code in the id
query I
SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'TEST:A1'), ST_SetCRS('POINT(3 4)'::GEOMETRY, '{"type":"GeographicCRS","name":"Test","id":{"authority":"TEST","code":"A1"}}')]::VARCHAR[];
----
['POINT (1 2)', 'POINT (3 4)']

query I
SELECT [ST_SetCRS('POINT(3 4)'::GEOMETRY, '{"type":"GeographicCRS","name":"Test","id":{"authority":"TEST","code":"A1"}}'), ST_SetCRS('POINT(1 2)'::GEOMETRY, 'TEST:A1')]::VARCHAR[];
----
['POINT (3 4)', 'POINT (1 2)']

# a WKT2 definition with that id
query I
SELECT len([ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(3 4)'::GEOMETRY, 'GEOGCRS["WGS 84",DATUM["World Geodetic System 1984",ELLIPSOID["WGS 84",6378137,298.257223563]],CS[ellipsoidal,2],AXIS["latitude",north],AXIS["longitude",east],ID["EPSG",4326]]')]);
----
2

# a table of the PROJJSON CRS takes a value of the code, also after a restart
statement ok
CREATE TABLE t (g GEOMETRY('{"type":"GeographicCRS","name":"WGS 84","id":{"authority":"EPSG","code":4326}}'));

statement ok
INSERT INTO t SELECT ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326');

restart

statement ok
INSERT INTO t SELECT ST_SetCRS('POINT(3 4)'::GEOMETRY, 'EPSG:4326');

query I
SELECT ST_AsText(g) FROM t ORDER BY 1;
----
POINT (1 2)
POINT (3 4)

# a different code differs
statement error
SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4269'), ST_SetCRS('POINT(3 4)'::GEOMETRY, '{"type":"GeographicCRS","name":"WGS 84","id":{"authority":"EPSG","code":4326}}')];
----
Cannot cast GEOMETRY with CRS

# a PROJJSON or WKT2 definition only named like the code, without an id, differs
statement error
SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(3 4)'::GEOMETRY, '{"type":"GeographicCRS","name":"EPSG:4326"}')];
----
Cannot cast GEOMETRY with CRS

statement error
SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(3 4)'::GEOMETRY, 'GEOGCRS["EPSG:4326",DATUM["World Geodetic System 1984",ELLIPSOID["WGS 84",6378137,298.257223563]],CS[ellipsoidal,2],AXIS["latitude",north],AXIS["longitude",east]]')];
----
Cannot cast GEOMETRY with CRS

# a CRS only named like the code also differs from a definition with that id, in any order
statement error
SELECT [ST_SetCRS('POINT(3 4)'::GEOMETRY, getvariable('projjson')), ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(5 6)'::GEOMETRY, '{"type":"GeographicCRS","name":"EPSG:4326"}')];
----
Cannot cast GEOMETRY with CRS

statement error
SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(3 4)'::GEOMETRY, getvariable('projjson')), ST_SetCRS('POINT(5 6)'::GEOMETRY, '{"type":"GeographicCRS","name":"EPSG:4326"}')];
----
Cannot cast GEOMETRY with CRS

statement error
SELECT ST_SetCRS('POINT(3 4)'::GEOMETRY, getvariable('projjson')) UNION ALL SELECT ST_SetCRS('POINT(5 6)'::GEOMETRY, '{"type":"GeographicCRS","name":"EPSG:4326"}');
----
Cannot cast GEOMETRY with CRS

# two definitions only named alike still match
query I
SELECT len([ST_SetCRS('POINT(1 2)'::GEOMETRY, '{"type":"GeographicCRS","name":"Local"}'), ST_SetCRS('POINT(3 4)'::GEOMETRY, '{"type":"GeographicCRS","name":"Local","area":"here"}')]);
----
2

# an id without a code is no id

statement error
SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(3 4)'::GEOMETRY, '{"type":"GeographicCRS","name":"Other CRS","id":{"authority":"EPSG:4326"}}')];
----
Cannot cast GEOMETRY with CRS

statement error
SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(3 4)'::GEOMETRY, '{"type":"GeographicCRS","name":"Other CRS","id":{"authority":"EPSG:4326","code":null}}')];
----
Cannot cast GEOMETRY with CRS

statement error
SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(3 4)'::GEOMETRY, '{"type":"GeographicCRS","name":"Other CRS","id":{"authority":"EPSG:4326","code":true}}')];
----
Cannot cast GEOMETRY with CRS
