# name: test/issues/general/test_26657.test
# description: Issue 26657: temporal strings round the digits past their precision to the nearest value
# group: [general]

query IIIII
SELECT '2024-01-01 12:00:00.1234575'::TIMESTAMP, '2024-01-01 12:00:00.1234569'::TIMESTAMP, '2024-01-01 12:00:00.1234564'::TIMESTAMP, '12:00:00.1234569'::TIME, '2024-01-01 12:00:00.1234567899'::TIMESTAMP_NS::VARCHAR
----
2024-01-01 12:00:00.123458	2024-01-01 12:00:00.123457	2024-01-01 12:00:00.123456	12:00:00.123457	2024-01-01 12:00:00.12345679

# a carry goes into the seconds, the minutes, the hours and the date
query IIII
SELECT '2024-12-31 23:59:59.9999995'::TIMESTAMP, '2024-01-01 12:59:59.99999951'::TIMESTAMP, '23:59:59.9999995'::TIME, '2024-01-01 23:59:59.9999999995'::TIMESTAMP_NS
----
2025-01-01 00:00:00	2024-01-01 13:00:00	24:00:00	2024-01-02 00:00:00

# a tie rounds away from zero for times and intervals, and away from the epoch for timestamps, like the casts
query II
SELECT '12:00:00.1234565+02'::TIMETZ, '1969-12-31 23:59:59.9999995'::TIMESTAMP
----
12:00:00.123457+02	1969-12-31 23:59:59.999999

query IIII
SELECT '1969-12-31 23:59:59.9999985'::TIMESTAMP, '1969-12-31 23:59:59.9999985'::TIMESTAMP_NS::TIMESTAMP, '1969-12-31 23:59:59.99999851'::TIMESTAMP, '1969-12-31 23:59:59.9999985+00'::TIMESTAMPTZ
----
1969-12-31 23:59:59.999998	1969-12-31 23:59:59.999998	1969-12-31 23:59:59.999999	1969-12-31 23:59:59.999998+00

query IIII
SELECT '1969-12-31 23:59:59.99999999850'::TIMESTAMP_NS, '1969-12-31 23:59:59.99999999851'::TIMESTAMP_NS, '1970-01-01 00:00:00.0000005+01'::TIMESTAMPTZ, '1969-12-31 23:59:59.9999995-01'::TIMESTAMPTZ
----
1969-12-31 23:59:59.999999998	1969-12-31 23:59:59.999999999	1969-12-31 23:00:00+00	1970-01-01 01:00:00+00

# a time taken from a timestamp rounds like a time, whatever the date
query IIII
SELECT '1969-12-31 12:00:00.1234565'::TIME, '12:00:00.1234565'::TIME, '1969-12-31 12:00:00.1234565'::TIMETZ, '1969-12-31 12:00:00.1234567895'::TIME_NS
----
12:00:00.123457	12:00:00.123457	12:00:00.123457+00	12:00:00.12345679

query IIII
SELECT '2024-01-01 23:59:59.9999995'::TIME, '2024-01-01 23:59:59.9999999995'::TIME_NS, '2024-01-01 23:59:59.9999995'::TIMETZ, TRY_CAST('2024-01-01 24:00:00.0000005' AS TIME)
----
24:00:00	24:00:00	24:00:00+00	NULL

query III
SELECT TRY_CAST('2024-01-01 24:00:00.0000000005' AS TIME_NS), TRY_CAST('2024-01-01 24:00:00.0000005' AS TIMETZ), TRY_CAST('2024-01-01 24:00:00.000000001' AS TIMESTAMP_NS)
----
NULL	NULL	NULL

# intervals round away from zero in both directions
query II
SELECT INTERVAL '00:00:00.0000005', '-00:00:00.0000005'::INTERVAL
----
00:00:00.000001	-00:00:00.000001

# rounding beyond the limits of the microseconds of an interval is an error
query IIII
SELECT TRY_CAST('2562047788:00:54.7758074' AS INTERVAL), TRY_CAST('2562047788:00:54.7758075' AS INTERVAL), TRY_CAST('-2562047788:00:54.7758084' AS INTERVAL), TRY_CAST('-2562047788:00:54.7758085' AS INTERVAL)
----
2562047788:00:54.775807	NULL	-2562047788:00:54.775808	NULL

# a first discarded digit below 5 rounds down
query I
SELECT '2024-01-01 12:00:00.12345649999'::TIMESTAMP
----
2024-01-01 12:00:00.123456

# rounding past the largest timestamp is an error, not infinity
statement error
SELECT '294247-01-10 04:00:54.7758065'::TIMESTAMP
----
out of range

query I
SELECT '294247-01-10 04:00:54.7758064'::TIMESTAMP
----
294247-01-10 04:00:54.775806

# at the lower end, the range check applies to the rounded value, which can be in range when the truncated one is not
query III
SELECT epoch_us('290309-12-21 (BC) 19:59:05.2241936'::TIMESTAMP), epoch_us('290309-12-21 (BC) 19:59:05.2241916'::TIMESTAMP), TRY_CAST('290309-12-21 (BC) 19:59:05.2241926' AS TIMESTAMP)
----
-9223372036854775806	-9223372036854775808	NULL

query III
SELECT epoch_us('290309-12-22 (BC) 00:59:05.2241936+05'::TIMESTAMPTZ), epoch_us('290309-12-22 (BC) 00:59:05.2241916+05'::TIMESTAMPTZ), epoch_us('290309-12-21 (BC) 19:59:05.2241936-05'::TIMESTAMPTZ)
----
-9223372036854775806	-9223372036854775808	-9223372018854775806

query II
SELECT '290309-12-21 (BC) 19:59:05.2241936'::TIME, '290309-12-22 (BC) 00:59:05.2241936+05'::TIMETZ
----
19:59:05.224194	19:59:05.224194+00

# with nanoseconds, only a carry into the microseconds can take the value into the range
query III
SELECT '290309-12-21 (BC) 19:59:05.2241919996'::TIME_NS, '290309-12-21 (BC) 19:59:05.2241939996'::TIME_NS, TRY_CAST('290309-12-21 (BC) 19:59:05.2241939986' AS TIME_NS)
----
19:59:05.224192	19:59:05.224194	NULL

# the local time of a string with an offset must be in range once rounded too
query III
SELECT TRY_CAST('290309-12-21 (BC) 19:59:05.2241926-05' AS TIMESTAMPTZ), TRY_CAST('294247-01-10 04:00:54.7758065+05' AS TIMESTAMPTZ), TRY_CAST('294247-01-10 04:00:54.7758065' AS TIME)
----
NULL	NULL	NULL

# a time taken from a timestamp needs the rounded timestamp in range, and its time then rounds like a time
query IIII
SELECT TRY_CAST('290309-12-22 (BC) 00:59:05.2241926+05' AS TIMETZ), TRY_CAST('294247-01-09 23:00:54.7758065-05' AS TIMETZ), '290309-12-22 (BC) 00:59:05.2241925+05'::TIMETZ, '290309-12-21 (BC) 19:59:05.2241925'::TIME
----
NULL	NULL	19:59:05.224193+00	19:59:05.224193

# the CSV reader parses with the same rules
statement ok
COPY (SELECT '2024-01-01 12:00:00.1234569' AS ts, '12:00:00.9999996' AS t) TO '{TEMP_DIR}/round_fraction.csv' (HEADER);

query II
SELECT ts, t FROM read_csv('{TEMP_DIR}/round_fraction.csv', columns = {'ts': 'TIMESTAMP', 't': 'TIME'})
----
2024-01-01 12:00:00.123457	12:00:01

statement ok
COPY (SELECT '290309-12-22 (BC) 00:59:05.2241936+05' AS ts) TO '{TEMP_DIR}/round_fraction_lowest.csv' (HEADER);

query I
SELECT epoch_us(ts) FROM read_csv('{TEMP_DIR}/round_fraction_lowest.csv', columns = {'ts': 'TIMESTAMPTZ'})
----
-9223372036854775806

# TRY_CAST and casts of columns round the same way
query II
SELECT TRY_CAST(s AS TIMESTAMP), CAST(s AS TIMESTAMPTZ) FROM (VALUES ('2024-01-01 12:00:00.9999996+00')) t(s)
----
2024-01-01 12:00:01	2024-01-01 12:00:01+00

# casts to milliseconds and seconds round once, at their own precision
query IIII
SELECT '2024-01-01 00:00:00.1234995'::TIMESTAMP_MS, '2024-01-01 00:00:00.1235'::TIMESTAMP_MS, '2024-01-01 00:00:00.4999995'::TIMESTAMP_S, '2024-01-01 00:00:00.5'::TIMESTAMP_S
----
2024-01-01 00:00:00.123	2024-01-01 00:00:00.124	2024-01-01 00:00:00	2024-01-01 00:00:01

# before the epoch, a cast to seconds or milliseconds rounds an exact tie down, and anything above it up
query IIII
SELECT '1969-12-31 23:59:59.5000009'::TIMESTAMP_S, '1969-12-31 23:59:59.50000001'::TIMESTAMP_S, '1969-12-31 23:59:59.5'::TIMESTAMP_S, '1969-12-31 23:59:59.9995009'::TIMESTAMP_MS
----
1970-01-01 00:00:00	1970-01-01 00:00:00	1969-12-31 23:59:59	1970-01-01 00:00:00

# at the lower end, the range check applies to the value above the tie
query IIII
SELECT '290309-12-21 (BC) 19:59:05.2245001'::TIMESTAMP_MS, '290309-12-21 (BC) 19:59:05.5000001'::TIMESTAMP_S, TRY_CAST('290309-12-21 (BC) 19:59:05.2245' AS TIMESTAMP_MS), TRY_CAST('290309-12-21 (BC) 19:59:05.5' AS TIMESTAMP_S)
----
290309-12-21 (BC) 19:59:05.225	290309-12-21 (BC) 19:59:06	NULL	NULL

# rounding cannot take the time of a timestamp past 24:00:00, nor any value past its largest one
query IIII
SELECT TRY_CAST('2024-01-01 24:00:00.0000005' AS TIMESTAMP), '2024-01-01 24:00:00'::TIMESTAMP, TRY_CAST('24:00:00.0000005' AS TIME), TRY_CAST('2262-04-11 23:47:16.8547758065' AS TIMESTAMP_NS)
----
NULL	2024-01-02 00:00:00	NULL	NULL

query II
SELECT TRY_CAST('1677-09-21 00:12:43.1452241925' AS TIMESTAMP_NS), TRY_CAST('1677-09-21 00:12:43.1452241926' AS TIMESTAMP_NS)
----
1677-09-21 00:12:43.145224192	NULL

query III
SELECT '2262-04-11 23:47:16.8547758064'::TIMESTAMP_NS, '2024-01-01 24:00:00.0000005'::TIMESTAMP_S, '2024-01-01 24:00:00.0000005'::TIMESTAMP_MS
----
2262-04-11 23:47:16.854775806	2024-01-02 00:00:00	2024-01-02 00:00:00

query II
SELECT '12:00:00.1234567895'::TIME_NS, '23:59:59.9999999995'::TIME_NS
----
12:00:00.12345679	24:00:00

require icu

statement ok
SET TimeZone = 'UTC';

# the fraction rounds the instant after the time zone resolved the local time, around both DST changes
query IIII
SELECT '2024-11-03 00:59:59.9999995 America/New_York'::TIMESTAMPTZ, '2024-03-10 01:59:59.9999995 America/New_York'::TIMESTAMPTZ, '2024-01-01 12:00:00.1234565+02'::TIMESTAMPTZ, '2024-11-03 00:59:59.9999999995 America/New_York'::TIMESTAMPTZ_NS
----
2024-11-03 05:00:00+00	2024-03-10 07:00:00+00	2024-01-01 10:00:00.123457+00	2024-11-03 05:00:00+00

# a named zone that moves a tie across the epoch rounds it by the instant
query II
SELECT '1970-01-01 01:00:00.0000005 Europe/Berlin'::TIMESTAMPTZ, '1969-12-31 19:00:00.0000005 America/New_York'::TIMESTAMPTZ
----
1970-01-01 00:00:00.000001+00	1970-01-01 00:00:00.000001+00

query I
SELECT '1970-01-01 00:59:59.9999995 Europe/Berlin'::TIMESTAMPTZ
----
1969-12-31 23:59:59.999999+00

# at the ends of the range, the checks apply to the rounded local time and the rounded instant
query III
SELECT epoch_us('290309-12-22 (BC) 05:18:04.2241936 Asia/Tokyo'::TIMESTAMPTZ), epoch_us('290309-12-22 (BC) 05:18:04.2241916 Asia/Tokyo'::TIMESTAMPTZ), epoch_us('290309-12-21 (BC) 19:59:05.2241936 America/New_York'::TIMESTAMPTZ)
----
-9223372036854775806	-9223372036854775808	-9223372019092775806

query II
SELECT TRY_CAST('290309-12-21 (BC) 19:59:05.2241926 America/New_York' AS TIMESTAMPTZ), TRY_CAST('294247-01-10 04:00:54.7758065 Asia/Tokyo' AS TIMESTAMPTZ)
----
NULL	NULL

# a local time that rounds onto -infinity is out of range, also when its instant is below the range
query II
SELECT TRY_CAST('290309-12-21 (BC) 19:59:05.2241926 Asia/Tokyo' AS TIMESTAMPTZ), TRY_CAST('290309-12-21 (BC) 19:59:05.2241929996 Asia/Tokyo' AS TIMESTAMPTZ_NS)
----
NULL	NULL

statement ok
SET TimeZone = 'America/New_York';

query II
SELECT '2024-11-03 00:59:59.9999995'::TIMESTAMPTZ, epoch_us('2024-11-03 00:59:59.9999995'::TIMESTAMPTZ)
----
2024-11-03 01:00:00-04	1730610000000000

query I
SELECT TRY_CAST('294247-01-10 04:00:54.7758065+00' AS TIMESTAMPTZ)
----
NULL

query II
SELECT epoch_us('290309-12-21 (BC) 19:59:05.2241936'::TIMESTAMPTZ), TRY_CAST('290309-12-21 (BC) 19:59:05.2241926' AS TIMESTAMPTZ)
----
-9223372019092775806	NULL
