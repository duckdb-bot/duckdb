# name: test/sql/index/create_index_option_wide_decimal.test
# description: A decimal literal wider than 38 digits as a CREATE INDEX option is a DOUBLE, which every storage version and every reading engine holds
# group: [index]

load {TEST_DIR}/create_index_option_wide_decimal.db

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET wal_autocheckpoint='1TB'

statement ok
CREATE TABLE t (s INTEGER);

statement ok
INSERT INTO t VALUES (7);

statement ok
CREATE INDEX wide ON t(s) WITH (some_option = 123456789012345678901234567890123456789.0);

statement ok
CREATE INDEX wide_negative ON t(s) WITH (some_option = -123456789012345678901234567890123456789.0);

# digit separators are not part of the number
statement ok
CREATE INDEX wide_separators ON t(s) WITH (some_option = 12_345_678_901_234_567_890_123_456_789_012_345_678.5);

# a literal of 38 digits is a decimal for every engine and stays exact
statement ok
CREATE INDEX exact ON t(s) WITH (some_option = 1234567890123456789012345678901234567.8);

statement ok
CREATE INDEX narrow ON t(s) WITH (some_option = 1.5);

statement ok
CREATE INDEX text_option ON t(s) WITH (some_option = '123456789012345678901234567890123456789.0');

query II
SELECT index_name, regexp_extract(sql, 'some_option = (.*) \)', 1) FROM duckdb_indexes() ORDER BY index_name
----
exact	1234567890123456789012345678901234567.8
narrow	1.5
text_option	'123456789012345678901234567890123456789.0'
wide	1.2345678901234568e+38
wide_negative	-1.2345678901234568e+38
wide_separators	1.2345678901234568e+37

# the options are read back from the WAL
restart

query II
SELECT index_name, regexp_extract(sql, 'some_option = (.*) \)', 1) FROM duckdb_indexes() ORDER BY index_name
----
exact	1234567890123456789012345678901234567.8
narrow	1.5
text_option	'123456789012345678901234567890123456789.0'
wide	1.2345678901234568e+38
wide_negative	-1.2345678901234568e+38
wide_separators	1.2345678901234568e+37

# and from the checkpointed catalog
statement ok
CHECKPOINT

restart

query II
SELECT index_name, regexp_extract(sql, 'some_option = (.*) \)', 1) FROM duckdb_indexes() ORDER BY index_name
----
exact	1234567890123456789012345678901234567.8
narrow	1.5
text_option	'123456789012345678901234567890123456789.0'
wide	1.2345678901234568e+38
wide_negative	-1.2345678901234568e+38
wide_separators	1.2345678901234568e+37

query I
SELECT s FROM t WHERE s = 7
----
7
