# name: test/sql/merge/merge_into_action_values.test
# description: MERGE INTO and ON CONFLICT DO UPDATE only compute the values of an action for the rows it applies to
# group: [merge]

statement ok
CREATE TABLE t (k INT PRIMARY KEY, u INT, s VARCHAR);

# no conflict, so the update and its failing cast do not run
statement ok
INSERT INTO t (k, s) VALUES (4, 'x') ON CONFLICT (k) DO UPDATE SET u = EXCLUDED.s::INT;

statement ok
INSERT INTO t VALUES (4, 0, 'x') ON CONFLICT (k) DO UPDATE SET u = EXCLUDED.s::INT WHERE false;

statement ok
CREATE TABLE src AS SELECT * FROM t;

statement ok
MERGE INTO t USING src ON t.k = src.k WHEN MATCHED AND t.k <= 0 THEN UPDATE SET u = CAST(t.s AS INT);

query III
SELECT * FROM t;
----
4	NULL	x

# the update still fails on the rows it applies to
statement error
INSERT INTO t VALUES (4, 0, 'x') ON CONFLICT (k) DO UPDATE SET u = EXCLUDED.s::INT;
----
Could not convert string 'x' to INT32

statement error
MERGE INTO t USING src ON t.k = src.k WHEN MATCHED THEN UPDATE SET u = CAST(t.s AS INT);
----
Could not convert string 'x' to INT32

# each action computes its own values
statement ok
INSERT INTO t VALUES (1, 0, '10'), (2, 0, 'y');

statement ok
CREATE OR REPLACE TABLE src AS SELECT * FROM (VALUES (1, '11'), (2, 'z'), (3, '13'), (5, 'w')) v(k, s);

query I
MERGE INTO t USING src ON t.k = src.k
WHEN MATCHED AND t.s = 'y' THEN UPDATE SET u = length(src.s)
WHEN MATCHED AND t.s <> 'x' THEN UPDATE SET u = src.s::INT
WHEN NOT MATCHED AND src.s <> 'w' THEN INSERT VALUES (src.k, src.s::INT, src.s)
WHEN NOT MATCHED THEN INSERT VALUES (src.k, length(src.s), src.s);
----
4

query III
SELECT * FROM t ORDER BY k;
----
1	11	10
2	1	y
3	13	13
4	NULL	x
5	1	w

# with an outer join, the updates do not run on the rows of the other side
statement ok
CREATE OR REPLACE TABLE src AS SELECT * FROM (VALUES (1, '21'), (3, '23')) v(k, s);

query I
MERGE INTO t USING src ON t.k = src.k
WHEN MATCHED THEN UPDATE SET u = t.s::INT + src.s::INT
WHEN NOT MATCHED BY SOURCE AND t.s = 'w' THEN DELETE;
----
3

query III
SELECT * FROM t ORDER BY k;
----
1	31	10
2	1	y
3	36	13
4	NULL	x

query I
MERGE INTO t USING (VALUES (7, 'q')) v(k, s) ON t.k = v.k
WHEN MATCHED THEN UPDATE SET u = v.s::INT
WHEN NOT MATCHED THEN DO NOTHING;
----
0

# volatile values and defaults only run for the rows of their action
statement ok
CREATE SEQUENCE seq;

statement ok
CREATE TABLE d (k INT PRIMARY KEY, u BIGINT DEFAULT nextval('seq'));

statement ok
INSERT INTO d VALUES (1, 0), (2, 0), (3, 0);

statement ok
MERGE INTO d USING (SELECT range AS k FROM range(1, 4)) s ON d.k = s.k
WHEN MATCHED AND d.k < 0 THEN UPDATE SET u = nextval('seq')
WHEN MATCHED AND d.k > 5 THEN UPDATE SET u = DEFAULT;

statement ok
INSERT INTO d VALUES (10, 0) ON CONFLICT (k) DO UPDATE SET u = nextval('seq');

query I
SELECT nextval('seq');
----
1

query I
MERGE INTO d USING (SELECT range AS k FROM range(1, 4)) s ON d.k = s.k
WHEN MATCHED AND d.k = 2 THEN UPDATE SET u = DEFAULT
WHEN MATCHED THEN UPDATE SET u = nextval('seq') * 10;
----
3

# the three updates take three sequence values
query I
SELECT nextval('seq');
----
5

query III
SELECT k, u % 10 = 0, u BETWEEN 2 AND 40 FROM d ORDER BY k;
----
1	true	true
2	false	true
3	true	true
10	true	false

# computed values next to RETURNING, updates of an indexed column, subqueries and lambdas
query IIII rowsort
MERGE INTO t USING (VALUES (1), (2)) v(k) ON t.k = v.k
WHEN MATCHED AND t.s = 'y' THEN UPDATE SET u = u * 100
WHEN MATCHED THEN UPDATE SET u = t.s::INT
RETURNING merge_action, *;
----
UPDATE	1	10	10
UPDATE	2	100	y

query I
MERGE INTO t USING (VALUES (1), (3), (4)) v(k) ON t.k = v.k
WHEN MATCHED AND t.s <> 'x' THEN UPDATE SET k = t.s::INT + 100;
----
2

query III
SELECT * FROM t ORDER BY k;
----
2	100	y
4	NULL	x
110	10	10
113	36	13

query I
MERGE INTO t USING (VALUES (2, '5'), (4, 'x')) v(k, s) ON t.k = v.k
WHEN MATCHED AND v.s = 'x' THEN UPDATE SET u = (SELECT max(k) FROM t) + length(v.s)
WHEN MATCHED THEN UPDATE SET u = list_sum(list_transform([1, 2], lambda x: x + v.s::INT));
----
2

query III
SELECT * FROM t WHERE k IN (2, 4) ORDER BY k;
----
2	13	y
4	114	x

statement error
MERGE INTO t USING (VALUES (2, '5'), (4, 'x')) v(k, s) ON t.k = v.k
WHEN MATCHED THEN UPDATE SET u = list_sum(list_transform([1, 2], lambda x: x + v.s::INT));
----
Could not convert string 'x' to INT32

# a subquery under TRY re-raises its errors where the projection plans it, so its value stays below that TRY
statement ok
CREATE TABLE e (k INT, s VARCHAR, u INT);

statement ok
INSERT INTO e VALUES (1, 'bad', 0);

query I
MERGE INTO e USING (VALUES (1), (2)) v(k) ON e.k = v.k
WHEN MATCHED THEN UPDATE SET u = 10 * TRY(1 + (SELECT s::INT FROM e WHERE k = 1)) + 1
WHEN NOT MATCHED THEN INSERT VALUES (v.k, 'new', TRY(1 + (SELECT s::INT FROM e WHERE k = 1)));
----
2

query III
SELECT * FROM e ORDER BY k;
----
1	bad	NULL
2	new	NULL

query I
MERGE INTO e USING (VALUES (1)) v(k) ON e.k = v.k
WHEN MATCHED AND false THEN UPDATE SET u = TRY(1 + (SELECT s::INT FROM e WHERE k = 1));
----
0

# the comparison of an ANY subquery is planned at its use site too, so its value keeps the CASE around it
statement ok
CREATE TABLE a (k INT, s VARCHAR, b BOOLEAN);

statement ok
INSERT INTO a VALUES (1, 'bad', false), (2, '2', false);

query I
MERGE INTO a USING (VALUES (1), (2)) v(k) ON a.k = v.k
WHEN MATCHED THEN UPDATE SET b = CASE WHEN a.k = 1 THEN false ELSE a.s::INT > ANY (SELECT 0) END;
----
2

query II
SELECT k, b FROM a ORDER BY k;
----
1	false
2	true
