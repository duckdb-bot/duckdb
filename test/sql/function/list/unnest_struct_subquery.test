# name: test/sql/function/list/unnest_struct_subquery.test
# description: UNNEST of a struct that a scalar subquery returns
# group: [list]

query I
SELECT unnest((SELECT row(1)));
----
1

query II
SELECT unnest((SELECT {'a': 1, 'b': 'x'}));
----
1	x

query II
SELECT unnest((SELECT {'a': 1, 'b': 'x'})) FROM range(2);
----
1	x
1	x

# a NULL struct gives NULL fields, as without the subquery
query II
SELECT unnest((SELECT NULL::STRUCT(a INTEGER, b VARCHAR)));
----
NULL	NULL

# also with a list around the struct, and recursively
query II
SELECT unnest((SELECT [{'a': 1, 'b': 'x'}, {'a': 2, 'b': 'y'}]), recursive := true);
----
1	x
2	y

query II
SELECT unnest((SELECT {'a': {'c': 1}, 'b': 'x'}), recursive := true);
----
1	x

# next to a list unnest, the struct is repeated for every element, and an empty list gives no rows
query II
SELECT unnest((SELECT row(1))), unnest([10, 20]);
----
1	10
1	20

query II
SELECT unnest((SELECT row(1))), unnest([]::INTEGER[]);
----

# keep_parent_names takes the name of the struct
query I
SELECT column_name FROM (DESCRIBE SELECT unnest(s := {'a': (SELECT 1)}, keep_parent_names := true));
----
s.a

# the struct is evaluated once per row, next to a recursive list unnest
statement ok
CREATE SEQUENCE seq;

query III
SELECT unnest((SELECT {'a': nextval('seq'), 'b': nextval('seq')})), unnest([[1], [2]], recursive := true);
----
1	2	1
1	2	2

query I
SELECT unnest((SELECT {'a': {'b': 1}}), max_depth := 2);
----
1

# a subquery without rows gives NULL fields, also in a correlated LEFT LATERAL join
query II
SELECT unnest((SELECT {'a': 1, 'b': 2} WHERE false));
----
NULL	NULL

query III
SELECT t.i, u.* FROM range(2) t(i) LEFT JOIN LATERAL (SELECT unnest((SELECT {'a': t.i, 'b': t.i * 10}))) u ON true ORDER BY ALL;
----
0	0	0
1	1	10

statement error
SELECT unnest((SELECT {'a': i} FROM range(2) t(i)));
----
More than one row returned by a subquery
