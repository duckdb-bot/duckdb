# name: test/issues/general/test_25074.test
# description: Converting a VARIANT nested deeper than the limit raises an error instead of overflowing the stack
# group: [general]

statement ok
CREATE TABLE t AS WITH RECURSIVE r(d, v, o) AS (
	SELECT 1, [1]::VARIANT, {'a': 1}::VARIANT
	UNION ALL
	SELECT d + 1, [v]::VARIANT, {'a': o}::VARIANT FROM r WHERE d < 128
)
SELECT d, v, o FROM r WHERE d IN (127, 128);

# a value inside 127 nested arrays or objects still converts
query II
SELECT length(v::VARCHAR), length(o::VARCHAR) FROM t WHERE d = 127;
----
255	890

statement error
SELECT v::VARCHAR FROM t WHERE d = 128;
----
VARIANT exceeds maximum recursion depth of 128

statement error
SELECT o::VARCHAR FROM t WHERE d = 128;
----
VARIANT exceeds maximum recursion depth of 128

statement error
SELECT [v]::VARIANT::VARCHAR FROM t WHERE d = 127;
----
VARIANT exceeds maximum recursion depth of 128

query II
SELECT TRY_CAST(v AS VARCHAR) IS NULL, TRY_CAST(o AS VARCHAR) IS NULL FROM t ORDER BY d;
----
false	false
true	true


# the limit applies to the whole value, whatever the target type and the other rows
query II
SELECT d, TRY_CAST(v AS VARCHAR[]) IS NULL FROM t ORDER BY d;
----
127	false
128	true

statement error
SELECT [v]::VARCHAR FROM t WHERE d = 128;
----
VARIANT exceeds maximum recursion depth of 128

statement error
SELECT {'a': v}::VARCHAR FROM t WHERE d = 128;
----
VARIANT exceeds maximum recursion depth of 128

statement error
SELECT CAST(o AS STRUCT(a VARIANT)) FROM t WHERE d = 128;
----
VARIANT exceeds maximum recursion depth of 128

statement error
SELECT CAST(o AS MAP(VARCHAR, VARIANT)) FROM t WHERE d = 128;
----
VARIANT exceeds maximum recursion depth of 128

query III
SELECT d, TRY_CAST(o AS STRUCT(a VARIANT)) IS NULL, TRY_CAST(v AS VARIANT[]) IS NULL FROM t ORDER BY d;
----
127	false	false
128	true	true

# a row of another type sends the whole batch to the conversion through a Value
statement ok
CREATE TABLE mixed AS SELECT d, v FROM t UNION ALL SELECT 0, 'x'::VARIANT;

query II
SELECT d, TRY_CAST(v AS VARCHAR[]) IS NULL FROM mixed ORDER BY d;
----
0	true
127	false
128	true

# TRY_CAST of a container sets the elements that do not convert to NULL, as for other types
query II
SELECT TRY_CAST([v, 1::VARIANT] AS VARCHAR), TRY_CAST({'a': v, 'b': 1::VARIANT} AS VARCHAR) FROM t WHERE d = 128;
----
[NULL, 1]	{'a': NULL, 'b': 1}

# the error names the nesting, also when another row of the batch converted another way
statement error
SELECT CAST(CASE WHEN i = 0 THEN (SELECT v FROM t WHERE d = 128) ELSE 1.234::DECIMAL(10,3)::VARIANT END AS DECIMAL(9,2))
FROM range(2) t(i);
----
VARIANT exceeds maximum recursion depth of 128

query III
SELECT TRY_CAST([v]::VARIANT[1] AS VARCHAR), TRY_CAST(MAP {'k': v} AS VARCHAR), TRY_CAST(union_value(u := v) AS VARCHAR) IS NULL
FROM t WHERE d = 128;
----
[NULL]	{k=NULL}	true

# arrays and objects with siblings, and a value far past the limit
statement ok
CREATE TABLE mix AS WITH RECURSIVE r(d, v) AS (
	SELECT 1, [1, 2]::VARIANT
	UNION ALL
	SELECT d + 1, CASE WHEN d % 2 = 0 THEN [v, 1::VARIANT]::VARIANT ELSE {'a': 1::VARIANT, 'b': v}::VARIANT END
	FROM r WHERE d < 1000
)
SELECT d, v FROM r WHERE d IN (127, 128, 1000);

query II
SELECT d, TRY_CAST(v AS VARCHAR) IS NULL FROM mix ORDER BY d;
----
127	false
128	true
1000	true

# the depth error is reported also when another row of the batch fails to convert
statement ok
CREATE TABLE mixed_errors AS SELECT 1 AS i, v FROM t WHERE d = 128 UNION ALL SELECT 2, 'x'::VARIANT UNION ALL
	SELECT 3, 42::VARIANT;

statement error
SELECT CAST(v AS INTEGER) FROM mixed_errors;
----
VARIANT exceeds maximum recursion depth of 128

query II
SELECT i, TRY_CAST(v AS INTEGER) FROM mixed_errors ORDER BY i;
----
1	NULL
2	NULL
3	42
