# name: test/sql/secrets/secret_scope_host_boundary.test
# description: A scope that ends in a host covers that host only, not a host whose name starts the same
# group: [secrets]

statement ok
CREATE SECRET host_only (TYPE http, BEARER_TOKEN 'T', SCOPE 'http://127.0.0.1');

statement ok
CREATE SECRET with_path (TYPE http, BEARER_TOKEN 'P', SCOPE 'http://example.com/data');

statement ok
CREATE SECRET bucket (TYPE http, BEARER_TOKEN 'B', SCOPE 'http://trusted');

statement ok
CREATE SECRET with_port (TYPE http, BEARER_TOKEN 'O', SCOPE 'http://host:80');

statement ok
CREATE SECRET whole_scheme (TYPE http, BEARER_TOKEN 'S', SCOPE 'https://');

statement ok
CREATE SECRET with_query (TYPE http, BEARER_TOKEN 'Q', SCOPE 'http://query.example?token=');

statement ok
CREATE SECRET ipv6 (TYPE http, BEARER_TOKEN 'I', SCOPE 'http://[::1]');

statement ok
CREATE SECRET not_a_url (TYPE http, BEARER_TOKEN 'N', SCOPE 'local/data');

# a host with a port, a path or a query, but not another host
query I
SELECT name FROM which_secret('http://127.0.0.1', 'http');
----
host_only

query I
SELECT name FROM which_secret('http://127.0.0.1/x', 'http');
----
host_only

query I
SELECT name FROM which_secret('http://127.0.0.1:8080/x', 'http');
----
host_only

query I
SELECT name FROM which_secret('http://127.0.0.1?q', 'http');
----
host_only

query I
SELECT count(*) FROM which_secret('http://127.0.0.10:8080/x', 'http');
----
0


query I
SELECT count(*) FROM which_secret('http://127.0.0.1.example.org/x', 'http');
----
0


# a scope with a path is a prefix of paths
query I
SELECT name FROM which_secret('http://example.com/data/x.csv', 'http');
----
with_path

query I
SELECT name FROM which_secret('http://example.com/data_2024.csv', 'http');
----
with_path

query I
SELECT count(*) FROM which_secret('http://example.com/other', 'http');
----
0

query I
SELECT name FROM which_secret('http://trusted/a.csv', 'http');
----
bucket

query I
SELECT name FROM which_secret('http://trusted#part', 'http');
----
bucket

query I
SELECT count(*) FROM which_secret('http://trusted-evil/a.csv', 'http');
----
0

query I
SELECT name FROM which_secret('http://host:80/x', 'http');
----
with_port

query I
SELECT count(*) FROM which_secret('http://host:8080/x', 'http');
----
0

# a scope of only a scheme covers every URL of it
query I
SELECT name FROM which_secret('https://anything.example/x', 'http');
----
whole_scheme

# a scope with a query or a fragment is a prefix as one with a path
query I
SELECT name FROM which_secret('http://query.example?token=abc', 'http');
----
with_query

# a colon after the host is a port, not the password of a user of another host
query I
SELECT count(*) FROM which_secret('http://127.0.0.1:pass@elsewhere.example/x', 'http');
----
0

query I
SELECT name FROM which_secret('http://[::1]:8080/x', 'http');
----
ipv6

query I
SELECT name FROM which_secret('local/data_2024.csv', 'http');
----
not_a_url
