# compressed input is read through buffers that cannot be looked at again, a range starting with a line feed stays as before
statement ok
COPY (SELECT 1 AS a FROM range(32)) TO '{TEST_DIR}/comment_lf_boundary_rows.csv.gz' (HEADER false, COMPRESSION gzip, NEW_LINE '\r\n');

loop buffer_size 12 21

query II
