# name: test/optimizer/statistics/statistics_monotone_infinity.test
# description: Monotone bounds are not inferred when -infinity lies between finite bounds
# group: [statistics]

# the smallest finite DATE and TIMESTAMP values sort below -infinity
statement ok
CREATE TABLE dates(c DATE);

statement ok
INSERT INTO dates VALUES (make_date(-2147483647 - 1)), ('-infinity'), ('1970-01-01');

query II
SELECT count(last_day(c)), count(*) FILTER (last_day(c) IS NOT NULL) FROM dates
----
2	2

statement ok
CREATE TABLE timestamps(c TIMESTAMP);

statement ok
INSERT INTO timestamps VALUES (make_timestamp(-9223372036854775807 - 1)), ('-infinity'), ('1970-01-01');

query I
SELECT count(last_day(c)) FROM timestamps
----
2

statement ok
CREATE TABLE timestamps_ns(c TIMESTAMP_NS);

statement ok
INSERT INTO timestamps_ns VALUES (make_timestamp_ns(-9223372036854775807 - 1)), ('-infinity'), ('1970-01-01');

query I
SELECT count(epoch_ns(c)) FROM timestamps_ns
----
2

statement ok
CREATE TABLE timestamps_tz_ns(c TIMESTAMPTZ_NS);

statement ok
INSERT INTO timestamps_tz_ns VALUES ('1677-09-21 00:12:43.145224192+00'), ('-infinity'), ('1970-01-01 00:00:00+00');

query II
SELECT count(epoch_ns(c)), epoch_ns(min(c)) FROM timestamps_tz_ns
----
2	-9223372036854775808

# -infinity as a bound, and the smallest finite value without -infinity, give the right counts
statement ok
CREATE TABLE dates_from_infinity(c DATE);

statement ok
INSERT INTO dates_from_infinity VALUES ('-infinity'), ('1970-01-01');

query I
SELECT count(last_day(c)) FROM dates_from_infinity
----
1

statement ok
CREATE TABLE smallest_ns(c TIMESTAMP_NS);

statement ok
INSERT INTO smallest_ns VALUES (make_timestamp_ns(-9223372036854775807 - 1)), ('1970-01-01');

query III
SELECT count(epoch_ns(c)), min(epoch_ns(c)), max(epoch_ns(c)) FROM smallest_ns
----
2	-9223372036854775808	0

# ranges that cannot hold -infinity keep their bounds
statement ok
CREATE TABLE recent_ns(c TIMESTAMP_NS);

statement ok
INSERT INTO recent_ns VALUES ('1970-01-01'), ('2000-01-01');

query I
SELECT stats(epoch_ns(c)) FROM recent_ns LIMIT 1
----
{'has_no_null': true, 'has_null': false, 'max': 946684800000000000, 'min': 0}

# adding days to a date keeps it on its side of -infinity
query IIII
SELECT '-infinity'::DATE + 2, 2 + '-infinity'::DATE, '-infinity'::DATE - 2, DATE '5877642-06-25 (BC)' + 0
----
-infinity	-infinity	-infinity	5877642-06-25 (BC)

statement error
SELECT make_date(-2147483647 - 1) + 2
----
Out of Range Error: Date out of range

statement error
SELECT 2 + make_date(-2147483647 - 1)
----
Out of Range Error: Date out of range

statement error
SELECT make_date(-2147483647 - 1) - (-2)
----
Out of Range Error: Date out of range

statement error
SELECT DATE '5877642-06-25 (BC)' + (-2)
----
Out of Range Error: Date out of range

statement error
SELECT DATE '5877642-06-25 (BC)' - 2
----
Out of Range Error: Date out of range

statement error
SELECT count(*) FROM dates WHERE c + 2 = '-infinity'::DATE
----
Out of Range Error: Date out of range

statement ok
CREATE TABLE days(i INTEGER);

statement ok
INSERT INTO days VALUES (-2147483648), (-2147483647);

statement error
SELECT make_date(i) + 2 FROM days ORDER BY i
----
Out of Range Error: Date out of range

# -infinity as the lower bound gives the right rows for date arithmetic
query I
SELECT count(*) FROM dates_from_infinity WHERE c + 2 = '-infinity'::DATE
----
1
