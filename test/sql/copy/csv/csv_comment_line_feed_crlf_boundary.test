3	[1, 3, 5]

mode unskip

# two comments in a row, the second starts where the first one's line feed ends
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '1,2' || chr(13) || chr(10) || '#comment' || chr(10) || '#second' || chr(10) || '300,400' || chr(13) || chr(10) || '500,600' || chr(13)) TO '{TEST_DIR}/comment_lf_boundary_two.csv' (HEADER false, QUOTE '', DELIM '|');

foreach parallel true false

loop buffer_size 10 47

query II
SELECT count(*), list(a ORDER BY a) FROM read_csv('{TEST_DIR}/comment_lf_boundary_two.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = {buffer_size}, parallel = {parallel});
----
3	[1, 300, 500]

endloop

endloop

# a quoted value right behind the comment keeps all of its bytes
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '1,2' || chr(13) || chr(10) || '#comment' || chr(10) || '"abcdefghijkl",4' || chr(13) || chr(10) || '5,6' || chr(13)) TO '{TEST_DIR}/comment_lf_boundary_quoted_value.csv' (HEADER false, QUOTE '', DELIM '|');

foreach parallel true false

loop buffer_size 19 41

query II
SELECT count(*), list(a ORDER BY a) FROM read_csv('{TEST_DIR}/comment_lf_boundary_quoted_value.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'VARCHAR', 'b': 'INTEGER'}, buffer_size = {buffer_size}, parallel = {parallel});
----
3	[1, 5, abcdefghijkl]

endloop

endloop

# FIXME: the row behind a row that fills the whole buffer up to its \r is lost, with and without the comment
mode skip

query II
SELECT count(*), list(a ORDER BY a) FROM read_csv('{TEST_DIR}/comment_lf_boundary_quoted_value.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'VARCHAR', 'b': 'INTEGER'}, buffer_size = 18);
----
3	[1, 5, abcdefghijkl]

mode unskip

# a quoted value holding a bare line feed and a \r\n is not a comment, the thread that starts inside it keeps it whole
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || 'xxxxxxxx,2' || chr(13) || chr(10) || '"a' || chr(10) || '3,4' || chr(13) || chr(10) || 'z",5' || chr(13) || chr(10) || '6,7' || chr(13)) TO '{TEST_DIR}/comment_lf_boundary_quoted_field.csv' (HEADER false, QUOTE '', DELIM '|');

foreach parallel true false

foreach errors ignore_errors=false ignore_errors=true store_rejects=true

loop buffer_size 17 19

query II
SELECT count(*), list(b ORDER BY b) FROM read_csv('{TEST_DIR}/comment_lf_boundary_quoted_field.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'VARCHAR', 'b': 'INTEGER'}, buffer_size = {buffer_size}, parallel = {parallel}, {errors});
----
3	[2, 5, 7]

endloop

loop buffer_size 24 41

query II
SELECT count(*), list(b ORDER BY b) FROM read_csv('{TEST_DIR}/comment_lf_boundary_quoted_field.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'VARCHAR', 'b': 'INTEGER'}, buffer_size = {buffer_size}, parallel = {parallel}, {errors});
----
3	[2, 5, 7]

endloop

endloop

endloop

