# with buffer_size and max_line_size both given, the last scan range of a buffer can be shorter than the others. A row
# that starts before that scan range and ends in the next buffer is read
statement ok
COPY (SELECT i + 1000 AS aaaa, 'wxyz' AS bbbbb FROM range(300) t(i) ORDER BY i) TO '{TEST_DIR}/short_rows.csv' (HEADER);

foreach buffer_size 980 1000 1010

query IIIII
SELECT count(*), count(DISTINCT aaaa), min(aaaa), max(aaaa), count(*) FILTER (WHERE bbbbb = 'wxyz') FROM read_csv('{TEST_DIR}/short_rows.csv', buffer_size = {buffer_size}, max_line_size = 100)
----
300	300	1000	1299	300

endloop

# more of the row than its line feed is in the next buffer
query IIIII
SELECT count(*), count(DISTINCT aaaa), min(aaaa), max(aaaa), count(*) FILTER (WHERE bbbbb = 'wxyz') FROM read_csv('{TEST_DIR}/short_rows.csv', buffer_size = 996, max_line_size = 100, ignore_errors = true)
----
300	300	1000	1299	300

