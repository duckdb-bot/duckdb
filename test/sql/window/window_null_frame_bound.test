# name: test/sql/window/window_null_frame_bound.test
# description: A NULL frame bound is an input error, also when it is a constant that the planner inspects (issue #724)
# group: [window]

statement error
SELECT sum(i) OVER (ORDER BY i ROWS BETWEEN NULL::BIGINT PRECEDING AND CURRENT ROW) FROM range(3) t(i);
----
Window ROWS PRECEDING expression cannot be NULL

statement error
SELECT sum(i) OVER (ORDER BY i ROWS BETWEEN CURRENT ROW AND NULL::BIGINT FOLLOWING) FROM range(3) t(i);
----
Window ROWS FOLLOWING expression cannot be NULL

statement error
SELECT sum(i) OVER (ORDER BY i ROWS BETWEEN 0 PRECEDING AND NULL::BIGINT FOLLOWING) FROM range(3) t(i);
----
Window ROWS FOLLOWING expression cannot be NULL

statement error
SELECT sum(i) OVER (ORDER BY i ROWS BETWEEN NULL PRECEDING AND NULL FOLLOWING) FROM range(3) t(i);
----
Window ROWS PRECEDING expression cannot be NULL

statement error
SELECT sum(i) OVER (ORDER BY i ROWS BETWEEN (SELECT NULL::BIGINT) PRECEDING AND CURRENT ROW) FROM range(3) t(i);
----
Window ROWS PRECEDING expression cannot be NULL

statement error
SELECT sum(i) OVER (ORDER BY i ROWS BETWEEN n PRECEDING AND CURRENT ROW) FROM (SELECT i, NULL::BIGINT AS n FROM range(3) t(i));
----
Window ROWS PRECEDING expression cannot be NULL

# the frame of the current row alone is still recognized
query II
SELECT i, sum(i) OVER (ORDER BY i ROWS BETWEEN 0 PRECEDING AND 0 FOLLOWING) FROM range(3) t(i) ORDER BY i;
----
0	0
1	1
2	2

query II
SELECT i, sum(i) OVER (ORDER BY i ROWS BETWEEN 0 PRECEDING AND 1 FOLLOWING) FROM range(3) t(i) ORDER BY i;
----
0	1
1	3
2	2
