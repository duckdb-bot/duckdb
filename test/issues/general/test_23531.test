# name: test/issues/general/test_23531.test
# description: Test autoloading an extension while a function call is bound
# group: [general]

require icu

# current_date in the select list loads icu while the call to + is bound
restart no_extension_load

statement ok
SET autoinstall_known_extensions = false

statement ok
SET autoload_known_extensions = true

query I
SELECT (current_date + 1) - current_date
----
1

# the same in a WHERE clause
restart no_extension_load

statement ok
SET autoinstall_known_extensions = false

statement ok
SET autoload_known_extensions = true

query I
SELECT 42 WHERE current_date - 1 < current_date
----
42

# date_part of a TIMESTAMPTZ loads icu while the call to + is bound
restart no_extension_load

statement ok
SET autoinstall_known_extensions = false

statement ok
SET autoload_known_extensions = true

query I
SELECT date_part('year', now()) + 1 > 2000
----
true

# a table function argument loads icu, which adds overloads of range
restart no_extension_load

statement ok
SET autoinstall_known_extensions = false

statement ok
SET autoload_known_extensions = true

query I
SELECT count(*) FROM range(current_date, current_date + 3, INTERVAL 1 DAY)
----
3

# a subquery in an argument loads icu
restart no_extension_load

statement ok
SET autoinstall_known_extensions = false

statement ok
SET autoload_known_extensions = true

query I
SELECT 1 + (SELECT current_date - current_date)
----
1

# a lambda body loads icu
restart no_extension_load

statement ok
SET autoinstall_known_extensions = false

statement ok
SET autoload_known_extensions = true

query I
SELECT list_transform([1, 2], lambda x: (current_date + x) - current_date)
----
[1, 2]

# the call is bound with the overloads that icu adds
restart no_extension_load

statement ok
SET autoinstall_known_extensions = false

statement ok
SET autoload_known_extensions = true

query I
SELECT typeof(current_date::TIMESTAMPTZ + INTERVAL 1 DAY)
----
TIMESTAMP WITH TIME ZONE

# a call without a matching overload is still an error
restart no_extension_load

statement ok
SET autoinstall_known_extensions = false

statement ok
SET autoload_known_extensions = true

statement error
SELECT current_date + [1]
----
<REGEX>:Binder Error.*No function matches.*
