# name: test/sql/types/decimal/decimal_division.test
# description: Test decimal_division scalar function
# group: [decimal]

# Basic division
query I
SELECT decimal_division(10.00, 4.00);
----
2.500000

# Unqualified DECIMAL literals resolve to DECIMAL(18,3); result_width=40 overflows -> error
# result_scale = max(6, 3+18+1) = 22, result_width = 18-3+3+22 = 40 > 38
statement error
SELECT decimal_division(DECIMAL '1.00', DECIMAL '3.000');
----
<REGEX>:.*could not perform an accurate division.*

# Explicit small-precision inputs: p1=5 s1=2, p2=5 s2=3
# result_scale = max(6, 2+5+1) = 8, result_width = 5-2+3+8 = 14 -> DECIMAL(14,8)
query I
SELECT decimal_division(1.00::DECIMAL(5,2), 3.000::DECIMAL(5,3));
----
0.33333333

# Negative dividend
query I
SELECT decimal_division(-7.00, 2.00);
----
-3.500000

# Division by a value less than 1
query I
SELECT decimal_division(1.00, 0.25);
----
4.000000

# Division by zero raises an error
statement error
SELECT decimal_division(1.00, 0.00);
----
decimal_division: division by zero

# INT16 inputs (p<=4) -> DECIMAL(10, 7), INT64 result physical type
# p1=4 s1=2 p2=4 s2=1: result_scale=max(6,2+4+1)=7, result_width=4-2+1+7=10
query I
SELECT typeof(decimal_division(12.34::DECIMAL(4,2), 3.5::DECIMAL(4,1)));
----
DECIMAL(10,7)

query I
SELECT decimal_division(12.34::DECIMAL(4,2), 3.5::DECIMAL(4,1));
----
3.5257143

# INT32 inputs (p<=9) -> DECIMAL(18, 10), INT64 result physical type
# p1=9 s1=3 p2=6 s2=2: result_scale=max(6,3+6+1)=10, result_width=9-3+2+10=18
query I
SELECT typeof(decimal_division(1000.000::DECIMAL(9,3), 4.00::DECIMAL(6,2)));
----
DECIMAL(18,10)

query I
SELECT decimal_division(1000.000::DECIMAL(9,3), 4.00::DECIMAL(6,2));
----
250.0000000000

# INT64 inputs (p<=18) -> DECIMAL(31, 18), INT128 result physical type
# p1=15 s1=5 p2=12 s2=3: result_scale=max(6,5+12+1)=18, result_width=15-5+3+18=31
query I
SELECT typeof(decimal_division(100000.00000::DECIMAL(15,5), 8.000::DECIMAL(12,3)));
----
DECIMAL(31,18)

query I
SELECT decimal_division(100000.00000::DECIMAL(15,5), 8.000::DECIMAL(12,3));
----
12500.000000000000000000

# INT128 inputs where result_width overflows (54 > 38) -> error
# p1=28 s1=8 p2=20 s2=5: result_scale=max(6,8+20+1)=29, result_width=28-8+5+29=54
statement error
SELECT decimal_division(10000000000.00000000::DECIMAL(28,8), 4.00000::DECIMAL(20,5));
----
<REGEX>:.*could not perform an accurate division.*

# result_scale overflows (40 > 38) -> error
# p1=38 s1=2 p2=37 s2=2: result_scale=max(6,2+37+1)=40
statement error
SELECT decimal_division(3::decimal(38,2), 16384::decimal(37,2));
----
<REGEX>:.*could not perform an accurate division.*

query I
SELECT typeof(decimal_division(12.34::DECIMAL(4,2), 3.5::DECIMAL(4,1), 2));
----
DECIMAL(5,2)

query I
SELECT decimal_division(12.34::DECIMAL(4,2), 3.5::DECIMAL(4,1), 2);
----
3.53

# scale=0: scale_exp = s2 + 0 - s1 = 1 - 2 = -1, divisor scaled up -> integer result
query I
SELECT typeof(decimal_division(12.34::DECIMAL(4,2), 3.5::DECIMAL(4,1), 0));
----
DECIMAL(3,0)

query I
SELECT decimal_division(12.34::DECIMAL(4,2), 3.5::DECIMAL(4,1), 0);
----
4

# scale=1: scale_exp = 0
query I
SELECT decimal_division(12.34::DECIMAL(4,2), 3.5::DECIMAL(4,1), 1);
----
3.5

query I
SELECT typeof(decimal_division(12.34::DECIMAL(4,2), 3.5::DECIMAL(4,1), 10));
----
DECIMAL(13,10)

query I
SELECT decimal_division(12.34::DECIMAL(4,2), 3.5::DECIMAL(4,1), 10);
----
3.5257142857

# INT16 inputs with large explicit scale: scale_exp exceeds int64_t safe range (4+|exp|>=19),
# must fall back to hugeint_t compute path — previously caused out-of-bounds POWERS_OF_TEN access
query I
SELECT decimal_division(1.00::DECIMAL(3,2), 3.00::DECIMAL(3,2), 17);
----
0.33333333333333333

query I
SELECT decimal_division(1.00::DECIMAL(3,2), 3.00::DECIMAL(3,2), 35);
----
0.33333333333333333333333333333333333

# Round half to even
query IIII
SELECT decimal_division(1::DECIMAL(2,0), 8::DECIMAL(1,0), 2),
       decimal_division(3::DECIMAL(2,0), 8::DECIMAL(1,0), 2),
       decimal_division(5::DECIMAL(2,0), 8::DECIMAL(1,0), 2),
       decimal_division(7::DECIMAL(2,0), 8::DECIMAL(1,0), 2);
----
0.12	0.38	0.62	0.88

query IIII
SELECT decimal_division(-1::DECIMAL(2,0), 8::DECIMAL(1,0), 2),
       decimal_division(3::DECIMAL(2,0), -8::DECIMAL(1,0), 2),
       decimal_division(-5::DECIMAL(2,0), -8::DECIMAL(1,0), 2),
       decimal_division(-7::DECIMAL(2,0), 8::DECIMAL(1,0), 2);
----
-0.12	-0.38	0.62	-0.88

# Hugeint compute paths, including a divisor that does not fit in a uint64_t
query II
SELECT decimal_division(1::DECIMAL(19,0), 8::DECIMAL(19,0), 2),
       decimal_division(3::DECIMAL(19,0), 8::DECIMAL(19,0), 2);
----
0.12	0.38

query II
SELECT decimal_division(10000000000000000000::DECIMAL(38,0),
                        20000000000000000000::DECIMAL(38,0), 0),
       decimal_division(30000000000000000000::DECIMAL(38,0),
                        20000000000000000000::DECIMAL(38,0), 0);
----
0	2

# Divisor fits in a uint64_t but not an int64_t
query II
SELECT decimal_division(9223372036854775808::DECIMAL(20,0),
                        18446744073709551614::DECIMAL(20,0), 0),
       decimal_division(27670116110564327421::DECIMAL(20,0),
                        18446744073709551614::DECIMAL(20,0), 0);
----
1	2

# Rounding can carry into an additional integer digit that does not fit the result width
statement error
SELECT decimal_division(9.99::DECIMAL(3,2), 0.1::DECIMAL(1,1), 0);
----
decimal_division: result out of range for result type

statement error
SELECT decimal_division(1.0::DECIMAL(4,1), 3.0::DECIMAL(4,1), -1);
----
<REGEX>:.*scale must be between.*

statement error
SELECT decimal_division(1.0::DECIMAL(4,1), 3.0::DECIMAL(4,1), 39);
----
<REGEX>:.*scale must be between.*

# Arguments in different physical tiers keep their types, so binding the plan again gives the same result type
# p1=19 s1=0 p2=10 s2=0: result_scale=max(6,0+10+1)=11, result_width=19-0+0+11=30 -> DECIMAL(30,11)
statement ok
CREATE TABLE dd(x DECIMAL(19,0), y DECIMAL(10,0));

statement ok
INSERT INTO dd VALUES (10, 4), (NULL, 4), (10, NULL), (-7, 2);

query II
SELECT decimal_division(x, y), typeof(decimal_division(x, y)) FROM dd ORDER BY x, y;
----
-3.50000000000	DECIMAL(30,11)
2.50000000000	DECIMAL(30,11)
NULL	DECIMAL(30,11)
NULL	DECIMAL(30,11)

# the narrower argument on the left: p1=10 s1=0 p2=19 s2=0: result_scale=max(6,0+19+1)=20, result_width=10+20=30
query II
SELECT decimal_division(y, x), typeof(decimal_division(y, x)) FROM dd WHERE x = 10 AND y = 4;
----
0.40000000000000000000	DECIMAL(30,20)

query I
SELECT decimal_division(x, y, 2) FROM dd WHERE x = 10 AND y = 4;
----
2.50

statement ok
EXPLAIN SELECT decimal_division(x, y) FROM dd;

statement ok
PREPARE dd_div AS SELECT decimal_division(x, y) FROM dd WHERE x = $1 AND y IS NOT NULL;

query I
EXECUTE dd_div(10);
----
2.50000000000

# every pair of tiers, as columns and as constants
statement ok
CREATE TABLE tiers(a DECIMAL(4,1), b DECIMAL(9,2), c DECIMAL(18,3), d DECIMAL(20,4));

statement ok
INSERT INTO tiers VALUES (12.5, 2.25, 3.125, 0.0625);

# a/b: scale=max(6,1+9+1)=11, width=4-1+2+11=16; a/c: scale=max(6,1+18+1)=20, width=4-1+3+20=26
# a/d: scale=max(6,1+20+1)=22, width=4-1+4+22=29
query III
SELECT decimal_division(a, b), decimal_division(a, c), decimal_division(a, d) FROM tiers;
----
5.55555555556	4.00000000000000000000	200.0000000000000000000000

query III
SELECT typeof(decimal_division(a, b)), typeof(decimal_division(a, c)), typeof(decimal_division(a, d)) FROM tiers;
----
DECIMAL(16,11)	DECIMAL(26,20)	DECIMAL(29,22)

# b/c: scale=max(6,2+18+1)=21, width=9-2+3+21=31; b/d: scale=max(6,2+20+1)=23, width=9-2+4+23=34
# c/d: scale=max(6,3+20+1)=24, width=18-3+4+24=43 > 38 -> error
query II
SELECT decimal_division(b, c), decimal_division(b, d) FROM tiers;
----
0.720000000000000000000	36.00000000000000000000000

statement error
SELECT decimal_division(c, d) FROM tiers;
----
<REGEX>:.*could not perform an accurate division.*

# the wider argument on the left: d/a: scale=max(6,4+4+1)=9, width=20-4+1+9=26; c/b: scale=max(6,3+9+1)=13, width=18-3+2+13=30
query IIII
SELECT decimal_division(d, a), typeof(decimal_division(d, a)), decimal_division(c, b), typeof(decimal_division(c, b)) FROM tiers;
----
0.005000000	DECIMAL(26,9)	1.3888888888889	DECIMAL(30,13)

query II
SELECT decimal_division(10::DECIMAL(19,0), 4::DECIMAL(10,0)), decimal_division(12.5::DECIMAL(4,1), 0.0625::DECIMAL(20,4));
----
2.50000000000	200.0000000000000000000000

statement ok
DROP TABLE dd;

statement ok
DROP TABLE tiers;
