# name: test/sql/optimizer/list_transform_row_group_pruning.test
# description: list_contains prunes row groups through list_transform
# group: [optimizer]

statement ok
ATTACH '{TEST_DIR}/list_transform_row_group_pruning.duckdb' AS db (ROW_GROUP_SIZE 2048);

statement ok
USE db;

statement ok
CREATE TABLE lists AS
SELECT [i] AS l, i % 2 AS c
FROM range(6144) tbl(i);

# a lambda that reads only the element keeps the min/max of the elements
query II
EXPLAIN ANALYZE SELECT count(*) FROM lists WHERE list_contains(list_transform(l, lambda x: x + 1), 3001);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM lists WHERE list_contains(list_transform(l, lambda x: x + 1), 3001);
----
1

query II
EXPLAIN ANALYZE SELECT count(*) FROM lists WHERE list_contains(list_transform(l, lambda x: 10000 - x), 7000);
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 3.*

query I
SELECT count(*) FROM lists WHERE list_contains(list_transform(l, lambda x: 10000 - x), 7000);
----
1

# a lambda that reads another column or the index finds its rows
query II
SELECT count(*) FILTER (WHERE list_contains(list_transform(l, lambda x: x + c), 3000)), count(*) FILTER (WHERE l[1] + c = 3000)
FROM lists
----
2	2

query I
SELECT count(*) FROM lists WHERE list_contains(list_transform(l, lambda x, i: x + i), 3001);
----
1
