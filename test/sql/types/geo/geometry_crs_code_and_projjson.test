# name: test/sql/types/geo/geometry_crs_code_and_projjson.test
# description: An AUTH:CODE CRS equals a PROJJSON or WKT2 CRS whose id is that code
# group: [geo]

require parquet

statement ok
SET VARIABLE projjson = '{"type":"GeographicCRS","name":"WGS 84","id":{"authority":"EPSG","code":4326}}';

query II
SELECT l::VARCHAR[], ST_CRS(l[1]) FROM (SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(3 4)'::GEOMETRY, getvariable('projjson'))] AS l);
----
['POINT (1 2)', 'POINT (3 4)']	EPSG:4326

# in both orders, and in a UNION ALL
query I
SELECT len([ST_SetCRS('POINT(3 4)'::GEOMETRY, getvariable('projjson')), ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326')]);
----
2

query I
SELECT ST_AsText(g) FROM (SELECT ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326') AS g UNION ALL SELECT ST_SetCRS('POINT(3 4)'::GEOMETRY, getvariable('projjson'))) ORDER BY 1;
----
POINT (1 2)
POINT (3 4)

# a table of either CRS takes a value of the other
statement ok
CREATE TABLE t (g GEOMETRY('{"type":"GeographicCRS","name":"WGS 84","id":{"authority":"EPSG","code":4326}}'));

statement ok
INSERT INTO t SELECT ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326');

statement ok
CREATE TABLE crs84 (g GEOMETRY('OGC:CRS84'));

statement ok
INSERT INTO crs84 SELECT ST_SetCRS('POINT(3 4)'::GEOMETRY, '{"type":"GeographicCRS","name":"WGS 84 (CRS84)","id":{"authority":"OGC","code":"CRS84"}}');

query II
SELECT ST_AsText(t.g), ST_AsText(crs84.g) FROM t, crs84;
----
POINT (1 2)	POINT (3 4)

# a GeoParquet file keeps the PROJJSON
statement ok
COPY (SELECT ST_SetCRS('POINT(1 2)'::GEOMETRY, getvariable('projjson')) AS g) TO '{TEST_DIR}/crs_code_and_projjson.parquet';

query I
SELECT [g, ST_SetCRS('POINT(3 4)'::GEOMETRY, 'EPSG:4326')]::VARCHAR[] FROM '{TEST_DIR}/crs_code_and_projjson.parquet';
----
['POINT (1 2)', 'POINT (3 4)']

# a WKT2 definition with that id
query I
SELECT len([ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(3 4)'::GEOMETRY, 'GEOGCRS["WGS 84",DATUM["World Geodetic System 1984",ELLIPSOID["WGS 84",6378137,298.257223563]],CS[ellipsoidal,2],AXIS["latitude",north],AXIS["longitude",east],ID["EPSG",4326]]')]);
----
2

# a different code, or a PROJJSON without an id, still differs
statement error
SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4269'), ST_SetCRS('POINT(3 4)'::GEOMETRY, getvariable('projjson'))];
----
Cannot cast GEOMETRY with CRS

statement error
SELECT [ST_SetCRS('POINT(1 2)'::GEOMETRY, 'EPSG:4326'), ST_SetCRS('POINT(3 4)'::GEOMETRY, '{"type":"GeographicCRS","name":"WGS 84"}')];
----
Cannot cast GEOMETRY with CRS
