# name: test/sql/types/variant/variant_list_functions.test
# description: List extraction and concatenation read a VARIANT as the list it holds, as its subscript does
# group: [variant]

statement ok
CREATE TABLE t AS SELECT [10, 20, 30]::VARIANT AS v;

statement ok
CREATE TABLE s AS SELECT 'hello'::VARCHAR::VARIANT AS v;

query IIIII
SELECT list_extract(v, 1), array_extract(v, 1), list_element(v, 2), v[1], typeof(list_extract(v, 1)) FROM t
----
10	10	20	10	VARIANT

query III
SELECT list_extract(v, -1), list_extract(v, 4), list_extract(v, NULL) FROM t
----
30	NULL	NULL

query I
SELECT list_extract(v, i) FROM t, range(1, 4) r(i) ORDER BY i
----
10
20
30

# a VARIANT that holds no list gives NULL, as its subscript does
query III
SELECT list_extract(v, 1), array_extract(v, 1), v[1] FROM s
----
NULL	NULL	NULL

query I
SELECT list_extract(NULL::VARIANT, 1)
----
NULL

query IIII
SELECT list_concat(v, v), array_concat(v, v), list_cat(v, [40::VARIANT]), list_concat(v, NULL) FROM t
----
[10, 20, 30, 10, 20, 30]	[10, 20, 30, 10, 20, 30]	[10, 20, 30, 40]	[10, 20, 30]

query I
SELECT [1] || v FROM t
----
[1, 10, 20, 30]

statement error
SELECT list_concat(v, v) FROM s
----
can't convert to 'VARIANT[]'

# the string functions keep reading a VARIANT as text
query III
SELECT concat(v, v), v || v, v || 'x' FROM s
----
hellohello	hellohello	hellox

query I
SELECT list_extract('hello', 1)
----
h
