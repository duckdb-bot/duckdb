# name: test/sql/catalog/system_functions/system_catalog_scanner_computed_columns.test
# description: duckdb_types() computes type_oid over the whole listing and does not prune it, duckdb_constraints() numbers constraint_index within a table and prunes
# group: [system_functions]

# The expected output names the default catalog 'memory'.
require noforcestorage

# duckdb_types: type_oid for a built-in type is its type id, shown once per listing and NULL for every later row with
# the same id, which marks an alias. The aliases int and integer share an id, and every catalog's main schema holds
# both, so only the first row in (catalog, schema, name) order shows it. A pruned listing would show it on a row that
# is NULL today, and which row that is would depend on the filters the optimizer pushes, so duckdb_types() does not
# prune its listing.
# lower() because binding a type recases the temp catalog's entry after the name used in the lookup. The catalogs are
# named because a test config may attach another one.
query III
SELECT database_name, lower(type_name), type_oid FROM duckdb_types() WHERE lower(type_name) IN ('int', 'integer') AND database_name IN ('memory', 'system', 'temp') ORDER BY ALL;
----
memory	int	13
memory	integer	NULL
system	int	NULL
system	integer	NULL
temp	int	NULL
temp	integer	NULL

statement ok
ATTACH ':memory:' AS aaa;

query III
SELECT database_name, lower(type_name), type_oid FROM duckdb_types() WHERE lower(type_name) = 'int' AND database_name IN ('aaa', 'memory', 'system', 'temp') ORDER BY ALL;
----
aaa	int	13
memory	int	NULL
system	int	NULL
temp	int	NULL

query III
SELECT database_name, lower(type_name), type_oid FROM duckdb_types() WHERE lower(type_name) IN ('int', 'integer') AND database_name = 'system' ORDER BY ALL;
----
system	int	NULL
system	integer	NULL

query II
EXPLAIN SELECT type_name FROM duckdb_types() WHERE database_name = 'system';
----
physical_plan	<!REGEX>:.*Filters:.*

# duckdb_constraints: constraint_index is the position of the constraint within its table, in the order of the
# table's constraints, so it does not depend on the other tables of the listing. pg_constraint.oid encodes it next to
# table_oid and pg_get_constraintdef() decodes it, a round trip a pruned scan keeps.
statement ok
CREATE TABLE a(i INTEGER PRIMARY KEY, j INTEGER CHECK (j > 0));

statement ok
CREATE TABLE b(x INTEGER UNIQUE, y INTEGER REFERENCES a(i));

statement ok
CREATE SCHEMA s;

statement ok
CREATE TABLE s.c(k INTEGER NOT NULL);

query III
SELECT table_name, constraint_index, constraint_type FROM duckdb_constraints() WHERE database_name = current_database() ORDER BY table_name, constraint_index;
----
a	0	PRIMARY KEY
a	1	CHECK
a	2	NOT NULL
b	0	UNIQUE
b	1	FOREIGN KEY
c	0	NOT NULL

query III
SELECT table_name, constraint_index, constraint_type FROM duckdb_constraints() WHERE database_name = current_database() AND table_name = 'b' ORDER BY constraint_index;
----
b	0	UNIQUE
b	1	FOREIGN KEY

query I
SELECT pg_get_constraintdef((SELECT oid FROM pg_catalog.pg_constraint WHERE conrelid = (SELECT oid FROM pg_catalog.pg_class WHERE relname = 'b') AND contype = 'f'));
----
FOREIGN KEY (y) REFERENCES a(i)

# the decode of pg_get_constraintdef pins the table when the oid is a constant, so it lists only that table's
# constraints (a scalar subquery as the argument is planned as a join and does not reach the scan as a filter)
statement ok
SET VARIABLE b_fk_oid = (SELECT oid FROM pg_catalog.pg_constraint WHERE conrelid = (SELECT oid FROM pg_catalog.pg_class WHERE relname = 'b') AND contype = 'f');

query I
SELECT pg_get_constraintdef(getvariable('b_fk_oid'));
----
FOREIGN KEY (y) REFERENCES a(i)

query II
EXPLAIN ANALYZE SELECT pg_get_constraintdef(getvariable('b_fk_oid'));
----
analyzed_plan	<REGEX>:.*Filters: table_oid = \d+.*Entries Scanned: 1/.*

# a referencing table adds a hidden constraint to the referenced table, which is not listed and does not number
statement ok
CREATE TABLE d(z INTEGER REFERENCES a(i));

query III
SELECT table_name, constraint_index, constraint_type FROM duckdb_constraints() WHERE database_name = current_database() AND table_name IN ('a', 'd') ORDER BY table_name, constraint_index;
----
a	0	PRIMARY KEY
a	1	CHECK
a	2	NOT NULL
d	0	FOREIGN KEY
