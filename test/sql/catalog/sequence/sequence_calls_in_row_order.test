# name: test/sql/catalog/sequence/sequence_calls_in_row_order.test
# description: nextval, setval and currval in one select list see each other in the order of the rows (duckdblabs/bot-issue-tracker#556)
# group: [sequence]

statement ok
CREATE SEQUENCE seq;

query II
SELECT x, CASE WHEN x THEN nextval('seq') ELSE currval('seq') END AS y FROM unnest([1, 0, 1, 0, 1, 0]) _(x);
----
1	1
0	1
1	2
0	2
1	3
0	3

# the columns of a row are evaluated from left to right
statement ok
CREATE SEQUENCE s2;

query III
SELECT i, nextval('s2') AS n, currval('s2') AS c FROM range(4) t(i);
----
0	1	1
1	2	2
2	3	3
3	4	4

statement ok
CREATE SEQUENCE s3;

query II
SELECT nextval('s3') AS a, nextval('s3') AS b FROM range(3);
----
1	2
3	4
5	6

statement ok
CREATE SEQUENCE s4;

query II
SELECT x, CASE WHEN x = 0 THEN setval('s4', 10) ELSE nextval('s4') END FROM unnest([1, 0, 1]) _(x);
----
1	1
0	10
1	11

# a currval before any nextval of the session fails as in the first row
statement ok
CREATE SEQUENCE s5;

statement error
SELECT CASE WHEN x = 1 THEN nextval('s5') ELSE currval('s5') END FROM unnest([0, 1, 0, 1]) _(x);
----
currval: sequence is not yet defined in this session

# more rows than a vector
statement ok
CREATE SEQUENCE s6;

query III
SELECT count(*), sum(n - c), max(n) FROM (SELECT nextval('s6') AS n, currval('s6') AS c FROM range(5000));
----
5000	0	5000

# a single nextval hands out its values as before
statement ok
CREATE SEQUENCE s7;

query II
SELECT count(*), max(n) FROM (SELECT nextval('s7') AS n FROM range(5000));
----
5000	5000
