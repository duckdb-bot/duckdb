# name: test/sql/aggregate/group/group_by_all_order_by_group_expression.test
# description: With GROUP BY ALL, ORDER BY and DISTINCT ON expressions can use the groups of the SELECT list
# group: [group]

statement ok
CREATE TABLE df AS SELECT ['aBc', 'Abd', 'abe'][x % 3 + 1] AS name, x FROM range(0, 6) r(x);

query II
SELECT name, sum(x) FROM df GROUP BY ALL ORDER BY lower(name) DESC;
----
abe	7
Abd	5
aBc	3

# qualified, and through the alias of the group
query II
SELECT df.name AS n, sum(x) FROM df GROUP BY ALL ORDER BY lower(df.name);
----
aBc	3
Abd	5
abe	7

query II
SELECT name AS n, sum(x) FROM df GROUP BY ALL ORDER BY lower(n) DESC;
----
abe	7
Abd	5
aBc	3

# the group is an expression of the SELECT list
query II
SELECT upper(name) AS u, count(*) FROM df GROUP BY ALL ORDER BY right(upper(name), 1) DESC;
----
ABE	2
ABD	2
ABC	2

# multiple ORDER BY expressions
query II
SELECT name, sum(x) FROM df GROUP BY ALL ORDER BY name[1], lower(name) DESC;
----
Abd	5
abe	7
aBc	3

query II
SELECT DISTINCT ON (name[1]) name, sum(x) FROM df GROUP BY ALL ORDER BY name[1], name;
----
Abd	5
aBc	3

# the expression can also mix groups and aggregates
query II
SELECT name, sum(x) FROM df GROUP BY ALL ORDER BY ascii(name[2]) + sum(x);
----
aBc	3
Abd	5
abe	7

# a column that is not a group is still an error
statement error
SELECT upper(name), sum(x) FROM df GROUP BY ALL ORDER BY lower(name);
----
must appear in the GROUP BY clause

statement error
SELECT name, sum(x) FROM df GROUP BY ALL ORDER BY x;
----
must appear in the GROUP BY clause

# with a collated group, ORDER BY over it still binds to the group
statement ok
CREATE TABLE collated (name VARCHAR COLLATE NOCASE, x INTEGER);

statement ok
INSERT INTO collated VALUES ('B', 3), ('a', 1), ('a', 2);

query II
SELECT name, sum(x) FROM collated GROUP BY ALL ORDER BY lower(name);
----
a	3
B	3

# ORDER BY reads the selected value of a collated group, not its collation key
query II
SELECT name, sum(x) FROM collated GROUP BY ALL ORDER BY unicode(name);
----
B	3
a	3

query II
SELECT DISTINCT ON (unicode(name) < 90) name, count(*) FROM collated GROUP BY ALL ORDER BY unicode(name) < 90, name;
----
a	2
B	1

# a collated group with a subquery
query II
SELECT (SELECT name) AS k, count(*) FROM collated GROUP BY ALL ORDER BY unicode((SELECT name));
----
B	1
a	2

query III
SELECT name AS n, (SELECT n) AS k, count(*) FROM collated GROUP BY ALL ORDER BY unicode(name);
----
B	B	1
a	a	2

statement ok
PREPARE p AS SELECT name || $1::VARCHAR AS k, count(*) FROM collated GROUP BY ALL ORDER BY unicode(name || $1::VARCHAR);

query II
EXECUTE p('x');
----
Bx	1
ax	2

query II
EXECUTE p('y');
----
By	1
ay	2

# a column of HAVING that is not in the SELECT list is a group too, with and without an ORDER BY expression
query II
SELECT s, count(*) FROM (VALUES ('a', 'p'), ('a', 'q'), ('b', 'r')) t(s, y)
GROUP BY ALL HAVING y > 'a' ORDER BY lower(s), count(*);
----
a	1
a	1
b	1

query II
SELECT s, count(*) FROM (VALUES ('a', 'p'), ('a', 'q'), ('b', 'r')) t(s, y)
GROUP BY ALL HAVING y > 'a' ORDER BY s;
----
a	1
a	1
b	1
