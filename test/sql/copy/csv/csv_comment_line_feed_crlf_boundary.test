query II
SELECT count(*), list(a ORDER BY a) FROM read_csv('{TEST_DIR}/comment_crlf_boundary.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = 18);
