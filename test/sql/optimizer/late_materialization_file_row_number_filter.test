# name: test/sql/optimizer/late_materialization_file_row_number_filter.test
# description: Late materialization of a Parquet scan below a filter that already reads file_row_number
# group: [optimizer]

require parquet

statement ok
COPY (SELECT i AS id, i % 2 AS a, 100 + i % 3 AS b FROM range(2000) r(i)) TO '{TEMP_DIR}/late_materialization_row_number.parquet';

statement ok
SET prefer_range_joins = true;

# a Parquet scan has two row id columns, the index of the file and the row number in the file
query I
SELECT a FROM '{TEMP_DIR}/late_materialization_row_number.parquet' WHERE id + 1 > file_row_number LIMIT 1 OFFSET 0;
----
0

query II
SELECT a, b FROM '{TEMP_DIR}/late_materialization_row_number.parquet' WHERE id + 1 > file_row_number LIMIT 2 OFFSET 3;
----
1	100
0	101

query II
SELECT a, b FROM '{TEMP_DIR}/late_materialization_row_number.parquet' WHERE id + 1 > file_row_number ORDER BY id DESC LIMIT 2;
----
1	101
0	100

query II
SELECT a, b FROM read_parquet(['{TEMP_DIR}/late_materialization_row_number.parquet', '{TEMP_DIR}/late_materialization_row_number.parquet']) WHERE id + 1 > file_row_number ORDER BY id DESC, b LIMIT 3;
----
1	101
1	101
0	100

query II
SELECT a, b FROM '{TEMP_DIR}/late_materialization_row_number.parquet' WHERE b + id > file_row_number + 101 LIMIT 2 OFFSET 1;
----
1	102
0	102
