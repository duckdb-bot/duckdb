# name: test/sql/prepared/prepared_verification_deferred_binding.test
# description: The prepared statement verification keeps ORDER BY positions and navigation offsets constant when the binding waits for the values
# group: [prepared]

statement ok
SET debug_verify_statement = 'prepared_statement';

statement ok
CREATE TABLE t (x INTEGER);

statement ok
INSERT INTO t VALUES (1), (2);

# the VALUES parameters leave the statement unbound until the values are known, the ORDER BY position is no parameter
query I
SELECT x FROM (VALUES (1), (2)) v(x) ORDER BY 1;
----
1
2

query I
SELECT * FROM (SELECT x FROM (VALUES (2), (1)) v(x) ORDER BY 1 LIMIT 1);
----
1

# a constant in a pivot expression
query I
SELECT * FROM t PIVOT(count(*) FOR (x + 1) IN (2)) ORDER BY 1;
----
1

# the offset of a navigation function is bound with the value
query I
SELECT v FROM (VALUES (1), (2)) v(x) MATCH_RECOGNIZE (ORDER BY x MEASURES LAST(x, 1) AS v ONE ROW PER MATCH PATTERN (A+) DEFINE A AS true);
----
1

# a statement without such positions runs as a prepared statement
query I
SELECT x + 1 FROM t ORDER BY x LIMIT 1;
----
2
