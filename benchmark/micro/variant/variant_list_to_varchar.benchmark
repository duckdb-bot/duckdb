# name: benchmark/micro/variant/variant_list_to_varchar.benchmark
# description: Cast VARIANT lists of integers to VARCHAR
# group: [variant]

name variant_list_to_varchar
group variant

load
CREATE TABLE tbl AS SELECT [i, i + 1, i + 2]::VARIANT AS v FROM range(200000) t(i);

run
SELECT count(*), max(length(v::VARCHAR)) FROM tbl;

result II
200000	24
