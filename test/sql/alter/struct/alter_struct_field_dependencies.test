# name: test/sql/alter/struct/alter_struct_field_dependencies.test
# description: An ALTER of a struct field registers what the new default of the column depends on
# group: [struct]

load {TEST_DIR}/alter_struct_field_dependencies.db

# a macro in the default of an added field
statement ok
CREATE MACRO mc() AS 7;

statement ok
CREATE TABLE m (i INT, s STRUCT(x INT) DEFAULT {'x': 1});

statement ok
ALTER TABLE m ADD COLUMN s.c INTEGER DEFAULT mc();

statement error
DROP MACRO mc;
----
table "m" depends on macro function "mc"

# a user type in the default of an added field
statement ok
CREATE TYPE e AS ENUM ('a', 'b');

statement ok
CREATE TABLE t (i INT, s STRUCT(x INT) DEFAULT {'x': 1});

statement ok
ALTER TABLE t ADD COLUMN s.c e DEFAULT 'a'::e;

statement error
DROP TYPE e;
----
table "t" depends on type "e"

statement ok
INSERT INTO t (i) VALUES (1);

statement ok
INSERT INTO t VALUES (2, {'x': 2, 'c': 'b'});

# the checkpoint writes the macro before the table that needs it, and the file opens again
restart

query II
SELECT * FROM t ORDER BY i;
----
1	{'x': 1, 'c': a}
2	{'x': 2, 'c': b}

statement ok
INSERT INTO m (i) VALUES (1);

query II
SELECT * FROM m;
----
1	{'x': 1, 'c': 7}

statement error
DROP MACRO mc;
----
table "m" depends on macro function "mc"

statement error
DROP TYPE e;
----
table "t" depends on type "e"

# a rename of another field keeps the default and what it depends on
statement ok
ALTER TABLE m RENAME COLUMN s.x TO y;

statement error
DROP MACRO mc;
----
table "m" depends on macro function "mc"

statement ok
INSERT INTO m (i) VALUES (2);

query II
SELECT * FROM m ORDER BY i;
----
1	{'y': 1, 'c': 7}
2	{'y': 1, 'c': 7}

# the default of the column still calls the macro after the field is gone
statement ok
ALTER TABLE m DROP COLUMN s.c;

statement error
DROP MACRO mc;
----
table "m" depends on macro function "mc"

statement ok
INSERT INTO m (i) VALUES (3);

# a new default releases the macro
statement ok
ALTER TABLE m ALTER s SET DEFAULT {'y': 0};

statement ok
DROP MACRO mc;

statement ok
INSERT INTO m (i) VALUES (4);

# the type of a field that was removed can be dropped
statement ok
CREATE TYPE o AS ENUM ('a', 'b');

statement ok
CREATE TABLE r (i INT, s STRUCT(x INT, c o));

statement ok
INSERT INTO r VALUES (1, {'x': 1, 'c': 'a'});

statement ok
ALTER TABLE r DROP COLUMN s.c;

statement ok
DROP TYPE o;

restart

query II
SELECT * FROM m ORDER BY i;
----
1	{'y': 1}
2	{'y': 1}
3	{'y': 1}
4	{'y': 0}

query II
SELECT * FROM r;
----
1	{'x': 1}

# a macro that the default of a nested field calls
statement ok
CREATE MACRO deep() AS 'deep';

statement ok
CREATE TABLE n (i INT, s STRUCT(x STRUCT(a INT), b INT) DEFAULT {'x': {'a': 1}, 'b': 2});

statement ok
ALTER TABLE n ADD COLUMN s.x.c VARCHAR DEFAULT deep();

statement error
DROP MACRO deep;
----
table "n" depends on macro function "deep"

restart

statement ok
INSERT INTO n (i) VALUES (1);

query II
SELECT * FROM n;
----
1	{'x': {'a': 1, 'c': deep}, 'b': 2}
