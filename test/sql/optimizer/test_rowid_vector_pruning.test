# name: test/sql/optimizer/test_rowid_vector_pruning.test
# description: Scans with row id filters only read the vectors that hold the row ids (duckdblabs/bot-issue-tracker#549)
# group: [optimizer]

require json

load {TEST_DIR}/rowid_vector_pruning.db

statement ok
SET threads = 1

# 300000 rows in three row groups, row id i holds k = (i * 7919) % 300000 and g = 'geom i'
statement ok
CREATE TABLE r (k BIGINT PRIMARY KEY, g VARCHAR, risk BIGINT, zone VARCHAR, score DOUBLE);

statement ok
INSERT INTO r SELECT (i * 7919) % 300000, 'geom ' || i, i % 7, 'zone ' || (i % 13), i * 0.5 FROM range(300000) t(i);

statement ok
CHECKPOINT;

statement ok
SET enable_profiling = 'json'

statement ok
SET tracked_metrics = ['query.total_rows_scanned']

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_in.json'

# row ids at the edges of vectors and row groups
query II
SELECT rowid, g FROM r WHERE rowid IN (2047, 2048, 122879, 122880, 299999) ORDER BY rowid
----
2047	geom 2047
2048	geom 2048
122879	geom 122879
122880	geom 122880
299999	geom 299999

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_late.json'

# late materialization finds the three row ids with the index, then scans the vectors that hold them
query IIIII
SELECT k, risk, zone, score, length(g) AS d FROM r WHERE k BETWEEN 4242 AND 4300 ORDER BY d DESC, k LIMIT 3
----
4242	3	zone 11	147159.0	11
4243	2	zone 6	105998.5	11
4244	1	zone 1	64838.0	11

statement ok
PRAGMA disable_profiling

# both scans read a few vectors instead of whole row groups
query I
SELECT query.total_rows_scanned < 122880 FROM '{TEST_DIR}/rowid_vector_pruning_in.json'
----
true

query I
SELECT query.total_rows_scanned < 122880 FROM '{TEST_DIR}/rowid_vector_pruning_late.json'
----
true

# one row group whose last vector is partial, row id i holds v = i
statement ok
CREATE TABLE s AS SELECT i AS v, 'pad ' || i AS pad FROM range(100001) t(i);

statement ok
SET enable_profiling = 'json'

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_first.json'

query I
SELECT v FROM s WHERE rowid = 0
----
0

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_first_last.json'

query I
SELECT v FROM s WHERE rowid IN (0, 100000) ORDER BY v
----
0
100000

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_late_first.json'

query II
SELECT v, pad FROM s ORDER BY abs(v - 50000) DESC, v LIMIT 1
----
0	pad 0

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_late_first_last.json'

query II
SELECT v, pad FROM s ORDER BY abs(v - 50000) DESC, v LIMIT 2
----
0	pad 0
100000	pad 100000

statement ok
PRAGMA disable_profiling

# a row id in the first vector skips the partial last vector too, a row id in the last vector reads it
query II
SELECT one_id.query.total_rows_scanned < two_ids.query.total_rows_scanned,
       late_one_id.query.total_rows_scanned < late_two_ids.query.total_rows_scanned
FROM '{TEST_DIR}/rowid_vector_pruning_first.json' one_id,
     '{TEST_DIR}/rowid_vector_pruning_first_last.json' two_ids,
     '{TEST_DIR}/rowid_vector_pruning_late_first.json' late_one_id,
     '{TEST_DIR}/rowid_vector_pruning_late_first_last.json' late_two_ids
----
true	true

# segment zonemaps also skip a partial last vector, so a table with one scans as much as the table without it
statement ok
SET force_compression = 'uncompressed'

statement ok
CREATE TABLE seg_partial AS SELECT i AS x, {'a': i} AS st FROM range(100001) t(i);

statement ok
CREATE TABLE seg_aligned AS SELECT i AS x, {'a': i} AS st FROM range(98304) t(i);

statement ok
CHECKPOINT

statement ok
RESET force_compression

statement ok
SET enable_profiling = 'json'

foreach tbl seg_partial seg_aligned

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_{tbl}_x.json'

query I
SELECT count(*) FROM {tbl} WHERE x < 10
----
10

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_{tbl}_st.json'

query I
SELECT count(*) FROM {tbl} WHERE st.a < 10
----
10

endloop

statement ok
PRAGMA disable_profiling

query II
SELECT partial_x.query.total_rows_scanned = aligned_x.query.total_rows_scanned,
       partial_st.query.total_rows_scanned = aligned_st.query.total_rows_scanned
FROM '{TEST_DIR}/rowid_vector_pruning_seg_partial_x.json' partial_x,
     '{TEST_DIR}/rowid_vector_pruning_seg_aligned_x.json' aligned_x,
     '{TEST_DIR}/rowid_vector_pruning_seg_partial_st.json' partial_st,
     '{TEST_DIR}/rowid_vector_pruning_seg_aligned_st.json' aligned_st
----
true	true

# with prefetching, late materialization reads the blocks of one vector instead of its whole row group
statement ok
CREATE TABLE p (k BIGINT PRIMARY KEY, o BIGINT, s VARCHAR);

statement ok
INSERT INTO p SELECT i, i % 1000, md5(i::VARCHAR) || md5((i + 1)::VARCHAR) FROM range(245760) t(i);

statement ok
CHECKPOINT;

restart

statement ok
SET threads = 1

statement ok
SET storage_block_prefetch = 'debug_force_always'

statement ok
SET enable_profiling = 'json'

statement ok
SET tracked_metrics = ['io.total_bytes_read']

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_prefetch_late.json'

query I
SELECT s FROM p WHERE k = 122881 ORDER BY o LIMIT 1
----
506995c3dc5272bbfb3321c48ef268ff71452dbcef3372bb549d6385d9566ee5

restart

statement ok
SET threads = 1

statement ok
SET storage_block_prefetch = 'debug_force_always'

statement ok
SET enable_profiling = 'json'

statement ok
SET tracked_metrics = ['io.total_bytes_read']

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_prefetch_group.json'

query I
SELECT count(DISTINCT s) FROM p WHERE rowid >= 122880
----
122880

# row ids in the first and the last vector of a row group prefetch the vectors between them as well
restart

statement ok
SET threads = 1

statement ok
SET storage_block_prefetch = 'debug_force_always'

statement ok
SET enable_profiling = 'json'

statement ok
SET tracked_metrics = ['io.total_bytes_read']

statement ok
SET profiling_output = '{TEST_DIR}/rowid_vector_pruning_prefetch_range.json'

query I
SELECT s FROM p WHERE rowid IN (122881, 245759) ORDER BY rowid
----
506995c3dc5272bbfb3321c48ef268ff71452dbcef3372bb549d6385d9566ee5
16d1463e014629c4db37dfbc739a1cfc54251033b4966af2e59dff7330afed9d

statement ok
PRAGMA disable_profiling

query II
SELECT late.io.total_bytes_read < row_group.io.total_bytes_read, two_ids.io.total_bytes_read >= row_group.io.total_bytes_read
FROM '{TEST_DIR}/rowid_vector_pruning_prefetch_late.json' late,
     '{TEST_DIR}/rowid_vector_pruning_prefetch_group.json' row_group,
     '{TEST_DIR}/rowid_vector_pruning_prefetch_range.json' two_ids
----
true	true
