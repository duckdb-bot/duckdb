# name: test/sql/copy/csv/csv_empty_line_buffer_boundary.test
# description: Empty lines at a buffer boundary are read the same way by every thread, and keep the lines and byte positions of the rows behind them
# group: [csv]

# two rows, one empty line, two rows, in a \n file and in a \r\n file
statement ok
COPY (SELECT '1,5' || chr(10) || '2,6' || chr(10) || chr(10) || '3,7' || chr(10) || '4,8') TO '{TEST_DIR}/empty_line_lf.csv' (HEADER false, QUOTE '', DELIM '|');

statement ok
COPY (SELECT '1,5' || chr(13) || chr(10) || '2,6' || chr(13) || chr(10) || chr(13) || chr(10) || '3,7' || chr(13) || chr(10) || '4,8' || chr(13)) TO '{TEST_DIR}/empty_line_crlf.csv' (HEADER false, QUOTE '', DELIM '|');

# five empty lines
statement ok
COPY (SELECT '1,5' || chr(10) || '2,6' || repeat(chr(10), 6) || '3,7' || chr(10) || '4,8') TO '{TEST_DIR}/empty_lines_lf.csv' (HEADER false, QUOTE '', DELIM '|');

statement ok
COPY (SELECT '1,5' || chr(13) || chr(10) || '2,6' || repeat(chr(13) || chr(10), 6) || '3,7' || chr(13) || chr(10) || '4,8' || chr(13)) TO '{TEST_DIR}/empty_lines_crlf.csv' (HEADER false, QUOTE '', DELIM '|');

foreach file empty_line_lf empty_line_crlf empty_lines_lf empty_lines_crlf

foreach parallel true false

foreach errors ignore_errors=false ignore_errors=true

loop buffer_size 6 31

query II
SELECT list(a ORDER BY a), list(b ORDER BY b) FROM read_csv('{TEST_DIR}/{file}.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', header = false, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = {buffer_size}, parallel = {parallel}, {errors});
----
[1, 2, 3, 4]	[5, 6, 7, 8]

endloop

endloop

endloop

endloop

# a reject behind five empty lines keeps its line and byte position, in a \n file
statement ok
COPY (SELECT '1,5' || chr(10) || '2,6' || repeat(chr(10), 6) || 'x,7' || chr(10) || '3,8' || chr(10) || '4,9') TO '{TEST_DIR}/empty_lines_reject_lf.csv' (HEADER false, QUOTE '', DELIM '|');

loop buffer_size 6 27

query II
SELECT a, b FROM read_csv('{TEST_DIR}/empty_lines_reject_lf.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\n', header = false, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = {buffer_size}, store_rejects = true, rejects_table = 'rej_lf_{buffer_size}', rejects_scan = 'scan_lf_{buffer_size}') ORDER BY ALL;
----
1	5
2	6
3	8
4	9

query II
SELECT line, byte_position FROM rej_lf_{buffer_size};
----
8	14

endloop

# the same in a \r\n file
statement ok
COPY (SELECT '1,5' || chr(13) || chr(10) || '2,6' || repeat(chr(13) || chr(10), 6) || 'x,7' || chr(13) || chr(10) || '3,8' || chr(13) || chr(10) || '4,9' || chr(13)) TO '{TEST_DIR}/empty_lines_reject_crlf.csv' (HEADER false, QUOTE '', DELIM '|');

loop buffer_size 6 18

query II
SELECT a, b FROM read_csv('{TEST_DIR}/empty_lines_reject_crlf.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', header = false, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = {buffer_size}, store_rejects = true, rejects_table = 'rej_crlf_{buffer_size}', rejects_scan = 'scan_crlf_{buffer_size}') ORDER BY ALL;
----
1	5
2	6
3	8
4	9

query II
SELECT line, byte_position FROM rej_crlf_{buffer_size};
----
8	21

endloop

loop buffer_size 19 31

query II
SELECT a, b FROM read_csv('{TEST_DIR}/empty_lines_reject_crlf.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', header = false, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = {buffer_size}, store_rejects = true, rejects_table = 'rej_crlf_{buffer_size}', rejects_scan = 'scan_crlf_{buffer_size}') ORDER BY ALL;
----
1	5
2	6
3	8
4	9

query II
SELECT line, byte_position FROM rej_crlf_{buffer_size};
----
8	21

endloop

# FIXME: with a buffer of 18 bytes the reject row starts a thread's range and the range is lost with store_rejects, as on main
mode skip

query II
SELECT a, b FROM read_csv('{TEST_DIR}/empty_lines_reject_crlf.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', header = false, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = 18, store_rejects = true, rejects_table = 'rej_crlf_18', rejects_scan = 'scan_crlf_18') ORDER BY ALL;
----
1	5
2	6
3	8
4	9

mode unskip

# an empty line at the start of a range inside a buffer, ranges of 16 bytes in buffers of 64 bytes
statement ok
COPY (SELECT string_agg(CASE WHEN i = 4 THEN '' ELSE (i % 9 + 1) || ',' || (i * 2 % 9 + 1) END, chr(10) ORDER BY i) FROM range(32) t(i)) TO '{TEST_DIR}/empty_line_range_lf.csv' (HEADER false, QUOTE '', DELIM '|');

query III
SELECT count(*), sum(a), sum(b) FROM read_csv('{TEST_DIR}/empty_line_range_lf.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\n', header = false, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = 64, max_line_size = 16);
----
31	145	151

statement ok
COPY (SELECT string_agg(CASE WHEN i = 3 THEN '' ELSE (i % 9 + 1) || ',' || (i * 2 % 9 + 1) END, chr(13) || chr(10) ORDER BY i) || chr(13) FROM range(31) t(i)) TO '{TEST_DIR}/empty_line_range_crlf.csv' (HEADER false, QUOTE '', DELIM '|');

query III
SELECT count(*), sum(a), sum(b) FROM read_csv('{TEST_DIR}/empty_line_range_crlf.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', header = false, columns = {'a': 'INTEGER', 'b': 'INTEGER'}, buffer_size = 64, max_line_size = 16);
----
30	141	144

# an empty line of a single column file is a NULL, at every buffer size
statement ok
COPY (SELECT '1' || chr(10) || '1' || chr(10) || chr(10) || '1' || chr(10) || '1') TO '{TEST_DIR}/empty_line_single_lf.csv' (HEADER false, QUOTE '', DELIM '|');

loop buffer_size 4 15

query II
SELECT count(*), count(a) FROM read_csv('{TEST_DIR}/empty_line_single_lf.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\n', header = false, columns = {'a': 'INTEGER'}, buffer_size = {buffer_size});
----
5	4

endloop
