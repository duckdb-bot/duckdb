# name: test/sql/copy/parquet/writer/parquet_write_interval.test
# description: Parquet interval round trip
# group: [writer]

statement ok
SET default_null_order='nulls_first';

require parquet

statement ok
CREATE TABLE IF NOT EXISTS intervals (i interval);

statement ok
INSERT INTO intervals VALUES
       (interval '1' day),
       (interval '00:00:01'),
       (NULL),
       (interval '0' month),
       (interval '1' month)

statement ok
COPY intervals TO '{TEST_DIR}/intervals.parquet'

query I
SELECT * FROM '{TEST_DIR}/intervals.parquet' ORDER BY 1
----
NULL
00:00:00
00:00:01
1 day
1 month

statement error
COPY (SELECT -interval '1 day') TO '{TEST_DIR}/intervals.parquet'
----
<REGEX>:.*IO Error.*do not support negative intervals.*

# Store complete days from a large microseconds component in Parquet's days field.
statement ok
COPY (SELECT INTERVAL '580063 hours 44 minutes 54 seconds' AS i) TO '{TEST_DIR}/large_interval.parquet'

query IIIIII
SELECT i = INTERVAL '580063 hours 44 minutes 54 seconds',
       datepart('month', i),
       datepart('day', i),
       datepart('hour', i),
       datepart('minute', i),
       datepart('second', i)
FROM '{TEST_DIR}/large_interval.parquet'
----
true	0	24169	7	44	54

# Intervals whose microseconds fit in the milliseconds field keep their days/micros split.
statement ok
COPY (SELECT INTERVAL 720 HOUR AS i, INTERVAL 36 HOUR AS j) TO '{TEST_DIR}/split_interval.parquet'

query TIITII
SELECT i::VARCHAR, datepart('day', i), datepart('hour', i), j::VARCHAR, datepart('day', j), datepart('hour', j)
FROM '{TEST_DIR}/split_interval.parquet'
----
720:00:00	0	720	36:00:00	0	36

# The milliseconds field keeps the time part up to its 32 bit limit, next to days and months
statement ok
COPY (
	SELECT * FROM (VALUES
		(1, INTERVAL '1193 hours 2 minutes 47.295 seconds'),
		(2, INTERVAL '1193 hours 2 minutes 47.296 seconds'),
		(3, INTERVAL '1 day 25 hours'),
		(4, INTERVAL '1 month 36 hours')
	) t(id, i)
) TO '{TEST_DIR}/interval_time_part.parquet' (DICTIONARY_SIZE_LIMIT 1000)

query II
SELECT id, i FROM '{TEST_DIR}/interval_time_part.parquet' ORDER BY id
----
1	1193:02:47.295
2	49 days 17:02:47.296
3	1 day 25:00:00
4	1 month 36:00:00

# also without a dictionary, and nested in lists and structs
statement ok
COPY (
	SELECT id, i, [i] AS l, {'i': i} AS s FROM '{TEST_DIR}/interval_time_part.parquet'
) TO '{TEST_DIR}/interval_time_part_plain.parquet' (DICTIONARY_SIZE_LIMIT 1)

query IIII
SELECT id, i, l, s FROM '{TEST_DIR}/interval_time_part_plain.parquet' ORDER BY id
----
1	1193:02:47.295	['1193:02:47.295']	{'i': '1193:02:47.295'}
2	49 days 17:02:47.296	['49 days 17:02:47.296']	{'i': '49 days 17:02:47.296'}
3	1 day 25:00:00	['1 day 25:00:00']	{'i': '1 day 25:00:00'}
4	1 month 36:00:00	['1 month 36:00:00']	{'i': '1 month 36:00:00'}

# the bloom filter holds the normalized interval, so equal intervals written another way find the rows
query I
SELECT bool_or(bloom_filter_excludes) FROM parquet_bloom_probe('{TEST_DIR}/interval_time_part.parquet', 'i', INTERVAL '2 days 1 hour')
----
false

query I
SELECT bool_and(bloom_filter_excludes) FROM parquet_bloom_probe('{TEST_DIR}/interval_time_part.parquet', 'i', INTERVAL '3 days')
----
true

query I
SELECT id FROM '{TEST_DIR}/interval_time_part.parquet' WHERE i = INTERVAL '2 days 1 hour'
----
3

query I
SELECT id FROM '{TEST_DIR}/interval_time_part.parquet' WHERE i = INTERVAL '1 month 1 day 12 hours'
----
4
