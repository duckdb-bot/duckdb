# name: test/issues/general/test_26066.test
# description: Rows of an INSERT with ON CONFLICT whose conflict key holds a NULL conflict with no row, so all are inserted
# group: [general]

statement ok
CREATE TABLE t (id INTEGER, val INTEGER UNIQUE);

statement ok
INSERT INTO t (id, val) VALUES (1, NULL), (2, NULL) ON CONFLICT (val) DO NOTHING;

query II
SELECT * FROM t ORDER BY id;
----
1	NULL
2	NULL

statement ok
INSERT INTO t VALUES (3, NULL), (4, 5), (5, 5), (6, NULL) ON CONFLICT (val) DO UPDATE SET id = excluded.id;

query II
SELECT count(*), count(val) FROM t;
----
5	1

statement ok
INSERT OR IGNORE INTO t VALUES (7, NULL), (8, NULL), (9, 5);

statement ok
INSERT OR REPLACE INTO t VALUES (10, NULL), (11, NULL);

query II
SELECT count(*), count(val) FROM t;
----
9	1

# a composite key with a NULL part, next to duplicates without NULLs, and a key on two constraints
statement ok
CREATE TABLE c (a INTEGER, b INTEGER, d INTEGER UNIQUE, UNIQUE (a, b));

statement ok
INSERT INTO c VALUES (1, NULL, NULL), (1, NULL, NULL), (1, 2, 3), (1, 2, 3) ON CONFLICT DO NOTHING;

query III
SELECT * FROM c ORDER BY ALL;
----
1	2	3
1	NULL	NULL
1	NULL	NULL

# keys that cannot be NULL keep deduplicating
statement ok
CREATE TABLE p (id INTEGER PRIMARY KEY, v INTEGER);

statement ok
INSERT INTO p VALUES (1, 1), (1, 2), (2, 3) ON CONFLICT DO NOTHING;

query I
SELECT count(*) FROM p;
----
2
