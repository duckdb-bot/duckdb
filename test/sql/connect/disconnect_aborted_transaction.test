# name: test/sql/connect/disconnect_aborted_transaction.test
# description: DISCONNECT returns to the local database when a failed statement aborted the local transaction
# group: [connect]

require quack

require httpfs

statement ok
CALL quack_serve('quack:127.0.0.1:9618', token = 'test_token');

statement ok
ATTACH 'quack:127.0.0.1:9618' AS qk (TOKEN 'test_token');

statement ok
CREATE TABLE local_t AS SELECT 1 AS i;

statement ok
BEGIN;

statement ok
INSERT INTO local_t VALUES (2);

statement ok
CONNECT qk;

statement error
CREATE GRANT;
----
syntax error at or near "GRANT"

statement ok
DISCONNECT;

# back on the local database, whose transaction the failure aborted
statement error
SELECT 42;
----
Current transaction is aborted

statement ok
ROLLBACK;

query I
SELECT sum(i) FROM local_t;
----
1

# the same with a CONNECT by connection string
statement ok
BEGIN;

statement ok
CONNECT 'quack:127.0.0.1:9618' (TOKEN 'test_token');

statement error
SELECT * FROM no_such_table;
----
no_such_table

statement ok
DISCONNECT;

statement ok
ROLLBACK;

query I
SELECT 42;
----
42

statement ok
CALL quack_stop('quack:127.0.0.1:9618');
