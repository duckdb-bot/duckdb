# name: test/parquet/corrupt/list_short_output.test
# description: Reject short list columns before consuming unread list entries
# group: [corrupt]

require parquet

# The row group declares eight rows, but y contains only four lists, which the row group check rejects.
statement error
SELECT x, y[1] FROM read_parquet('data/parquet-testing/corrupt/list_short_output.parquet') WHERE x > 0;
----
Column has 4 values but row group has 8 rows

statement error
SELECT x, y[1] FROM read_parquet('data/parquet-testing/corrupt/list_short_output.parquet');
----
Column has 4 values but row group has 8 rows
