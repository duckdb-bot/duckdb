# name: test/sql/catalog/nested_schema/nested_view_function_attached.test
# description: A view of an attached database calls a function by its nested schema path in that database (duckdblabs/bot-issue-tracker#686)
# group: [nested_schema]

# an in-memory default database allows nested schemas under every storage version
statement ok
ATTACH ':memory:' AS mem;

statement ok
USE mem;

statement ok
ATTACH '{TEST_DIR}/nested_view_function_attached.db' AS db (STORAGE_VERSION 'v2.0.0');

statement ok
CREATE SCHEMA db.p;

statement ok
CREATE SCHEMA db.p.s;

statement ok
CREATE MACRO db.p.s.f() AS 11;

statement ok
CREATE TABLE db.p.s.t AS SELECT 5 AS x;

statement ok
CREATE VIEW db.p.s.v_table AS SELECT x FROM p.s.t;

statement ok
CREATE VIEW db.p.s.v_function AS SELECT p.s.f() AS y;

query II
SELECT (SELECT x FROM db.p.s.v_table), (SELECT y FROM db.p.s.v_function);
----
5	11

# the default database's own nested schemas are still found from it
statement ok
CREATE SCHEMA q;

statement ok
CREATE SCHEMA q.r;

statement ok
CREATE MACRO q.r.g() AS 33;

query I
SELECT q.r.g();
----
33

# the view keeps working when the database is attached under a different alias
statement ok
DETACH db;

statement ok
ATTACH '{TEST_DIR}/nested_view_function_attached.db' AS other;

query II
SELECT (SELECT x FROM other.p.s.v_table), (SELECT y FROM other.p.s.v_function);
----
5	11
