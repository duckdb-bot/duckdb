# name: test/sql/storage/types/variant/variant_shredding_depth_limit.test
# description: A checkpoint leaves a VARIANT column unshredded when a value is nested deeper than the visitors allow
# group: [variant]

require json

load {TEST_DIR}/variant_shredding_depth_limit.db

statement ok
SET variant_minimum_shredding_size = 0;

# the JSON text comes from a table, so that no deep VARIANT constant is folded into the plan
statement ok
CREATE TABLE src AS
SELECT i,
       CASE WHEN i = 0 THEN repeat('{"a":', 128) || '1' || repeat('}', 128) ELSE '{"a": ' || i || '}' END AS deep_object,
       CASE WHEN i = 0 THEN repeat('[', 500) || '1' || repeat(']', 500) ELSE '[' || i || ']' END AS deep_array,
       CASE WHEN i = 0 THEN repeat('[', 128) || repeat(']', 128) ELSE '[' || i || ']' END AS empty_at_limit,
       CASE WHEN i = 0 THEN repeat('{"a":', 127) || '1' || repeat('}', 127) ELSE '{"a": ' || i || '}' END AS below_limit
FROM range(10) t(i);

# 128 nested objects, the leaf is at the depth limit
statement ok
CREATE TABLE deep_object AS SELECT deep_object::JSON::VARIANT AS v, i FROM src;

# arrays far deeper than the limit
statement ok
CREATE TABLE deep_array AS SELECT deep_array::JSON::VARIANT AS v, i FROM src;

# an empty array at depth 127 has no children at the limit
statement ok
CREATE TABLE empty_at_limit AS SELECT empty_at_limit::JSON::VARIANT AS v, i FROM src;

# 127 nested objects can still be shredded
statement ok
CREATE TABLE below_limit AS SELECT below_limit::JSON::VARIANT AS v, i FROM src;

statement ok
CHECKPOINT;

restart

statement ok
SET variant_minimum_shredding_size = 0;

query II
SELECT count(*), sum(i) FROM deep_object;
----
10	45

# the unshredded over-depth value comes back whole: it equals a fresh cast of its source text,
# and the 127 levels below its root cast to their complete text
query III
SELECT variant_typeof(d.v), d.v = s.deep_object::JSON::VARIANT,
       variant_extract(d.v, 'a')::VARCHAR = repeat('{''a'': ', 127) || '1' || repeat('}', 127)
FROM deep_object d JOIN src s USING (i) WHERE i = 0;
----
OBJECT(a)	true	true

# variant_extract walks the 128 single-key objects down to the leaf
query III
WITH RECURSIVE walk(v, depth) AS (
    SELECT v, 0 FROM deep_object WHERE i = 0
    UNION ALL
    SELECT variant_extract(v, 'a'), depth + 1 FROM walk WHERE variant_typeof(v) = 'OBJECT(a)'
)
SELECT depth, variant_typeof(v), v::VARCHAR FROM walk WHERE depth >= 127 ORDER BY depth;
----
127	OBJECT(a)	{'a': 1}
128	UINT64	1

query I
SELECT v::VARCHAR FROM deep_object WHERE i = 3;
----
{'a': 3}

# the 500 nested arrays, far beyond the limit, come back whole too
query III
SELECT variant_typeof(d.v), variant_array_length(d.v), d.v = s.deep_array::JSON::VARIANT
FROM deep_array d JOIN src s USING (i) WHERE i = 0;
----
ARRAY(1)	1	true

query III
WITH RECURSIVE walk(v, depth) AS (
    SELECT v, 0 FROM deep_array WHERE i = 0
    UNION ALL
    SELECT variant_extract(v, 1), depth + 1 FROM walk WHERE variant_typeof(v) = 'ARRAY(1)'
)
SELECT depth, variant_typeof(v), v::VARCHAR FROM walk WHERE depth >= 499 ORDER BY depth;
----
499	ARRAY(1)	[1]
500	UINT64	1

query I
SELECT v::VARCHAR FROM deep_array WHERE i = 4;
----
[4]

# every shallow row next to the deep ones reads back unchanged, in the unshredded and in the shredded tables
query IIIII
SELECT count(*), bool_and(o.v::VARCHAR = '{''a'': ' || i || '}'), bool_and(a.v::VARCHAR = '[' || i || ']'),
       bool_and(e.v::VARCHAR = '[' || i || ']'), bool_and(b.v::VARCHAR = '{''a'': ' || i || '}')
FROM deep_object o JOIN deep_array a USING (i) JOIN empty_at_limit e USING (i) JOIN below_limit b USING (i)
WHERE i > 0;
----
9	true	true	true	true

query II
SELECT length(v::VARCHAR), (SELECT v::VARCHAR FROM below_limit WHERE i = 5) FROM below_limit WHERE i = 0;
----
890	{'a': 5}

query I
SELECT count(*) > 0 FROM pragma_storage_info('below_limit') WHERE column_name = 'v' AND column_path LIKE '[0, 2%';
----
true

query II
SELECT length(v::VARCHAR), (SELECT count(*) > 0 FROM pragma_storage_info('empty_at_limit') WHERE column_name = 'v' AND column_path LIKE '[0, 2%') FROM empty_at_limit WHERE i = 0;
----
256	true

# later checkpoints keep working
statement ok
INSERT INTO deep_object SELECT ('{"a": ' || i || '}')::JSON::VARIANT, i FROM range(10, 20) t(i);

statement ok
CHECKPOINT;

restart

query II
SELECT count(*), sum(i) FROM deep_object;
----
20	190

# the over-depth values are still whole after the second checkpoint
query III
SELECT variant_typeof(d.v), d.v = s.deep_object::JSON::VARIANT,
       (SELECT a.v = t.deep_array::JSON::VARIANT FROM deep_array a JOIN src t USING (i) WHERE i = 0)
FROM deep_object d JOIN src s USING (i) WHERE i = 0;
----
OBJECT(a)	true	true

query III
WITH RECURSIVE walk(v, depth) AS (
    SELECT v, 0 FROM deep_object WHERE i = 0
    UNION ALL
    SELECT variant_extract(v, 'a'), depth + 1 FROM walk WHERE variant_typeof(v) = 'OBJECT(a)'
)
SELECT depth, variant_typeof(v), v::VARCHAR FROM walk WHERE depth >= 127 ORDER BY depth;
----
127	OBJECT(a)	{'a': 1}
128	UINT64	1

query I
SELECT v::VARCHAR FROM deep_object WHERE i = 15;
----
{'a': 15}
