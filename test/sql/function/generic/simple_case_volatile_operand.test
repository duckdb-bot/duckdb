# name: test/sql/function/generic/simple_case_volatile_operand.test
# description: A simple CASE evaluates its operand once per row
# group: [generic]

# every row matches one of the branches
query I
SELECT count(*) FROM (
	SELECT CASE (floor(random() * 3))::INTEGER WHEN 0 THEN 'zero' WHEN 1 THEN 'one' WHEN 2 THEN 'two' ELSE 'other' END AS r
	FROM range(10000)
) WHERE r = 'other'
----
0

statement ok
CREATE SEQUENCE seq;

query I
SELECT CASE nextval('seq') WHEN 1 THEN 'a' WHEN 2 THEN 'b' ELSE 'c' END FROM range(3) ORDER BY ALL
----
a
b
c

query I
SELECT currval('seq')
----
3

# a window or UNNEST in the operand is computed once
statement ok
CREATE SEQUENCE window_seq;

query I
SELECT CASE sum(nextval('window_seq')) OVER () + (random() * 0)::INTEGER WHEN 1 THEN 'a' WHEN 2 THEN 'b' END FROM range(1)
----
a

query I
SELECT currval('window_seq')
----
1

statement ok
CREATE SEQUENCE unnest_seq;

query I
SELECT CASE unnest([nextval('unnest_seq')]) + (random() * 0)::INTEGER WHEN 1 THEN 'a' WHEN 2 THEN 'b' END AS r
FROM range(3) ORDER BY r NULLS LAST
----
a
b
NULL

query I
SELECT currval('unnest_seq')
----
3

# one branch, a subquery operand and a lambda
statement ok
CREATE SEQUENCE single_seq;

query I
SELECT CASE nextval('single_seq') WHEN 1 THEN 'a' ELSE 'b' END FROM range(3) ORDER BY ALL
----
a
b
b

query I
SELECT CASE (SELECT 2) WHEN 1 THEN 'a' WHEN 2 THEN 'b' END
----
b

query I
SELECT list_transform([1, 2], lambda x: CASE x + (random() * 0)::INTEGER WHEN 1 THEN 'a' WHEN 2 THEN 'b' END)
----
[a, b]

query I
SELECT list_transform([1, 2, 3], lambda x: CASE x WHEN 1 THEN 'a' WHEN 2 THEN 'b' ELSE 'c' END)
----
[a, b, c]

# results of a simple CASE with an ordinary operand are unchanged
query II
SELECT CASE g WHEN 0 THEN 'even' ELSE 'odd' END AS k, count(*) FROM (SELECT i % 2 AS g FROM range(4) t(i)) GROUP BY g
ORDER BY k
----
even	2
odd	2

query I
SELECT CASE i WHEN 1.5 THEN 'x' WHEN 2 THEN 'two' ELSE 'other' END FROM range(3) t(i) ORDER BY i
----
other
other
two

query I
SELECT CASE NULL WHEN NULL THEN 'null' WHEN 1 THEN 'one' ELSE 'else' END
----
else

query I
SELECT CASE 'A' COLLATE NOCASE WHEN 'a' THEN 'match' WHEN 'b' THEN 'b' ELSE 'none' END
----
match

statement error
SELECT CASE i WHEN 1 THEN 'a' WHEN 2 THEN 2 END FROM range(3) t(i)
----
Cannot mix values of type VARCHAR and INTEGER_LITERAL in CASE expression

# branches with a subquery or UNNEST, which a lambda cannot hold, still work
query I
SELECT CASE (random() * 0)::INTEGER WHEN 0 THEN (SELECT 1) WHEN 1 THEN 2 END
----
1

query I
SELECT CASE (SELECT 2) WHEN 1 THEN (SELECT 'a') WHEN 2 THEN 'b' END
----
b

# a simple CASE prints as one
statement ok
CREATE MACRO pick(x) AS CASE x WHEN 1 THEN 'a' WHEN 2 THEN 'b' ELSE 'c' END

query I
SELECT macro_definition FROM duckdb_functions() WHERE function_name = 'pick'
----
CASE x WHEN 1 THEN 'a' WHEN 2 THEN 'b' ELSE 'c' END

query I
SELECT pick(2)
----
b
