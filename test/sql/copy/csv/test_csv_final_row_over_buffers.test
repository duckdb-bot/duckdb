# a row over the maximum line size behind that line feed is reported on its line, and the rows behind it are read
statement ok
COPY (SELECT l || chr(13) FROM (VALUES (0, 'a,b'), (1, '1,2'), (2, '33,44'), (3, '5,' || repeat('6', 17)), (4, '7,8'), (5, '9,9')) t(i, l) ORDER BY i) TO '{TEST_DIR}/crlf_pair_split_long.csv' (HEADER false, QUOTE '', DELIMITER '|');

