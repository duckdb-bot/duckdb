# name: test/sql/index/art/storage/test_art_list_sort_bind_deadline.test
# description: The deadline of a connection stops its bind of an index on list_sort, and the next bind replays the rows
# group: [storage]

require skip_reload

# the replay evaluates the keys of 300 chunks
require exact_vector_size 2048

load {TEST_DIR}/art_list_sort_bind_deadline.db

statement ok
SET wal_autocheckpoint = '1TB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
CREATE TABLE t (a BIGINT, l BIGINT[]);

statement ok
INSERT INTO t SELECT range, [range + 1, range] FROM range(1000);

statement ok
CREATE UNIQUE INDEX idx_l ON t ((list_sort(l)[1]));

statement ok
CHECKPOINT;

# these rows stay in the write-ahead log and are buffered for the index when the database is opened again
statement ok
INSERT INTO t SELECT 1000 + range, [range + 1001, range + 1000] FROM range(614400);

restart

# without scheduler threads a statement runs on the thread of its connection
statement ok
SET threads = 1;

# The INSERT of the loop binds the index on a new thread. A thread reads the deadline of its query at every 256th
# interrupt check, and without the optimizer only the replay of the 300 buffered chunks gets that far.
concurrentloop i 0 1

statement ok
SET debug_disable_optimizer = true;

statement ok
SET max_execution_time = 1;

statement error
INSERT INTO t VALUES (-1, [0, -1]);
----
Query exceeded maximum execution time

endloop

# the index stayed unbound with its buffered rows, and this statement binds it
statement ok
INSERT INTO t VALUES (-1, [0, -1]);

# the keys of an early and of the last buffered chunk are in the index
statement error
INSERT INTO t VALUES (-2, [5001, 5000]);
----
Duplicate key

statement error
INSERT INTO t VALUES (-2, [615400, 615399]);
----
Duplicate key

query I
SELECT count(*) FROM t;
----
615401
