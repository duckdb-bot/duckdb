# name: test/sql/catalog/system_functions/system_catalog_scanner_functions.test
# description: The system catalog functions list only the schemas that filters on their names let through
# group: [system_functions]

# The fixture and expected output name the default catalog 'memory'.
require noforcestorage

# filters that can throw run on the rows, not on the names of schemas without rows
statement ok
CREATE SCHEMA "1";

statement ok
CREATE TABLE "1".t (i INTEGER);

statement ok
CREATE INDEX idx ON "1".t (i);

statement ok
CREATE SEQUENCE "1".seq;

statement ok
CREATE TABLE "1".log (i INTEGER);

statement ok
CREATE TRIGGER trig AFTER INSERT ON "1".t FOR EACH STATEMENT INSERT INTO "1".log SELECT 1;

query I
SELECT table_name FROM duckdb_tables() WHERE schema_name::INTEGER = 1 ORDER BY ALL;
----
log
t

query I
SELECT index_name FROM duckdb_indexes() WHERE schema_name::INTEGER = 1;
----
idx

query I
SELECT sequence_name FROM duckdb_sequences() WHERE schema_name::INTEGER = 1;
----
seq

query I
SELECT trigger_name FROM duckdb_triggers() WHERE schema_name::INTEGER = 1;
----
trig

# they still fail on the rows they fail on
statement error
SELECT table_name FROM duckdb_tables() WHERE schema_name = '1' AND schema_name::DATE IS NOT NULL;
----
Conversion Error

statement ok
DROP SCHEMA "1" CASCADE;

statement ok
CREATE TABLE mine (i INTEGER);

statement ok
CREATE VIEW mine_view AS SELECT 42 AS x;

statement ok
ATTACH ':memory:' AS other;

statement ok
CREATE SCHEMA other.s1;

statement ok
CREATE SCHEMA other."S2";

statement ok
CREATE TABLE other.s1.t1 (a INTEGER);

statement ok
CREATE TABLE other.s1.t2 (a INTEGER);

statement ok
CREATE TABLE other."S2".t3 (a INTEGER);

statement ok
CREATE VIEW other."S2".v1 AS SELECT 1 AS y;

statement ok
CREATE TABLE other.main.t4 (a INTEGER CHECK (a > 0));

statement ok
CREATE SEQUENCE other.s1.seq1;

statement ok
CREATE INDEX idx1 ON other.s1.t1 (a);

statement ok
CREATE TABLE other.s1.t5 (a INTEGER);

query I
SHOW TABLES FROM memory.main;
----
mine
mine_view

query I
SHOW TABLES FROM other.s2;
----
t3
v1

query I
SHOW TABLES FROM other;
----
t1
t2
t3
t4
t5
v1

query II
SELECT schema_name, table_name FROM duckdb_tables() WHERE database_name = 'other' AND schema_name = 's1' ORDER BY ALL;
----
s1	t1
s1	t2
s1	t5

query I
SELECT table_name FROM duckdb_tables() WHERE lower(database_name) = 'other' AND lower(schema_name) = 's2';
----
t3

query I
SELECT table_name FROM duckdb_tables() WHERE lower(schema_name) = 'S2';
----

query I
SELECT table_name FROM duckdb_tables() WHERE 'S2' = schema_name;
----
t3

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'nothing';
----
0

query II
SELECT table_schema, table_name FROM information_schema.tables WHERE table_catalog = 'other' AND table_schema = 's1' ORDER BY ALL;
----
s1	t1
s1	t2
s1	t5

# filters on both name columns, or on a name and another column, see every schema
query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'memory' OR schema_name = 'S2' ORDER BY ALL;
----
mine
t3

query I
SELECT table_name FROM duckdb_tables() WHERE schema_name = database_name;
----

query II
SELECT schema_name, table_name FROM duckdb_tables() WHERE database_name = 'other' AND (schema_name = 's1' OR table_name = 't4') ORDER BY ALL;
----
main	t4
s1	t1
s1	t2
s1	t5

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name LIKE 's%';
----
3

# filters that can throw run on the rows as before
statement error
SELECT table_name FROM duckdb_tables() WHERE schema_name::INTEGER = 1;
----
Conversion Error

# collations compare through lower() and other functions
query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'other' AND schema_name COLLATE nocase = 'S2';
----
t3

query I
SELECT table_name FROM duckdb_tables() WHERE database_name COLLATE nocase = 'OTHER' AND schema_name COLLATE noaccent = 'S2';
----
t3

statement ok
SET default_collation = 'nocase';

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'Other' AND schema_name = 's2';
----
t3

statement ok
RESET default_collation;

# names that are only equal after lower()
statement ok
CREATE SCHEMA "Ä";

statement ok
CREATE SCHEMA "ä";

statement ok
CREATE TABLE "Ä".upper_t (i INTEGER);

statement ok
CREATE TABLE "ä".lower_t (i INTEGER);

query I
SHOW TABLES FROM memory."Ä";
----
lower_t
upper_t

query I
SELECT table_name FROM duckdb_tables() WHERE schema_name = 'Ä';
----
upper_t

query I
SELECT table_name FROM duckdb_tables() WHERE lower(schema_name) = 'ä' ORDER BY ALL;
----
lower_t
upper_t

query I
SELECT table_name FROM duckdb_tables() WHERE schema_name COLLATE nocase = 'Ä' ORDER BY ALL;
----
lower_t
upper_t

query I
SELECT table_name FROM duckdb_tables() WHERE schema_name COLLATE noaccent = 'A';
----
upper_t

statement ok
DROP SCHEMA "Ä" CASCADE;

statement ok
DROP SCHEMA "ä" CASCADE;

# prepared statements see the catalog of each execution
statement ok
PREPARE pinned_s1 AS SELECT table_name FROM duckdb_tables() WHERE database_name = 'other' AND schema_name = 's1' ORDER BY ALL;

query I
EXECUTE pinned_s1;
----
t1
t2
t5

statement ok
CREATE TABLE other.s1.t7 (a INTEGER);

query I
EXECUTE pinned_s1;
----
t1
t2
t5
t7

statement ok
DROP TABLE other.s1.t7;

query I
EXECUTE pinned_s1;
----
t1
t2
t5

# WITH ORDINALITY numbers the rows of the full scan
statement ok
CREATE TABLE ordinality_scan AS SELECT database_name, schema_name, table_name, ordinality FROM duckdb_tables() WITH ORDINALITY;

query I
SELECT count(*) FROM (SELECT database_name, schema_name, table_name, ordinality FROM duckdb_tables() WITH ORDINALITY WHERE database_name = 'other' AND schema_name = 's1' EXCEPT ALL SELECT * FROM ordinality_scan WHERE database_name = 'other' AND schema_name = 's1');
----
0

query I
SELECT count(*) FROM ordinality_scan WHERE database_name = 'other' AND schema_name = 's1';
----
3

statement ok
DROP TABLE ordinality_scan;

# column aliases do not change which columns the filters are on
query I
SELECT table_name FROM duckdb_tables() AS d(schema_name, db_oid, database_name) WHERE schema_name = 'other' AND database_name = 'S2';
----
t3

query I
SELECT schema_name FROM duckdb_tables() AS d(x, y, z, w, schema_name) WHERE schema_name = 't3';
----
t3

# schemas of the same name in other databases and in nested schemas
statement ok
ATTACH ':memory:' AS parent;

statement ok
CREATE SCHEMA parent.s1;

statement ok
CREATE SCHEMA parent.p;

statement ok
CREATE SCHEMA parent.p.s1;

statement ok
CREATE TABLE parent.s1.top_t (a INTEGER);

statement ok
CREATE TABLE parent.p.s1.nested_t (a INTEGER);

query II
SELECT database_name, table_name FROM duckdb_tables() WHERE schema_name = 's1' ORDER BY ALL;
----
other	t1
other	t2
other	t5
parent	nested_t
parent	top_t

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'parent' AND schema_name = 's1' ORDER BY ALL;
----
nested_t
top_t

# the other catalog functions
query III
SELECT schema_name, table_name, column_name FROM duckdb_columns() WHERE database_name = 'other' AND schema_name = 'S2';
----
S2	t3	a
S2	v1	y

query II
SELECT table_name, column_name FROM information_schema.columns WHERE table_catalog = 'other' AND table_schema = 'main';
----
t4	a

query II
SELECT database_name, schema_name FROM duckdb_schemas() WHERE database_name = 'other' AND schema_name = 's1';
----
other	s1

query I
SELECT sequence_name FROM duckdb_sequences() WHERE database_name = 'other' AND schema_name = 's1';
----
seq1

query I
SELECT index_name FROM duckdb_indexes() WHERE database_name = 'other' AND schema_name = 's1';
----
idx1

query I
SELECT count(*) > 100 FROM duckdb_functions() WHERE database_name = 'system' AND schema_name = 'main';
----
true

query I
SELECT count(*) FROM duckdb_functions() WHERE database_name = 'other';
----
0

# filtered rows are the same as the rows of a full scan, also for functions whose rows depend on the whole scan
statement ok
CREATE TABLE other.s1.t6 (a INTEGER PRIMARY KEY, b INTEGER CHECK (b > 0));

statement ok
CREATE TYPE other.s1.mood AS ENUM ('happy', 'sad');

statement ok
CREATE MACRO other.s1.add_one(x) AS x + 1;

statement ok
CREATE MACRO other.s1.one_row() AS TABLE SELECT 1 AS x;

statement ok
CREATE TABLE other.s1.log (i INTEGER);

statement ok
CREATE TRIGGER other_trigger AFTER INSERT ON other.s1.t1 FOR EACH STATEMENT INSERT INTO other.s1.log SELECT 1;

# duckdb_functions has a VARCHAR database_oid
statement ok
SET VARIABLE other_oid = (SELECT database_oid::VARCHAR FROM duckdb_databases() WHERE database_name = 'other');

foreach function duckdb_tables duckdb_views duckdb_columns duckdb_constraints duckdb_types duckdb_indexes duckdb_sequences duckdb_schemas duckdb_functions duckdb_triggers

statement ok
CREATE TABLE full_scan AS SELECT * FROM {function}();

query I
SELECT count(*) FROM (SELECT * FROM {function}() WHERE database_name = 'other' AND schema_name = 's1' EXCEPT ALL SELECT * FROM full_scan WHERE database_name = 'other' AND schema_name = 's1');
----
0

query I
SELECT count(*) FROM (SELECT * FROM full_scan WHERE database_name = 'other' AND schema_name = 's1' EXCEPT ALL SELECT * FROM {function}() WHERE database_name = 'other' AND schema_name = 's1');
----
0

query I
SELECT count(*) FROM (SELECT * FROM {function}() WHERE database_name = 'other' EXCEPT ALL SELECT * FROM full_scan WHERE database_name = 'other');
----
0

query I
SELECT count(*) FROM (SELECT * FROM full_scan WHERE database_name = 'other' EXCEPT ALL SELECT * FROM {function}() WHERE database_name = 'other');
----
0

query I
SELECT count(*) > 0 FROM full_scan WHERE database_oid::VARCHAR = getvariable('other_oid');
----
true

query I
SELECT count(*) FROM (SELECT * FROM {function}() WHERE database_oid::VARCHAR = getvariable('other_oid') EXCEPT ALL SELECT * FROM full_scan WHERE database_oid::VARCHAR = getvariable('other_oid'));
----
0

query I
SELECT count(*) FROM (SELECT * FROM full_scan WHERE database_oid::VARCHAR = getvariable('other_oid') EXCEPT ALL SELECT * FROM {function}() WHERE database_oid::VARCHAR = getvariable('other_oid'));
----
0

statement ok
DROP TABLE full_scan;

endloop

# only the pinned catalog and schema are scanned
query II
EXPLAIN ANALYZE SHOW TABLES FROM other.s1;
----
analyzed_plan	<REGEX>:.*DUCKDB_TABLES.*Catalogs Scanned: 1/.*Schemas Scanned: 1/.*

foreach function duckdb_indexes duckdb_sequences duckdb_schemas duckdb_functions duckdb_triggers

query II
EXPLAIN ANALYZE SELECT * FROM {function}() WHERE database_name = 'other' AND schema_name = 's1';
----
analyzed_plan	<REGEX>:.*Catalogs Scanned: 1/.*Schemas Scanned: 1/.*

query II
EXPLAIN ANALYZE SELECT * FROM {function}() WHERE lower(database_name) = 'other';
----
analyzed_plan	<REGEX>:.*Catalogs Scanned: 1/.*

endloop
