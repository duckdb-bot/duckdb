# name: test/issues/general/test_26657.test
# description: Issue 26657: temporal strings round the digits past their precision half away from zero
# group: [general]

query IIIII
SELECT '2024-01-01 12:00:00.1234575'::TIMESTAMP, '2024-01-01 12:00:00.1234569'::TIMESTAMP, '2024-01-01 12:00:00.1234564'::TIMESTAMP, '12:00:00.1234569'::TIME, '2024-01-01 12:00:00.1234567899'::TIMESTAMP_NS::VARCHAR
----
2024-01-01 12:00:00.123458	2024-01-01 12:00:00.123457	2024-01-01 12:00:00.123456	12:00:00.123457	2024-01-01 12:00:00.12345679

# a carry goes into the seconds, the minutes, the hours and the date
query IIII
SELECT '2024-12-31 23:59:59.9999995'::TIMESTAMP, '2024-01-01 12:59:59.99999951'::TIMESTAMP, '23:59:59.9999995'::TIME, '2024-01-01 23:59:59.9999999995'::TIMESTAMP_NS
----
2025-01-01 00:00:00	2024-01-01 13:00:00	24:00:00	2024-01-02 00:00:00

query II
SELECT '12:00:00.1234565+02'::TIMETZ, '1969-12-31 23:59:59.9999995'::TIMESTAMP
----
12:00:00.123457+02	1970-01-01 00:00:00

# intervals round away from zero in both directions
query II
SELECT INTERVAL '00:00:00.0000005', '-00:00:00.0000005'::INTERVAL
----
00:00:00.000001	-00:00:00.000001

# digits after the first one past the precision do not change the result
query I
SELECT '2024-01-01 12:00:00.12345649999'::TIMESTAMP
----
2024-01-01 12:00:00.123456

# rounding past the largest timestamp is an error, not infinity
statement error
SELECT '294247-01-10 04:00:54.7758065'::TIMESTAMP
----
out of range

query I
SELECT '294247-01-10 04:00:54.7758064'::TIMESTAMP
----
294247-01-10 04:00:54.775806

# the CSV reader parses with the same rules
statement ok
COPY (SELECT '2024-01-01 12:00:00.1234569' AS ts, '12:00:00.9999996' AS t) TO '{TEMP_DIR}/round_fraction.csv' (HEADER);

query II
SELECT ts, t FROM read_csv('{TEMP_DIR}/round_fraction.csv', columns = {'ts': 'TIMESTAMP', 't': 'TIME'})
----
2024-01-01 12:00:00.123457	12:00:01

# TRY_CAST and casts of columns round the same way
query II
SELECT TRY_CAST(s AS TIMESTAMP), CAST(s AS TIMESTAMPTZ) FROM (VALUES ('2024-01-01 12:00:00.9999996+00')) t(s)
----
2024-01-01 12:00:01	2024-01-01 12:00:01+00

# casts to milliseconds and seconds round once, at their own precision
query IIII
SELECT '2024-01-01 00:00:00.1234995'::TIMESTAMP_MS, '2024-01-01 00:00:00.1235'::TIMESTAMP_MS, '2024-01-01 00:00:00.4999995'::TIMESTAMP_S, '2024-01-01 00:00:00.5'::TIMESTAMP_S
----
2024-01-01 00:00:00.123	2024-01-01 00:00:00.124	2024-01-01 00:00:00	2024-01-01 00:00:01

# before the epoch, a cast to seconds or milliseconds rounds an exact tie down, and anything above it up
query IIII
SELECT '1969-12-31 23:59:59.5000009'::TIMESTAMP_S, '1969-12-31 23:59:59.50000001'::TIMESTAMP_S, '1969-12-31 23:59:59.5'::TIMESTAMP_S, '1969-12-31 23:59:59.9995009'::TIMESTAMP_MS
----
1970-01-01 00:00:00	1970-01-01 00:00:00	1969-12-31 23:59:59	1970-01-01 00:00:00

# rounding cannot take the time of a timestamp past 24:00:00, nor any value past its largest one
query IIII
SELECT TRY_CAST('2024-01-01 24:00:00.0000005' AS TIMESTAMP), '2024-01-01 24:00:00'::TIMESTAMP, TRY_CAST('24:00:00.0000005' AS TIME), TRY_CAST('2262-04-11 23:47:16.8547758075' AS TIMESTAMP_NS)
----
NULL	2024-01-02 00:00:00	NULL	NULL

query II
SELECT '12:00:00.1234567895'::TIME_NS, '23:59:59.9999999995'::TIME_NS
----
12:00:00.12345679	24:00:00

require icu

statement ok
SET TimeZone = 'UTC';

# the fraction rounds the instant after the time zone resolved the local time, around both DST changes
query IIII
SELECT '2024-11-03 00:59:59.9999995 America/New_York'::TIMESTAMPTZ, '2024-03-10 01:59:59.9999995 America/New_York'::TIMESTAMPTZ, '2024-01-01 12:00:00.1234565+02'::TIMESTAMPTZ, '2024-11-03 00:59:59.9999999995 America/New_York'::TIMESTAMPTZ_NS
----
2024-11-03 05:00:00+00	2024-03-10 07:00:00+00	2024-01-01 10:00:00.123457+00	2024-11-03 05:00:00+00

statement ok
SET TimeZone = 'America/New_York';

query II
SELECT '2024-11-03 00:59:59.9999995'::TIMESTAMPTZ, epoch_us('2024-11-03 00:59:59.9999995'::TIMESTAMPTZ)
----
2024-11-03 01:00:00-04	1730610000000000

query I
SELECT TRY_CAST('294247-01-10 04:00:54.7758065+00' AS TIMESTAMPTZ)
----
NULL
