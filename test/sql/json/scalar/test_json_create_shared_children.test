# name: test/sql/json/scalar/test_json_create_shared_children.test
# description: to_json of rows whose lists and maps share the same child entries (duckdblabs/bot-issue-tracker#506)
# group: [scalar]

require json

# a constant list or map inside a struct gives every row the same list entry
query II
SELECT to_json({'i': i, 'l': [1, 2, 3]}), to_json({'i': i, 'm': MAP {'a': [1, 2], 'b': [3]}}) FROM range(3) t(i);
----
{"i":0,"l":[1,2,3]}	{"i":0,"m":{"a":[1,2],"b":[3]}}
{"i":1,"l":[1,2,3]}	{"i":1,"m":{"a":[1,2],"b":[3]}}
{"i":2,"l":[1,2,3]}	{"i":2,"m":{"a":[1,2],"b":[3]}}

query I
SELECT to_json({'i': i, 'l': [{'x': [i, 1]}, {'x': [2]}]}) FROM range(2) t(i);
----
{"i":0,"l":[{"x":[0,1]},{"x":[2]}]}
{"i":1,"l":[{"x":[1,1]},{"x":[2]}]}

# list_reverse gives inner lists in reverse order
query I
SELECT to_json(list_reverse(l)) FROM (VALUES ([[1], [2, 3], [4]]), ([[5, 6], [], [7]])) t(l)
----
[[4],[2,3],[1]]
[[7],[],[5,6]]
