# name: test/issues/general/test_26144.test
# description: PREPARE delays binding an expression that modifies the database and is folded while binding to EXECUTE
# group: [general]

load {TEST_DIR}/test_26144.db

statement ok
CREATE SEQUENCE s;

statement ok
PREPARE p AS SELECT count(*) FROM range(nextval('s'));

query I
SELECT 42;
----
42

# PREPARE did not advance the sequence
statement error
SELECT currval('s');
----
currval: sequence is not yet defined in this session

# every EXECUTE binds the statement again and advances the sequence once
query I
EXECUTE p;
----
1

query I
EXECUTE p;
----
2

statement ok
PREPARE g AS SELECT count(*) FROM generate_series(1, nextval('s'));

query I
EXECUTE g;
----
3

statement ok
PREPARE v AS SELECT count(*) FROM range(setval('s', 10));

query I
SELECT currval('s');
----
3

query I
EXECUTE v;
----
10

statement ok
CREATE MACRO m(x) AS TABLE SELECT * FROM range(x);

statement ok
PREPARE t AS SELECT count(*) FROM m(nextval('s'));

query I
EXECUTE t;
----
11

statement ok
PREPARE cl AS COPY (SELECT 42) TO '{TEST_DIR}/test_26144.csv' (DELIMITER chr(invoke(lambda x: nextval('s'), 0)::INTEGER + 32));

query I
SELECT currval('s');
----
11

statement ok
EXECUTE cl;

query I
SELECT currval('s');
----
12

# a directly run statement evaluates the expression while binding, as EXECUTE does
query I
SELECT count(*) FROM range(nextval('s'));
----
13

statement ok
BEGIN;

statement ok
PREPARE q AS SELECT count(*) FROM range(nextval('s'));

statement ok
COMMIT;

statement ok
BEGIN;

query I
EXECUTE q;
----
14

statement ok
COMMIT;

query I
EXECUTE q;
----
15

# currval only reads the sequence
statement ok
BEGIN TRANSACTION READ ONLY;

statement ok
PREPARE cur AS SELECT count(*) FROM range(currval('s'));

query I
EXECUTE cur;
----
15

statement ok
COMMIT;

# EXECUTE evaluates its parameters while binding
statement ok
PREPARE e AS SELECT $1::BIGINT;

query I
EXECUTE e(nextval('s'));
----
16

query I
EXECUTE e(1 + nextval('s'));
----
18

# an expression that is evaluated while executing advances the sequence on every EXECUTE too
statement ok
PREPARE l AS SELECT count(*) FROM (SELECT * FROM range(100) LIMIT nextval('s'));

query I
EXECUTE l;
----
18

query I
EXECUTE l;
----
19

# a volatile function that does not modify the database is evaluated while binding
statement ok
CREATE TABLE tt (i INTEGER);

statement error
SELECT * FROM tt AT (VERSION => random());
----
Binder Error: Catalog type does not support time travel

restart

query I
SELECT nextval('s');
----
20
