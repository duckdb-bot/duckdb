This type was either manually set or derived from an existing table. Select a different type to correctly parse this column.

# and with the sniffer on, also when the sample has the type that was given
statement ok
COPY (SELECT CASE WHEN i = 2500 THEN 'nope' ELSE i::VARCHAR END AS x FROM range(3000) t(i) ORDER BY i) TO '{TEST_DIR}/csv_error_message_type_late.csv' (HEADER false);

statement error
SELECT count(x) FROM read_csv('{TEST_DIR}/csv_error_message_type_late.csv', header = false, columns = {'x': 'BIGINT'}, sample_size = 1);
----
This type was either manually set or derived from an existing table. Select a different type to correctly parse this column.

