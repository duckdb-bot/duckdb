# name: test/sql/copy/csv/rejects/csv_rejects_unquoted_value_buffer_end.test
# description: A column value with text behind its closing quote is rejected once
# group: [rejects]

require skip_reload

# a single column, the bad value on the last row
statement ok
COPY (SELECT * FROM (VALUES ('a'), ('0'), ('1'), ('"xx"x')) t(line)) TO '{TEST_DIR}/unquoted_last_row.csv' (HEADER false, QUOTE '', DELIMITER '|');

loop buffer_size 6 15

query I
SELECT a FROM read_csv('{TEST_DIR}/unquoted_last_row.csv', header = true, auto_detect = false, columns = {'a': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = false, store_rejects = true) ORDER BY a;
----
0
1

query IIII
SELECT line, column_idx, error_type, csv_line FROM reject_errors;
----
4	1	UNQUOTED VALUE	"xx"x

statement ok
DROP TABLE reject_scans;

statement ok
DROP TABLE reject_errors;

# the parallel scan is only checked for the number of its rejects
statement ok
SELECT a FROM read_csv('{TEST_DIR}/unquoted_last_row.csv', header = true, auto_detect = false, columns = {'a': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = true, store_rejects = true);

query I
SELECT count(*) FROM reject_errors;
----
1

statement ok
DROP TABLE reject_scans;

statement ok
DROP TABLE reject_errors;

endloop

# more text behind the closing quote and a row behind the bad one
statement ok
COPY (SELECT * FROM (VALUES ('a'), ('0'), ('1'), ('"xx"xyz'), ('3')) t(line)) TO '{TEST_DIR}/unquoted_middle_row.csv' (HEADER false, QUOTE '', DELIMITER '|');

loop buffer_size 8 19

query I
SELECT a FROM read_csv('{TEST_DIR}/unquoted_middle_row.csv', header = true, auto_detect = false, columns = {'a': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = false, store_rejects = true) ORDER BY a;
----
0
1
3

query IIII
SELECT line, column_idx, error_type, csv_line FROM reject_errors;
----
4	1	UNQUOTED VALUE	"xx"xyz

statement ok
DROP TABLE reject_scans;

statement ok
DROP TABLE reject_errors;

statement ok
SELECT a FROM read_csv('{TEST_DIR}/unquoted_middle_row.csv', header = true, auto_detect = false, columns = {'a': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = true, store_rejects = true);

query I
SELECT count(*) FROM reject_errors;
----
1

statement ok
DROP TABLE reject_scans;

statement ok
DROP TABLE reject_errors;

endloop

# two bad values in one row give one reject for each column in a single-threaded scan
statement ok
COPY (SELECT * FROM (VALUES ('a,b'), ('0,0'), ('"xx"xyz,"yy"y'), ('3,3')) t(line)) TO '{TEST_DIR}/unquoted_two_columns.csv' (HEADER false, QUOTE '', DELIMITER '|');

loop buffer_size 14 29

query II
SELECT a, b FROM read_csv('{TEST_DIR}/unquoted_two_columns.csv', header = true, auto_detect = false, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'}, buffer_size = {buffer_size}, parallel = false, store_rejects = true) ORDER BY a;
----
0	0
3	3

query IIII
SELECT line, column_idx, error_type, csv_line FROM reject_errors ORDER BY column_idx;
----
3	1	UNQUOTED VALUE	"xx"xyz,"yy"y
3	2	UNQUOTED VALUE	"xx"xyz,"yy"y

statement ok
DROP TABLE reject_scans;

statement ok
DROP TABLE reject_errors;

endloop

# carriage returns behind the bad text are invalid too when the line break is a line feed, without a buffer end
statement ok
COPY (SELECT * FROM (VALUES ('a'), ('0'), ('"xx"x' || chr(13) || 'z' || chr(13) || 'w'), ('3')) t(line)) TO '{TEST_DIR}/unquoted_carriage_returns.csv' (HEADER false, QUOTE '', DELIMITER '|');

query I
SELECT a FROM read_csv('{TEST_DIR}/unquoted_carriage_returns.csv', header = true, auto_detect = false, columns = {'a': 'VARCHAR'}, new_line = '\n', parallel = false, store_rejects = true) ORDER BY a;
----
0
3

query III
SELECT line, column_idx, error_type FROM reject_errors;
----
3	1	UNQUOTED VALUE
