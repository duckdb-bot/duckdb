# name: test/issues/general/test_25074_json.test
# description: Converting a VARIANT nested deeper than the limit to JSON, or from a folded JSON constant, raises an error
# group: [general]

require json

statement ok
CREATE TABLE t AS WITH RECURSIVE r(d, v, o) AS (
	SELECT 1, [1]::VARIANT, {'a': 1}::VARIANT
	UNION ALL
	SELECT d + 1, [v]::VARIANT, {'a': o}::VARIANT FROM r WHERE d < 129
)
SELECT d, v, o FROM r WHERE d IN (128, 129);

# a value nested too deeply does not convert to JSON either
query III
SELECT d, TRY_CAST(v AS JSON) IS NULL, TRY_CAST(o AS STRUCT(a JSON)) IS NULL FROM t ORDER BY d;
----
128	false	false
129	true	true

statement error
SELECT v::JSON FROM t WHERE d = 129;
----
Can't convert VARIANT value nested deeper than 128 levels

# a constant is folded through a Value
query I
SELECT length((repeat('[', 128) || repeat(']', 128))::JSON::VARIANT::VARCHAR);
----
256

statement error
SELECT (repeat('[', 129) || repeat(']', 129))::JSON::VARIANT::VARCHAR;
----
<REGEX>:.*(nested deeper than 128 levels|depth).*

# naming an expression renders its constants, also one nested too deeply
query I
SELECT TRY_CAST(CASE WHEN i = 0 THEN (repeat('[', 129) || repeat(']', 129))::JSON::VARIANT ELSE 42::VARIANT END AS VARCHAR)
FROM range(2) t(i);
----
NULL
42
