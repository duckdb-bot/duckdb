# name: test/sql/secrets/persistent_secret_rollback.test
# description: The files of persistent secrets follow the catalog when a transaction is rolled back
# group: [secrets]

require noforcestorage

load {TEST_DIR}/persistent_secret_rollback.db

statement ok
SET secret_directory = '{TEST_DIR}/persistent_secret_rollback';

# a rolled back CREATE leaves no file
statement ok
BEGIN;

statement ok
CREATE PERSISTENT SECRET s1 (TYPE http);

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 's1';
----
1

statement ok
ROLLBACK;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 's1';
----
0

query I
SELECT count(*) FROM glob('{TEST_DIR}/persistent_secret_rollback/*');
----
0

statement error
DROP PERSISTENT SECRET s1;
----
non-existent

# the secret can be created again
statement ok
CREATE PERSISTENT SECRET s1 (TYPE http, SCOPE 'http://old');

query I
SELECT count(*) FROM glob('{TEST_DIR}/persistent_secret_rollback/s1.duckdb_secret');
----
1

statement ok
CREATE TABLE s1_file AS SELECT content FROM read_blob('{TEST_DIR}/persistent_secret_rollback/s1.duckdb_secret');

# a rolled back DROP keeps the file
statement ok
BEGIN;

statement ok
DROP PERSISTENT SECRET s1;

query I
SELECT count(*) FROM glob('{TEST_DIR}/persistent_secret_rollback/*');
----
0

statement ok
ROLLBACK;

query II
SELECT name, persistent FROM duckdb_secrets();
----
s1	true

query I
SELECT content = (SELECT content FROM s1_file) FROM read_blob('{TEST_DIR}/persistent_secret_rollback/s1.duckdb_secret');
----
true

# a rolled back replacement keeps the file of the replaced secret
statement ok
BEGIN;

statement ok
CREATE OR REPLACE PERSISTENT SECRET s1 (TYPE http, SCOPE 'http://new');

query I
SELECT content = (SELECT content FROM s1_file) FROM read_blob('{TEST_DIR}/persistent_secret_rollback/s1.duckdb_secret');
----
false

statement ok
ROLLBACK;

query I
SELECT scope[1] FROM duckdb_secrets() WHERE name = 's1';
----
http://old

query I
SELECT content = (SELECT content FROM s1_file) FROM read_blob('{TEST_DIR}/persistent_secret_rollback/s1.duckdb_secret');
----
true

# a CREATE that fails because the secret exists, and a DROP IF EXISTS of a secret that does not exist, change no file
statement ok
BEGIN;

statement error
CREATE PERSISTENT SECRET s1 (TYPE http, SCOPE 'http://new');
----
already exists

statement ok
ROLLBACK;

statement ok
BEGIN;

statement ok
DROP PERSISTENT SECRET IF EXISTS s_none FROM local_file;

statement ok
ROLLBACK;

query I
SELECT content = (SELECT content FROM s1_file) FROM read_blob('{TEST_DIR}/persistent_secret_rollback/s1.duckdb_secret');
----
true

query I
SELECT list_sort(list(parse_filename(file))) FROM glob('{TEST_DIR}/persistent_secret_rollback/*');
----
[s1.duckdb_secret]

# several changes in one rolled back transaction
statement ok
BEGIN;

statement ok
CREATE PERSISTENT SECRET s2 (TYPE http);

statement ok
DROP PERSISTENT SECRET s1;

statement ok
CREATE PERSISTENT SECRET s3 (TYPE http);

statement ok
DROP PERSISTENT SECRET s3;

statement ok
ROLLBACK;

query I
SELECT list_sort(list(name)) FROM duckdb_secrets();
----
[s1]

query I
SELECT list_sort(list(parse_filename(file))) FROM glob('{TEST_DIR}/persistent_secret_rollback/*');
----
[s1.duckdb_secret]

# a committed transaction keeps its changes
statement ok
BEGIN;

statement ok
CREATE PERSISTENT SECRET s2 (TYPE http);

statement ok
DROP PERSISTENT SECRET s1;

statement ok
COMMIT;

query I
SELECT list_sort(list(name)) FROM duckdb_secrets();
----
[s2]

query I
SELECT list_sort(list(parse_filename(file))) FROM glob('{TEST_DIR}/persistent_secret_rollback/*');
----
[s2.duckdb_secret]

# a new instance sees the files of the committed state only
restart

statement ok
SET secret_directory = '{TEST_DIR}/persistent_secret_rollback';

query II
SELECT name, persistent FROM duckdb_secrets();
----
s2	true

# temporary secrets are not affected
statement ok
BEGIN;

statement ok
CREATE SECRET t1 (TYPE http);

statement ok
ROLLBACK;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 't1';
----
0

# a rolled back statement that changed no file leaves another connection's uncommitted change alone
statement ok con1
BEGIN;

statement ok con1
DROP PERSISTENT SECRET IF EXISTS c1 FROM local_file;

statement ok con2
BEGIN;

statement ok con2
CREATE PERSISTENT SECRET c1 (TYPE http);

statement ok con1
ROLLBACK;

statement ok con2
COMMIT;

query I
SELECT count(*) FROM glob('{TEST_DIR}/persistent_secret_rollback/c1.duckdb_secret');
----
1

statement ok
CREATE PERSISTENT SECRET c2 (TYPE http, SCOPE 'http://old');

statement ok con1
BEGIN;

statement ok con1
CREATE PERSISTENT SECRET IF NOT EXISTS c2 (TYPE http);

statement ok con2
BEGIN;

statement ok con2
CREATE OR REPLACE PERSISTENT SECRET c2 (TYPE http, SCOPE 'http://new');

statement ok con1
ROLLBACK;

statement ok con2
COMMIT;

statement ok con1
BEGIN;

statement ok con1
CREATE PERSISTENT SECRET IF NOT EXISTS c1 (TYPE http);

statement ok con2
BEGIN;

statement ok con2
DROP PERSISTENT SECRET c1;

statement ok con1
ROLLBACK;

statement ok con2
COMMIT;

restart

statement ok
SET secret_directory = '{TEST_DIR}/persistent_secret_rollback';

query I
SELECT list_sort(list(name)) FROM duckdb_secrets();
----
[c2, s2]

query I
SELECT scope[1] FROM duckdb_secrets() WHERE name = 'c2';
----
http://new
