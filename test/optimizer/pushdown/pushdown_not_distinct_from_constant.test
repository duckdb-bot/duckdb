# name: test/optimizer/pushdown/pushdown_not_distinct_from_constant.test
# description: A constant that one side of an IS NOT DISTINCT FROM condition equals is pushed to the other side
# group: [pushdown]

require json

statement ok
CREATE TABLE t1 AS SELECT * FROM (VALUES (1, {'a': 1}), (3, {'a': 3}), (NULL, NULL), (3, {'a': 4})) v(a, s);

statement ok
CREATE TABLE t2 AS SELECT * FROM (VALUES (3, {'a': 3}), (NULL, NULL), (5, {'a': 5})) v(b, s);

query II
EXPLAIN SELECT t1.a, t2.b FROM t1 JOIN t2 ON t1.a IS NOT DISTINCT FROM t2.b WHERE t2.b = 3
----
physical_plan	<REGEX>:.*Filters: a = 3.*Filters: b = 3.*

query II
SELECT t1.a, t2.b FROM t1 JOIN t2 ON t1.a IS NOT DISTINCT FROM t2.b WHERE t2.b = 3 ORDER BY ALL
----
3	3
3	3

# NULL is not a constant the other side can be filtered on
query II
SELECT t1.a, t2.b FROM t1 JOIN t2 ON t1.a IS NOT DISTINCT FROM t2.b WHERE t2.b IS NULL
----
NULL	NULL

# an expression of the column, here a field of a struct
query II
EXPLAIN SELECT t1.s, t2.s FROM t1 JOIN t2 ON t1.s IS NOT DISTINCT FROM t2.s WHERE t2.s.a = 3
----
physical_plan	<REGEX>:.*Filters: struct_extract\(s, 'a'\) = 3.*Filters: struct_extract\(s, 'a'\) = 3.*

query II
SELECT t1.s, t2.s FROM t1 JOIN t2 ON t1.s IS NOT DISTINCT FROM t2.s WHERE t2.s.a = 3
----
{'a': 3}	{'a': 3}

# a filter that contradicts the derived constant
query I
SELECT t1.a FROM t1 JOIN t2 ON t1.a IS NOT DISTINCT FROM t2.b WHERE t2.b = 3 AND t1.a > 5
----

# a selective outer filter reaches the recursive CTE of a nested correlated LATERAL (issue #27072)
statement ok
CREATE TABLE person AS SELECT i AS id FROM range(1000) t(i);

statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '{TEMP_DIR}/lateral_recursive.json';

query I
SELECT max(q.x) FROM person o, LATERAL (SELECT r.x FROM person i, LATERAL (WITH RECURSIVE walk(x) AS (SELECT i.id UNION ALL SELECT x + 1 FROM walk WHERE x < i.id + 2) SELECT x FROM walk) r WHERE i.id = o.id) q WHERE o.id = 3
----
5

statement ok
PRAGMA disable_profiling;

query I
SELECT sum((value->>'intermediate_rows')::BIGINT) FROM read_text('{TEMP_DIR}/lateral_recursive.json'), json_tree(content) WHERE value->>'type' = 'RECURSIVE_CTE'
----
3
