# name: test/issues/general/test_20543_storage_version.test
# description: ALTER TABLE ... SET TYPE ... USING with a cast to a user type replays from the WAL of an older storage version
# group: [general]

# a storage version before v2.0.0 logs the target of a cast as a type instead of a type expression
load {TEST_DIR}/alter_type_using_replay_v1.db readwrite v1.0.0

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET wal_autocheckpoint = '1GB';

statement ok
CREATE TYPE e AS ENUM ('a', 'b');

statement ok
CREATE TABLE t (p VARCHAR, q VARCHAR);

statement ok
INSERT INTO t VALUES ('a', 'b');

statement ok
ALTER TABLE t ALTER p SET TYPE USING p::e;

statement ok
ALTER TABLE t ALTER q SET TYPE USING {'k': q}::STRUCT(k e);

restart

query IIII
SELECT p, typeof(p), q, typeof(q) FROM t;
----
a	ENUM('a', 'b')	{'k': b}	STRUCT(k ENUM('a', 'b'))
