# name: test/sql/transactions/concurrent_commits_checkpoint.test
# description: a checkpoint right after concurrent commits finds no committed transaction held back from cleanup
# group: [transactions]

statement ok
SET threads = 1;

statement ok
SET checkpoint_threshold = '1TB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

# the commits wait for their write ahead log sync without the transaction lock, so they overlap
statement ok
SET debug_wal_fsync_sleep_ms = 2;

statement ok
ATTACH '{TEST_DIR}/concurrent_commits_checkpoint.db' AS db;

statement ok
CREATE TABLE db.counters AS SELECT i, 0 AS v FROM range(3) t(i);

loop batch 0 50

concurrentloop threadid 0 3

statement ok
UPDATE db.counters SET v = v + 1 WHERE i = {threadid};

endloop

# every committed transaction has left the active set and released its checkpoint lock
statement ok
CHECKPOINT db;

endloop

query I
SELECT sum(v) FROM db.counters;
----
150
