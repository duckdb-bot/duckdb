# name: test/sql/copy/csv/rejects/csv_rejects_cast_before_unterminated_quote.test
# description: Cast errors before a last row that ends inside a quoted value keep their line numbers in reject_errors, and ignore_errors removes a last row whose cast fails as it crosses into the last buffer
# group: [rejects]

# the files end inside a quoted value without a newline (they are -text in .gitattributes), the scanner adds
# the row of the unterminated value when it finishes its boundary, which must count as a line like every other row

query I
SELECT * FROM read_csv('data/csv/cast_then_unterminated_quote.csv', auto_detect=false, header=false, columns={'a': 'INTEGER[]'}, parallel=true, strict_mode=true, store_rejects=true);
----

query IIII
SELECT line, line_byte_position, error_type, csv_line FROM reject_errors ORDER BY line;
----
1	1	CAST	x
2	3	UNQUOTED VALUE	"abc

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

query I
SELECT * FROM read_csv('data/csv/two_casts_then_unterminated_quote.csv', auto_detect=false, header=false, columns={'a': 'INTEGER[]'}, parallel=true, strict_mode=true, store_rejects=true);
----

query IIII
SELECT line, line_byte_position, error_type, csv_line FROM reject_errors ORDER BY line;
----
1	1	CAST	x
2	3	CAST	1
3	5	UNQUOTED VALUE	"abc

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

# the same with the errors ignored and a rejects table
query I
SELECT * FROM read_csv('data/csv/two_casts_then_unterminated_quote.csv', auto_detect=false, header=false, columns={'a': 'INTEGER[]'}, parallel=true, strict_mode=true, ignore_errors=true, rejects_table='rejects');
----

query II
SELECT line, error_type FROM rejects ORDER BY line;
----
1	CAST
2	CAST
3	UNQUOTED VALUE

statement ok
DROP TABLE rejects;

# the quoted value crosses into the last buffer, the file ends inside it and the row before it is complete
query II
SELECT * FROM read_csv('data/csv/cast_then_unterminated_quote_two_columns.csv', auto_detect=false, header=false, columns={'a': 'INTEGER', 'b': 'VARCHAR'}, buffer_size=8, parallel=true, strict_mode=true, store_rejects=true);
----
1	a

query IIII
SELECT line, line_byte_position, error_type, csv_line FROM reject_errors ORDER BY line, error_type;
----
2	5	CAST	x,"abc
2	5	UNQUOTED VALUE	x,"abc

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

# the same file as above with the quoted value crossing into the last buffer
query I
SELECT * FROM read_csv('data/csv/two_casts_then_unterminated_quote.csv', auto_detect=false, header=false, columns={'a': 'INTEGER[]'}, buffer_size=6, parallel=true, strict_mode=true, store_rejects=true);
----

query IIII
SELECT line, line_byte_position, error_type, csv_line FROM reject_errors ORDER BY line, error_type;
----
1	1	CAST	x
2	3	CAST	1
3	5	CAST	"abc
3	5	UNQUOTED VALUE	"abc

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

# the same file read without parallelism takes the same end of file path
query II
SELECT * FROM read_csv('data/csv/cast_then_unterminated_quote_two_columns.csv', auto_detect=false, header=false, columns={'a': 'INTEGER', 'b': 'VARCHAR'}, buffer_size=8, parallel=false, strict_mode=true, store_rejects=true);
----
1	a

query IIII
SELECT line, line_byte_position, error_type, csv_line FROM reject_errors ORDER BY line, error_type;
----
2	5	CAST	x,"abc
2	5	UNQUOTED VALUE	x,"abc

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

# a cast done after parsing reports the text of the row the boundary ended in
query II
SELECT * FROM read_csv('data/csv/cast_then_unterminated_quote_two_columns.csv', auto_detect=false, header=false, columns={'a': 'INTEGER[]', 'b': 'VARCHAR'}, parallel=true, strict_mode=true, store_rejects=true);
----

query IIII
SELECT line, line_byte_position, error_type, csv_line FROM reject_errors ORDER BY line, error_type;
----
1	1	CAST	1,a
2	5	CAST	x,"abc
2	5	UNQUOTED VALUE	x,"abc

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

# the unterminated value is the second of three columns and crosses into the last buffer
query III
SELECT * FROM read_csv('data/csv/cast_then_unterminated_quote_three_columns.csv', auto_detect=false, header=false, columns={'a': 'INTEGER', 'b': 'VARCHAR', 'c': 'VARCHAR'}, buffer_size=10, parallel=true, strict_mode=true, store_rejects=true);
----
1	a	z

query IIII
SELECT line, line_byte_position, error_type, csv_line FROM reject_errors ORDER BY line, error_type;
----
2	7	CAST	x,"abc
2	7	UNQUOTED VALUE	x,"abc

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

# the value that crosses into the last buffer has an escaped quote, the unterminated quotes are reported once
query I
SELECT * FROM read_csv('data/csv/escaped_quote_then_unterminated.csv', auto_detect=false, header=false, columns={'a': 'INTEGER'}, buffer_size=3, parallel=true, strict_mode=true, store_rejects=true);
----

query IIII
SELECT line, line_byte_position, error_type, csv_line FROM reject_errors ORDER BY line, error_type;
----
1	1	CAST	"1""2
1	1	UNQUOTED VALUE	"1""2

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

# a malformed quoted value in each of the two columns, both are reported
query II
SELECT * FROM read_csv('data/csv/malformed_quotes_two_columns.csv', auto_detect=false, header=false, columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, buffer_size=16, parallel=true, strict_mode=true, store_rejects=true);
----

query IIIII
SELECT line, column_idx, byte_position, error_type, csv_line FROM reject_errors ORDER BY column_idx;
----
1	1	1	UNQUOTED VALUE	"a"b,"c"d
1	2	6	UNQUOTED VALUE	"a"b,"c"d

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

# a malformed quoted value before a quoted value that crosses into the last buffer and is left open, read without
# parallelism, which returned a garbage row before, with parallelism the boundary ends at the malformed value
query II
SELECT * FROM read_csv('data/csv/malformed_quote_then_unterminated.csv', auto_detect=false, header=false, columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, buffer_size=6, parallel=false, strict_mode=true, store_rejects=true);
----

query IIIII
SELECT line, column_idx, byte_position, error_type, csv_line FROM reject_errors ORDER BY column_idx;
----
1	1	1	UNQUOTED VALUE	"a"b,"c
1	2	6	UNQUOTED VALUE	"a"b,"c

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

# the same file in one buffer, the unterminated value at the end of the file is reported next to the malformed one
query II
SELECT * FROM read_csv('data/csv/malformed_quote_then_unterminated.csv', auto_detect=false, header=false, columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, buffer_size=16, parallel=true, strict_mode=true, store_rejects=true);
----

query IIIII
SELECT line, column_idx, byte_position, error_type, csv_line FROM reject_errors ORDER BY column_idx;
----
1	1	1	UNQUOTED VALUE	"a"b,"c
1	2	6	UNQUOTED VALUE	"a"b,"c

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

# only one of the two columns is read
query I
SELECT a FROM read_csv('data/csv/cast_then_unterminated_quote_two_columns.csv', auto_detect=false, header=false, columns={'a': 'INTEGER', 'b': 'VARCHAR'}, buffer_size=8, parallel=true, strict_mode=true, store_rejects=true);
----
1

query IIIII
SELECT line, column_idx, byte_position, error_type, csv_line FROM reject_errors ORDER BY column_idx;
----
2	1	5	CAST	x,"abc
2	2	7	UNQUOTED VALUE	x,"abc

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

query I
SELECT b FROM read_csv('data/csv/cast_then_unterminated_quote_two_columns.csv', auto_detect=false, header=false, columns={'a': 'INTEGER', 'b': 'VARCHAR'}, buffer_size=8, parallel=true, strict_mode=true, store_rejects=true);
----
a

query IIIII
SELECT line, column_idx, byte_position, error_type, csv_line FROM reject_errors ORDER BY column_idx;
----
2	2	7	UNQUOTED VALUE	x,"abc

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

# with the errors ignored and no rejects table the row is removed, when it is the first row of its chunk and when
# it crosses into the last buffer
query I
SELECT * FROM read_csv('data/csv/escaped_quote_then_unterminated.csv', auto_detect=false, header=false, columns={'a': 'INTEGER'}, parallel=true, strict_mode=true, ignore_errors=true);
----

query I
SELECT * FROM read_csv('data/csv/escaped_quote_then_unterminated.csv', auto_detect=false, header=false, columns={'a': 'INTEGER'}, buffer_size=3, parallel=true, strict_mode=true, ignore_errors=true);
----

query II
SELECT * FROM read_csv('data/csv/malformed_quote_then_unterminated.csv', auto_detect=false, header=false, columns={'a': 'VARCHAR', 'b': 'VARCHAR'}, buffer_size=6, parallel=false, strict_mode=true, ignore_errors=true);
----

query II
SELECT * FROM read_csv('data/csv/cast_then_unterminated_quote_two_columns.csv', auto_detect=false, header=false, columns={'a': 'INTEGER', 'b': 'VARCHAR'}, buffer_size=8, parallel=true, strict_mode=true, ignore_errors=true);
----
1	a

# the row with the unterminated value is the 2048th row of its chunk and crosses into the last buffer
foreach parallel true false

query II
SELECT count(*), sum(a) FROM read_csv('data/csv/unterminated_quote_at_vector_end.csv', auto_detect=false, header=false, columns={'a': 'INTEGER', 'b': 'VARCHAR'}, buffer_size=10239, parallel={parallel}, strict_mode=true, store_rejects=true);
----
2047	2047

query IIII
SELECT line, line_byte_position, error_type, csv_line FROM reject_errors;
----
2048	10236	UNQUOTED VALUE	2,"abc

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

endloop

# with the errors ignored and no rejects table, a last row whose cast fails and which crosses into the last buffer is
# removed when it is the first row of its chunk, and the connection stays usable afterwards
foreach parallel true false

# a header line and the row abc, which crosses into the last buffer
query I
SELECT a FROM read_csv('data/csv/header_then_cast_error_at_eof.csv', auto_detect=false, header=true, columns={'a': 'INTEGER'}, buffer_size=32, parallel={parallel}, strict_mode=true, ignore_errors=true);
----

query I
SELECT 42;
----
42

# the row abc is the whole file
query I
SELECT a FROM read_csv('data/csv/cast_error_at_eof.csv', auto_detect=false, header=false, columns={'a': 'INTEGER'}, buffer_size=2, parallel={parallel}, strict_mode=true, ignore_errors=true);
----

query I
SELECT 42;
----
42

query II
SELECT count(*), sum(a) FROM read_csv('data/csv/cast_error_at_eof.csv', auto_detect=false, header=false, columns={'a': 'INTEGER'}, buffer_size=2, parallel={parallel}, strict_mode=true, ignore_errors=true);
----
0	NULL

query I
SELECT 42;
----
42

# the row abc follows 2048 rows, so with the default vector size it starts the second chunk
query II
SELECT count(*), sum(a) FROM read_csv('data/csv/cast_error_at_eof_after_full_vector.csv', auto_detect=false, header=false, columns={'a': 'INTEGER'}, buffer_size=4097, parallel={parallel}, strict_mode=true, ignore_errors=true);
----
2048	2048

query I
SELECT 42;
----
42

endloop
