# name: test/issues/general/test_25967.test
# description: An UPDATE to a nested VARIANT constant stores the value an INSERT stores, whatever the nesting
# group: [general]

require json

# the optimizer folds the cast into a VARIANT constant, which the relation statistics do not render as SQL
statement ok
CREATE TABLE t (id INTEGER, doc VARIANT);

statement ok
INSERT INTO t VALUES (1, NULL), (2, (repeat('[' || array_to_string(range(50), ', ') || ', {"k": "it''s", "n": null}, ', 100) || '[]' ||
    repeat(']', 100))::JSON);

statement ok
UPDATE t SET doc = (repeat('[' || array_to_string(range(50), ', ') || ', {"k": "it''s", "n": null}, ', 100) || '[]' ||
    repeat(']', 100))::JSON WHERE id = 1;

query III
SELECT variant_typeof(a.doc), length(a.doc::JSON::VARCHAR), a.doc::JSON::VARCHAR = b.doc::JSON::VARCHAR
FROM t a, t b WHERE a.id = 1 AND b.id = 2;
----
ARRAY(52)	16402	true

# the issue's values, nested deeper than the 128 levels at which rendering a VARIANT as SQL fails
statement ok
UPDATE t SET doc = (repeat('[', 1000) || repeat(']', 1000))::JSON WHERE id = 1;

statement ok
UPDATE t SET doc = (repeat('[', 2000) || repeat(']', 2000))::JSON WHERE id = 1;

statement ok
INSERT INTO t VALUES (3, (repeat('[', 2000) || repeat(']', 2000))::JSON);

query II
SELECT variant_typeof(a.doc), a.doc = b.doc FROM t a, t b WHERE a.id = 1 AND b.id = 3;
----
ARRAY(1)	true

# an empty array inside 127 arrays or objects is the deepest value that casts back to JSON
statement ok
UPDATE t SET doc = (repeat('[', 127) || '[]' || repeat(']', 127))::JSON WHERE id = 1;

query I
SELECT doc::JSON::VARCHAR = repeat('[', 128) || repeat(']', 128) FROM t WHERE id = 1;
----
true

statement ok
UPDATE t SET doc = (repeat('{"a":', 127) || '[]' || repeat('}', 127))::JSON WHERE id = 1;

query I
SELECT doc::JSON::VARCHAR = repeat('{"a":', 127) || '[]' || repeat('}', 127) FROM t WHERE id = 1;
----
true
