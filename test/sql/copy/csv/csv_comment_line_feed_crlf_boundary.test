mode skip

query II
SELECT count(*), list(b ORDER BY b) FROM read_csv('{TEST_DIR}/comment_lf_boundary_quoted_field.csv', auto_detect = false, delim = ',', quote = '"', escape = '"', new_line = '\r\n', comment = '#', header = true, columns = {'a': 'VARCHAR', 'b': 'INTEGER'}, buffer_size = 20);
