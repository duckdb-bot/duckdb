# name: test/sql/subquery/any_all/test_union_null_member_correlated.test
# description: Correlated quantified comparisons and joins of a UNION whose active member is NULL see its NULL comparison (duckdblabs/bot-issue-tracker#691)
# group: [any_all]

statement ok
CREATE TABLE a(g INTEGER, x UNION(k INTEGER));

statement ok
INSERT INTO a VALUES (1, union_value(k := NULL::INTEGER)), (1, union_value(k := 1));

statement ok
CREATE TABLE b(g INTEGER, y UNION(k INTEGER));

statement ok
INSERT INTO b VALUES (1, union_value(k := 2)), (1, union_value(k := NULL::INTEGER));

query II
SELECT a.x, b.y FROM a JOIN b ON a.g = b.g AND a.x < b.y ORDER BY ALL;
----
1	2

query TII
SELECT x, x < ANY (SELECT y FROM b WHERE b.g = a.g), x IN (SELECT y FROM b WHERE b.g = a.g) FROM a ORDER BY ALL;
----
1	true	NULL
NULL	NULL	NULL

query I
SELECT count(*) FROM a WHERE x NOT IN (SELECT y FROM b WHERE b.g = a.g);
----
0

# every correlated quantified comparison against the three-valued result of its comparisons, for UNIONs with NULL
# members, other tags, NULL values and empty groups
statement ok
CREATE TABLE l(id INTEGER, x UNION(i INTEGER, s VARCHAR));

statement ok
INSERT INTO l VALUES (1, union_value(s := NULL::VARCHAR)), (2, union_value(s := 'a')), (3, union_value(i := NULL::INTEGER)),
	(4, union_value(i := 1)), (5, NULL), (6, union_value(i := 3)), (7, union_value(s := 'b'));

statement ok
CREATE TABLE r(g INTEGER, y UNION(i INTEGER, s VARCHAR));

statement ok
INSERT INTO r SELECT g, y FROM (VALUES (union_value(s := 'b')), (union_value(s := 'c')), (NULL),
	(union_value(i := 2)), (union_value(s := NULL::VARCHAR)), (union_value(i := 0)), (union_value(s := 'a')),
	(union_value(i := NULL::INTEGER))) v(y), range(1, 8) t(g)
WHERE hash(g, y::VARCHAR) % 3 = 0;

foreach op < <= > >= = <>

query I
SELECT count(*) FROM l, range(1, 9) t(g)
WHERE (l.x {op} ANY (SELECT y FROM r WHERE r.g = t.g)) IS DISTINCT FROM
	(SELECT CASE WHEN bool_or(l.x {op} y) THEN true WHEN bool_or((l.x {op} y) IS NULL) THEN NULL ELSE false END
	 FROM r WHERE r.g = t.g);
----
0

query I
SELECT count(*) FROM l, range(1, 9) t(g)
WHERE (l.x {op} ALL (SELECT y FROM r WHERE r.g = t.g)) IS DISTINCT FROM
	(SELECT CASE WHEN bool_or(NOT (l.x {op} y)) THEN false WHEN bool_or((l.x {op} y) IS NULL) THEN NULL ELSE true END
	 FROM r WHERE r.g = t.g);
----
0

query I
SELECT count(*) FROM l, range(1, 9) t(g)
WHERE (l.x {op} ANY (SELECT y FROM r WHERE r.g = t.g + l.id - l.id)) IS DISTINCT FROM
	(SELECT CASE WHEN bool_or(l.x {op} y) THEN true WHEN bool_or((l.x {op} y) IS NULL) THEN NULL ELSE false END
	 FROM r WHERE r.g = t.g);
----
0

# a hash join with an equality and the UNION inequality, and range joins that sort on other inequalities
query I
SELECT (SELECT count(*) FROM l JOIN r ON l.id = r.g AND l.x {op} r.y) -
	(SELECT count(*) FROM l, r WHERE (l.id = r.g AND l.x {op} r.y) IS TRUE);
----
0

endloop

statement ok
CREATE TABLE ml AS SELECT i % 2 AS a, CASE WHEN i % 2 = 0 THEN union_value(k := NULL::INTEGER) ELSE union_value(k := i) END::UNION(k INTEGER) x
FROM range(2000) t(i);

statement ok
CREATE TABLE mr AS SELECT i % 2 + 1 AS a, CASE WHEN i % 3 = 0 THEN union_value(k := NULL::INTEGER) ELSE union_value(k := i) END::UNION(k INTEGER) y
FROM range(2000) t(i);

statement ok
SET merge_join_threshold = 0;

query I
SELECT (SELECT count(*) FROM ml JOIN mr ON ml.a < mr.a AND ml.x < mr.y) -
	(SELECT count(*) FROM ml, mr WHERE (ml.a < mr.a AND ml.x < mr.y) IS TRUE);
----
0

query I
SELECT (SELECT count(*) FROM ml JOIN mr ON ml.a <= mr.a AND ml.x > mr.y AND ml.a + 1 >= mr.a) -
	(SELECT count(*) FROM ml, mr WHERE (ml.a <= mr.a AND ml.x > mr.y AND ml.a + 1 >= mr.a) IS TRUE);
----
0

statement ok
SET prefer_range_joins = true;

query I
SELECT (SELECT count(*) FROM ml JOIN mr ON ml.a = mr.a - 1 AND ml.a < mr.a AND ml.x < mr.y AND ml.x <= mr.y) -
	(SELECT count(*) FROM ml, mr WHERE (ml.a = mr.a - 1 AND ml.a < mr.a AND ml.x < mr.y AND ml.x <= mr.y) IS TRUE);
----
0
