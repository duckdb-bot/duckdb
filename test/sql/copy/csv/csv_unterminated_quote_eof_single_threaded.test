----
Value with unterminated quote found.

query II
SELECT count(*), sum(a) FROM read_csv('{TEST_DIR}/unterminated_quote_eof_2048.csv', auto_detect=false, header=false, columns={'a': 'INTEGER'}, parallel={parallel}, strict_mode=true, store_rejects=true);
----
2048	2096128

query II
