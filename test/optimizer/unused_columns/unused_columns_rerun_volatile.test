# name: test/optimizer/unused_columns/unused_columns_rerun_volatile.test
# description: A volatile column that loses its reader in statistics propagation is still computed
# group: [unused_columns]

# the pruning runs again on a plan that already carries projection maps
statement ok
SET debug_verify_column_bindings=true;

statement ok
CREATE TABLE v AS SELECT x FROM (VALUES (1), (2), (3)) t(x);

# the statistics decide the comparison of the derived column, which alone leaves the column in the plan
statement ok
CREATE SEQUENCE fold_sequence;

query I
SELECT list(c ORDER BY x) FROM (SELECT x, b > false AS c FROM (SELECT x, CASE WHEN nextval('fold_sequence') > 0 THEN true ELSE true END AS b FROM v));
----
[true, true, true]

query I
SELECT nextval('fold_sequence');
----
4

# a count that loses its argument makes the pruning run again
statement ok
CREATE SEQUENCE count_sequence;

query II
SELECT count(x), list(c ORDER BY x) FROM (SELECT x, b > false AS c FROM (SELECT x, CASE WHEN nextval('count_sequence') > 0 THEN true ELSE true END AS b FROM v));
----
3	[true, true, true]

query I
SELECT nextval('count_sequence');
----
4

# so does a WHERE clause that is true for every row
statement ok
CREATE SEQUENCE where_sequence;

query I
SELECT list(c ORDER BY x) FROM (SELECT x, b > false AS c FROM (SELECT x, CASE WHEN nextval('where_sequence') > 0 THEN true ELSE true END AS b FROM v)) WHERE x >= 1;
----
[true, true, true]

query I
SELECT nextval('where_sequence');
----
4

# the argument that the count loses is the volatile column itself
statement ok
CREATE SEQUENCE argument_sequence;

query II
SELECT x, count(b) FROM (SELECT x, CASE WHEN nextval('argument_sequence') > 0 THEN true ELSE true END AS b FROM v) GROUP BY x ORDER BY x;
----
1	1
2	1
3	1

query I
SELECT nextval('argument_sequence');
----
4

# an aggregate filter that is true for every row is dropped, the column it read is still computed
statement ok
CREATE SEQUENCE filter_sequence;

query I
SELECT sum(x) FILTER (WHERE b) FROM (SELECT x, CASE WHEN nextval('filter_sequence') > 0 THEN true ELSE true END AS b FROM v);
----
6

query I
SELECT nextval('filter_sequence');
----
4

# through a second derived table that passes the column on
statement ok
CREATE SEQUENCE nested_sequence;

query I
SELECT sum(x) FILTER (WHERE c) FROM (SELECT x, b AS c FROM (SELECT x, CASE WHEN nextval('nested_sequence') > 0 THEN true ELSE true END AS b FROM v));
----
6

query I
SELECT nextval('nested_sequence');
----
4

# a comparison and a NULL check of the column inside the filter
statement ok
CREATE SEQUENCE comparison_sequence;

query I
SELECT sum(x) FILTER (WHERE b > false) FROM (SELECT x, CASE WHEN nextval('comparison_sequence') > 0 THEN true ELSE true END AS b FROM v);
----
6

query I
SELECT nextval('comparison_sequence');
----
4

statement ok
CREATE SEQUENCE null_check_sequence;

query I
SELECT sum(x) FILTER (WHERE b IS NOT NULL) FROM (SELECT x, CASE WHEN nextval('null_check_sequence') > 0 THEN true ELSE true END AS b FROM v);
----
6

query I
SELECT nextval('null_check_sequence');
----
4

# a second derived table whose comparison of the column the statistics decide
statement ok
CREATE SEQUENCE projected_comparison_sequence;

query I
SELECT sum(x) FILTER (WHERE c) FROM (SELECT x, b > false AS c FROM (SELECT x, CASE WHEN nextval('projected_comparison_sequence') > 0 THEN true ELSE true END AS b FROM v));
----
6

query I
SELECT nextval('projected_comparison_sequence');
----
4

# below an ORDER BY, whose columns can be compressed and restored by projections
statement ok
CREATE SEQUENCE order_sequence;

query I
SELECT first(x) FILTER (WHERE b) FROM (SELECT x, CASE WHEN nextval('order_sequence') > 0 THEN true ELSE true END AS b FROM v ORDER BY x DESC);
----
3

query I
SELECT nextval('order_sequence');
----
4

# below a join that compresses only its other side
statement ok
CREATE TEMPORARY TABLE payload AS SELECT x, x::VARIANT AS vx FROM (VALUES (1), (2), (3)) t(x);

statement ok
CREATE TABLE joined AS SELECT * FROM (VALUES (10, false), (20, true)) t(x, k);

statement ok
CREATE SEQUENCE join_sequence;

query II
SELECT sum(joined.x) FILTER (WHERE q.c), list(q.vx ORDER BY q.vx::INT)
FROM (SELECT x % 2 = 0 AS k, vx, b > false AS c FROM (SELECT x, vx, CASE WHEN nextval('join_sequence') > 0 THEN true ELSE true END AS b FROM payload)) q JOIN joined ON q.k = joined.k;
----
40	[1, 2, 3]

query I
SELECT nextval('join_sequence');
----
4

# a materialized CTE, whose columns are pruned through a projection of their own
statement ok
CREATE SEQUENCE cte_sequence;

query I
WITH m AS MATERIALIZED (SELECT x, CASE WHEN nextval('cte_sequence') > 0 THEN true ELSE true END AS b FROM v)
SELECT sum(x) FILTER (WHERE b) FROM m;
----
6

query I
SELECT nextval('cte_sequence');
----
4

# a UNION ALL, whose columns are pruned through a projection in each child
statement ok
CREATE SEQUENCE union_sequence;

query I
SELECT sum(x) FILTER (WHERE b) FROM (
	SELECT x, CASE WHEN nextval('union_sequence') > 0 THEN true ELSE true END AS b FROM v
	UNION ALL
	SELECT x, CASE WHEN nextval('union_sequence') > 0 THEN true ELSE true END AS b FROM v);
----
12

query I
SELECT nextval('union_sequence');
----
7

# a scalar subquery runs once
statement ok
CREATE SEQUENCE subquery_sequence;

query I
SELECT sum(x) FILTER (WHERE (SELECT CASE WHEN nextval('subquery_sequence') > 0 THEN true ELSE true END)) FROM v;
----
6

query I
SELECT nextval('subquery_sequence');
----
2

# also in the CASE form that is rewritten into a filter
statement ok
CREATE SEQUENCE case_sequence;

query I
SELECT sum(CASE WHEN (SELECT CASE WHEN nextval('case_sequence') > 0 THEN true ELSE true END) THEN x END) FROM v;
----
6

query I
SELECT nextval('case_sequence');
----
2

# a volatile aggregate whose reader the statistics decide
statement ok
CREATE SEQUENCE aggregate_sequence;

query I
SELECT sum(x) FILTER (WHERE b IS NULL) FROM (SELECT x, first(CASE WHEN nextval('aggregate_sequence') > 0 THEN NULL::INTEGER ELSE NULL::INTEGER END) AS b FROM v GROUP BY x);
----
6

query I
SELECT nextval('aggregate_sequence');
----
4

statement ok
CREATE SEQUENCE aggregate_fold_sequence;

query II
SELECT count(x), list(c ORDER BY x) FROM (SELECT x, b IS NULL AS c FROM (SELECT x, first(CASE WHEN nextval('aggregate_fold_sequence') > 0 THEN NULL::INTEGER ELSE NULL::INTEGER END) AS b FROM v GROUP BY x));
----
3	[true, true, true]

query I
SELECT nextval('aggregate_fold_sequence');
----
4

# an ungrouped count over a volatile column is not answered from the row count of the table
statement ok
CREATE SEQUENCE ungrouped_sequence;

query I
SELECT count(b) FROM (SELECT x, CASE WHEN nextval('ungrouped_sequence') > 0 THEN true ELSE true END AS b FROM v);
----
3

query I
SELECT nextval('ungrouped_sequence');
----
4

statement ok
CREATE SEQUENCE count_filter_sequence;

query I
SELECT count(*) FILTER (WHERE b) FROM (SELECT x, CASE WHEN nextval('count_filter_sequence') > 0 THEN true ELSE true END AS b FROM v);
----
3

query I
SELECT nextval('count_filter_sequence');
----
4

statement ok
CREATE SEQUENCE count_where_sequence;

query I
SELECT count(*) FROM (SELECT x, b > false AS c FROM (SELECT x, CASE WHEN nextval('count_where_sequence') > 0 THEN true ELSE true END AS b FROM v)) WHERE c;
----
3

query I
SELECT nextval('count_where_sequence');
----
4

# a top-N window rewrite with late materialization makes the pruning run again as well
statement ok
CREATE TABLE t AS SELECT i AS x, i % 5 AS g, md5(i::VARCHAR) AS p FROM range(1000) r(i);

statement ok
CREATE SEQUENCE late_materialization_sequence;

query IIII
SELECT sum(q.x), bool_and(q.c), sum(w.x), sum(length(w.p))
FROM (SELECT x, b > false AS c FROM (SELECT x, CASE WHEN nextval('late_materialization_sequence') > 0 THEN true ELSE true END AS b FROM v)) q
CROSS JOIN (SELECT x, g, p FROM t QUALIFY row_number() OVER (PARTITION BY g ORDER BY x) <= 2) w;
----
60	true	135	960

query I
SELECT nextval('late_materialization_sequence');
----
4

# the pruning inside the top-N window rewrite
statement ok
CREATE SEQUENCE top_n_sequence;

query III
SELECT count(*), bool_and(c), sum(x)
FROM (SELECT x, c FROM (SELECT x, g, b > false AS c FROM (SELECT x, g, CASE WHEN nextval('top_n_sequence') > 0 THEN true ELSE true END AS b FROM t)) QUALIFY row_number() OVER (PARTITION BY g ORDER BY x) <= 2);
----
10	true	45

query I
SELECT nextval('top_n_sequence');
----
1001

# a scalar subquery that returns more than one row raises its error
statement error
SELECT sum(x) FILTER (WHERE CASE WHEN (SELECT x FROM v) > 0 THEN true ELSE true END) FROM v;
----
More than one row returned by a subquery
