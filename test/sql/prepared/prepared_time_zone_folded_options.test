# name: test/sql/prepared/prepared_time_zone_folded_options.test
# description: Prepared percentile fractions and UNNEST options folded from a cast that reads the TimeZone are bound again at every execution
# group: [prepared]

require icu

statement ok
SET TimeZone = 'UTC';

# the cast of the epoch to TIMESTAMP gives midnight in UTC and one in the morning in Amsterdam, which the fraction
# and the options below depend on; the fraction is folded to a constant when the aggregate is bound
statement ok
PREPARE fraction AS SELECT percentile_cont(CASE WHEN to_timestamp(1767225600)::TIMESTAMP = TIMESTAMP '2026-01-01 00:00:00' THEN 0.0 ELSE 1.0 END) WITHIN GROUP (ORDER BY v) FROM (VALUES (0), (10)) t(v);

# the fractions of a descending percentile are negated when they are folded
statement ok
PREPARE fraction_desc AS SELECT percentile_disc(CASE WHEN to_timestamp(1767225600)::TIMESTAMP = TIMESTAMP '2026-01-01 00:00:00' THEN 0.0 ELSE 1.0 END) WITHIN GROUP (ORDER BY v DESC) FROM (VALUES (0), (10)) t(v);

# a list of fractions is folded element by element
statement ok
PREPARE fraction_list AS SELECT percentile_cont([CASE WHEN to_timestamp(1767225600)::TIMESTAMP = TIMESTAMP '2026-01-01 00:00:00' THEN 0.0 ELSE 1.0 END, 0.5]) WITHIN GROUP (ORDER BY v) FROM (VALUES (0), (10)) t(v);

# the options of UNNEST are folded when it is bound
statement ok
PREPARE recursive_option AS SELECT UNNEST([[1]], recursive := to_timestamp(1767225600)::TIMESTAMP = TIMESTAMP '2026-01-01 00:00:00');

statement ok
PREPARE depth_option AS SELECT UNNEST([[[1]]], max_depth := CASE WHEN to_timestamp(1767225600)::TIMESTAMP = TIMESTAMP '2026-01-01 00:00:00' THEN 1 ELSE 2 END);

# a fraction and an option that do not read a setting
statement ok
PREPARE plain_fraction AS SELECT percentile_cont('0.5'::DOUBLE) WITHIN GROUP (ORDER BY v) FROM (VALUES (0), (10)) t(v);

statement ok
PREPARE plain_option AS SELECT UNNEST([[1]], recursive := '1'::BOOLEAN);

query I
EXECUTE fraction;
----
0.0

query I
EXECUTE fraction_desc;
----
10

query I
EXECUTE fraction_list;
----
[0.0, 5.0]

query I
EXECUTE recursive_option;
----
1

query I
EXECUTE depth_option;
----
[[1]]

query I
EXECUTE plain_fraction;
----
5.0

query I
EXECUTE plain_option;
----
1

statement ok
SET TimeZone = 'Europe/Amsterdam';

query I
EXECUTE fraction;
----
10.0

query I
SELECT percentile_cont(CASE WHEN to_timestamp(1767225600)::TIMESTAMP = TIMESTAMP '2026-01-01 00:00:00' THEN 0.0 ELSE 1.0 END) WITHIN GROUP (ORDER BY v) FROM (VALUES (0), (10)) t(v);
----
10.0

query I
EXECUTE fraction_desc;
----
0

query I
EXECUTE fraction_list;
----
[10.0, 5.0]

query I
EXECUTE recursive_option;
----
[1]

query I
SELECT UNNEST([[1]], recursive := to_timestamp(1767225600)::TIMESTAMP = TIMESTAMP '2026-01-01 00:00:00');
----
[1]

query I
EXECUTE depth_option;
----
[1]

query I
EXECUTE plain_fraction;
----
5.0

query I
EXECUTE plain_option;
----
1

# the statements that read the TimeZone keep no plan, the others keep theirs
query II
SELECT name, result_types IS NULL AS bound_again FROM duckdb_prepared_statements()
WHERE name IN ('fraction', 'fraction_desc', 'fraction_list', 'recursive_option', 'depth_option', 'plain_fraction', 'plain_option')
ORDER BY name;
----
depth_option	true
fraction	true
fraction_desc	true
fraction_list	true
plain_fraction	false
plain_option	false
recursive_option	true

# back in UTC the statements give their first results again
statement ok
SET TimeZone = 'UTC';

query I
EXECUTE fraction;
----
0.0

query I
EXECUTE recursive_option;
----
1
