# name: test/sql/join/hash_join/hash_join_dominant_partition.test
# description: a join with a dominant partition only turns external where an external join holds less in memory
# group: [hash_join]

# a restart between the statements would discard the operator log
require skip_reload

statement ok
SET threads = 1;

# every reservation gets its minimum, as when other operators hold the memory
statement ok
SET debug_force_external = true;

# a recursive CTE only retains a build when it reuses its operator states
statement ok
SET enable_caching_operators = true;

statement ok
SET disabled_optimizers = 'join_order,build_side_probe_side';

statement ok
CALL enable_logging('PhysicalOperator');

# all build rows share one key, so one partition holds the whole build and nothing can spill
query I
SELECT count(*)
FROM range(10) t(i) JOIN (SELECT 7 AS k, i AS v FROM range(500000) s(i)) b ON t.i = b.k;
----
500000

# nine of ten build rows share one key, and the pointer table of their partition is larger than the direct lookup
query I
SELECT count(*)
FROM range(10) t(i)
JOIN (SELECT CASE WHEN i % 10 = 0 THEN (i // 10) % 1000 ELSE 7 END AS k, i AS v FROM range(500000) s(i)) b
ON t.i = b.k;
----
450500

statement ok
CALL disable_logging();

query II
SELECT count(*) FILTER (WHERE info['external'] = '1'), count(*) FILTER (WHERE info['external'] = '0') >= 2
FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'PhysicalHashJoin' AND event = 'Finalize';
----
0	true

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

# the same share of equal keys without a direct lookup, the other partitions spill while the largest one is built
query I
SELECT count(*)
FROM range(10) t(i)
JOIN (SELECT CASE WHEN i % 10 = 0 THEN i * 1000003 ELSE 7 END AS k FROM range(1000000) s(i)) b ON t.i = b.k;
----
900001

statement ok
CALL disable_logging();

query I
SELECT count(*) FILTER (WHERE info['external'] = '1') >= 1
FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'PhysicalHashJoin' AND event = 'Finalize';
----
true

statement ok
RESET disabled_optimizers;

statement ok
CREATE TABLE edges AS SELECT i AS src, i + 1 AS dst FROM range(500000) t(i);

statement ok
CALL truncate_duckdb_logs();

statement ok
CALL enable_logging('PhysicalOperator');

# the first build has 16 partitions and spills, later iterations build a single partition, which is kept for reuse
query III
WITH RECURSIVE walk(node, depth) AS (
	SELECT 0::BIGINT, 0
	UNION ALL
	SELECT e.dst, w.depth + 1
	FROM walk w
	JOIN edges e ON e.src = w.node
	WHERE w.depth < 3
)
SELECT count(*), max(depth), sum(node) FROM walk;
----
4	3	6

statement ok
CALL disable_logging();

query I
SELECT info.retained_build_executions::UBIGINT
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class = 'PhysicalRecursiveCTE' AND event = 'RuntimeMetrics' AND parameters['CTE Name'] = 'walk';
----
1

query I
SELECT count(*) FILTER (WHERE info['external'] = '0') >= 1
FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'PhysicalHashJoin' AND event = 'Finalize';
----
true
