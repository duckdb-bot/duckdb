query IIII
SELECT iv = to_months(2147483647) + to_days(2147483647) + to_microseconds(86400000000), datepart('day', iv) = 2147483647, datepart('microseconds', iv) = 0, hash(iv) = hash(to_months(2147483647) + to_days(2147483647) + to_microseconds(86400000000)) FROM read_parquet('{TEST_DIR}/external_good.parquet', file_row_number=true) WHERE file_row_number=6;
