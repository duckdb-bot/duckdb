# name: test/sql/alter/test_alter_database_rename_file.test
# description: Attaching the file of a renamed database again
# group: [alter]

statement ok
SET GLOBAL max_execution_time = 10000;

statement ok
ATTACH '{TEST_DIR}/rename_file.db' AS orig_name;

statement ok
CREATE TABLE orig_name.t AS SELECT range AS i FROM range(3);

statement ok
ALTER DATABASE orig_name SET ALIAS TO other_name;

statement error
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS orig_name;
----
already attached by database "other_name"

query I
SELECT database_name FROM duckdb_databases() WHERE NOT internal ORDER BY ALL;
----
memory
other_name

statement ok
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS other_name;

query I
SELECT count(*) FROM other_name.t;
----
3

statement error
ATTACH '{TEST_DIR}/rename_file.db' AS third;
----
already attached by database "other_name"

# the rename can spell the name in another case
statement ok
ALTER DATABASE OTHER_NAME SET ALIAS TO orig_name;

statement ok
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS orig_name;

statement error
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS other_name;
----
already attached by database "orig_name"

# detaching the renamed database frees the file
statement ok
DETACH orig_name;

statement ok
ATTACH '{TEST_DIR}/rename_file.db' AS fresh;

query I
SELECT count(*) FROM fresh.t;
----
3

statement ok
DETACH fresh;

# the same file attached read-only under two names
statement ok
ATTACH '{TEST_DIR}/rename_file.db' AS r1 (READ_ONLY);

statement ok
ATTACH '{TEST_DIR}/rename_file.db' AS r2 (READ_ONLY);

statement ok
ALTER DATABASE r1 SET ALIAS TO r3;

statement ok
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS r2 (READ_ONLY);

statement ok
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS r3 (READ_ONLY);

statement ok
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS r1 (READ_ONLY);

query I
SELECT database_name FROM duckdb_databases() WHERE NOT internal ORDER BY ALL;
----
memory
r1
r2
r3

statement ok
DETACH r2;

statement ok
DETACH r3;

query I
SELECT count(*) FROM r1.t;
----
3

statement ok
DETACH r1;

statement ok
ATTACH '{TEST_DIR}/rename_file.db' AS writable;

statement ok
INSERT INTO writable.t VALUES (3);

statement ok
DETACH writable;

# an attach that fails or is rolled back leaves no name behind
statement ok
ATTACH '{TEST_DIR}/rename_file.db' AS anchor (READ_ONLY);

statement error
ATTACH '{TEST_DIR}/rename_file.db' AS failed (READ_ONLY, UNKNOWN_OPTION 1);
----
Unrecognized option

statement ok
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS failed (READ_ONLY);

statement ok
BEGIN;

statement ok
ATTACH '{TEST_DIR}/rename_file.db' AS rolled_back (READ_ONLY);

statement ok
ROLLBACK;

statement ok
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS rolled_back (READ_ONLY);

query I
SELECT database_name FROM duckdb_databases() WHERE NOT internal ORDER BY ALL;
----
anchor
failed
memory
rolled_back

statement ok
DETACH anchor;

statement ok
DETACH failed;

statement ok
DETACH rolled_back;

# a renamed database that another transaction still uses after the detach
statement ok con1
ATTACH '{TEST_DIR}/rename_file.db' AS kept;

statement ok con1
ALTER DATABASE kept SET ALIAS TO kept_renamed;

statement ok con2
BEGIN;

query I con2
SELECT count(*) FROM kept_renamed.t;
----
4

statement ok con1
DETACH kept_renamed;

statement error con1
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS kept_renamed;
----
in the process of being detached

statement ok con2
COMMIT;

statement ok con1
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS kept_renamed;

query I con1
SELECT count(*) FROM kept_renamed.t;
----
4

statement ok con1
DETACH kept_renamed;

# a rolled back attach that another transaction still uses
statement ok con1
BEGIN;

statement ok con1
ATTACH '{TEST_DIR}/rename_file.db' AS rolled;

statement ok con1
ALTER DATABASE rolled SET ALIAS TO rolled_renamed;

statement ok con2
BEGIN;

query I con2
SELECT count(*) FROM rolled_renamed.t;
----
4

statement ok con1
ROLLBACK;

statement error con1
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS rolled_renamed;
----
in the process of being detached

statement ok con2
COMMIT;

statement ok con1
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS rolled_renamed;

statement ok con1
DETACH rolled_renamed;

# a hidden attach that another transaction still uses after its detach
statement ok con1
ATTACH '{TEST_DIR}/rename_file.db' AS hidden_db (HIDDEN true);

statement ok con1
ALTER DATABASE hidden_db SET ALIAS TO hidden_renamed;

statement ok con2
BEGIN;

query I con2
SELECT count(*) FROM hidden_renamed.t;
----
4

statement ok con1
DETACH hidden_renamed;

statement error con1
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS hidden_renamed;
----
in the process of being detached

statement ok con2
COMMIT;

statement ok con1
ATTACH IF NOT EXISTS '{TEST_DIR}/rename_file.db' AS hidden_renamed;

query I con1
SELECT count(*) FROM hidden_renamed.t;
----
4
