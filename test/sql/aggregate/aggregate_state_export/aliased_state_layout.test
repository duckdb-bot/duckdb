# name: test/sql/aggregate/aggregate_state_export/aliased_state_layout.test
# description: States whose layout has an alias of its own can be finalized and combined
# group: [aggregate_state_export]

require json

query I
SELECT finalize(max(j) EXPORT_STATE) FROM (VALUES ('{"a": 1}'::JSON), ('[2]'::JSON)) t(j);
----
{"a": 1}

query I
SELECT finalize(combine(max(j) EXPORT_STATE, max(j) EXPORT_STATE)) FROM (VALUES ('{"a": 1}'::JSON), ('[2]'::JSON)) t(j);
----
{"a": 1}
