# name: test/sql/copy/parquet/bloom_filter_decimal_flba16.test
# description: Bloom filters of 16-byte decimal columns are probed for the fixed-size tiers, a wide decimal is not probed
# group: [parquet]

require parquet

# both fixtures hold 0 to 19 ten times each in a 16-byte FIXED_LEN_BYTE_ARRAY with a dictionary and a bloom filter,
# written by DuckDB as DECIMAL(38,0) with the declared precision changed in the footer

# decimal(18,0), which is read through the INT64 tier, is hashed like the 16 bytes the writer hashed
query I
SELECT typeof(h) FROM 'data/parquet-testing/decimal/decimal18_flba16_bloom.parquet' LIMIT 1
----
DECIMAL(18,0)

query I
SELECT count(*) FROM 'data/parquet-testing/decimal/decimal18_flba16_bloom.parquet' WHERE h = 5
----
10

query I
SELECT count(*) FROM 'data/parquet-testing/decimal/decimal18_flba16_bloom.parquet' WHERE h IN (3, 1000)
----
10

query I
SELECT bloom_filter_excludes FROM parquet_bloom_probe('data/parquet-testing/decimal/decimal18_flba16_bloom.parquet', 'h', 5)
----
false

query I
SELECT bloom_filter_excludes FROM parquet_bloom_probe('data/parquet-testing/decimal/decimal18_flba16_bloom.parquet', 'h', 1000)
----
true

# decimal(39,0) is a wide decimal, a BIGNUM blob, so its bloom filter is not probed
query I
SELECT typeof(h) FROM 'data/parquet-testing/decimal/wide_decimal_flba16_bloom.parquet' LIMIT 1
----
DECIMAL(39,0)

query I
SELECT count(*) FROM 'data/parquet-testing/decimal/wide_decimal_flba16_bloom.parquet' WHERE h = 5
----
10

query I
SELECT count(*) FROM 'data/parquet-testing/decimal/wide_decimal_flba16_bloom.parquet' WHERE h IN (3, 1000)
----
10

query I
SELECT count(*) FROM 'data/parquet-testing/decimal/wide_decimal_flba16_bloom.parquet' WHERE h = 1000
----
0

query I
SELECT bloom_filter_excludes FROM parquet_bloom_probe('data/parquet-testing/decimal/wide_decimal_flba16_bloom.parquet', 'h', 1000)
----
false
