----
32	32

endloop

# a bare line feed behind a closing quote is invalid data, the thread starting at that line feed does not take the rest of the rejected record for a row
statement ok
COPY (SELECT '1' || chr(13) || chr(10) || '1' || chr(13) || chr(10) || '"abc"' || chr(10) || '2' || chr(13) || chr(10) || '3' || chr(13)) TO '{TEST_DIR}/comment_lf_boundary_quote_lf.csv' (HEADER false, QUOTE '', DELIM '|');

query I
