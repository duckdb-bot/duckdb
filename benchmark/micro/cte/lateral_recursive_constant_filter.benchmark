# name: benchmark/micro/cte/lateral_recursive_constant_filter.benchmark
# description: A constant filter on the outer key of three nested correlated LATERAL joins with a recursive CTE
# group: [cte]

name Lateral Recursive Constant Filter
group micro
subgroup cte

load
CREATE TABLE person AS SELECT i AS id FROM range(1000000) t(i);

run
SELECT max(q.x)
FROM person o, LATERAL (
    SELECT p.x
    FROM person m, LATERAL (
        SELECT r.x
        FROM person i, LATERAL (
            WITH RECURSIVE walk(x) AS (
                SELECT i.id
                UNION ALL
                SELECT x + 1 FROM walk WHERE x < i.id + 2
            )
            SELECT x FROM walk
        ) r
        WHERE i.id = m.id
    ) p
    WHERE m.id = o.id
) q
WHERE o.id = 3;

result I
5
