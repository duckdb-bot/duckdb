# name: test/sql/copy/parquet/writer/parquet_write_uhugeint.test
# description: Parquet uhugeint round trip
# group: [writer]

require parquet

statement ok
CREATE TABLE hugeints(h UHUGEINT)

statement ok
INSERT INTO hugeints VALUES (0), (1), (NULL), (1180591620717411303424)

statement ok
COPY hugeints TO '{TEST_DIR}/hugeints.parquet' (FORMAT 'parquet');

query I
SELECT * FROM '{TEST_DIR}/hugeints.parquet'
----
0
1
NULL
1180591620717411303424

query I
SELECT typeof(h) FROM '{TEST_DIR}/hugeints.parquet' LIMIT 1
----
DECIMAL(38,0)


statement ok
COPY (SELECT * FROM (VALUES (1, 9007199254740993::UHUGEINT), (2, 99999999999999999999999999999999999999)) t(i, h)) TO '{TEST_DIR}/uhugeints_exact.parquet' (FORMAT parquet);

query II
SELECT i, h::UHUGEINT FROM '{TEST_DIR}/uhugeints_exact.parquet' ORDER BY i
----
1	9007199254740993
2	99999999999999999999999999999999999999

statement error
COPY (SELECT 340282366920938463463374607431768211455::UHUGEINT AS h) TO '{TEST_DIR}/uhugeints_over.parquet' (FORMAT parquet);
----
Could not write UHUGEINT value 340282366920938463463374607431768211455 to Parquet
