# name: benchmark/micro/list/short_list_sparse_filter.benchmark
# description: Filter tables of one-element and two-element lists that keep few rows
# group: [list]

name Short List Sparse Filter
group micro
subgroup list

load
CREATE TABLE t AS SELECT i AS id, i % 1000 AS k, [i] AS l1, [i, i] AS l2 FROM range(5000000) r(i);

run
SELECT sum(len(l1)), sum(len(l2)) FROM t WHERE k = 1

result II
5000	10000
