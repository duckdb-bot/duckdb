# name: test/sql/catalog/function/test_macro_own_schema.test
# description: The body of a macro looks names up in the schema of the macro first, as a view does
# group: [function]

statement ok
ATTACH '{TEST_DIR}/macro_own_schema.db' AS db;

statement ok
CREATE MACRO db.foo() AS TABLE SELECT 'db.foo' AS text;

statement ok
CREATE MACRO db.bar() AS TABLE SELECT * FROM foo();

statement ok
CREATE MACRO db.baz() AS (SELECT text FROM foo());

statement ok
CREATE MACRO db.s1(x) AS x + 1;

statement ok
CREATE MACRO db.s2(x) AS s1(x) * 2;

statement ok
CREATE TABLE db.t AS SELECT 42 AS v;

statement ok
CREATE MACRO db.from_t() AS TABLE SELECT * FROM t;

statement ok
CREATE MACRO db.sum_t() AS (SELECT sum(v) FROM t);

statement ok
CREATE TYPE db.mood AS ENUM ('db');

statement ok
CREATE MACRO db.cast_mood() AS 'db'::mood;

statement ok
CREATE MACRO db.with_cte() AS TABLE WITH t AS (SELECT 1 AS v) SELECT * FROM t;

statement ok
CREATE MACRO db.uses_builtin(x) AS abs(x);

statement ok
CREATE MACRO db.add_one(x) AS x + 1;

statement ok
CREATE MACRO db.echo(x) AS TABLE SELECT x AS v;

statement ok
CREATE MACRO db.self_cte() AS TABLE WITH t AS (SELECT * FROM t) SELECT * FROM t;

statement ok
CREATE MACRO db.later_cte() AS TABLE WITH a AS (SELECT * FROM t), t AS (SELECT 5 AS v) SELECT * FROM a;

statement ok
CREATE TABLE db.r AS SELECT 100 AS v;

statement ok
CREATE MACRO db.recursive_cte() AS TABLE
WITH RECURSIVE r AS (SELECT v FROM r UNION ALL SELECT v + 1 FROM r WHERE v < 102) SELECT sum(v) FROM r;

# the aggregates of USING KEY are bound with the search path of the session at CREATE
statement ok
USE db;

statement ok
CREATE MACRO recursive_key() AS TABLE
WITH RECURSIVE r(k, v) USING KEY (k, max(s1(v)) AS v) AS (VALUES (1, 10) UNION ALL SELECT k + 1, v + 1 FROM r WHERE k < 2)
SELECT * FROM r ORDER BY k;

statement ok
USE memory;

statement ok
CREATE MACRO db.pivot_cte() AS TABLE PIVOT (WITH t AS (SELECT 'a' AS k, 7 AS v) SELECT * FROM t) ON k IN ('a') USING sum(v);

statement ok
CREATE MACRO db.star_replace() AS TABLE SELECT * REPLACE (s1(a) AS a) FROM (VALUES (1, 2)) t(a, b);

statement ok
CREATE MACRO db.columns_s1() AS TABLE SELECT s1(COLUMNS(*)) FROM (VALUES (1, 2)) t(a, b);

statement ok
CREATE MACRO db.param_name(x := 2) AS TABLE SELECT s1(x);

statement ok
CREATE MACRO db.arg_columns(x) AS TABLE SELECT s1(x) FROM (VALUES (1, 2)) t(a, b);

statement ok
CREATE MACRO db.pivot_in() AS TABLE PIVOT (SELECT 2 AS k, 42 AS v) ON k IN (s1(1)) USING sum(v);

statement ok
CREATE MACRO db.unpivot_on() AS TABLE UNPIVOT (SELECT 1 AS a) ON (s1(a)) INTO NAME k VALUE v;

statement ok
CREATE MACRO db.pivot_names() AS TABLE PIVOT (SELECT 'a' AS k, 5 AS v) ON k IN ('a') USING sum(s1(v)), max(v);

statement ok
CREATE MACRO db.match_names() AS TABLE SELECT * FROM (VALUES (1), (1), (2)) t(i)
MATCH_RECOGNIZE (PARTITION BY s1(i) ORDER BY i MEASURES count(*) AS n ONE ROW PER MATCH PATTERN (A+) DEFINE A AS true);

statement ok
CREATE TABLE db.dt AS SELECT -1 AS v;

statement ok
CREATE MACRO db.unused_dt() AS TABLE WITH unused AS (SELECT * FROM dt) SELECT 1 AS v;

statement ok
CREATE MACRO db.pivot_columns() AS TABLE PIVOT (SELECT 'a' AS k, 5 AS v) ON k IN ('a') USING sum(s1(COLUMNS('v'))), max(v);

statement ok
DETACH db;

statement ok
ATTACH '{TEST_DIR}/macro_own_schema.db' AS db;

query T
SELECT * FROM db.bar()
----
db.foo

query T
SELECT db.baz()
----
db.foo

query I
SELECT db.s2(1)
----
4

query I
SELECT * FROM db.from_t()
----
42

query I
SELECT db.sum_t()
----
42

query TT
SELECT db.cast_mood()::VARCHAR, typeof(db.cast_mood())
----
db	ENUM('db')

# names of the calling database do not shadow the ones of the macro
statement ok
CREATE MACRO foo() AS TABLE SELECT 'memory.foo' AS text;

statement ok
CREATE TABLE t AS SELECT -1 AS v;

statement ok
CREATE MACRO s1(x) AS x + 100;

statement ok
CREATE TYPE mood AS ENUM ('memory');

query T
SELECT * FROM db.bar()
----
db.foo

query T
SELECT db.baz()
----
db.foo

query I
SELECT db.s2(1)
----
4

query I
SELECT * FROM db.from_t()
----
42

query T
SELECT db.cast_mood()::VARCHAR
----
db

statement ok
CREATE TABLE r AS SELECT -100 AS v;

# a CTE sees the table of its own name and the CTEs before it, the recursive part of a recursive CTE sees itself
query I
SELECT * FROM db.self_cte()
----
42

query I
SELECT * FROM db.later_cte()
----
42

query I
SELECT * FROM db.recursive_cte()
----
303

query II
SELECT * FROM db.recursive_key()
----
1	11
2	12

query I
WITH t AS (SELECT * FROM db.from_t()) SELECT * FROM t
----
42

query I
SELECT * FROM db.pivot_cte()
----
7

# a column keeps the name it has without the qualification
query II
SELECT a, b FROM db.star_replace()
----
2	2

query II
SELECT a, b FROM db.columns_s1()
----
2	3

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM db.param_name())
----
s1(2)	INTEGER

query I
SELECT * FROM db.param_name()
----
3

query II
SELECT a, b FROM db.arg_columns(COLUMNS(*))
----
2	3

query I
SELECT "2" FROM db.pivot_in()
----
42

query TI
SELECT * FROM db.unpivot_on()
----
a	2

query I
SELECT "a_sum(s1(v))" FROM db.pivot_names()
----
6

query II
SELECT "s1(i)", n FROM db.match_names() ORDER BY 1
----
2	2
3	1

query I
SELECT "a_sum(s1(COLUMNS('v')))" FROM db.pivot_columns()
----
6

# a name the body does not bind is not looked up as an error
statement ok
ATTACH ':memory:' AS dt (DEFAULT_TABLE 'real_t');

statement ok
CREATE TABLE dt.real_t AS SELECT 42 AS v;

query I
SELECT * FROM db.unused_dt()
----
1

statement ok
DETACH dt;

# the arguments still resolve where the macro is called
query I
SELECT db.add_one(s1(0))
----
101

query I
SELECT * FROM db.echo(s1(0))
----
100

# a CTE of the body is the body's, a CTE of the calling query is visible in the body as before
query I
SELECT * FROM db.with_cte()
----
1

query I
WITH t AS (SELECT 7 AS v) SELECT * FROM db.from_t()
----
7

# names the schema of the macro does not have resolve where the macro is called, as before
query I
SELECT db.uses_builtin(-3)
----
3

statement ok
CREATE MACRO only_memory(x) AS x * 10;

statement ok
CREATE MACRO db.calls_only_memory(x) AS only_memory(x);

query I
SELECT db.calls_only_memory(2)
----
20

# a column named after an expression keeps its name
statement ok
CREATE MACRO db.named() AS TABLE SELECT s1(1), s1(2) AS two;

query II
SELECT * FROM db.named()
----
2	3

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM db.named())
----
s1(1)	INTEGER
two	INTEGER

# a macro of the calling database is unchanged
statement ok
CREATE MACRO uses_s1() AS s1(1);

query I
SELECT uses_s1()
----
101

# a nested schema cannot be in a search path, so a macro in one looks in the default schema of its catalog
statement ok
CREATE SCHEMA a;

statement ok
CREATE SCHEMA a.b;

statement ok
CREATE SCHEMA b;

statement ok
CREATE MACRO f() AS 1;

statement ok
CREATE MACRO b.f() AS 2;

statement ok
CREATE MACRO a.b.g() AS f();

query I
SELECT a.b.g()
----
1

# the default table of a catalog is qualified with its own name
statement ok
ATTACH ':memory:' AS dt (DEFAULT_TABLE 'real_t');

statement ok
CREATE TABLE dt.real_t AS SELECT 42 AS v;

statement ok
CREATE TABLE dt.dt AS SELECT 99 AS v;

statement ok
CREATE MACRO from_default_table() AS TABLE SELECT * FROM dt;

statement ok
ATTACH ':memory:' AS caller;

statement ok
CREATE VIEW caller.macro_view AS SELECT * FROM memory.from_default_table();

statement ok
CREATE TABLE caller.dt AS SELECT -1 AS v;

query I
SELECT * FROM memory.from_default_table();
----
42

query I
SELECT * FROM caller.macro_view;
----
42
