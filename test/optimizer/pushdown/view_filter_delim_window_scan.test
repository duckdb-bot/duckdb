# name: test/optimizer/pushdown/view_filter_delim_window_scan.test
# description: A filter on a view with correlated subqueries over a list reaches the scan below the row number window of their delim joins (issue #26510)
# group: [pushdown]

require json

statement ok
CREATE TABLE facts AS SELECT i AS id, (i % 25) AS customer_id, [ (i % 50), ((i + 1) % 50) ] AS dim_ids FROM range(10000) r(i);

statement ok
CREATE TABLE dims AS SELECT i AS dim_id, 'name ' || i AS name FROM range(50) r(i);

statement ok
CREATE VIEW v_single AS SELECT f.id, f.customer_id, (SELECT list(d.name ORDER BY d.name) FROM UNNEST(f.dim_ids) AS u(dim_id) JOIN dims d ON d.dim_id = u.dim_id) AS dim_names FROM facts f;

statement ok
CREATE VIEW v_mark AS SELECT f.id, f.customer_id, EXISTS (SELECT 1 FROM UNNEST(f.dim_ids) AS u(dim_id) WHERE u.dim_id = 8) AS has8 FROM facts f;

statement ok
CREATE VIEW v_two AS SELECT f.id, f.customer_id, (SELECT list(d.name ORDER BY d.name) FROM UNNEST(f.dim_ids) AS u(dim_id) JOIN dims d ON d.dim_id = u.dim_id) AS dim_names, (SELECT count(*) FROM UNNEST(f.dim_ids) AS u(dim_id) JOIN dims d ON d.dim_id = u.dim_id WHERE d.name LIKE 'name %') AS dim_count FROM facts f;

statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '{TEMP_DIR}/view_scan_single.json';

query II
SELECT id, dim_names FROM v_single WHERE customer_id = 7 AND id = 1007;
----
1007	[name 7, name 8]

statement ok
PRAGMA profiling_output = '{TEMP_DIR}/view_scan_mark.json';

query II
SELECT id, has8 FROM v_mark WHERE customer_id = 7 AND id = 1007;
----
1007	true

statement ok
PRAGMA profiling_output = '{TEMP_DIR}/view_scan_two.json';

query III
SELECT id, dim_names, dim_count FROM v_two WHERE customer_id = 7 AND id = 1007;
----
1007	[name 7, name 8]	2

statement ok
PRAGMA disable_profiling;

# the scan of facts applies the filter and returns only that row
foreach kind single mark two

query I
SELECT sum((value->>'intermediate_rows')::BIGINT) FROM read_text('{TEMP_DIR}/view_scan_{kind}.json'), json_tree(content) WHERE value->>'type' = 'TABLE_SCAN' AND (value->'extra_info'->>'Table') LIKE '%facts'
----
1

endloop
