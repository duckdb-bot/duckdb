# name: test/optimizer/constant_order_normalization.test
# description: Constant folding test
# group: [optimizer]

statement ok
CREATE TABLE test(col0 INTEGER, col1 SMALLINT);

statement ok
PRAGMA explain_output = OPTIMIZED_ONLY;

# addition
query I nosort add_test
EXPLAIN SELECT col0 + 1 + 2 FROM test
----

query I nosort add_test
EXPLAIN SELECT 1 + col0 + 2 FROM test
----

query I nosort add_test
EXPLAIN SELECT 1 + 2 + col0  FROM test
----

query I nosort add_test
EXPLAIN SELECT 3 + col0  FROM test
----

# multiplication
query I nosort mult_test
EXPLAIN SELECT col0 * 1 * 2 FROM test
----

query I nosort mult_test
EXPLAIN SELECT 1 * col0 * 2 FROM test
----

query I nosort mult_test
EXPLAIN SELECT 1 * 2 * col0  FROM test
----

query I nosort mult_test
EXPLAIN SELECT 2 * col0  FROM test
----

# with two other operands, the constants of an addition stay in place: moving them can overflow
query II
EXPLAIN SELECT 1 * col0 * 2 + 1 + col1 + 2 FROM test
----
logical_opt	<REGEX>:(?s).*\(\(\(col0 \* 2\) \+ 1\) \+ CAST\(col1 AS INTEGER\)\) \+ 2.*

# with one other operand, constants that fold into the type move together
query II
EXPLAIN SELECT col0 + 1 + -2 FROM test
----
logical_opt	<REGEX>:(?s).*Expressions: -1 \+ col0 .*

query II
EXPLAIN SELECT col0 * 2 * 3 FROM test
----
logical_opt	<REGEX>:(?s).*Expressions: col0 \* 6 .*

# constants that do not fold into the type stay in place
query II
EXPLAIN SELECT col0 + 2147483647 + 1 FROM test
----
logical_opt	<REGEX>:(?s).*\(col0 \+ 2147483647\) \+ 1.*

query II
EXPLAIN SELECT col0 * 0 * 2 FROM test
----
logical_opt	<!REGEX>:(?s).*col0 \* 0\).*

statement ok
CREATE TABLE limits (a INTEGER, b INTEGER);

statement ok
INSERT INTO limits VALUES (2147483645, -2), (-2147483647, 1);

query I
SELECT (a + 1) + (b + 2) FROM limits ORDER BY ALL;
----
-2147483643
2147483646

# multiplications with several other operands keep their order
statement ok
CREATE TABLE factors AS SELECT 2147483647 AS a, 2 AS b, 0 AS c, -2147483648 AS m, -1 AS n, 0::TINYINT AS z;

query IIII
SELECT 2 * (a * (b * c)), (-1 * n) * m, ((64::TINYINT * z) * 2::TINYINT) * (-1)::TINYINT, (a * 1) * (c * 4) FROM factors;
----
0	-2147483648	0	0

query I
SELECT a + 2 + -3 FROM limits ORDER BY ALL;
----
-2147483648
2147483644

# boundary values of other integer types
statement ok
CREATE TABLE wide (a BIGINT, b BIGINT, u UBIGINT, h HUGEINT, uh UHUGEINT);

statement ok
INSERT INTO wide VALUES (-9223372036854775807, 1537228672809129301, 18446744073709551612, -170141183460469231731687303715884105727, 170141183460469231731687303715884105728), (NULL, NULL, NULL, NULL, NULL);

query IIIIII
SELECT a + 1 + -2, b * 2 * 3, u + 1::UBIGINT + 2::UBIGINT, h + -1::HUGEINT + 1::HUGEINT + -1::HUGEINT, uh + 1::UHUGEINT + 2::UHUGEINT, (uh - uh) + 170141183460469231731687303715884105728::UHUGEINT + 1::UHUGEINT FROM wide ORDER BY ALL;
----
-9223372036854775808	9223372036854775806	18446744073709551615	-170141183460469231731687303715884105728	170141183460469231731687303715884105731	170141183460469231731687303715884105729
NULL	NULL	NULL	NULL	NULL	NULL
