# a value over the number of columns at the end of a buffer, with a projection
statement ok
COPY (SELECT l FROM (VALUES (0, 'a,b,c'), (1, '1,1,1'), (2, '1,1,1'), (3, '1,1,1'), (4, '1,1,1'), (5, '2,2,2,2222222222222'), (6, '3,3,3')) t(i, l) ORDER BY i) TO '{TEST_DIR}/extra_value.csv' (HEADER false, QUOTE '');

query I
SELECT a FROM read_csv('{TEST_DIR}/extra_value.csv', header = true, auto_detect = false, columns = {'a': 'INTEGER', 'b': 'INTEGER', 'c': 'INTEGER'}, buffer_size = 32, ignore_errors = true)
----
1
1
1
1
3

statement error
SELECT a FROM read_csv('{TEST_DIR}/extra_value.csv', header = true, auto_detect = false, columns = {'a': 'INTEGER', 'b': 'INTEGER', 'c': 'INTEGER'}, buffer_size = 32)
----
Expected Number of Columns: 3 Found: 4

# a comment at the end of a long value
statement ok
COPY (SELECT l FROM (VALUES (0, 'a,b'), (1, '0,0'), (2, '1,1'), (3, '2,' || repeat('x', 65) || '#yyyy'), (4, '3,3')) t(i, l) ORDER BY i) TO '{TEST_DIR}/comment_long_value.csv' (HEADER false, QUOTE '');

foreach parallel true false

statement error
SELECT count(*) FROM read_csv('{TEST_DIR}/comment_long_value.csv', header = true, auto_detect = false, columns = {'a': 'INTEGER', 'b': 'VARCHAR'}, comment = '#', buffer_size = 16, parallel = {parallel})
----
Maximum line size of 16 bytes exceeded

statement error
SELECT a, b FROM read_csv('{TEST_DIR}/comment_long_value.csv', header = true, auto_detect = false, columns = {'a': 'INTEGER', 'b': 'VARCHAR'}, comment = '#', buffer_size = 16, parallel = {parallel})
----
Maximum line size of 16 bytes exceeded

query II
SELECT a, b FROM read_csv('{TEST_DIR}/comment_long_value.csv', header = true, auto_detect = false, columns = {'a': 'INTEGER', 'b': 'VARCHAR'}, comment = '#', buffer_size = 16, parallel = {parallel}, ignore_errors = true)
----
0	0
1	1
3	3

endloop

