# Issue #4978 -- Substring overflow 3
query I
SELECT '1'[-1];
----
1

statement error
SELECT '1'[9223372036854775807];
----
Out of Range Error: Substring offset outside of supported range (> 4294967295)

statement error
SELECT '0'[-9223372036854775808];
----
Out of Range Error: Substring offset outside of supported range (< -4294967296)

# array_extract, list_extract and list_element take no strings
statement error
SELECT array_extract(s, 1) FROM strings
----
No function matches the given name and argument types 'array_extract(VARCHAR, INTEGER_LITERAL)'

statement error
SELECT list_extract(s, 1) FROM strings
----
No function matches the given name and argument types 'list_extract(VARCHAR, INTEGER_LITERAL)'

statement error
SELECT list_element(s, 1) FROM strings
----
No function matches the given name and argument types 'list_element(VARCHAR, INTEGER_LITERAL)'

statement error
SELECT array_extract('DuckDB', 2)
----
Could not choose a best candidate function for the function call "array_extract(STRING_LITERAL, INTEGER_LITERAL)"
