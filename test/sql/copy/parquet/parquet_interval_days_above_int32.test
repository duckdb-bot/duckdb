# name: test/sql/copy/parquet/parquet_interval_days_above_int32.test
# description: A Parquet INTERVAL whose unsigned days field is above the largest days of an interval reads back its value (duckdblabs/bot-issue-tracker#650)
# group: [parquet]

require parquet

# the milliseconds do not fit 32 bits, so the writer moves the whole days of the microseconds into the days field
statement ok
COPY (SELECT INTERVAL '2147483647 days' + to_microseconds(4320000000000) AS iv) TO '{TEST_DIR}/interval_days.parquet';

query I
SELECT iv FROM '{TEST_DIR}/interval_days.parquet';
----
2147483647 days 1200:00:00

# the largest microseconds, also inside a list and a struct
statement ok
COPY (
	SELECT i, iv, [iv] AS l, {'iv': iv} AS s
	FROM (VALUES
		(1, INTERVAL '2147483647 days' + to_microseconds(9223372036854775000)),
		(2, INTERVAL '2147483600 days' + to_microseconds(8640000000000)),
		(3, INTERVAL '5 days' + to_microseconds(4320000000000))
	) t(i, iv)
) TO '{TEST_DIR}/interval_days_nested.parquet';

query IIII
SELECT i, iv = original, l[1] = original, s.iv = original
FROM '{TEST_DIR}/interval_days_nested.parquet' JOIN (VALUES
	(1, INTERVAL '2147483647 days' + to_microseconds(9223372036854775000)),
	(2, INTERVAL '2147483600 days' + to_microseconds(8640000000000)),
	(3, INTERVAL '5 days' + to_microseconds(4320000000000))
) t(i, original) USING (i)
ORDER BY i;
----
1	true	true	true
2	true	true	true
3	true	true	true

query II
SELECT i, iv FROM '{TEST_DIR}/interval_days_nested.parquet' ORDER BY i;
----
1	2147483647 days 2562047788:00:54.775
2	2147483647 days 1272:00:00
3	55 days

# files of another writer can hold any unsigned days, which keep their value or fail to read when the days past the
# largest days of an interval do not fit in its microseconds
statement ok
COPY (SELECT from_hex('')) TO '{TEST_DIR}/external_good.parquet' (FORMAT BLOB);

statement ok
COPY (SELECT from_hex('')) TO '{TEST_DIR}/external_statistics.parquet' (FORMAT BLOB);

statement ok
COPY (SELECT from_hex('504152311500151815182c1502150015061506000000000000f6e75c86f88fdc001502192c4806736368656d61150200150e1518150018026976252a001602191c191c26001c150e191500191802697615001602163a163a26080000163a1602002823696e646570656e64656e7420696e74657276616c207265766965772066697874757265006600000050415231')) TO '{TEST_DIR}/external_add_overflow.parquet' (FORMAT BLOB);

statement ok
COPY (SELECT from_hex('504152311500151815182c1502150015061506000000000000f7e75c86000000001502192c4806736368656d61150200150e1518150018026976252a001602191c191c26001c150e191500191802697615001602163a163a26080000163a1602002823696e646570656e64656e7420696e74657276616c207265766965772066697874757265006600000050415231')) TO '{TEST_DIR}/external_multiply_overflow.parquet' (FORMAT BLOB);

statement ok
COPY (SELECT from_hex('504152311500151815182c1502150015061506000000000000ffffffff000000001502192c4806736368656d61150200150e1518150018026976252a001602191c191c26001c150e191500191802697615001602163a163a26080000163a1602002823696e646570656e64656e7420696e74657276616c207265766965772066697874757265006600000050415231')) TO '{TEST_DIR}/external_uint32_max.parquet' (FORMAT BLOB);


query IIII
SELECT iv = to_months(0) + to_days(2147483646) + to_microseconds(0), datepart('day', iv) = 2147483646, datepart('microseconds', iv) = 0, hash(iv) = hash(to_months(0) + to_days(2147483646) + to_microseconds(0)) FROM read_parquet('{TEST_DIR}/external_good.parquet', file_row_number=true) WHERE file_row_number=0;
----
true	true	true	true

query IIII
SELECT iv = to_months(0) + to_days(2147483647) + to_microseconds(0), datepart('day', iv) = 2147483647, datepart('microseconds', iv) = 0, hash(iv) = hash(to_months(0) + to_days(2147483647) + to_microseconds(0)) FROM read_parquet('{TEST_DIR}/external_good.parquet', file_row_number=true) WHERE file_row_number=1;
----
true	true	true	true

