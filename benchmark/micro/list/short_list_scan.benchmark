# name: benchmark/micro/list/short_list_scan.benchmark
# description: Scan a table of one-element lists without a filter
# group: [list]

name Short List Scan
group micro
subgroup list

load
CREATE TABLE t AS SELECT i AS id, i % 1000 AS k, [i] AS l1 FROM range(5000000) r(i);

run
SELECT sum(len(l1)) FROM t

result I
5000000
