# name: test/sql/function/date/date_part_stats.test
# description: Test date part stats on empty table
# group: [date]

statement ok
CREATE TABLE dates(d DATE);

# test stats propagation from empty table
query I
SELECT EXTRACT(year FROM d) FROM dates;
