# name: test/issues/general/test_25086.test
# description: variant_contains on deeply nested or wide VARIANT values does not overflow the stack
# group: [general]

require parquet

# 100000 levels alternating between an array (the outermost) and an object with key 'a', each holding one element,
# in the binary encoding of variant_bytes_to_variant. The offsets of an element take as many bytes as its length needs
statement ok
CREATE TABLE levels AS
WITH RECURSIVE levels(depth, child_length, width) AS (
	SELECT 1, 1, 1
	UNION ALL
	SELECT depth + 1, child_length + 2 + depth % 2 + 2 * width,
	       CASE WHEN child_length + 2 + depth % 2 + 2 * width < 256 THEN 1
	            WHEN child_length + 2 + depth % 2 + 2 * width < 65536 THEN 2 ELSE 3 END
	FROM levels WHERE depth < 100000
)
SELECT depth,
       CASE WHEN depth % 2 = 1 THEN printf('%02x0100', 2 + 4 * (width - 1)) ELSE printf('%02x01', 3 + 4 * (width - 1)) END ||
       repeat('00', width) ||
       left(printf('%02x%02x%02x', child_length % 256, child_length // 256 % 256, child_length // 65536), 2 * width) AS header
FROM levels;

# rows 1 and 2 hold a NULL at the bottom, row 3 holds true
statement ok
CREATE TABLE t AS
SELECT id, variant_bytes_to_variant(unhex('1101000161' || string_agg(header, '' ORDER BY depth DESC) || bottom)) AS v
FROM levels, (VALUES (1, '00'), (2, '00'), (3, '04')) bottoms(id, bottom)
GROUP BY id, bottom;

query II
SELECT id, variant_contains(v, v) FROM t ORDER BY id;
----
1	true
2	true
3	true

# the needle is only found at the bottom of row 3, and 1 nowhere
query III
SELECT id, variant_contains(v, true::VARIANT), variant_contains(v, 1::VARIANT) FROM t ORDER BY id;
----
1	false	false
2	false	false
3	true	false

# an equal deep needle, a nested needle found nowhere, and the deep needle in a shallow haystack
query III
SELECT variant_contains(a.v, b.v), variant_contains(a.v, [[1]]::VARIANT), variant_contains([[1]]::VARIANT, a.v)
FROM t a, t b WHERE a.id = 1 AND b.id = 2;
----
true	false	false

query I
SELECT variant_contains({'x': [a.v]}::VARIANT, b.v) FROM t a, t b WHERE a.id = 1 AND b.id = 2;
----
true

# wide arrays
query II
SELECT variant_contains(l, [99999]::VARIANT), variant_contains(l, [100000]::VARIANT)
FROM (SELECT range(100000)::VARIANT AS l);
----
true	false
