# name: test/sql/alter/struct/alter_struct_field_user_macro.test
# description: Adding, renaming or dropping a struct field calls the functions of the system, also when a macro of a user is named remap_struct or struct_pack
# group: [struct]

statement ok
CREATE TABLE renamed (i INT, s STRUCT(x INT, y INT));

statement ok
CREATE TABLE dropped (i INT, s STRUCT(x INT, y INT));

statement ok
CREATE TABLE added (i INT, s STRUCT(x INT, y INT));

statement ok
CREATE TABLE renamed_default (i INT, s STRUCT(x INT, y INT) DEFAULT {'x': 1, 'y': 2});

statement ok
CREATE TABLE added_default (i INT, s STRUCT(x INT) DEFAULT {'x': 1});

statement ok
CREATE TABLE renamed_temp (i INT, s STRUCT(x INT, y INT));

statement ok
CREATE TABLE dropped_temp (i INT, s STRUCT(x INT, y INT));

statement ok
CREATE TABLE added_temp (i INT, s STRUCT(x INT, y INT));

statement ok
CREATE TABLE renamed_path (i INT, s STRUCT(x INT, y INT));

statement ok
CREATE TABLE dropped_path (i INT, s STRUCT(x INT, y INT));

statement ok
CREATE TABLE added_path (i INT, s STRUCT(x INT, y INT));

statement ok
INSERT INTO renamed VALUES (1, {'x': 1, 'y': 2}), (2, {'x': 3, 'y': 4});

statement ok
INSERT INTO dropped VALUES (1, {'x': 1, 'y': 2}), (2, {'x': 3, 'y': 4});

statement ok
INSERT INTO added VALUES (1, {'x': 1, 'y': 2}), (2, {'x': 3, 'y': 4});

statement ok
INSERT INTO renamed_temp VALUES (1, {'x': 1, 'y': 2}), (2, {'x': 3, 'y': 4});

statement ok
INSERT INTO dropped_temp VALUES (1, {'x': 1, 'y': 2}), (2, {'x': 3, 'y': 4});

statement ok
INSERT INTO added_temp VALUES (1, {'x': 1, 'y': 2}), (2, {'x': 3, 'y': 4});

statement ok
INSERT INTO renamed_path VALUES (1, {'x': 1, 'y': 2}), (2, {'x': 3, 'y': 4});

statement ok
INSERT INTO dropped_path VALUES (1, {'x': 1, 'y': 2}), (2, {'x': 3, 'y': 4});

statement ok
INSERT INTO added_path VALUES (1, {'x': 1, 'y': 2}), (2, {'x': 3, 'y': 4});

statement ok
INSERT INTO renamed_default (i) VALUES (1);

statement ok
INSERT INTO added_default (i) VALUES (1);

# a macro in the schema of the tables
statement ok
CREATE MACRO remap_struct(a, b, c, d) AS NULL;

statement ok
ALTER TABLE renamed RENAME COLUMN s.y TO z;

statement ok
ALTER TABLE dropped DROP COLUMN s.y;

statement ok
ALTER TABLE added ADD COLUMN s.z INT DEFAULT 5;

query II
SELECT * FROM renamed ORDER BY i
----
1	{'x': 1, 'z': 2}
2	{'x': 3, 'z': 4}

query II
SELECT * FROM dropped ORDER BY i
----
1	{'x': 1}
2	{'x': 3}

query II
SELECT * FROM added ORDER BY i
----
1	{'x': 1, 'y': 2, 'z': 5}
2	{'x': 3, 'y': 4, 'z': 5}

# the rewritten default of the column does not call the macro either
statement ok
ALTER TABLE renamed_default RENAME COLUMN s.y TO z;

statement ok
ALTER TABLE added_default ADD COLUMN s.y INT DEFAULT 5;

statement ok
INSERT INTO renamed_default (i) VALUES (2);

statement ok
INSERT INTO added_default (i) VALUES (2);

query II
SELECT * FROM renamed_default ORDER BY i
----
1	{'x': 1, 'z': 2}
2	{'x': 1, 'z': 2}

query II
SELECT * FROM added_default ORDER BY i
----
1	{'x': 1, 'y': 5}
2	{'x': 1, 'y': 5}

query I
SELECT count(*) FROM duckdb_columns() WHERE table_name IN ('renamed_default', 'added_default') AND column_name = 's' AND column_default LIKE '"system".main.remap_struct(%'
----
2

statement ok
DROP MACRO remap_struct;

# a temporary macro that returns its first argument
statement ok
CREATE TEMPORARY MACRO remap_struct(a, b, c, d) AS a;

statement ok
ALTER TABLE renamed_temp RENAME COLUMN s.y TO z;

query II
SELECT * FROM renamed_temp ORDER BY i
----
1	{'x': 1, 'z': 2}
2	{'x': 3, 'z': 4}

statement ok
DROP MACRO remap_struct;

# a temporary macro that returns NULL
statement ok
CREATE TEMPORARY MACRO remap_struct(a, b, c, d) AS NULL;

statement ok
ALTER TABLE dropped_temp DROP COLUMN s.y;

statement ok
ALTER TABLE added_temp ADD COLUMN s.z INT DEFAULT 5;

query II
SELECT * FROM dropped_temp ORDER BY i
----
1	{'x': 1}
2	{'x': 3}

query II
SELECT * FROM added_temp ORDER BY i
----
1	{'x': 1, 'y': 2, 'z': 5}
2	{'x': 3, 'y': 4, 'z': 5}

statement ok
DROP MACRO remap_struct;

# a macro that only the schema of the table has
statement ok
CREATE SCHEMA k;

statement ok
CREATE TABLE k.renamed (i INT, s STRUCT(x INT, y INT) DEFAULT {'x': 1, 'y': 2});

statement ok
INSERT INTO k.renamed (i) VALUES (1);

statement ok
CREATE TABLE k.added (i INT, s STRUCT(x INT) DEFAULT {'x': 1});

statement ok
INSERT INTO k.added (i) VALUES (1);

statement ok
CREATE MACRO k.remap_struct(a, b, c, d) AS NULL;

statement ok
ALTER TABLE k.renamed RENAME COLUMN s.y TO z;

statement ok
ALTER TABLE k.added ADD COLUMN s.y INT DEFAULT 5;

statement ok
INSERT INTO k.renamed (i) VALUES (2);

statement ok
INSERT INTO k.added (i) VALUES (2);

query II
SELECT * FROM k.renamed ORDER BY i
----
1	{'x': 1, 'z': 2}
2	{'x': 1, 'z': 2}

query II
SELECT * FROM k.added ORDER BY i
----
1	{'x': 1, 'y': 5}
2	{'x': 1, 'y': 5}

# the default of a new field is packed with the struct_pack of the system
statement ok
CREATE TABLE packed (i INT, s STRUCT(x INT, t STRUCT(k INT)));

statement ok
INSERT INTO packed VALUES (1, {'x': 1, 't': {'k': 2}});

statement ok
CREATE MACRO struct_pack(z) AS NULL;

statement ok
ALTER TABLE packed ADD COLUMN s.z INT DEFAULT 5;

statement ok
DROP MACRO struct_pack;

statement ok
CREATE MACRO struct_pack(t) AS NULL;

statement ok
ALTER TABLE packed ADD COLUMN s.t.m INT DEFAULT 7;

statement ok
DROP MACRO struct_pack;

query II
SELECT * FROM packed
----
1	{'x': 1, 't': {'k': 2, 'm': 7}, 'z': 5}

# a macro in another schema of the search path, which stays set to the end of the test
statement ok
CREATE SCHEMA other;

statement ok
CREATE MACRO other.remap_struct(a, b, c, d) AS NULL;

statement ok
SET search_path = 'main,other';

statement ok
ALTER TABLE renamed_path RENAME COLUMN s.y TO z;

statement ok
ALTER TABLE dropped_path DROP COLUMN s.y;

statement ok
ALTER TABLE added_path ADD COLUMN s.z INT DEFAULT 5;

query II
SELECT * FROM renamed_path ORDER BY i
----
1	{'x': 1, 'z': 2}
2	{'x': 3, 'z': 4}

query II
SELECT * FROM dropped_path ORDER BY i
----
1	{'x': 1}
2	{'x': 3}

query II
SELECT * FROM added_path ORDER BY i
----
1	{'x': 1, 'y': 2, 'z': 5}
2	{'x': 3, 'y': 4, 'z': 5}
