# name: benchmark/micro/pushdown/view_filter_below_two_delim_joins.benchmark
# description: A filter on a view with two correlated subqueries in its select list runs before both subqueries
# group: [pushdown]

name ViewFilterBelowTwoDelimJoins
group micro
subgroup pushdown

load
CREATE TABLE facts AS SELECT i AS id, (i % 25) AS customer_id, [ (i % 50), ((i + 1) % 50) ] AS dim_ids FROM range(2000000) r(i);
CREATE TABLE dims AS SELECT i AS dim_id, 'name ' || i AS name FROM range(50) r(i);
CREATE VIEW v AS SELECT f.id, f.customer_id, (SELECT list(d.name ORDER BY d.name) FROM UNNEST(f.dim_ids) AS u(dim_id) JOIN dims d ON d.dim_id = u.dim_id) AS dim_names, (SELECT count(*) FROM UNNEST(f.dim_ids) AS u(dim_id) JOIN dims d ON d.dim_id = u.dim_id WHERE d.name LIKE 'name %') AS dim_count FROM facts f;

run
SELECT id, dim_names, dim_count FROM v WHERE customer_id = 7 AND id = 1007;

result III
1007	[name 7, name 8]	2
