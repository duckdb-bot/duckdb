# name: test/sql/function/string/test_substring_lambda_capture.test
# description: substring and string subscripts of a string that a lambda captures, which checks each byte for ASCII once
# group: [string]

statement ok
CREATE TABLE words AS SELECT * FROM (VALUES
	(1, 'abcdefghijklmnopqrstuvwxyz0123'),
	(2, 'abcdefghijklmnopqrstéuvwxyz0123'),
	(3, 'ébcdefghijklmnopqrstuvwxyz0123'),
	(4, 'short'),
	(5, 'shé'),
	(6, NULL)) t(id, s);

# offsets that grow past the non-ASCII character of the second string
query II
SELECT id, list_transform(range(17, 24), lambda i: substring(s, i, 3)) FROM words ORDER BY id;
----
1	[qrs, rst, stu, tuv, uvw, vwx, wxy]
2	[qrs, rst, sté, téu, éuv, uvw, vwx]
3	[qrs, rst, stu, tuv, uvw, vwx, wxy]
4	['', '', '', '', '', '', '']
5	['', '', '', '', '', '', '']
6	[NULL, NULL, NULL, NULL, NULL, NULL, NULL]

# offsets that shrink, after a longer prefix was checked
query II
SELECT id, list_transform([23, 21, 20, 19, 2], lambda i: s[i]) FROM words ORDER BY id;
----
1	[w, u, t, s, b]
2	[v, é, t, s, b]
3	[w, u, t, s, b]
4	['', '', '', '', h]
5	['', '', '', '', h]
6	[NULL, NULL, NULL, NULL, NULL]

# two strings that alternate from one element to the next
query I
SELECT list_transform(range(18, 24), lambda i: substring(CASE WHEN i % 2 = 0 THEN 'abcdefghijklmnopqrstéuvwxyz0123' ELSE 'abcdefghijklmnopqrstuvwxyz0123' END, i, 2));
----
[rs, st, té, uv, uv, wx]

# two strings of the same size, inlined and not, after the first one was checked
query I
SELECT list_transform([6, 5, 6, 5], lambda i: substring(CASE WHEN i = 5 THEN 'abcdé' ELSE 'abcdef' END, i, 1));
----
[f, é, f, é]

query I
SELECT list_transform([20, 19, 21], lambda i: substring(CASE WHEN i = 21 THEN 'abcdefghijklmnopqrstéuvwxyz012' ELSE 'abcdefghijklmnopqrstuvwxyz01234' END, i, 2));
----
[tu, st, éu]

# every positive offset and length, against substring_grapheme, which counts the same characters for these strings
query II
SELECT id, list_transform(range(0, 35), lambda i: list_transform(range(-2, 5), lambda l: substring(s, i, l))) =
    list_transform(range(0, 35), lambda i: list_transform(range(-2, 5), lambda l: substring_grapheme(s, i, l)))
FROM words ORDER BY id;
----
1	true
2	true
3	true
4	true
5	true
6	true

query II
SELECT id, list_transform(range(0, 35), lambda i: substring(s, i)) =
    list_transform(range(0, 35), lambda i: substring_grapheme(s, i))
FROM words ORDER BY id;
----
1	true
2	true
3	true
4	true
5	true
6	true

query II
SELECT id, list_transform(range(0, 35), lambda i: s[i]) = list_transform(range(0, 35), lambda i: substring_grapheme(s, i, 1))
FROM words ORDER BY id;
----
1	true
2	true
3	true
4	true
5	true
6	true

# negative offsets count from the end
query II
SELECT id, list_transform([-1, -3, -12, -31, -40], lambda i: substring(s, i, 2)) FROM words ORDER BY id;
----
1	[3, 12, st, a, '']
2	[3, 12, té, ab, '']
3	[3, 12, st, é, '']
4	[t, or, '', '', '']
5	[é, sh, '', '', '']
6	[NULL, NULL, NULL, NULL, NULL]

# two captured strings in one lambda
query III
SELECT w1.id, w2.id, list_transform(range(18, 24), lambda i: substring(w1.s, i, 1) || substring(w2.s, i, 1))
FROM words w1, words w2 WHERE w1.id <= 3 AND w2.id <= 3 ORDER BY ALL;
----
1	1	[rr, ss, tt, uu, vv, ww]
1	2	[rr, ss, tt, ué, vu, wv]
1	3	[rr, ss, tt, uu, vv, ww]
2	1	[rr, ss, tt, éu, uv, vw]
2	2	[rr, ss, tt, éé, uu, vv]
2	3	[rr, ss, tt, éu, uv, vw]
3	1	[rr, ss, tt, uu, vv, ww]
3	2	[rr, ss, tt, ué, vu, wv]
3	3	[rr, ss, tt, uu, vv, ww]

# rows of a table, outside of a lambda
query III
SELECT id, substring(s, 21, 3), s[21] FROM words ORDER BY id;
----
1	uvw	u
2	éuv	é
3	uvw	u
4	(empty)	(empty)
5	(empty)	(empty)
6	NULL	NULL
