# name: test/sql/storage/wal/wal_replay_unbound_index_failed_bind.test
# description: A failed index bind does not keep the automatic checkpoint from running
# group: [wal]

require skip_reload

load {TEST_DIR}/wal_replay_unbound_index_failed_bind.db

statement ok
CREATE TEMP MACRO tnorm(s) AS lower(s);

statement ok
CREATE TABLE t(k VARCHAR);

statement ok
CREATE INDEX idx ON t((tnorm(k)));

statement ok
INSERT INTO t VALUES ('a'), ('b');

statement ok
CHECKPOINT;

restart

# the temporary macro is gone, so binding the index fails
statement error
SELECT count(*) FROM t WHERE k = 'a';
----
tnorm

statement ok
SET wal_autocheckpoint = '0B';

statement ok
CREATE TABLE other AS SELECT 1 AS i;

query I
SELECT wal_size FROM pragma_database_size() WHERE database_name = current_database();
----
0 bytes

# with replays buffered, a failed bind keeps the WAL, and a later bind applies them

load {TEST_DIR}/wal_replay_unbound_index_failed_bind_replays.db

statement ok
CREATE TEMP MACRO tnorm(s) AS lower(s);

statement ok
CREATE TABLE t(k VARCHAR);

statement ok
CREATE INDEX idx ON t((tnorm(k)));

statement ok
INSERT INTO t VALUES ('a'), ('b');

statement ok
CHECKPOINT;

statement ok
SET wal_autocheckpoint = '1TB';

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
INSERT INTO t VALUES ('c');

statement ok
DELETE FROM t WHERE k = 'a';

restart

statement error
SELECT count(*) FROM t WHERE k = 'b';
----
tnorm

statement ok
SET wal_autocheckpoint = '0B';

statement ok
CREATE TABLE other AS SELECT 1 AS i;

query I
SELECT wal_size <> '0 bytes' FROM pragma_database_size() WHERE database_name = current_database();
----
true

statement ok
PRAGMA disable_checkpoint_on_shutdown;

restart

statement ok
CREATE TEMP MACRO tnorm(s) AS lower(s);

query I
SELECT k FROM t ORDER BY k;
----
b
c

# deleting every row fails if the index lacks the replayed insert
statement ok
DELETE FROM t;

query I
SELECT count(*) FROM t;
----
0
