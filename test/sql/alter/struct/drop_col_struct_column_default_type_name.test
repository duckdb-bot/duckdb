# name: test/sql/alter/struct/drop_col_struct_column_default_type_name.test
# description: A default is not cast to a field type by a name that a type of the user has taken when a field is dropped
# group: [struct]

require json

# the tables are in a database in memory, so no restart replays their ALTER before the json extension is loaded
statement ok
ATTACH ':memory:' AS attached;

statement ok
CREATE SCHEMA attached.app;

statement ok
CREATE TABLE attached.app.cast_default(i INT, s STRUCT(x JSON, y INT) DEFAULT {'x': '1.4', 'y': 2}::STRUCT(x VARCHAR, y INT));

statement ok
CREATE TABLE attached.app.constructor(i INT, s STRUCT(x JSON, y INT) DEFAULT {'x': '1.4', 'y': 2});

# a type in the schema of the tables takes the name of the type of the field that stays
statement ok
CREATE TYPE attached.app.JSON AS INTEGER;

statement ok
INSERT INTO attached.app.cast_default(i) VALUES (1);

statement ok
INSERT INTO attached.app.constructor(i) VALUES (1);

statement ok
ALTER TABLE attached.app.cast_default DROP COLUMN s.y;

statement ok
ALTER TABLE attached.app.constructor DROP COLUMN s.y;

statement ok
INSERT INTO attached.app.cast_default(i) VALUES (2);

statement ok
INSERT INTO attached.app.constructor(i) VALUES (2);

query IT
SELECT i, s.x::VARCHAR FROM attached.app.cast_default ORDER BY i;
----
1	1.4
2	1.4

query IT
SELECT i, s.x::VARCHAR FROM attached.app.constructor ORDER BY i;
----
1	1.4
2	1.4

# the default with the cast stays as it is, the constructor loses the argument
query II
SELECT table_name, column_default FROM duckdb_columns() WHERE database_name = 'attached' AND column_name = 's' ORDER BY table_name;
----
cast_default	CAST(struct_pack(x := '1.4', y := 2) AS STRUCT(x VARCHAR, y INTEGER))
constructor	struct_pack(x := '1.4')
