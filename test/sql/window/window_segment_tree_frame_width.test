# name: test/sql/window/window_segment_tree_frame_width.test
# description: The segment tree of a window aggregate does not aggregate rows that no frame holds together (issue #723)
# group: [window]

# every frame holds one row, so no sum overflows
query II
SELECT i, sum(170141183460469231731687303715884105727::HUGEINT - i) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND 1 PRECEDING) AS s
FROM range(3) t(i) ORDER BY i;
----
0	NULL
1	170141183460469231731687303715884105727
2	170141183460469231731687303715884105726

query II
SELECT i, sum(170141183460469231731687303715884105727::HUGEINT - i) OVER (ROWS BETWEEN 1 PRECEDING AND 1 PRECEDING) AS s
FROM range(3) t(i) ORDER BY i;
----
0	NULL
1	170141183460469231731687303715884105727
2	170141183460469231731687303715884105726

# every frame holds two rows that sum to the maximum
query II
SELECT i, sum(v) OVER (ORDER BY i ROWS BETWEEN CURRENT ROW AND 1 FOLLOWING) AS s
FROM (VALUES (0, 170141183460469231731687303715884105727::HUGEINT), (1, 0::HUGEINT), (2, 170141183460469231731687303715884105727::HUGEINT)) t(i, v) ORDER BY i;
----
0	170141183460469231731687303715884105727
1	170141183460469231731687303715884105727
2	170141183460469231731687303715884105727

# more rows than the fanout of the tree, so the tree has nodes over 16 and over 256 rows that would overflow
query I
SELECT count(*) FROM (
	SELECT i, sum(170141183460469231731687303715884105727::HUGEINT - i) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND 1 PRECEDING) AS s
	FROM range(1000) t(i)
) WHERE s - 1 + i = 170141183460469231731687303715884105727;
----
999

query I
SELECT count(*) FROM (
	SELECT i, sum(170141183460469231731687303715884105727::HUGEINT - i) OVER (ORDER BY i ROWS BETWEEN 3 PRECEDING AND 3 PRECEDING EXCLUDE CURRENT ROW) AS s
	FROM range(1000) t(i)
) WHERE s - 3 + i = 170141183460469231731687303715884105727;
----
997

# frames that cross the groups of the tree
query I
SELECT count(*) FROM (
	SELECT i, sum(v) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS s
	FROM (SELECT i, CASE WHEN i % 3 = 1 THEN 170141183460469231731687303715884105727::HUGEINT ELSE 0::HUGEINT END AS v FROM range(1000) t(i))
) WHERE s = 170141183460469231731687303715884105727;
----
999

# a frame of 16 rows reads the nodes over 16 rows, which hold the same sums as the frames
query I
SELECT count(*) FROM (
	SELECT i, sum(v) OVER (ORDER BY i ROWS BETWEEN 15 PRECEDING AND CURRENT ROW) AS s
	FROM (SELECT i, 10633823966279326983230456482242756607::HUGEINT AS v FROM range(1000) t(i))
) WHERE s = 10633823966279326983230456482242756607::HUGEINT * least(i + 1, 16);
----
1000

# the frames that still read the whole tree give the same results as before
statement ok
CREATE TABLE t AS SELECT i, (i * 7919) % 1000 AS v FROM range(5000) t(i);

query I
SELECT count(*) FROM (
	SELECT i, sum(v) OVER (ORDER BY i ROWS BETWEEN 100 PRECEDING AND 20 FOLLOWING) AS s,
	       (SELECT sum(v) FROM t t2 WHERE t2.i BETWEEN t.i - 100 AND t.i + 20) AS r
	FROM t
) WHERE s IS DISTINCT FROM r;
----
0

query I
SELECT count(*) FROM (
	SELECT i, sum(v) OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND 17 PRECEDING) AS s,
	       (SELECT sum(v) FROM t t2 WHERE t2.i <= t.i - 17) AS r
	FROM t
) WHERE s IS DISTINCT FROM r;
----
0

query I
SELECT count(*) FROM (
	SELECT i, sum(v) OVER (ORDER BY i ROWS BETWEEN 17 PRECEDING AND 17 FOLLOWING EXCLUDE CURRENT ROW) AS s,
	       (SELECT sum(v) FROM t t2 WHERE t2.i BETWEEN t.i - 17 AND t.i + 17 AND t2.i <> t.i) AS r
	FROM t
) WHERE s IS DISTINCT FROM r;
----
0

# without the optimizer there are no statistics on the frame bounds, so a constant bound is read directly
statement ok
PRAGMA disable_optimizer

query I
SELECT count(*) FROM (
	SELECT i, sum(170141183460469231731687303715884105727::HUGEINT - i) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND 1 PRECEDING) AS s
	FROM range(1000) t(i)
) WHERE s - 1 + i = 170141183460469231731687303715884105727;
----
999

query I
SELECT count(*) FROM (
	SELECT i, sum(v) OVER (ORDER BY i ROWS BETWEEN CURRENT ROW AND 1 FOLLOWING) AS s
	FROM (SELECT i, CASE WHEN i % 2 = 0 THEN 170141183460469231731687303715884105727::HUGEINT ELSE 0::HUGEINT END AS v FROM range(1000) t(i))
) WHERE s = 170141183460469231731687303715884105727;
----
999

statement ok
PRAGMA enable_optimizer

# a frame bound given by a column uses the column's statistics
query I
SELECT count(*) FROM (
	SELECT i, w, sum(170141183460469231731687303715884105727::HUGEINT - i) OVER (ORDER BY i ROWS BETWEEN w PRECEDING AND w PRECEDING) AS s
	FROM (SELECT i, 1 + i % 2 AS w FROM range(1000) t(i))
) WHERE s - w + i = 170141183460469231731687303715884105727;
----
998
