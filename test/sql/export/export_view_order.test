# name: test/sql/export/export_view_order.test
# description: EXPORT DATABASE writes a view after the views it reads
# group: [export]

load {TEST_DIR}/export_view_order.db

statement ok
CREATE TABLE t AS SELECT range AS x FROM range(3);

# views that read views with a later name, and views that read views with an earlier name
statement ok
CREATE VIEW b AS SELECT 1 AS x;

statement ok
CREATE VIEW a AS SELECT * FROM b;

statement ok
CREATE VIEW m_first AS SELECT x + 100 AS x FROM a;

statement ok
CREATE VIEW n_second AS SELECT x + 1 AS x FROM m_first;

statement ok
CREATE VIEW d AS SELECT max(x) AS m FROM t;

statement ok
CREATE VIEW c AS SELECT (SELECT m FROM d) AS m;

statement ok
CREATE SCHEMA zz;

statement ok
CREATE VIEW zz.base AS SELECT 42 AS v;

statement ok
CREATE SCHEMA aa;

statement ok
CREATE VIEW aa.top AS SELECT v FROM zz.base;

# a view replaced after the views that read it
statement ok
CREATE VIEW p AS SELECT 1 AS x;

statement ok
CREATE VIEW q AS SELECT x * 7 AS x FROM p;

statement ok
CREATE OR REPLACE VIEW p AS SELECT 2 AS x;

# a view created before the view it reads
statement ok
CREATE VIEW f WITH (DEFER_BINDING) AS SELECT x + 3 AS x FROM g;

statement ok
CREATE VIEW g AS SELECT 30 AS x;

# a view that defines a common table expression with the name of a view that reads it
statement ok
CREATE VIEW w AS WITH y AS (SELECT 5 AS x) SELECT x FROM y;

statement ok
CREATE VIEW y AS SELECT x + 1 AS x FROM w;

# a common table expression that is not used is not bound
statement ok
CREATE VIEW ua AS WITH unused AS (SELECT * FROM ub) SELECT 42 AS x;

statement ok
CREATE VIEW ub AS SELECT * FROM ua;

# a read that is not found by name, after a view with an unused common table expression
statement ok
CREATE VIEW qa AS WITH unused AS (SELECT * FROM qc) SELECT 42 AS x;

statement ok
CREATE VIEW qb AS SELECT * FROM qa;

statement ok
CREATE VIEW qc AS SELECT * FROM query_table('qb');

# a common table expression in a subquery hides a view of the same name only within the subquery
statement ok
CREATE VIEW sz AS SELECT 42 AS x;

statement ok
CREATE VIEW ry AS SELECT x + (WITH sz AS (SELECT 7 AS x) SELECT x FROM sz) AS x FROM sz;

# a nested schema with the name of another schema
statement ok
CREATE SCHEMA ns;

statement ok
CREATE SCHEMA zz.ns;

statement ok
CREATE VIEW ns.va AS SELECT 42 AS x;

statement ok
CREATE VIEW ns.vb AS SELECT * FROM va;

statement ok
CREATE VIEW zz.ns.va AS SELECT x + 1 AS x FROM ns.vb;

# a view without recorded dependencies before a view with them
statement ok
CREATE VIEW rb AS SELECT 42 AS x;

statement ok
CREATE VIEW rc AS SELECT * FROM query_table('rb');

statement ok
SET enable_view_dependencies = true;

statement ok
CREATE VIEW ra AS SELECT * FROM rc;

statement ok
SET enable_view_dependencies = false;

# subqueries that binding drops: a macro argument the macro does not use, a star that expands to nothing
statement ok
CREATE MACRO ignore_arg(x) AS 42;

statement ok
CREATE VIEW ma AS SELECT ignore_arg((SELECT x FROM mb)) AS x;

statement ok
CREATE VIEW mb AS SELECT * FROM ma;

statement ok
CREATE VIEW ca AS SELECT 42 AS x, COLUMNS(* EXCLUDE (dummy)) + (SELECT x FROM cb) FROM (SELECT 1 AS dummy);

statement ok
CREATE VIEW cb AS SELECT * FROM ca;

# a qualified name for the state of a recursive common table expression
statement ok
CREATE SCHEMA recurring;

statement ok
CREATE VIEW rk AS WITH RECURSIVE r(x) USING KEY (x) AS (SELECT 1 UNION SELECT x + 1 FROM recurring.r WHERE x < 3) SELECT max(x) AS x FROM r;

statement ok
CREATE VIEW recurring.r AS SELECT * FROM rk;

# a name without a schema in a view of a nested schema
statement ok
CREATE VIEW ns.lc AS SELECT 42 AS x;

statement ok
CREATE VIEW zz.ns.la AS SELECT * FROM lc;

statement ok
CREATE VIEW zz.ns.lc AS SELECT x + 1 AS x FROM zz.ns.la;

# a name without a schema in a view of another schema refers to the default schema
statement ok
CREATE VIEW aa.reads_main AS SELECT x * 10 AS x FROM n_second;

# a name without a schema that refers to a table of the schema of the view
statement ok
CREATE SCHEMA ar;

statement ok
CREATE TABLE ar.shared AS SELECT 7 AS x;

statement ok
CREATE VIEW ar.reader AS SELECT x FROM shared;

statement ok
CREATE VIEW shared AS SELECT x + 1 AS x FROM ar.reader;

# a view that reads a temporary view instead after loading
statement ok
CREATE VIEW tz AS SELECT 41 AS x;

statement ok
CREATE VIEW sa AS SELECT x + 1 AS x FROM tz;

# a view with a side effect when it is bound
statement ok
CREATE SEQUENCE seq;

statement ok
CREATE VIEW sv AS SELECT * FROM range(nextval('seq'));

# views created in one transaction
statement ok
BEGIN;

statement ok
CREATE VIEW k AS SELECT 5 AS x;

statement ok
CREATE VIEW j AS SELECT x * 2 AS x FROM k;

statement ok
COMMIT;

# the views get new identifiers when the database is loaded again
restart

statement ok
CREATE TEMP VIEW tz AS SELECT 99 AS x;

statement ok
EXPORT DATABASE '{TEST_DIR}/export_view_order';

query I
SELECT nextval('seq');
----
2

statement ok
ATTACH ':memory:' AS imported;

statement ok
USE imported;

statement ok
IMPORT DATABASE '{TEST_DIR}/export_view_order';

statement ok
DROP VIEW temp.tz;

query IIIIIIIIIIII
SELECT (SELECT x FROM a), (SELECT x FROM n_second), (SELECT m FROM c), (SELECT v FROM aa.top), (SELECT x FROM q), (SELECT x FROM f), (SELECT x FROM j), (SELECT x FROM y), (SELECT x FROM aa.reads_main), (SELECT x FROM shared), (SELECT x FROM sa), (SELECT count(*) FROM t)
----
1	102	2	42	14	33	10	6	1020	8	42	3

query IIII
SELECT (SELECT x FROM ub), (SELECT x FROM qc), (SELECT x FROM ry), (SELECT x FROM imported.zz.ns.va)
----
42	42	49	43

query IIIIII
SELECT (SELECT x FROM ra), (SELECT x FROM mb), (SELECT x FROM cb), (SELECT x FROM recurring.r), (SELECT x FROM ns.lc), (SELECT x FROM imported.zz.ns.lc)
----
42	42	42	3	42	43
