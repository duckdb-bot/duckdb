# name: test/sql/function/generic/test_between_nested.test
# description: BETWEEN and range filters on LIST, STRUCT and ARRAY values
# group: [generic]

# two comparisons of one expression with constants are combined into a BETWEEN
query I
SELECT a FROM (VALUES (NULL::INTEGER[]), ([0]), ([1]), ([3]), ([NULL])) t(a) WHERE a > [0] AND a < [3];
----
[1]

query I
SELECT s FROM (VALUES ({'x': 1}), ({'x': 5})) t(s) WHERE s > {'x': 0} AND s < {'x': 3};
----
{'x': 1}

query I
SELECT a FROM (VALUES ([0]), ([1]), ([3])) t(a) WHERE a BETWEEN [1] AND [2];
----
[1]

query I
SELECT a FROM (VALUES ([0]), ([1]), ([3])) t(a) WHERE NOT (a <= [0]) AND NOT (a >= [3]);
----
[1]

query I
SELECT a FROM (VALUES ([1, 1]::INTEGER[2]), ([2, 2]::INTEGER[2]), ([3, 3]::INTEGER[2])) t(a)
WHERE a BETWEEN [1, 5]::INTEGER[2] AND [3, 0]::INTEGER[2];
----
[2, 2]

query I
SELECT m FROM (VALUES (MAP {1: 2}), (MAP {5: 6})) t(m) WHERE m BETWEEN MAP {0: 0} AND MAP {3: 0};
----
{1=2}

query I
SELECT u FROM (VALUES (union_value(k := 1)), (union_value(k := 5))) t(u) WHERE u > union_value(k := 0) AND u < union_value(k := 3);
----
1

statement ok
CREATE TABLE lists AS SELECT [i] AS a FROM range(5) r(i);

query I
SELECT a FROM lists WHERE a >= [1] AND a < [3] ORDER BY a;
----
[1]
[2]

query I
SELECT a FROM lists WHERE a > [1] AND a <= [3] ORDER BY a;
----
[2]
[3]

query I
SELECT a FROM lists WHERE a >= [1] AND a <= [3] ORDER BY a;
----
[1]
[2]
[3]

# the rows outside the bounds
query I
SELECT a FROM lists WHERE a NOT BETWEEN [1] AND [3] ORDER BY a;
----
[0]
[4]

query I
SELECT a FROM lists WHERE a BETWEEN [1] AND [2] OR a = [4] ORDER BY a;
----
[1]
[2]
[4]

query II
SELECT a, CASE WHEN a BETWEEN [1] AND [2] THEN 'in' ELSE 'out' END FROM lists ORDER BY a;
----
[0]	out
[1]	in
[2]	in
[3]	out
[4]	out

# an expression input is not split into comparisons, and the earlier branch leaves a partial selection
query II
SELECT i, CASE WHEN i % 2 = 0 THEN 'even' WHEN [i] BETWEEN [1] AND [3] THEN 'in' ELSE 'out' END FROM range(6) t(i);
----
0	even
1	in
2	even
3	in
4	even
5	out

query I
SELECT i FROM range(6) t(i) WHERE i = 0 OR [i] BETWEEN [2] AND [3] ORDER BY i;
----
0
2
3

query I
SELECT i FROM range(6) t(i) WHERE i != 4 AND NOT ([i] BETWEEN [2] AND [3]) ORDER BY i;
----
0
1
5

# several vectors with NULL rows and NULL elements, against the same comparisons outside a filter
statement ok
CREATE TABLE nested AS
SELECT CASE WHEN i % 7 = 0 THEN NULL ELSE [i % 10, CASE WHEN i % 3 = 0 THEN NULL ELSE i END] END AS a,
       CASE WHEN i % 11 = 0 THEN NULL ELSE {'x': i % 10, 'y': i::VARCHAR} END AS s
FROM range(5000) r(i);

query II
SELECT (SELECT count(*) FROM nested WHERE a BETWEEN [3] AND [5]),
       (SELECT count(*) FROM nested WHERE a NOT BETWEEN [3] AND [5]);
----
857	3428

query II
SELECT sum(((a BETWEEN [3] AND [5]) IS TRUE)::INTEGER), sum(((a NOT BETWEEN [3] AND [5]) IS TRUE)::INTEGER) FROM nested;
----
857	3428

query II
SELECT (SELECT count(*) FROM nested WHERE s > {'x': 2, 'y': '9'} AND s < {'x': 5, 'y': ''}),
       (SELECT count(*) FROM nested WHERE NOT (s > {'x': 2, 'y': '9'} AND s < {'x': 5, 'y': ''}));
----
918	3627

query II
SELECT sum(((s > {'x': 2, 'y': '9'} AND s < {'x': 5, 'y': ''}) IS TRUE)::INTEGER),
       sum(((NOT (s > {'x': 2, 'y': '9'} AND s < {'x': 5, 'y': ''})) IS TRUE)::INTEGER)
FROM nested;
----
918	3627
