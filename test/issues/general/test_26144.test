# name: test/issues/general/test_26144.test
# description: Binding rejects functions that modify the database where it evaluates an expression
# group: [general]

load {TEST_DIR}/test_26144.db

statement ok
CREATE SEQUENCE s;

statement error
PREPARE p AS SELECT count(*) FROM range(nextval('s'));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

query I
SELECT 42;
----
42

statement error
SELECT count(*) FROM range(nextval('s'));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement error
PREPARE g AS SELECT count(*) FROM generate_series(1, nextval('s'));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement error
PREPARE v AS SELECT count(*) FROM range(setval('s', 10));
----
Binder Error: Function "setval" modifies the database and cannot be evaluated while binding

# the check does not depend on the branch that runs
statement error
PREPARE x AS SELECT count(*) FROM range(CASE WHEN false THEN nextval('s') ELSE 2 END);
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement ok
CREATE MACRO m(x) AS TABLE SELECT * FROM range(x);

statement error
PREPARE t AS SELECT count(*) FROM m(nextval('s'));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement ok
PREPARE e AS SELECT $1::BIGINT;

statement error
EXECUTE e(1 + nextval('s'));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement error
PREPARE c AS COPY (SELECT 42) TO '{TEST_DIR}/test_26144.csv' (DELIMITER chr(nextval('s')::INTEGER + 43));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement error
SET threads = nextval('s');
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

# lambda bodies are checked too
statement error
SET threads = invoke(lambda x: nextval('s'), 0) + 1;
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement error
SET threads = list_sum(list_transform([1, 2], lambda x: nextval('s')));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement error
SET threads = list_sum(list_transform([1], lambda x: list_sum(list_transform([2], lambda y: setval('s', 10)))));
----
Binder Error: Function "setval" modifies the database and cannot be evaluated while binding

statement error
PREPARE cl AS COPY (SELECT 42) TO '{TEST_DIR}/test_26144.csv' (DELIMITER chr(invoke(lambda x: nextval('s'), 0)::INTEGER + 43));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement ok
CREATE TABLE tt (i INTEGER);

statement error
SELECT * FROM tt AT (VERSION => nextval('s'));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

# a volatile function that does not modify the database is still evaluated
statement error
SELECT * FROM tt AT (VERSION => random());
----
Binder Error: Catalog type does not support time travel

statement ok
BEGIN;

statement error
PREPARE q AS SELECT count(*) FROM range(nextval('s'));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement ok
ROLLBACK;

statement ok
BEGIN TRANSACTION READ ONLY;

statement error
PREPARE r AS SELECT count(*) FROM range(nextval('s'));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement ok
ROLLBACK;

# none of the statements above advanced the sequence
query I
SELECT nextval('s');
----
1

# currval only reads the sequence
statement ok
BEGIN TRANSACTION READ ONLY;

statement ok
PREPARE cur AS SELECT count(*) FROM range(currval('s'));

query I
EXECUTE cur;
----
1

statement ok
COMMIT;

# sequence functions that are evaluated while executing advance the sequence on every EXECUTE
statement ok
PREPARE l AS SELECT count(*) FROM (SELECT * FROM range(10) LIMIT nextval('s'));

query I
EXECUTE l;
----
2

query I
EXECUTE l;
----
3

statement ok
PREPARE sub AS SELECT count(*) FROM range((SELECT nextval('s')));

query I
EXECUTE sub;
----
4

statement ok
ATTACH '{TEST_DIR}/test_26144_ro.db' AS ro;

statement ok
CREATE SEQUENCE ro.s;

statement ok
DETACH ro;

statement ok
ATTACH '{TEST_DIR}/test_26144_ro.db' AS ro (READ_ONLY);

statement error
PREPARE a AS SELECT count(*) FROM range(nextval('ro.s'));
----
Binder Error: Function "nextval" modifies the database and cannot be evaluated while binding

statement error
PREPARE b AS SELECT count(*) FROM range(setval('ro.s', 10));
----
Binder Error: Function "setval" modifies the database and cannot be evaluated while binding

query I
SELECT 42;
----
42

statement ok
DETACH ro;

restart

query I
SELECT nextval('s');
----
5
