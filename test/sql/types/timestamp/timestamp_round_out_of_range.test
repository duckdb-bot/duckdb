# name: test/sql/types/timestamp/timestamp_round_out_of_range.test
# description: Rounding timestamps to a lower precision cannot go past the largest timestamp
# group: [timestamp]

statement error
SELECT TIMESTAMP '294247-01-10 04:00:54.775806'::TIMESTAMP_S
----
can't be cast

statement error
SELECT TIMESTAMP '294247-01-10 04:00:54.6'::TIMESTAMP_S::TIMESTAMPTZ
----
can't be cast

query II
SELECT TRY_CAST(TIMESTAMP '294247-01-10 04:00:54.775806' AS TIMESTAMP_S)::VARCHAR, TRY_CAST(TIMESTAMP '294247-01-10 04:00:54.775806' AS TIMESTAMP_MS)
----
NULL	NULL

query II
SELECT TIMESTAMP '294247-01-10 04:00:54.4'::TIMESTAMP_S, TIMESTAMP '2024-01-01 10:00:00.6'::TIMESTAMP_S
----
294247-01-10 04:00:54	2024-01-01 10:00:01

# TIMESTAMP_MS to TIMESTAMP_S
statement error
SELECT CAST(TIMESTAMP_MS '294247-01-10 04:00:54.775' AS TIMESTAMP_S)
----
<REGEX>:Conversion Error.*294247-01-10 04:00:54.775.*can't be cast.*

statement error
SELECT CAST(TIMESTAMP_MS '294247-01-10 04:00:54.500' AS TIMESTAMP_S)
----
<REGEX>:Conversion Error.*294247-01-10 04:00:54.5.*can't be cast.*

query I
SELECT TRY_CAST(TIMESTAMP_MS '294247-01-10 04:00:54.775' AS TIMESTAMP_S)
----
NULL

query II
SELECT CAST(TIMESTAMP_MS '294247-01-10 04:00:54.400' AS TIMESTAMP_S), CAST(TIMESTAMP_MS '2024-01-01 00:00:00.600' AS TIMESTAMP_S)
----
294247-01-10 04:00:54	2024-01-01 00:00:01

# values from a table
statement ok
CREATE TABLE milliseconds(id INTEGER, x TIMESTAMP_MS);

statement ok
INSERT INTO milliseconds VALUES (1, '2024-01-01 00:00:00.600'), (2, '294247-01-10 04:00:54.775'), (3, NULL), (4, 'infinity');

statement error
SELECT id, CAST(x AS TIMESTAMP_S) FROM milliseconds
----
<REGEX>:Conversion Error.*294247-01-10 04:00:54.775.*can't be cast.*

query II
SELECT id, TRY_CAST(x AS TIMESTAMP_S) FROM milliseconds ORDER BY id
----
1	2024-01-01 00:00:01
2	NULL
3	NULL
4	infinity

query I
SELECT 42
----
42
