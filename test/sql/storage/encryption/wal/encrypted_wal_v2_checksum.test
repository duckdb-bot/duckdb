# name: test/sql/storage/encryption/wal/encrypted_wal_v2_checksum.test
# description: Encrypted v2.0.0 databases verify the checksums of their blocks and WAL entries after replay and checkpoint
# group: [wal]

statement ok
SET debug_force_mbedtls_unsafe=true

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET checkpoint_threshold='1TB'

foreach cipher GCM CTR

statement ok
ATTACH '{TEST_DIR}/encrypted_wal_v2_checksum_{cipher}.db' AS enc (ENCRYPTION_KEY 'asdf', ENCRYPTION_CIPHER '{cipher}', STORAGE_VERSION 'v2.0.0');

statement ok
CREATE TABLE enc.t AS SELECT range AS i, 'value ' || range AS s FROM range(10000);

statement ok
CHECKPOINT enc

statement ok
INSERT INTO enc.t SELECT range, 'value ' || range FROM range(10000, 11000);

statement ok
DETACH enc

# attaching replays the WAL entries of the insert
statement ok
ATTACH '{TEST_DIR}/encrypted_wal_v2_checksum_{cipher}.db' AS enc (ENCRYPTION_KEY 'asdf', ENCRYPTION_CIPHER '{cipher}', STORAGE_VERSION 'v2.0.0');

query III
SELECT count(*), sum(i), count(*) FILTER (WHERE s <> 'value ' || i) FROM enc.t
----
11000	60494500	0

statement ok
CHECKPOINT enc

statement ok
DETACH enc

statement ok
ATTACH '{TEST_DIR}/encrypted_wal_v2_checksum_{cipher}.db' AS enc (ENCRYPTION_KEY 'asdf', ENCRYPTION_CIPHER '{cipher}', STORAGE_VERSION 'v2.0.0');

query III
SELECT count(*), sum(i), count(*) FILTER (WHERE s <> 'value ' || i) FROM enc.t
----
11000	60494500	0

query I
SELECT tags['storage_version'] FROM duckdb_databases() WHERE database_name = 'enc'
----
v2.0.0+

statement ok
DETACH enc

endloop
