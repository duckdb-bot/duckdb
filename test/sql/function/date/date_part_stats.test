statement ok
PRAGMA disable_verification

statement ok
INSERT INTO dates VALUES (DATE '1992-01-01'), (DATE '2000-12-31');

statement ok
CREATE TABLE expected_result AS FROM (VALUES
	('year', 1992, 2000),
	('month', 1, 12),
	('day', 1, 31),
	('decade', 199, 200),
	('century', 20, 20),
	('millenium', 2, 2),
	('microseconds', 0, 59999999),
	('milliseconds', 0, 59999),
	('second', 0, 59),
	('minute', 0, 59),
	('hour', 0, 24),
	('dow', 0, 6),
	('week', 1, 53),
	('doy', 1, 366),
	('quarter', 1, 4),
	('yearweek', 199201, 200052),
	('dayofmonth', 1, 31),
	('weekday', 0, 6),
	('weekofyear', 1, 53)
	) t(component, min, max)

foreach component year month day decade century millenium microseconds milliseconds second minute hour dow week doy quarter yearweek dayofmonth weekday weekofyear

query I
SELECT
	CASE WHEN stats.min = expected_result.min AND stats.max = expected_result.max THEN NULL ELSE {'stats': stats, 'expected_result': expected_result} END
FROM (
	SELECT STATS(EXTRACT({component} FROM d)) AS stats, (SELECT expected_result FROM expected_result WHERE component = '{component}') expected_result FROM dates LIMIT 1
)
----
NULL

endloop

foreach type DATE TIMESTAMP TIMESTAMP_S TIMESTAMP_MS TIMESTAMP_NS

statement ok
CREATE TABLE t0(c0 {type});

statement ok
INSERT INTO t0(c0) VALUES ('-infinity'), ('infinity');

query III
SELECT (t0.c0), WEEKOFYEAR(t0.c0), WEEKOFYEAR(t0.c0) IS NULL FROM t0 ORDER BY c0;
----
-infinity	NULL	true
infinity	NULL	true

query III
SELECT (t0.c0), WEEKDAY(t0.c0), WEEKDAY(t0.c0) IS NULL FROM t0 ORDER BY c0;
----
-infinity	NULL	true
infinity	NULL	true

query III
SELECT (t0.c0), DAYOFMONTH(t0.c0), DAYOFMONTH(t0.c0) IS NULL FROM t0 ORDER BY c0;
----
-infinity	NULL	true
infinity	NULL	true

query I
SELECT WEEKOFYEAR(t0.c0) IS NOT NULL FROM t0;
----
false
false

statement ok
DROP TABLE t0

endloop

# the smallest finite value sorts below -infinity, so -infinity can lie between finite bounds
statement ok
CREATE TABLE dates_min(d DATE);

statement ok
INSERT INTO dates_min VALUES (make_date(-2147483647 - 1)), ('-infinity'), ('1970-01-01');

query IIIIIIIIIIIIIIIIIIIIIII
SELECT count(year(d)), count(month(d)), count(day(d)), count(decade(d)), count(century(d)), count(millennium(d)),
       count(quarter(d)), count(dayofyear(d)), count(dayofweek(d)), count(isodow(d)), count(era(d)), count(epoch(d)),
       count(julian(d)), count(hour(d)), count(minute(d)), count(second(d)), count(millisecond(d)),
       count(microsecond(d)), count(nanosecond(d)), count(epoch_ms(d)), count(weekday(d)), count(dayofmonth(d)),
       count(date_part('year', d))
FROM dates_min
----
2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2

statement ok
CREATE TABLE timestamps_min(ts TIMESTAMP);

statement ok
INSERT INTO timestamps_min VALUES (make_timestamp(-9223372036854775807 - 1)), ('-infinity'), ('1970-01-01');

query IIIIIIIIIIIIIIIIIIIIIIIIIII
SELECT count(year(ts)), count(month(ts)), count(day(ts)), count(decade(ts)), count(century(ts)),
       count(millennium(ts)), count(quarter(ts)), count(dayofyear(ts)), count(week(ts)), count(isoyear(ts)),
       count(yearweek(ts)), count(dayofweek(ts)), count(isodow(ts)), count(era(ts)), count(epoch(ts)),
       count(julian(ts)), count(hour(ts)), count(minute(ts)), count(second(ts)), count(millisecond(ts)),
       count(microsecond(ts)), count(nanosecond(ts)), count(epoch_us(ts)), count(weekday(ts)), count(weekofyear(ts)),
       count(dayofmonth(ts)), count(timezone(ts))
FROM timestamps_min
----
2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2	2

statement ok
CREATE TABLE timestamps_ns_min(ts TIMESTAMP_NS);

statement ok
INSERT INTO timestamps_ns_min VALUES (make_timestamp_ns(-9223372036854775807 - 1)), ('-infinity'), ('1970-01-01');

query I
SELECT count(nanosecond(ts)) FROM timestamps_ns_min
----
2

# the smallest finite values have date parts
statement ok
DELETE FROM dates_min WHERE NOT isfinite(d)

statement ok
DELETE FROM timestamps_min WHERE NOT isfinite(ts)

query IIII
SELECT count(year(d)), min(year(d)), max(year(d)), count(month(d)) FROM dates_min
----
2	-5877641	1970	2

query IIII
SELECT count(year(ts)), min(year(ts)), max(year(ts)), count(month(ts)) FROM timestamps_min
----
2	-290308	1970	2

statement ok
DELETE FROM dates_min WHERE year(d) = 1970

query II
SELECT count(year(d)), year(min(d)) FROM dates_min
----
1	-5877641
