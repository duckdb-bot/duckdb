# name: test/sql/storage/wal/wal_replay_struct_field_dependencies.test
# description: The replay of an ALTER of a struct field registers what the new default of the column depends on
# group: [wal]

load {TEST_DIR}/wal_replay_struct_field_dependencies.db

statement ok
CREATE MACRO mc() AS 7;

statement ok
CREATE TABLE m (i INT, s STRUCT(x INT) DEFAULT {'x': 1});

statement ok
CHECKPOINT;

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET wal_autocheckpoint='1TB';

statement ok
ALTER TABLE m ADD COLUMN s.c INTEGER DEFAULT mc();

# the ALTER is replayed from the WAL
restart

statement error
DROP MACRO mc;
----
table "m" depends on macro function "mc"

statement ok
INSERT INTO m (i) VALUES (1);

# this restart writes a checkpoint, with the macro before the table that needs it
restart

statement ok
INSERT INTO m (i) VALUES (2);

query II
SELECT * FROM m ORDER BY i;
----
1	{'x': 1, 'c': 7}
2	{'x': 1, 'c': 7}
