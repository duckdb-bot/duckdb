----
3	[1, 5, abcdefghijkl]

endloop

endloop

# a quoted value holding a bare line feed and a \r\n is not a comment, the thread that starts inside it keeps it whole
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || 'xxxxxxxx,2' || chr(13) || chr(10) || '"a' || chr(10) || '3,4' || chr(13) || chr(10) || 'z",5' || chr(13) || chr(10) || '6,7' || chr(13)) TO '{TEST_DIR}/comment_lf_boundary_quoted_field.csv' (HEADER false, QUOTE '', DELIM '|');

