# name: test/sql/copy/csv/auto/test_sniffer_apostrophe_quote.test
# description: An apostrophe at the start of one value and another at the end of a later one do not quote the lines between them
# group: [auto]

statement ok
COPY (SELECT * FROM (VALUES ('c1,c2,c3'), ('a,''xxx,1'), ('b,yyy,2'), ('c,zzz'',3')) t(line)) TO '{TEST_DIR}/apostrophes.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query III
SELECT * FROM read_csv('{TEST_DIR}/apostrophes.csv')
----
a	'xxx	1
b	yyy	2
c	zzz'	3

query T
SELECT Quote FROM sniff_csv('{TEST_DIR}/apostrophes.csv')
----
(empty)

# the apostrophes in the first chunk of the sample, or in a later one
foreach first 10 3000

statement ok
COPY (SELECT i || ',' || CASE WHEN i = {first} THEN '''starts' WHEN i = {first} + 10 THEN 'ends''' ELSE 'plain' END || ',' || i * 2 FROM range(1, 5001) t(i) ORDER BY i) TO '{TEST_DIR}/apostrophes_{first}.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query III
SELECT count(*), count(*) FILTER (column1 LIKE '%''%'), sum(column2) FROM read_csv('{TEST_DIR}/apostrophes_{first}.csv')
----
5000	2	25005000

endloop

# a quoted value that the lines of a file only make sense with keeps its quote
statement ok
COPY (SELECT * FROM (VALUES ('a,b,c'), ('1,''x'), ('y'',2'))) TO '{TEST_DIR}/apostrophes_quoted_lines.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query III
SELECT a, replace(b, chr(10), ' '), c FROM read_csv('{TEST_DIR}/apostrophes_quoted_lines.csv')
----
1	x y	2

statement ok
COPY (SELECT * FROM (VALUES ('a,b,c'), ('1,''x,y'',2'), ('2,''z'',3'))) TO '{TEST_DIR}/apostrophes_quoted.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query III
SELECT * FROM read_csv('{TEST_DIR}/apostrophes_quoted.csv')
----
1	x,y	2
2	z	3

# double quotes around lines are quotes
statement ok
COPY (SELECT * FROM (VALUES ('a,b'), ('1,"x'), ('y,z"'))) TO '{TEST_DIR}/double_quoted_lines.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query II
SELECT a, replace(b, chr(10), ' ') FROM read_csv('{TEST_DIR}/double_quoted_lines.csv')
----
1	x y,z

# a quote given by the user is used
query III
SELECT c1, replace(c2, chr(10), ' '), c3 FROM read_csv('{TEST_DIR}/apostrophes.csv', quote = '''')
----
a	xxx,1 b,yyy,2 c,zzz	3

# another quote that only reads the lines by skipping or padding them does not read them as rows
statement ok
COPY (SELECT * FROM (VALUES ('1,''x'), ('y'',2'), ('3,z,4'))) TO '{TEST_DIR}/apostrophes_leading.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query III
SELECT column0, replace(column1, chr(10), ' '), column2 FROM read_csv('{TEST_DIR}/apostrophes_leading.csv', header = false)
----
1	x y	2
3	z	4

statement ok
COPY (SELECT * FROM (VALUES ('a,b,c'), ('1,''x'), ('y'',2'), ('3,z,4'))) TO '{TEST_DIR}/apostrophes_padded.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query III
SELECT a, replace(b, chr(10), ' '), c FROM read_csv('{TEST_DIR}/apostrophes_padded.csv', null_padding = true, parallel = false)
----
1	x y	2
3	z	4

# a value later in the sample that needs the apostrophe as quote keeps it
statement ok
COPY (SELECT * FROM (SELECT 0 AS i, 'a,b,c' AS line UNION ALL SELECT 1, '1,''x,1' UNION ALL SELECT 2, '2,y'',2' UNION ALL SELECT i, i || ',plain,' || i FROM range(3, 2048) t(i) UNION ALL SELECT 2048, '2048,''x,y'',2048') ORDER BY i) TO '{TEST_DIR}/apostrophes_needed_later.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query II
SELECT count(*), sum(c) FROM read_csv('{TEST_DIR}/apostrophes_needed_later.csv', sample_size = -1)
----
2047	2098175

# a new line after an escape is inside the quotes too
statement ok
COPY (SELECT * FROM (VALUES ('c1,c2,c3'), ('a,''xxx,1\'), ('b,yyy,2\'), ('c,zzz'',3'))) TO '{TEST_DIR}/apostrophes_escaped.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query III
SELECT * FROM read_csv('{TEST_DIR}/apostrophes_escaped.csv')
----
a	'xxx	1\
b	yyy	2\
c	zzz'	3

# another quote that reads a line between the apostrophes as a comment does not read the lines as rows
statement ok
COPY (SELECT * FROM (VALUES ('a,b,c'), ('1,''x,1'), ('#inner'), ('2,y'',2'))) TO '{TEST_DIR}/apostrophes_comment.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query III
SELECT a, replace(b, chr(10), ' '), c FROM read_csv('{TEST_DIR}/apostrophes_comment.csv', comment = '#')
----
1	x,1 #inner 2,y	2

# the apostrophe candidate that read the whole file waits until another quote has read its sample
statement ok
COPY (SELECT i || ',' || CASE WHEN i = 1 THEN '''starts' WHEN i = 2051 THEN 'ends''' WHEN i = 4096 THEN '''x,y''' ELSE 'plain' END || ',' || i FROM range(1, 4097) t(i) ORDER BY i) TO '{TEST_DIR}/apostrophes_long.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query II
SELECT count(*), sum(column2) FROM read_csv('{TEST_DIR}/apostrophes_long.csv', sample_size = -1)
----
2046	6288381

# rows skipped by the user count the same for both candidates
statement ok
COPY (SELECT * FROM (VALUES ('note'), ('c1,c2,c3'), ('a,''xxx,1'), ('b,yyy,2'), ('c,zzz'',3'))) TO '{TEST_DIR}/apostrophes_skip.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\t')

query III
SELECT * FROM read_csv('{TEST_DIR}/apostrophes_skip.csv', skip = 1)
----
a	'xxx	1
b	yyy	2
c	zzz'	3
