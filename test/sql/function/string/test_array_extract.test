# name: test/sql/function/string/test_array_extract.test
# description: Extract a character from a string with a subscript, array_extract takes no strings
# group: [string]

statement ok
CREATE TABLE strings(s VARCHAR, off INTEGER);

statement ok
INSERT INTO strings VALUES ('hello', 1), ('world', 2), ('b', 1), (NULL, 2)

# test zero length
query TT
SELECT '🦆ab'[4], 'abc'[4]
----
(empty)	(empty)

# constant offset/length
# normal subscript
query T
SELECT s[2] FROM strings
----
e
o
(empty)
NULL

# subscript out of range
query T
SELECT s[3] FROM strings
----
l
r
(empty)
NULL

# variable length offset/length
query T
SELECT s[off] FROM strings
----
h
o
b
NULL

query T
SELECT s[2] FROM strings
----
e
o
(empty)
NULL

query T
SELECT 'hello'[off] FROM strings
----
h
e
h
e

# test substrings with constant nulls in different places
query T
SELECT (NULL::VARCHAR)[off] FROM strings
----
NULL
NULL
NULL
NULL

query T
SELECT 'hello'[NULL] FROM strings
----
NULL
NULL
NULL
NULL

query T
SELECT (NULL::VARCHAR)[NULL] FROM strings
----
NULL
NULL
NULL
NULL

query T
SELECT (NULL::VARCHAR)[off] FROM strings
----
NULL
NULL
NULL
NULL

query T
SELECT (NULL::VARCHAR)[NULL] FROM strings
----
NULL
NULL
NULL
NULL

# negative offset
query T
SELECT s[-1] FROM strings
----
o
d
b
NULL

# zero offset
query T
SELECT s[1] FROM strings
----
h
w
b
NULL

# length 0
query T
SELECT s[6] FROM strings
----
(empty)
(empty)
(empty)
NULL

# very large offset and length
query T
SELECT s[2147483646] FROM strings
----
(empty)
(empty)
(empty)
NULL

query T
SELECT s[-2147483647] FROM strings
----
(empty)
(empty)
(empty)
NULL


# Issue #4978 -- Substring overflow 3
query I
SELECT '1'[-1];
----
1

statement error
SELECT '1'[9223372036854775807];
----
Out of Range Error: Substring offset outside of supported range (> 4294967295)

statement error
SELECT '0'[-9223372036854775808];
----
Out of Range Error: Substring offset outside of supported range (< -4294967296)

query TT
SELECT 'abc'[0], ('Ab' COLLATE nocase)[1] = 'a'
----
(empty)	true

statement ok
PREPARE subscript_base AS SELECT $1[2]

query T
EXECUTE subscript_base('abc')
----
b

query I
EXECUTE subscript_base([10, 20])
----
20

# a value that casts implicitly to a string is indexed as one
statement ok
CREATE TYPE mood AS ENUM ('happy', 'sad')

query T
SELECT ('happy'::mood)[1]
----
h

statement error
SELECT (union_value(s := 'abc'))[1]
----
No function matches the given name and argument types 'array_extract(UNION(s VARCHAR), INTEGER_LITERAL)'

statement ok
SET old_implicit_casting = true

query TT
SELECT (42)[1], (union_value(s := 'abc'))[1]
----
4	a

statement error
SELECT ('abc'::BLOB)[1]
----
No function matches the given name and argument types 'array_extract(BLOB, INTEGER_LITERAL)'

statement ok
RESET old_implicit_casting

# an untyped NULL is not a string, its subscript binds to array_extract
query TTT
SELECT typeof(NULL[1]), typeof(array_extract(NULL, 1)), NULL[k] FROM (VALUES ('x')) t(k)
----
VARIANT	VARIANT	NULL

# array_extract, list_extract and list_element take no strings
statement error
SELECT array_extract(s, 1) FROM strings
----
No function matches the given name and argument types 'array_extract(VARCHAR, INTEGER_LITERAL)'

statement error
SELECT list_extract(s, 1) FROM strings
----
No function matches the given name and argument types 'list_extract(VARCHAR, INTEGER_LITERAL)'

statement error
SELECT list_element(s, 1) FROM strings
----
No function matches the given name and argument types 'list_element(VARCHAR, INTEGER_LITERAL)'

# a string literal casts implicitly to VARIANT, which does not make it a list
statement error
SELECT array_extract('DuckDB', 2)
----
array_extract does not extract from a string, use s[i] or substring(s, i, 1) instead

statement error
SELECT list_extract('DuckDB', 2)
----
list_extract does not extract from a string, use s[i] or substring(s, i, 1) instead

statement error
SELECT list_element('DuckDB', 2)
----
list_element does not extract from a string, use s[i] or substring(s, i, 1) instead

# a string cast to VARIANT explicitly is read as a VARIANT, which holds no list here
query I
SELECT list_extract('DuckDB'::VARIANT, 2)
----
NULL
