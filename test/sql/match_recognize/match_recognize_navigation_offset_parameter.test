# name: test/sql/match_recognize/match_recognize_navigation_offset_parameter.test
# description: The offset of a navigation function can be a prepared statement parameter, bound for every execution
# group: [match_recognize]

statement ok
CREATE TABLE t (x INTEGER);

statement ok
INSERT INTO t VALUES (1), (2), (3);

statement ok
PREPARE last_offset AS SELECT v FROM t MATCH_RECOGNIZE (ORDER BY x MEASURES LAST(x, $1) AS v ONE ROW PER MATCH PATTERN (A+) DEFINE A AS true);

query I
EXECUTE last_offset(0);
----
3

# the offset is read again for every execution
query I
EXECUTE last_offset(1);
----
2

query I
EXECUTE last_offset(5);
----
NULL

statement error
EXECUTE last_offset(NULL);
----
must be a non-negative integer, not NULL

statement error
EXECUTE last_offset(-1);
----
must be a non-negative integer

# in a DEFINE condition
statement ok
PREPARE define_offset AS SELECT v FROM t MATCH_RECOGNIZE (ORDER BY x MEASURES LAST(x) AS v ONE ROW PER MATCH PATTERN (A B+) DEFINE B AS x = PREV(x, $1) + $1);

query I
EXECUTE define_offset(1);
----
3

# a constant offset keeps working, and a column is still refused
query I
SELECT v FROM t MATCH_RECOGNIZE (ORDER BY x MEASURES FIRST(x, 1) AS v ONE ROW PER MATCH PATTERN (A+) DEFINE A AS true);
----
2

statement error
SELECT v FROM t MATCH_RECOGNIZE (ORDER BY x MEASURES FIRST(x, x) AS v ONE ROW PER MATCH PATTERN (A+) DEFINE A AS true);
----
must be a constant
