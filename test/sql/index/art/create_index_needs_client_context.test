# name: test/sql/index/art/create_index_needs_client_context.test
# description: Appends and deletes compute index keys without a client context, so keys that need one are rejected
# group: [art]

statement ok
CREATE TABLE t (id INTEGER, l INTEGER[], s VARCHAR);

statement ok
INSERT INTO t VALUES (1, [3, 1, 2], 'abc');

statement error
CREATE INDEX i ON t ((list_transform(l, lambda x: x + 1)[1]));
----
Index keys cannot contain "list_transform", which needs a client context to execute

statement error
CREATE INDEX i ON t ((list_filter(l, lambda x: x > 1)[1]));
----
Index keys cannot contain "list_filter", which needs a client context to execute

statement error
CREATE UNIQUE INDEX i ON t ((list_reduce(l, lambda a, b: a + b)));
----
Index keys cannot contain "list_reduce", which needs a client context to execute

foreach function list_sort array_sort list_reverse_sort list_grade_up

statement error
CREATE INDEX i ON t (({function}(l)[1]));
----
which needs a client context to execute

endloop

# the edit distances check for interrupts only when there is a client context
statement ok
CREATE UNIQUE INDEX i_lev ON t ((levenshtein(s, 'abd')));

statement ok
CREATE INDEX i_dlev ON t ((damerau_levenshtein(s, 'acb')));

statement ok
INSERT INTO t VALUES (2, [5, 4], 'abdxx');

statement error
INSERT INTO t VALUES (3, [7], 'abe');
----
Duplicate key "levenshtein(s, 'abd'): 1"

query I
SELECT id FROM t WHERE levenshtein(s, 'abd') = 2;
----
2

query I
SELECT id FROM t WHERE damerau_levenshtein(s, 'acb') = 1;
----
1

statement ok
DELETE FROM t WHERE id = 1;

statement ok
INSERT INTO t VALUES (3, [7], 'abe');

query III
SELECT id, levenshtein(s, 'abd'), damerau_levenshtein(s, 'acb') FROM t ORDER BY id;
----
2	2	4
3	1	2
