# name: test/sql/catalog/nested_schema/nested_rename_foreign_key.test
# description: Renaming a table in a nested schema keeps the schema path in its foreign key constraints
# group: [nested_schema]

load {TEST_DIR}/nested_rename_foreign_key.db readwrite v2.0.0

# keep the changes in the WAL until the explicit checkpoint, so that the first restart replays them
statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET wal_autocheckpoint = '1GB';

statement ok
CREATE SCHEMA a;

statement ok
CREATE SCHEMA a.b;

statement ok
CREATE TABLE a.b.p (i INTEGER PRIMARY KEY);

statement ok
INSERT INTO a.b.p VALUES (1), (2);

statement ok
CREATE TABLE a.b.c (j INTEGER REFERENCES a.b.p (i));

statement ok
INSERT INTO a.b.c VALUES (1);

statement ok
ALTER TABLE a.b.c RENAME TO c2;

# nothing references 2, but 1 is referenced by c2
statement ok
DELETE FROM a.b.p WHERE i = 2;

statement error
DELETE FROM a.b.p WHERE i = 1;
----
Violates foreign key constraint

statement error
INSERT INTO a.b.c2 VALUES (3);
----
Violates foreign key constraint

query I
SELECT sql FROM duckdb_tables() WHERE schema_name = 'b' AND table_name = 'c2';
----
CREATE TABLE a.b.c2(j INTEGER, FOREIGN KEY (j) REFERENCES a.b.p(i));

# a self-referencing table keeps its schema path in the renamed constraint
statement ok
CREATE TABLE a.b.s (i INTEGER PRIMARY KEY, parent INTEGER REFERENCES a.b.s (i));

statement ok
ALTER TABLE a.b.s RENAME TO s2;

query I
SELECT sql FROM duckdb_tables() WHERE schema_name = 'b' AND table_name = 's2';
----
CREATE TABLE a.b.s2(i INTEGER PRIMARY KEY, parent INTEGER, FOREIGN KEY (parent) REFERENCES a.b.s2(i));

statement ok
INSERT INTO a.b.s2 VALUES (1, NULL);

statement ok
INSERT INTO a.b.s2 VALUES (2, 1);

statement error
INSERT INTO a.b.s2 VALUES (3, 4);
----
Violates foreign key constraint

# a nested schema of an attached database
statement ok
ATTACH ':memory:' AS att;

statement ok
CREATE SCHEMA att.a;

statement ok
CREATE SCHEMA att.a.b;

statement ok
CREATE TABLE att.a.b.s (i INTEGER PRIMARY KEY, parent INTEGER REFERENCES att.a.b.s (i));

statement ok
ALTER TABLE att.a.b.s RENAME TO s3;

query I
SELECT sql FROM duckdb_tables() WHERE database_name = 'att' AND table_name = 's3';
----
CREATE TABLE a.b.s3(i INTEGER PRIMARY KEY, parent INTEGER, FOREIGN KEY (parent) REFERENCES a.b.s3(i));

statement error
INSERT INTO att.a.b.s3 VALUES (3, 4);
----
Violates foreign key constraint

# the nested schema as the search path
statement ok
USE a.b;

statement ok
CREATE TABLE u (i INTEGER PRIMARY KEY, parent INTEGER REFERENCES u (i));

statement ok
ALTER TABLE u RENAME TO u2;

query I
SELECT sql FROM duckdb_tables() WHERE schema_name = 'b' AND table_name = 'u2';
----
CREATE TABLE a.b.u2(i INTEGER PRIMARY KEY, parent INTEGER, FOREIGN KEY (parent) REFERENCES a.b.u2(i));

statement error
INSERT INTO u2 VALUES (3, 4);
----
Violates foreign key constraint

statement ok
INSERT INTO u2 VALUES (1, NULL);

query II
SELECT i, parent FROM u2;
----
1	NULL

# the names and their schema paths survive a restart, replayed from the WAL and read from a checkpoint
restart

query I
SELECT sql FROM duckdb_tables() WHERE schema_name = 'b' AND table_name IN ('c2', 's2', 'u2') ORDER BY table_name;
----
CREATE TABLE a.b.c2(j INTEGER, FOREIGN KEY (j) REFERENCES a.b.p(i));
CREATE TABLE a.b.s2(i INTEGER PRIMARY KEY, parent INTEGER, FOREIGN KEY (parent) REFERENCES a.b.s2(i));
CREATE TABLE a.b.u2(i INTEGER PRIMARY KEY, parent INTEGER, FOREIGN KEY (parent) REFERENCES a.b.u2(i));

statement error
INSERT INTO a.b.s2 VALUES (3, 4);
----
Violates foreign key constraint

statement error
DELETE FROM a.b.p WHERE i = 1;
----
Violates foreign key constraint

statement ok
CHECKPOINT;

restart

query I
SELECT sql FROM duckdb_tables() WHERE schema_name = 'b' AND table_name IN ('c2', 's2', 'u2') ORDER BY table_name;
----
CREATE TABLE a.b.c2(j INTEGER, FOREIGN KEY (j) REFERENCES a.b.p(i));
CREATE TABLE a.b.s2(i INTEGER PRIMARY KEY, parent INTEGER, FOREIGN KEY (parent) REFERENCES a.b.s2(i));
CREATE TABLE a.b.u2(i INTEGER PRIMARY KEY, parent INTEGER, FOREIGN KEY (parent) REFERENCES a.b.u2(i));

statement error
INSERT INTO a.b.u2 VALUES (3, 4);
----
Violates foreign key constraint

statement ok
INSERT INTO a.b.c2 VALUES (1);

query I
SELECT count(*) FROM a.b.c2;
----
2
