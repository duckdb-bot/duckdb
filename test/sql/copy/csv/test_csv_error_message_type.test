# a type given with columns was not auto-detected, with the sniffer off
statement ok
COPY (SELECT * FROM (VALUES ('1'), ('nope'), ('2')) v(x)) TO '{TEST_DIR}/csv_error_message_type_given.csv' (HEADER false);

statement error
SELECT * FROM read_csv('{TEST_DIR}/csv_error_message_type_given.csv', auto_detect = false, header = false, columns = {'x': 'INTEGER'});
----
This type was either manually set or derived from an existing table. Select a different type to correctly parse this column.

statement ok
