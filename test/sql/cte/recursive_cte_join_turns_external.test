# name: test/sql/cte/recursive_cte_join_turns_external.test
# description: a join reused across recursive CTE iterations can turn external after an in memory iteration
# group: [cte]

# a restart between the statements would discard the operator log
require skip_reload

statement ok
SET threads = 1;

statement ok
SET debug_force_external = true;

# the iterations only reuse the join's operator state with caching operators
statement ok
SET enable_caching_operators = true;

statement ok
CALL enable_logging('PhysicalOperator');

# the MARK join builds nothing in the first iteration and 200,000 rows in the second. Its condition rows make that
# build larger than the minimum reservation of its single partition, so the join turns external
query III
WITH RECURSIVE w(n, k) AS (
    SELECT 0, 0::BIGINT
    UNION ALL
    (
        SELECT f.n + 1, u.k FROM (SELECT * FROM w WHERE n = 0) f CROSS JOIN range(200000) u(k)
        UNION ALL
        SELECT 2, l.k FROM range(200000) l(k) WHERE (l.k, l.k + 1) IN (SELECT s.k, s.k + 1 FROM w s WHERE s.n = 1)
    )
)
SELECT count(*), min(n), max(n) FROM w;
----
400001	0	2

statement ok
CALL disable_logging();

# the second iteration's join went external
query I
SELECT count(*) FILTER (WHERE event = 'Finalize' AND info['external'] = '1') >= 1
FROM duckdb_logs_parsed('PhysicalOperator') WHERE class = 'PhysicalHashJoin';
----
true
