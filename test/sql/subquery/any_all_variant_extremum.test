# name: test/sql/subquery/any_all_variant_extremum.test
# description: ANY/ALL with an ordering comparison over types whose min/max keeps its own collation
# group: [subquery]

# an ordering comparison rewrites the subquery into MIN/MAX, and min/max over VARIANT or BIT binds
# its own collation handling to keep the result in the input type

statement ok
CREATE TABLE v AS SELECT x::INTEGER::VARIANT AS v FROM (VALUES (7),(15)) s(x);

query I
SELECT 127::INTEGER::VARIANT >= ALL (SELECT v FROM v);
----
true

query I
SELECT 127::INTEGER::VARIANT > ALL (SELECT v FROM v);
----
true

query I
SELECT 127::INTEGER::VARIANT <= ALL (SELECT v FROM v);
----
false

query I
SELECT 127::INTEGER::VARIANT < ALL (SELECT v FROM v);
----
false

query I
SELECT 127::INTEGER::VARIANT >= ANY (SELECT v FROM v);
----
true

query I
SELECT 127::INTEGER::VARIANT <= ANY (SELECT v FROM v);
----
false

# equality-based quantifiers went through the mark join and always worked - keep them covered

query I
SELECT 127::INTEGER::VARIANT = ANY (SELECT v FROM v);
----
false

query I
SELECT 7::INTEGER::VARIANT = ANY (SELECT v FROM v);
----
true

# BIT takes the same branch inside min/max

query I
SELECT '1010'::BIT >= ALL (SELECT x::BIT FROM (VALUES ('0101'),('1001')) s(x));
----
true

# the collation can sit on the OUTER side only, and the extremum must still be taken under it:
# 'b' > ANY('Z','a') is true iff 'b' > min(x), and under NOCASE that min is 'a', not 'Z'

query I
SELECT 'b' COLLATE NOCASE > ANY(SELECT x FROM (VALUES ('Z'), ('a')) t(x));
----
true

# collated VARCHAR must be unchanged

statement ok
CREATE TABLE c(x VARCHAR);

statement ok
INSERT INTO c VALUES ('a'), ('b');

query I
SELECT 'B' COLLATE NOCASE >= ALL (SELECT x COLLATE NOCASE FROM c);
----
true

query I
SELECT 'B' COLLATE NOCASE >= ALL (SELECT x COLLATE NOCASE FROM (VALUES ('a'),('c')) s(x));
----
false

query I
SELECT 'z' >= ALL (SELECT x FROM c);
----
true

# NULL in the subquery still makes the answer unknown

query I
SELECT 5 > ALL (SELECT x FROM (VALUES (1),(2),(NULL)) s(x));
----
NULL

query I
SELECT 5 > ALL (SELECT x FROM (VALUES (1),(2)) s(x));
----
true

# an empty subquery is vacuously true for ALL

query I
SELECT 5 > ALL (SELECT x FROM (VALUES (1)) s(x) WHERE x > 100);
----
true

# values that are normalized to another type, such as TIME WITH TIME ZONE, compare against the normalized extremum

query II
SELECT '12:00:00+00'::TIMETZ > ANY (SELECT '11:00:00+00'::TIMETZ), '12:00:00+00'::TIMETZ <= ALL (SELECT '11:00:00+00'::TIMETZ);
----
true	false

query I
SELECT x FROM (VALUES ('12:00:00+00'::TIMETZ), ('09:00:00+00'::TIMETZ)) t(x) WHERE x > ANY (SELECT '10:00:00+00'::TIMETZ);
----
12:00:00+00

query I
SELECT ['12:00:00+00'::TIMETZ] > ANY (SELECT ['11:00:00+00'::TIMETZ]);
----
true

query II
SELECT ['10:00:00+00'::TIMETZ] > ALL (SELECT x FROM (VALUES (['11:00:00+00'::TIMETZ]), (['09:00:00+00'::TIMETZ])) s(x)),
       ['10:00:00+00'::TIMETZ] >= ANY (SELECT x FROM (VALUES (['11:00:00+00'::TIMETZ]), (['09:00:00+00'::TIMETZ])) s(x));
----
false	true

query III
SELECT map(['12:00:00+00'::TIMETZ], [1]) > ANY (SELECT map(['11:00:00+00'::TIMETZ], [1])),
       map(['10:00:00+00'::TIMETZ], [1]) > ALL (SELECT x FROM (VALUES (map(['11:00:00+00'::TIMETZ], [1])), (map(['09:00:00+00'::TIMETZ], [1]))) s(x)),
       map(['10:00:00+00'::TIMETZ], [1]) >= ANY (SELECT x FROM (VALUES (map(['11:00:00+00'::TIMETZ], [1])), (map(['09:00:00+00'::TIMETZ], [1]))) s(x));
----
true	false	true

# a subquery without rows or with untyped NULLs is compared in the type of the left side

query II
SELECT i, ['a' COLLATE NOCASE] > ANY (SELECT NULL WHERE i = 1) FROM range(2) t(i) ORDER BY i;
----
0	false
1	NULL

query II
SELECT 'b' COLLATE NOCASE > ANY (SELECT NULL), '12:00:00+00'::TIMETZ > ALL (SELECT NULL WHERE false);
----
NULL	true

# without a collation the subquery values are cast to the compared type after the extremum is taken, as before,
# so a typed NULL does not become a UNION member and a value that does not fit the compared type is not cast

query I
WITH rhs(v) AS (VALUES (2), (NULL::INTEGER)) SELECT union_value(n := 1) < ANY (SELECT v FROM rhs);
----
true

query I
SELECT 0.5::DECIMAL(38,37) > ANY (SELECT v FROM (VALUES (0), (100)) rhs(v));
----
true

# maps with collated keys take their extremum under the collation, so 'b' > ALL('A', 'Z') is false under NOCASE

query II
SELECT map(['b' COLLATE NOCASE], [1]) > ANY (SELECT map(['A' COLLATE NOCASE], [1])),
       map(['b' COLLATE NOCASE], [1]) > ALL (SELECT x FROM (VALUES (map(['A'], [1])), (map(['Z'], [1]))) s(x));
----
true	false
