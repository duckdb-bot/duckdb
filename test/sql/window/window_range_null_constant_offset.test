# name: test/sql/window/window_range_null_constant_offset.test
# description: A constant NULL offset of a RANGE frame is rejected whatever its type
# group: [window]

# typed NULL constants at the end and at the start of the frame
statement error
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN CURRENT ROW AND NULL::BIGINT FOLLOWING) FROM range(3) t(i)
----
Binder Error: Window RANGE expressions cannot be NULL

statement error
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN NULL::BIGINT PRECEDING AND CURRENT ROW) FROM range(3) t(i)
----
Binder Error: Window RANGE expressions cannot be NULL

statement error
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN NULL::BIGINT FOLLOWING AND UNBOUNDED FOLLOWING) FROM range(3) t(i)
----
Binder Error: Window RANGE expressions cannot be NULL

statement error
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN 1 PRECEDING AND NULL::BIGINT PRECEDING) FROM range(3) t(i)
----
Binder Error: Window RANGE expressions cannot be NULL

# descending order
statement error
SELECT i, sum(i) OVER (ORDER BY i DESC RANGE BETWEEN NULL::BIGINT PRECEDING AND 1 FOLLOWING) FROM range(3) t(i)
----
Binder Error: Window RANGE expressions cannot be NULL

# other offset types
statement error
SELECT d, count(*) OVER (ORDER BY d RANGE BETWEEN NULL::INTERVAL PRECEDING AND CURRENT ROW)
FROM (SELECT DATE '2024-01-01' + i::INTEGER AS d FROM range(3) t(i))
----
Binder Error: Window RANGE expressions cannot be NULL

statement error
SELECT i, sum(i) OVER (ORDER BY i::DOUBLE RANGE BETWEEN CURRENT ROW AND NULL::DOUBLE FOLLOWING) FROM range(3) t(i)
----
Binder Error: Window RANGE expressions cannot be NULL

# several casts
statement error
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN CURRENT ROW AND NULL::INTEGER::BIGINT FOLLOWING) FROM range(3) t(i)
----
Binder Error: Window RANGE expressions cannot be NULL

statement error
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN CURRENT ROW AND TRY_CAST(NULL AS BIGINT) FOLLOWING) FROM range(3) t(i)
----
Binder Error: Window RANGE expressions cannot be NULL

# the same constant as a grouping key
statement error
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN NULL::BIGINT PRECEDING AND CURRENT ROW)
FROM range(3) t(i) GROUP BY i, NULL::BIGINT
----
Binder Error: Window RANGE expressions cannot be NULL

# named windows
statement error
SELECT i, sum(i) OVER w FROM range(3) t(i) WINDOW w AS (ORDER BY i RANGE BETWEEN 1 PRECEDING AND NULL::BIGINT FOLLOWING)
----
Binder Error: Window RANGE expressions cannot be NULL

# untyped NULL constants and columns
statement error
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN CURRENT ROW AND NULL FOLLOWING) FROM range(3) t(i)
----
Binder Error: Window RANGE expressions cannot be NULL

statement error
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN CURRENT ROW AND n FOLLOWING) FROM (SELECT i, NULL AS n FROM range(3) t(i))
----
Binder Error: Window RANGE expressions cannot be NULL

# an offset read from a column places its NULL at the peers of the current row
query II
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN CURRENT ROW AND off FOLLOWING)
FROM (SELECT i, CASE WHEN i = 1 THEN NULL ELSE 1 END AS off FROM range(3) t(i))
ORDER BY i
----
0	1
1	1
2	2

query III
SELECT k, v, sum(v) OVER (ORDER BY k RANGE BETWEEN CURRENT ROW AND off FOLLOWING)
FROM (VALUES (1, 10, NULL::INTEGER), (1, 20, NULL::INTEGER), (2, 30, 0)) t(k, v, off)
ORDER BY k, v
----
1	10	30
1	20	30
2	30	30

# so does the NULL value of a prepared statement parameter, also when the statement is bound again with the value
statement ok
PREPARE untyped_offset AS
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN $1 PRECEDING AND CURRENT ROW) FROM range(3) t(i) ORDER BY i

query II
EXECUTE untyped_offset(NULL::BIGINT)
----
0	0
1	1
2	2

query II
EXECUTE untyped_offset(1)
----
0	0
1	1
2	3

statement error
EXECUTE untyped_offset(NULL)
----
Binder Error: Window RANGE expressions cannot be NULL

statement ok
PREPARE typed_offset AS
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN CURRENT ROW AND $1::BIGINT FOLLOWING) FROM range(3) t(i) ORDER BY i

query II
EXECUTE typed_offset(NULL)
----
0	0
1	1
2	2

query II
EXECUTE typed_offset(1)
----
0	1
1	3
2	2

statement ok
PREPARE rebound_offset AS
SELECT i, sum(i) OVER (
    ORDER BY i RANGE BETWEEN CASE WHEN now() IS NOT NULL THEN $1::BIGINT ELSE 1 END PRECEDING AND CURRENT ROW
)
FROM range(3) t(i) ORDER BY i

query II
EXECUTE rebound_offset(NULL::BIGINT)
----
0	0
1	1
2	2

statement ok
PREPARE alias_offset AS
SELECT $1::BIGINT AS off, i, sum(i) OVER (ORDER BY i RANGE BETWEEN off PRECEDING AND CURRENT ROW)
FROM range(3) t(i) ORDER BY i

query III
EXECUTE alias_offset(NULL::BIGINT)
----
NULL	0	0
NULL	1	1
NULL	2	2

query III
EXECUTE alias_offset(1)
----
1	0	0
1	1	1
1	2	3

# so does a variable, read as a parameter or with getvariable
statement ok
SET VARIABLE null_offset = NULL::BIGINT

query II
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN $null_offset PRECEDING AND CURRENT ROW) FROM range(3) t(i) ORDER BY i
----
0	0
1	1
2	2

query II
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN getvariable('null_offset') PRECEDING AND CURRENT ROW)
FROM range(3) t(i) ORDER BY i
----
0	0
1	1
2	2

# and an offset that is computed, from a NULL constant or by a cast that fails
query II
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN NULL::BIGINT + 1 FOLLOWING AND UNBOUNDED FOLLOWING)
FROM range(3) t(i) ORDER BY i
----
0	3
1	3
2	2

query II
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN CURRENT ROW AND TRY_CAST('x' AS BIGINT) FOLLOWING)
FROM range(3) t(i) ORDER BY i
----
0	0
1	1
2	2

# a constant offset that is also a grouping key
query II
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN 1::BIGINT PRECEDING AND CURRENT ROW)
FROM range(3) t(i) GROUP BY i, 1::BIGINT ORDER BY i
----
0	0
1	1
2	3

# the binder replaces a generated column by its expression, which can be the NULL constant
statement ok
CREATE TABLE generated_offset(i BIGINT, null_off BIGINT GENERATED ALWAYS AS (NULL), off BIGINT GENERATED ALWAYS AS (i - i))

statement ok
INSERT INTO generated_offset(i) VALUES (0), (1), (2)

statement error
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN null_off PRECEDING AND CURRENT ROW) FROM generated_offset
----
Binder Error: Window RANGE expressions cannot be NULL

query II
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN off PRECEDING AND CURRENT ROW) FROM generated_offset ORDER BY i
----
0	0
1	1
2	2

# a macro argument is a constant when it is written as one
statement ok
CREATE MACRO range_sum(x) AS TABLE
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN x PRECEDING AND CURRENT ROW) AS s FROM range(3) t(i)

statement error
SELECT * FROM range_sum(NULL::BIGINT)
----
Binder Error: Window RANGE expressions cannot be NULL

statement ok
PREPARE macro_offset AS SELECT * FROM range_sum($1) ORDER BY i

query II
EXECUTE macro_offset(NULL::BIGINT)
----
0	0
1	1
2	2

# constant offsets that are not NULL
query II
SELECT i, sum(i) OVER (ORDER BY i RANGE BETWEEN 1::BIGINT PRECEDING AND CURRENT ROW) FROM range(3) t(i) ORDER BY i
----
0	0
1	1
2	3

# a constant NULL ordering expression is not an offset
query II
SELECT i, count(*) OVER (ORDER BY NULL::TIME RANGE BETWEEN INTERVAL 1 HOUR PRECEDING AND CURRENT ROW)
FROM range(3) t(i)
ORDER BY i
----
0	3
1	3
2	3
