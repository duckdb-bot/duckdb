# name: test/sql/catalog/sequence/sequence_calls_in_row_order.test
# description: nextval, setval and currval in one select list see each other in the order of the rows (duckdblabs/bot-issue-tracker#556)
# group: [sequence]

statement ok
CREATE SEQUENCE seq;

query II
SELECT x, CASE WHEN x THEN nextval('seq') ELSE currval('seq') END AS y FROM unnest([1, 0, 1, 0, 1, 0]) _(x);
----
1	1
0	1
1	2
0	2
1	3
0	3

# the columns of a row are evaluated from left to right
statement ok
CREATE SEQUENCE s2;

query III
SELECT i, nextval('s2') AS n, currval('s2') AS c FROM range(4) t(i);
----
0	1	1
1	2	2
2	3	3
3	4	4

statement ok
CREATE SEQUENCE s3;

query II
SELECT nextval('s3') AS a, nextval('s3') AS b FROM range(3);
----
1	2
3	4
5	6

statement ok
CREATE SEQUENCE s4;

query II
SELECT x, CASE WHEN x = 0 THEN setval('s4', 10) ELSE nextval('s4') END FROM unnest([1, 0, 1]) _(x);
----
1	1
0	10
1	11

# a currval before any nextval of the session fails as in the first row
statement ok
CREATE SEQUENCE s5;

statement error
SELECT CASE WHEN x = 1 THEN nextval('s5') ELSE currval('s5') END FROM unnest([0, 1, 0, 1]) _(x);
----
currval: sequence is not yet defined in this session

# more rows than a vector
statement ok
CREATE SEQUENCE s6;

query III
SELECT count(*), sum(n - c), max(n) FROM (SELECT nextval('s6') AS n, currval('s6') AS c FROM range(5000));
----
5000	0	5000

# a single nextval hands out its values as before
statement ok
CREATE SEQUENCE s7;

query II
SELECT count(*), max(n) FROM (SELECT nextval('s7') AS n FROM range(5000));
----
5000	5000

# calls nested in other functions and in lambda bodies
statement ok
CREATE SEQUENCE s8;

query I
SELECT nextval('s8') + currval('s8') FROM range(4);
----
2
4
6
8

statement ok
CREATE SEQUENCE s9;

query I
SELECT abs(CASE WHEN x THEN nextval('s9') ELSE currval('s9') END) FROM unnest([1, 0, 1, 0]) _(x);
----
1
1
2
2

statement ok
CREATE SEQUENCE s10;

query II
SELECT list_transform([i], lambda v: nextval('s10')), currval('s10') FROM range(4) _(i);
----
[1]	1
[2]	2
[3]	3
[4]	4

# strings and lists of a filtered input that spans several vectors pass through unchanged
statement ok
CREATE SEQUENCE s11;

query IIIII
SELECT count(*), sum(n - c), sum(len(s)), sum(l[2]), max(n)
FROM (SELECT nextval('s11') AS n, currval('s11') AS c, repeat('x', i % 50) || i AS s, [i, i + 1] AS l FROM range(5000) t(i) WHERE i % 3 <> 0);
----
3333	0	94261	8335000	3333

# the rows before an error have taken their values, as in PostgreSQL
statement ok
CREATE SEQUENCE s12;

statement error
SELECT CASE WHEN i = 3 THEN error('stop') ELSE nextval('s12') END, currval('s12') FROM range(5) t(i);
----
stop

query I
SELECT currval('s12');
----
3
