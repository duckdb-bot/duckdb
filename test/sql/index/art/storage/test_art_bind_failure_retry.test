# name: test/sql/index/art/storage/test_art_bind_failure_retry.test
# description: After a query fails to bind an index, later queries fail the same way or bind it (duckdblabs/bot-issue-tracker#486)
# group: [storage]

require skip_reload

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET checkpoint_threshold='999999GB';

statement ok
ATTACH '{TEST_DIR}/art_bind_failure_retry.db' AS db;

statement ok
CREATE TEMP MACRO tnorm(s) AS lower(s);

statement ok
CREATE TABLE db.t(k VARCHAR);

statement ok
CREATE UNIQUE INDEX idx ON db.t((tnorm(k)));

statement ok
INSERT INTO db.t VALUES ('a'), ('b');

statement ok
CHECKPOINT db;

# this row stays in the WAL, so the index buffers it when the database is attached again
statement ok
INSERT INTO db.t VALUES ('c');

statement ok
DETACH db;

statement ok
DROP MACRO tnorm;

statement ok
ATTACH '{TEST_DIR}/art_bind_failure_retry.db' AS db;

# every statement that binds the index fails the same way
statement error
INSERT INTO db.t VALUES ('d');
----
Scalar Function with name tnorm does not exist

statement error
INSERT INTO db.t VALUES ('d');
----
Scalar Function with name tnorm does not exist

statement error
DELETE FROM db.t WHERE k = 'b';
----
Scalar Function with name tnorm does not exist

statement ok
CREATE TEMP MACRO tnorm(s) AS lower(s);

query I
SELECT count(*) FROM db.t WHERE k = 'a';
----
1

# the index holds the checkpointed rows and the row of the WAL
statement error
INSERT INTO db.t VALUES ('A');
----
<REGEX>:Constraint Error.*Duplicate key.*

statement error
INSERT INTO db.t VALUES ('C');
----
<REGEX>:Constraint Error.*Duplicate key.*

statement ok
INSERT INTO db.t VALUES ('d');

query I
SELECT k FROM db.t ORDER BY k;
----
a
b
c
d

statement ok
DETACH db;

statement ok
ATTACH '{TEST_DIR}/art_bind_failure_retry.db' AS db;

statement error
INSERT INTO db.t VALUES ('D');
----
<REGEX>:Constraint Error.*Duplicate key.*

query I
SELECT k FROM db.t ORDER BY k;
----
a
b
c
d
