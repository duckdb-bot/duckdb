# name: test/issues/general/test_26106.test
# description: An automatic checkpoint after WAL replay keeps the index entries that the replay buffered
# group: [general]

require skip_reload

load {TEST_DIR}/test_26106.db

statement ok
CREATE TABLE t(id INTEGER, k VARCHAR);

statement ok
CREATE INDEX idx_k ON t(k);

statement ok
CHECKPOINT;

# keep the insert in the WAL
statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
PRAGMA wal_autocheckpoint='1TB';

statement ok
INSERT INTO t SELECT i, 'k' || i FROM range(500) r(i);

# the WAL replay buffers the inserts into the unbound index, then a commit triggers an automatic checkpoint
restart

statement ok
SET wal_autocheckpoint = '1KB';

statement ok
CREATE TABLE other AS SELECT * FROM range(20000) r(x);

# the automatic checkpoint is skipped, so the WAL keeps the inserts
query I
SELECT wal_size <> '0 bytes' FROM pragma_database_size() WHERE database_name = current_database();
----
true

statement ok
PRAGMA disable_checkpoint_on_shutdown;

restart

statement ok
SET wal_autocheckpoint = '1KB';

# a lookup binds the index, after which a commit checkpoints again
query I
SELECT count(*) FROM t WHERE k = 'k7';
----
1

statement ok
INSERT INTO other VALUES (20000);

query I
SELECT wal_size FROM pragma_database_size() WHERE database_name = current_database();
----
0 bytes

statement ok
PRAGMA disable_checkpoint_on_shutdown;

restart

query II
SELECT (SELECT count(*) FROM t WHERE id = 7), (SELECT count(*) FROM t WHERE k = 'k7');
----
1	1

statement ok
DELETE FROM t;

query II
SELECT count(*), (SELECT count(*) FROM other) FROM t;
----
0	20001
