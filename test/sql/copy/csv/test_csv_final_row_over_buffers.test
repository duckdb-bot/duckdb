# a comment line behind the pair that ends with the buffer
statement ok
COPY (SELECT l || chr(13) FROM (VALUES (0, 'a,b'), (1, '1,2'), (2, '33,44'), (3, '#cccccc'), (4, '7,8'), (5, '9,9')) t(i, l) ORDER BY i) TO '{TEST_DIR}/crlf_pair_split_comment.csv' (HEADER false, QUOTE '', DELIMITER '|');

query II
SELECT * FROM read_csv('{TEST_DIR}/crlf_pair_split_comment.csv', header = true, auto_detect = false, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'}, new_line = '\r\n', comment = '#', buffer_size = 24, max_line_size = 16) ORDER BY ALL
----
1	2
33	44
7	8
9	9

# rows of a larger file in these places
statement ok
COPY (SELECT i + 1000 AS aaaa, 'wxyz' AS bbbbb FROM range(300) t(i) ORDER BY i) TO '{TEST_DIR}/short_rows_crlf.csv' (HEADER, NEW_LINE e'\r\n');

foreach buffer_size 986 1050 1066

query IIIII
SELECT count(*), count(DISTINCT aaaa), min(aaaa), max(aaaa), count(*) FILTER (WHERE bbbbb = 'wxyz') FROM read_csv('{TEST_DIR}/short_rows_crlf.csv', buffer_size = {buffer_size}, max_line_size = 100)
----
300	300	1000	1299	300

endloop

foreach buffer_size 914 1000 1042

query IIIII
SELECT count(*), count(DISTINCT aaaa), min(aaaa), max(aaaa), count(*) FILTER (WHERE bbbbb = 'wxyz') FROM read_csv('{TEST_DIR}/short_rows_crlf.csv', buffer_size = {buffer_size}, max_line_size = 100, ignore_errors = true)
----
300	300	1000	1299	300

endloop

# scan ranges that fill the buffer, and a read with one thread
query IIIII
SELECT count(*), count(DISTINCT aaaa), min(aaaa), max(aaaa), count(*) FILTER (WHERE bbbbb = 'wxyz') FROM read_csv('{TEST_DIR}/short_rows_crlf.csv', buffer_size = 992, max_line_size = 100)
----
300	300	1000	1299	300

query IIIII
SELECT count(*), count(DISTINCT aaaa), min(aaaa), max(aaaa), count(*) FILTER (WHERE bbbbb = 'wxyz') FROM read_csv('{TEST_DIR}/short_rows_crlf.csv', buffer_size = 986, max_line_size = 100, parallel = false)
----
300	300	1000	1299	300

# read sequentially, the end of a file of three full buffers is only found when a fourth one is asked for. One thread
# is in the long last row when the other one finds the end, and the read is repeated to make that order likely
statement ok
SET threads = 2;

statement ok
COPY (SELECT l FROM (SELECT i, printf('%07d,%07d', i, i) AS l FROM range(16388) t(i) UNION ALL SELECT 16388, '9,"' || repeat('x', 524220)) ORDER BY i) TO '{TEST_DIR}/sequential_three_buffers.csv' (HEADER false, QUOTE '', DELIMITER '|');

loop i 0 10

query II
SELECT count(*), sum(a) FROM read_csv('{TEST_DIR}/sequential_three_buffers.csv', header = false, auto_detect = false, columns = {'a': 'BIGINT', 'b': 'VARCHAR'}, encoding = 'latin-1', buffer_size = 262144, ignore_errors = true)
----
16388	134275078

endloop
