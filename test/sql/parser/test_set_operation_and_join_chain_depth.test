statement ok
RESET max_expression_depth;

# chains far beyond the limit are rejected while they are parsed, before a tree of that depth exists
statement error
FROM query('PIVOT (SELECT 1 AS a' || repeat(' EXCEPT SELECT 1 AS a', 100000) || ') ON a IN (1)');
----
<REGEX>:Parser Error.*Max expression depth.*

statement error
FROM query('PIVOT (SELECT 1 AS a' || repeat(' INTERSECT SELECT 1 AS a', 100000) || ') ON a IN (1)');
----
<REGEX>:Parser Error.*Max expression depth.*

statement error
FROM query('SELECT 1 AS a' || repeat(' EXCEPT SELECT 1 AS a', 100000));
----
<REGEX>:Parser Error.*Max expression depth.*

statement error
FROM query('PIVOT (SELECT 1 AS a FROM range(1)' || repeat(', range(1)', 100000) || ') ON a IN (1)');
----
<REGEX>:Parser Error.*Max expression depth.*

statement error
FROM query('PIVOT (SELECT 1 AS a FROM range(1)' || repeat(' JOIN range(1) USING (range)', 100000) || ') ON a IN (1)');
----
<REGEX>:Parser Error.*Max expression depth.*

# a repeated UNION ALL of any length stays one node
query I
FROM query('SELECT count(*) FROM (SELECT 1 AS a' || repeat(' UNION ALL SELECT 1 AS a', 5000) || ')');
----
5001

query I
SELECT 42;
----
42
