# name: test/sql/function/list/lambdas/nested_lambda_bind_data.test
# description: Deeply nested lambdas, which share their bodies between the copies of their bind data (duckdblabs/bot-issue-tracker#689)
# group: [lambdas]

# a collation of eight nested STRUCT(...)[] levels collates through two lambdas per level
statement ok
SET default_collation = 'nocase';

statement ok
CREATE TABLE t(id INTEGER, x STRUCT(f STRUCT(f STRUCT(f STRUCT(f STRUCT(f STRUCT(f STRUCT(f STRUCT(f VARCHAR)[])[])[])[])[])[])[])[]);

statement ok
INSERT INTO t VALUES (1, [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': 'Abc'}]}]}]}]}]}]}]}]), (2, [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': 'aBC'}]}]}]}]}]}]}]}]), (3, [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': 'abd'}]}]}]}]}]}]}]}]), (4, NULL);

query II
SELECT count(DISTINCT x), count(*) FROM t;
----
2	4

query II
SELECT count(*), list(id ORDER BY id) FROM t GROUP BY x ORDER BY ALL;
----
1	[3]
1	[4]
2	[1, 2]

query II
SELECT l.id, r.id FROM t l JOIN t r ON l.x = r.x AND l.id < r.id ORDER BY ALL;
----
1	2

query I
SELECT [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': [{'f': 'ABC'}]}]}]}]}]}]}]}] IN (SELECT x FROM t);
----
true

statement ok
SET default_collation = '';

# lambdas nested in each other, each capturing a column and the parameters of the lambdas around it
statement ok
CREATE TABLE n(k INTEGER, l INTEGER[][][][][]);

statement ok
INSERT INTO n VALUES (10, [[[[[1, 2]]], [[[3]]]]]), (20, [[[[[4]], [[5, 6]]]]]), (30, NULL);

query II
SELECT k, list_transform(l, lambda a: list_transform(a, lambda b: list_transform(b, lambda c: list_transform(c, lambda d:
	list_transform(d, lambda e, i: e * k + i + len(a) + len(b) + len(c) + len(d)))))) FROM n ORDER BY k;
----
10	[[[[[17, 28]]], [[[36]]]]]
20	[[[[[86]], [[107, 128]]]]]
30	NULL

query II
SELECT k, list_transform(l, lambda a: list_filter(a, lambda b: list_reduce(flatten(flatten(b)), lambda x, y: x + y + k) > k + 2))
FROM n ORDER BY k;
----
10	[[[[[1, 2]]]]]
20	[[[[[4]], [[5, 6]]]]]
30	NULL

# the same through a prepared statement and a view
statement ok
PREPARE p AS SELECT list_transform(l, lambda a: list_transform(a, lambda b: list_transform(b, lambda c: len(c) * $1))) FROM n WHERE k = 10;

query I
EXECUTE p(3);
----
[[[3], [3]]]

statement ok
CREATE VIEW v AS SELECT k, list_transform(l, lambda a: list_transform(a, lambda b: list_transform(b, lambda c: list_transform(c, lambda d: len(d) + k)))) AS r FROM n;

query II
SELECT k, r FROM v ORDER BY k;
----
10	[[[[12]], [[11]]]]
20	[[[[21], [22]]]]
30	NULL
