# name: test/sql/copy/parquet/writer/write_null_fixed_size_array.test
# description: A NULL fixed-size array is written as a single NULL entry without child elements
# group: [writer]

require parquet

statement ok
COPY (SELECT * FROM (VALUES (1, [true, false]::BOOLEAN[2]), (2, NULL), (3, [NULL, true]), (4, NULL)) t(i, c0)) TO '{TEST_DIR}/null_array.parquet' (FORMAT PARQUET);

# two entries for each of the two arrays, and one for each NULL
query I
SELECT num_values FROM parquet_metadata('{TEST_DIR}/null_array.parquet') WHERE path_in_schema LIKE 'c0%';
----
6

query II
SELECT * FROM '{TEST_DIR}/null_array.parquet' ORDER BY i;
----
1	[true, false]
2	NULL
3	[NULL, true]
4	NULL

# a NULL array and a NULL struct above an array
statement ok
COPY (SELECT i, CASE WHEN i % 3 = 0 THEN NULL ELSE {'a': CASE WHEN i % 3 = 1 THEN NULL ELSE [i, i + 1, i + 2]::INT[3] END} END AS c0 FROM range(6) t(i)) TO '{TEST_DIR}/null_array_struct.parquet' (FORMAT PARQUET);

query I
SELECT num_values FROM parquet_metadata('{TEST_DIR}/null_array_struct.parquet') WHERE path_in_schema LIKE 'c0%';
----
10

query II
SELECT * FROM '{TEST_DIR}/null_array_struct.parquet' ORDER BY i;
----
0	NULL
1	{'a': NULL}
2	{'a': [2, 3, 4]}
3	NULL
4	{'a': NULL}
5	{'a': [5, 6, 7]}

# NULL arrays inside an array, and a NULL outer array
statement ok
COPY (SELECT i, CASE WHEN i % 4 = 0 THEN NULL ELSE [CASE WHEN i % 2 = 0 THEN NULL ELSE [i, i]::INT[2] END, [i, NULL]::INT[2]] END AS c0 FROM range(4) t(i)) TO '{TEST_DIR}/null_array_nested.parquet' (FORMAT PARQUET);

query I
SELECT num_values FROM parquet_metadata('{TEST_DIR}/null_array_nested.parquet') WHERE path_in_schema LIKE 'c0%';
----
12

query II
SELECT * FROM '{TEST_DIR}/null_array_nested.parquet' ORDER BY i;
----
0	NULL
1	[[1, 1], [1, NULL]]
2	[NULL, [2, NULL]]
3	[[3, 3], [3, NULL]]

# NULL arrays inside a fixed-size array
statement ok
COPY (SELECT i, CASE WHEN i % 4 = 0 THEN NULL ELSE [CASE WHEN i % 2 = 0 THEN NULL ELSE [i, i]::INT[2] END, [i, NULL]::INT[2]]::INT[2][2] END AS c0 FROM range(4) t(i)) TO '{TEST_DIR}/null_array_array.parquet' (FORMAT PARQUET);

query I
SELECT num_values FROM parquet_metadata('{TEST_DIR}/null_array_array.parquet') WHERE path_in_schema LIKE 'c0%';
----
12

query II
SELECT * FROM '{TEST_DIR}/null_array_array.parquet' ORDER BY i;
----
0	NULL
1	[[1, 1], [1, NULL]]
2	[NULL, [2, NULL]]
3	[[3, 3], [3, NULL]]

# strings in arrays across several vectors
statement ok
COPY (SELECT i, CASE WHEN i % 5 = 0 THEN NULL ELSE [CASE WHEN i % 2 = 0 THEN NULL ELSE 'x' || i END, 'y']::VARCHAR[2] END AS c0 FROM range(5000) t(i)) TO '{TEST_DIR}/null_array_large.parquet' (FORMAT PARQUET);

query I
SELECT num_values FROM parquet_metadata('{TEST_DIR}/null_array_large.parquet') WHERE path_in_schema LIKE 'c0%';
----
9000

query III
SELECT count(*), count(c0), count(c0[1]) FROM '{TEST_DIR}/null_array_large.parquet';
----
5000	4000	2000

query I
SELECT count(*) FROM '{TEST_DIR}/null_array_large.parquet' WHERE c0 IS DISTINCT FROM CASE WHEN i % 5 = 0 THEN NULL ELSE [CASE WHEN i % 2 = 0 THEN NULL ELSE 'x' || i END, 'y']::VARCHAR[2] END;
----
0

# long strings, format version 2 and small row groups
statement ok
COPY (SELECT i, CASE WHEN i % 5 = 0 THEN NULL ELSE [CASE WHEN i % 2 = 0 THEN NULL ELSE repeat('x', 100) || i END, 'y']::VARCHAR[2] END AS c0 FROM range(5000) t(i)) TO '{TEST_DIR}/null_array_v2.parquet' (FORMAT PARQUET, PARQUET_VERSION v2, ROW_GROUP_SIZE 1000);

query I
SELECT sum(num_values) FROM parquet_metadata('{TEST_DIR}/null_array_v2.parquet') WHERE path_in_schema LIKE 'c0%';
----
9000

query I
SELECT count(*) FROM '{TEST_DIR}/null_array_v2.parquet' WHERE c0 IS DISTINCT FROM CASE WHEN i % 5 = 0 THEN NULL ELSE [CASE WHEN i % 2 = 0 THEN NULL ELSE repeat('x', 100) || i END, 'y']::VARCHAR[2] END;
----
0
