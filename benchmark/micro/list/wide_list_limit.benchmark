# name: benchmark/micro/list/wide_list_limit.benchmark
# description: Read one row of a table with wide lists, which reads the children of that row only
# group: [list]

name Wide List Limit
group micro
subgroup list

load
CREATE TABLE df AS SELECT list(loading) AS loadings FROM (SELECT random() AS loading, b.range AS row FROM range(20000) a, range(3000) b) GROUP BY row;

run
SELECT loadings[1] FROM df LIMIT 1
