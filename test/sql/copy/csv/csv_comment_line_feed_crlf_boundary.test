# a reject right behind the comment keeps its line and byte positions
statement ok
COPY (SELECT 'a,b' || chr(13) || chr(10) || '1,2' || chr(13) || chr(10) || '#comment' || chr(10) || 'nope,400' || chr(13) || chr(10) || '500,600' || chr(13)) TO '{TEST_DIR}/comment_lf_boundary_reject.csv' (HEADER false, QUOTE '', DELIM '|');

