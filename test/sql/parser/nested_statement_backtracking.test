# 4096 parentheses in FROM, each tried as a subquery before it is tried as a parenthesized table reference
query I
SELECT count(*) FROM query('SELECT * FROM ' || repeat('(', 4096) || 't' || repeat(')', 4096))
----
2

query I
SELECT count(*) FROM query('SELECT * FROM ' || repeat('(', 4096) || '(SELECT * FROM t) sq' || repeat(')', 4096))
----
2

