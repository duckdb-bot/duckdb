# name: test/sql/subquery/any_all/test_union_null_member_correlated.test
# description: Correlated quantified comparisons and joins of a UNION whose active member is NULL see its NULL comparison (duckdblabs/bot-issue-tracker#691)
# group: [any_all]

statement ok
CREATE TABLE a(g INTEGER, x UNION(k INTEGER));

statement ok
INSERT INTO a VALUES (1, union_value(k := NULL::INTEGER)), (1, union_value(k := 1));

statement ok
CREATE TABLE b(g INTEGER, y UNION(k INTEGER));

statement ok
INSERT INTO b VALUES (1, union_value(k := 2)), (1, union_value(k := NULL::INTEGER));

query II
SELECT a.x, b.y FROM a JOIN b ON a.g = b.g AND a.x < b.y ORDER BY ALL;
----
1	2

query TII
SELECT x, x < ANY (SELECT y FROM b WHERE b.g = a.g), x IN (SELECT y FROM b WHERE b.g = a.g) FROM a ORDER BY ALL;
----
1	true	NULL
NULL	NULL	NULL

query I
SELECT count(*) FROM a WHERE x NOT IN (SELECT y FROM b WHERE b.g = a.g);
----
0

# every correlated quantified comparison against the three-valued result of its comparisons, for UNIONs with NULL
# members, other tags, NULL values and empty groups
statement ok
CREATE TABLE l(id INTEGER, x UNION(i INTEGER, s VARCHAR));

statement ok
INSERT INTO l VALUES (1, union_value(s := NULL::VARCHAR)), (2, union_value(s := 'a')), (3, union_value(i := NULL::INTEGER)),
	(4, union_value(i := 1)), (5, NULL), (6, union_value(i := 3)), (7, union_value(s := 'b'));

statement ok
CREATE TABLE r(g INTEGER, y UNION(i INTEGER, s VARCHAR));

statement ok
INSERT INTO r SELECT g, y FROM (VALUES (union_value(s := 'b')), (union_value(s := 'c')), (NULL),
	(union_value(i := 2)), (union_value(s := NULL::VARCHAR)), (union_value(i := 0)), (union_value(s := 'a')),
	(union_value(i := NULL::INTEGER))) v(y), range(1, 8) t(g)
WHERE hash(g, y::VARCHAR) % 3 = 0;

foreach op < <= > >= = <>

query I
SELECT count(*) FROM l, (SELECT * FROM range(1, 9) UNION ALL SELECT NULL) t(g)
WHERE (l.x {op} ANY (SELECT y FROM r WHERE r.g = t.g)) IS DISTINCT FROM
	(SELECT CASE WHEN bool_or(l.x {op} y) THEN true WHEN bool_or((l.x {op} y) IS NULL) THEN NULL ELSE false END
	 FROM r WHERE r.g = t.g);
----
0

query I
SELECT count(*) FROM l, (SELECT * FROM range(1, 9) UNION ALL SELECT NULL) t(g)
WHERE (l.x {op} ALL (SELECT y FROM r WHERE r.g = t.g)) IS DISTINCT FROM
	(SELECT CASE WHEN bool_or(NOT (l.x {op} y)) THEN false WHEN bool_or((l.x {op} y) IS NULL) THEN NULL ELSE true END
	 FROM r WHERE r.g = t.g);
----
0

query I
SELECT count(*) FROM l, (SELECT * FROM range(1, 9) UNION ALL SELECT NULL) t(g)
WHERE (l.x {op} ANY (SELECT y FROM r WHERE r.g = t.g + l.id - l.id)) IS DISTINCT FROM
	(SELECT CASE WHEN bool_or(l.x {op} y) THEN true WHEN bool_or((l.x {op} y) IS NULL) THEN NULL ELSE false END
	 FROM r WHERE r.g = t.g);
----
0

# a hash join with an equality and the UNION inequality
query I
SELECT count(*) FROM (
	(SELECT l.id, l.x, r.y FROM l JOIN r ON l.id = r.g AND l.x {op} r.y
	 EXCEPT ALL SELECT l.id, l.x, r.y FROM l, r WHERE (l.id = r.g AND l.x {op} r.y) IS TRUE)
	UNION ALL
	(SELECT l.id, l.x, r.y FROM l, r WHERE (l.id = r.g AND l.x {op} r.y) IS TRUE
	 EXCEPT ALL SELECT l.id, l.x, r.y FROM l JOIN r ON l.id = r.g AND l.x {op} r.y));
----
0

endloop

# members that are a STRUCT, a LIST or a UNION; a UNION member compares as NULL also when neither member is NULL,
# which the counts per tag do not see, so the groups here have no NULL inside a UNION member
statement ok
CREATE TABLE nl(id INTEGER, x UNION(m STRUCT(n INTEGER), a INTEGER[], u UNION(j INTEGER), k INTEGER));

statement ok
INSERT INTO nl VALUES (0, union_value(m := NULL::STRUCT(n INTEGER))), (1, union_value(m := {'n': NULL::INTEGER})),
	(2, union_value(m := {'n': 1})), (3, union_value(a := NULL::INTEGER[])), (4, union_value(a := [NULL::INTEGER])),
	(5, union_value(a := [1])), (6, union_value(u := NULL::UNION(j INTEGER))), (7, union_value(u := union_value(j := 1))),
	(8, union_value(k := NULL::INTEGER)), (9, union_value(k := 1)), (10, NULL);

statement ok
CREATE TABLE nr AS SELECT g, x AS y FROM nl, range(4) t(g) WHERE hash(g, id) % 2 = 0;

foreach op = < <>

query I
SELECT count(*) FROM nl, (SELECT * FROM range(4) UNION ALL SELECT NULL) t(g)
WHERE (nl.x {op} ANY (SELECT y FROM nr WHERE nr.g = t.g)) IS DISTINCT FROM
	(SELECT CASE WHEN bool_or(nl.x {op} y) THEN true WHEN bool_or((nl.x {op} y) IS NULL) THEN NULL ELSE false END
	 FROM nr WHERE nr.g = t.g);
----
0

endloop

# FIXME: a NULL inside a UNION member of both sides makes the comparison NULL, which the counts per tag do not see
mode skip

query I
SELECT union_value(u := union_value(j := 1))::UNION(u UNION(j INTEGER), k INTEGER) IN
	(SELECT y FROM (VALUES (1, union_value(u := union_value(j := NULL::INTEGER))::UNION(u UNION(j INTEGER), k INTEGER))) v(g, y)
	 WHERE v.g = t.g)
FROM range(1, 2) t(g);
----
NULL

mode unskip

# range joins that sort on other inequalities
statement ok
CREATE TABLE ml AS SELECT i % 2 AS a, CASE WHEN i % 2 = 0 THEN union_value(k := NULL::INTEGER) ELSE union_value(k := i) END::UNION(k INTEGER) x
FROM range(2000) t(i);

statement ok
CREATE TABLE mr AS SELECT i % 2 + 1 AS a, CASE WHEN i % 3 = 0 THEN union_value(k := NULL::INTEGER) ELSE union_value(k := i) END::UNION(k INTEGER) y
FROM range(2000) t(i);

statement ok
SET merge_join_threshold = 0;

query I
SELECT count(*) FROM (
	(SELECT ml.a, ml.x, mr.a, mr.y FROM ml JOIN mr ON ml.a < mr.a AND ml.x < mr.y
	 EXCEPT ALL SELECT ml.a, ml.x, mr.a, mr.y FROM ml, mr WHERE (ml.a < mr.a AND ml.x < mr.y) IS TRUE)
	UNION ALL
	(SELECT ml.a, ml.x, mr.a, mr.y FROM ml, mr WHERE (ml.a < mr.a AND ml.x < mr.y) IS TRUE
	 EXCEPT ALL SELECT ml.a, ml.x, mr.a, mr.y FROM ml JOIN mr ON ml.a < mr.a AND ml.x < mr.y));
----
0

query I
SELECT count(*) FROM (
	(SELECT ml.a, ml.x, mr.a, mr.y FROM ml JOIN mr ON ml.a <= mr.a AND ml.x > mr.y AND ml.a + 1 >= mr.a
	 EXCEPT ALL SELECT ml.a, ml.x, mr.a, mr.y FROM ml, mr WHERE (ml.a <= mr.a AND ml.x > mr.y AND ml.a + 1 >= mr.a) IS TRUE)
	UNION ALL
	(SELECT ml.a, ml.x, mr.a, mr.y FROM ml, mr WHERE (ml.a <= mr.a AND ml.x > mr.y AND ml.a + 1 >= mr.a) IS TRUE
	 EXCEPT ALL SELECT ml.a, ml.x, mr.a, mr.y FROM ml JOIN mr ON ml.a <= mr.a AND ml.x > mr.y AND ml.a + 1 >= mr.a));
----
0

statement ok
SET prefer_range_joins = true;

query I
SELECT (SELECT count(*) FROM ml JOIN mr ON ml.a = mr.a - 1 AND ml.a < mr.a AND ml.x < mr.y AND ml.x <= mr.y) -
	(SELECT count(*) FROM ml, mr WHERE (ml.a = mr.a - 1 AND ml.a < mr.a AND ml.x < mr.y AND ml.x <= mr.y) IS TRUE);
----
0
