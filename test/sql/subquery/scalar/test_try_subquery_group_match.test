# name: test/sql/subquery/scalar/test_try_subquery_group_match.test
# description: TRY over a scalar subquery whose select item is a scalar subquery that is also a GROUP BY expression
# group: [scalar]

statement ok
CREATE TABLE t AS SELECT 1 AS x;

query I
SELECT (SELECT (SELECT x) FROM t GROUP BY (SELECT x));
----
1

query I
SELECT TRY((SELECT (SELECT x) FROM t GROUP BY (SELECT x)));
----
1

# the same item written with TRY directly in the grouped select list
query I
SELECT TRY((SELECT x)) FROM t GROUP BY (SELECT x);
----
1

query I
SELECT TRY((SELECT (SELECT x) FROM (VALUES (1)) t(x) GROUP BY (SELECT x)));
----
1

query I
SELECT TRY((SELECT (SELECT x) AS a FROM t GROUP BY (SELECT x)));
----
1

query I
SELECT TRY((SELECT (SELECT x) FROM t GROUP BY (SELECT x) HAVING (SELECT x) = 1 ORDER BY (SELECT x)));
----
1

# the group used inside a larger select item was already supported
query I
SELECT TRY((SELECT (SELECT x) + 1 FROM t GROUP BY (SELECT x)));
----
2

statement ok
CREATE TABLE t2 AS SELECT * FROM (VALUES (1), (1), (2)) v(x);

query I
SELECT TRY((SELECT (SELECT x) FROM t2 WHERE x = 1 GROUP BY (SELECT x)));
----
1

# more than one group still fails the cardinality check of the scalar subquery
statement error
SELECT TRY((SELECT (SELECT x) FROM t2 GROUP BY (SELECT x)));
----
More than one row returned by a subquery

# an error in the group expression is not masked, like without the subquery
statement error
SELECT TRY((SELECT (SELECT 10 // (x - 1)) FROM t GROUP BY (SELECT 10 // (x - 1))));
----
Division by zero

statement error
SELECT TRY((SELECT 10 // (x - 1) FROM t GROUP BY 10 // (x - 1)));
----
Division by zero
