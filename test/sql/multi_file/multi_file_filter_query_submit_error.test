# name: test/sql/multi_file/multi_file_filter_query_submit_error.test
# description: A filter query that fails when it is submitted reports its own error
# group: [multi_file]

require parquet

statement ok
COPY (SELECT i FROM range(10) t(i)) TO '{TEST_DIR}/filter_query_submit_data.parquet'

# a parameter without a value fails when the query is submitted
statement error
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_submit_data.parquet', 'filter_query': 'SELECT ?::BIGINT, 5::BIGINT, NULL::BIT'}])
----
<REGEX>:Invalid Input Error: Failed to read the filter query of file .*filter_query_submit_data.parquet: Values were not provided for the following parameters.*

# a Bernoulli sample with a row count is rejected when the query is planned at submission, and the error keeps its class
statement error
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_submit_data.parquet', 'filter_query': 'SELECT 0::BIGINT, count(*)::BIGINT, NULL::BIT FROM read_parquet(''{TEST_DIR}/filter_query_submit_data.parquet'') USING SAMPLE bernoulli(3 ROWS)'}])
----
<REGEX>:Parser Error: Failed to read the filter query of file .*filter_query_submit_data.parquet: Sample method.*cannot be used with a discrete sample count.*

# the scan still works
query I
SELECT count(*) FROM read_parquet([{'filename': '{TEST_DIR}/filter_query_submit_data.parquet', 'filter_query': 'SELECT 0::BIGINT, 5::BIGINT, NULL::BIT'}])
----
5
