# name: test/optimizer/not_null_check_simplification.test
# description: NOT of a NULL check becomes the other NULL check
# group: [optimizer]

statement ok
CREATE TABLE t (a INTEGER);

statement ok
INSERT INTO t VALUES (1), (NULL), (3);

statement ok
PRAGMA explain_output = 'OPTIMIZED_ONLY';

query II
EXPLAIN SELECT * FROM t WHERE NOT (a IS NULL);
----
logical_opt	<!REGEX>:(?s).*NOT ?\(.*

query II
EXPLAIN SELECT * FROM t WHERE NOT (a IS NULL);
----
logical_opt	<REGEX>:(?s).*a IS NOT NULL.*

query II
EXPLAIN SELECT * FROM t WHERE NOT (a IS NOT NULL);
----
logical_opt	<REGEX>:(?s).*a IS NULL.*

query II
EXPLAIN SELECT * FROM t WHERE NOT (a IS NOT NULL);
----
logical_opt	<!REGEX>:(?s).*(NOT ?\(|IS NOT NULL).*

query I
SELECT a FROM t WHERE NOT (a IS NULL) ORDER BY a;
----
1
3

query I
SELECT count(*) FROM t WHERE NOT (a IS NOT NULL);
----
1

query II
SELECT a, NOT (a IS NULL) AND NOT (NOT (a IS NOT NULL)) FROM t ORDER BY a;
----
1	true
3	true
NULL	false
